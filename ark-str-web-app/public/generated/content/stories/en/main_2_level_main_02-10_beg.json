  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（前）"
    },
    {
      "type": "background",
      "backgroundId": "bg_lungmen_r"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Liskarm Are you able to hold the line?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "I'm fine over here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "Franka, watch out for an enemy flank!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "There's no end to them...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "You don't have a chance of breaking through our defenses!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "I'm going to smash you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Guh?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "A-aaaagh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Wh-what is that? !"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "It's a thermite blade."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Does slicing count as breaking as well?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "What a pain..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Medic! There's someone injured here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Be careful when transporting them!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerId": null,
      "isRemote": false,
      "text": "I got it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "How's the situation over there?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "I think we have a little issue here."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "Franka..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "The enemy leader... just showed up in front of me and Liskarm!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "Where else do you plan on hiding?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "You can't escape us, Rhodes Island."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "I'll grind you to dust..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "...not even your bones will remain."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "You traitors... have turned your backs on the Infected!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Oh~ This one's finally decided to show up."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Doesn't sound too impressive, though."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "Amiya, seems like we--"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Ack, it's a dead end!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Did I run too far ahead? !"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "Franka's also having some problems..."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "Reunion has us cornered."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "We'll have to fight."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "I feel that... we more than match up against them."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "We just have to get a bit more serious..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Liskarm, you just don't understand."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "Whatever level of power we choose to display, we can't let the L.G.D. feel threatened."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "But we can't just sit here and let them run over us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "Defenders, hold your ground!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "A leader of Rhodes Island, eh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "You're an Infected, but you still assist Lungmen in their slaughter of other Infected!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "You have blood of so many of my comrades on your hands!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "Stand and face me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "Reunion..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "You were the ones who started the hatred, the pain, and the violence..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "You were the ones who started all this in Chernobog!!"
    },
    {
      "type": "sceneBreak"
    }
  ],
