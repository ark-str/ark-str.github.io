{
  "server": "en",
  "storyId": "main_0_level_main_00-01_beg",
  "groupId": "main_0",
  "stageId": "main_00-01",
  "title": "Collapse",
  "storyCode": "0-1",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_00-01_beg.txt",
  "sourceHash": "9af4b636698837fba6af3bc4be6d36e1ec0fa47ce66927930d51eae3e544f4e0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "How could this be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "What in the world... is going on here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Search all these houses! I want every single room turned inside out!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "text": "Let go of me...! No! You can't...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Trying to resist? Too late, you filthy Chernos!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Male",
      "text": "Just run! Don't worry about me... Save... our child...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Mama... Mama...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Guard",
      "text": "Forget about the civilians! Hold the line first! There are too many masked goons coming!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Don't give the cops any time to rest! Keep attacking!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Guard",
      "text": "Where are our reinforcements?! We're going to get overrun...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Attack, attack!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What's going on...? ! Why... Why is Reunion doing this...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "After all these years, the wolves in sheep's clothing finally bare their fangs.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "The Infected... they, they're attacking the Ursus troops!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "But why?! Challenging the Ursus government like this is basically suicide!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "No, look at how fierce this attack is. This must have been a planned operation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "The place we rescued Doctor from was supposed to be top secret... but they somehow still managed to infiltrate it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "It's possible that Reunion's attack has already spread through Chernobog in its entirety.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "No... How, how can that be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Shhhh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member A",
      "text": "Have you found any of those fleeing Chernos yet?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "I'm still looking!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member A",
      "text": "Good, don't let a single one get away!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member A",
      "text": "Those cold-blooded beasts... I'll make them pay for what they did to my family!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "(*cough*)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member A",
      "text": "What was that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "Over there!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "(Mmfh!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "(They... they found us...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "(Shush!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "(Mmf...!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "text": "...Ugh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member A",
      "text": "Over here! I found 'em!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "text": "...Nooooo!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "text": "Aaah! No, don't...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "Hiding in an alley?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "Get out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "text": "Aaaaahh...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "Did you really think we wouldn't find you there...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "text": "I'm... I'm sorry! I'm so sorry!! Please, at least spare my child!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member B",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...We need to stop this, now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Amiya...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I'm aware of the risk, Instructor Dobermann.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's just that... we don't have the luxury of sitting around waiting for Reunion to disband.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Additionally, nobody knows how long this situation will last...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Therefore, the best course of action would be to take out the enemy and then get moving. Wouldn't you agree?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Understood. I'll follow your command.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "All squads, listen up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "We have the element of surprise - these Reunion members don't know that we're here yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Remember, be decisive! Take them out, cleanly and swiftly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Dr. {@nickname}, gather your team. It's time for you to prove yourself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "We have no more time to second-guess ourselves.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You should have told me sooner.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        },
        {
          "label": "A simple matter. I'll handle this.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "Hah.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "text": "Amiya, I'm counting on you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Understood.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "'Silent we shall be, should conflict be avoidable--",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "--but fight tooth and nail, should it be necessary!'",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Rhodes Island's creed... has always been the same!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
