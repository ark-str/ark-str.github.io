{
  "server": "en",
  "storyId": "story_skadi_set_1_story_1",
  "groupId": "story_skadi_set_1",
  "stageId": null,
  "title": "Endless Journey",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_skadi_1_1.txt",
  "sourceHash": "8d5cb2f1d924604cac21022130757aa15898f0ff5af5558f0e524f9def4b0eff",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Who's Rober?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, that's me."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "This is your food for today."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, alright."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Also, Joni wanted me to bring this present to you."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, these are my favorite flowers! Why didn't he come himself?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "He said he was working."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Coward."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "If you're fine, I'm going."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, hey, visitor, wait."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "He already paid."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, you're Skadi, the bounty hunter who came into the village recently, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Mm."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I hear you've been doing a lot for us. I've been wanting to meet you."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#4",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "It wasn't anything major."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sit down, Skadi. Eat something, it's on me."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "...Is there wine?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Will ale be okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Mm."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Here."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your accent's very strange, Skadi. You're not an Iberian, are you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Mm."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How rare. We often have refugees pass through this place, but I've never seen someone who wasn't an Iberian before."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Visitor, where did you come from?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I came from the sea."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The sea? You’re an Ægir?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We have Ægir in our village too, but I don't think they're too different from us. Not like you. I felt the difference between us the moment I saw you."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I've heard them tell of how they all left Ægir and came ashore when my grandfather was my age."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, yes. My neighbor is an Ægir too. I'll get her to have a chat with you."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "No need."
    },
    {
      "type": "narration",
      "text": "She once held such hopes, but when she saw the Ægir of dry land, she knew she and they were nothing alike.\nOnly the oldest of them still dimly remembered what Ægir even looked like.\nShe had nothing she could share with them, nor they with her."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, Skadi, did you know? The village has been talking about you every day."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#6",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Hm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "When you arrived in the village, you gave everyone an awful scare. We all thought you were just fleeing here after other bounty hunters injured you."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It frightened us. A wounded bounty hunter is like a temperamental beast."
    },
    {
      "type": "narration",
      "text": "Most creatures of dry land are frail, unable to harm her.\nWhat harmed her were those who profess themselves the Church of the Deep.\nThey were fixated on her for reasons unknown. Moreover, they were clearly unlike ordinary Iberians."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But now, they're all saying they've never met a bounty hunter as kind as you."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#9",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Are bounty hunters usually bad news?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We've had bounty hunters hiding in our village before. They were especially ferocious, and kept clashing with the villagers."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "So at first, we'd all discussed whether or not to drive you away."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#7",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I'll leave."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't! You've given us so much help these past few days. We're all so fond of you now."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You can stay here as long as you like."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Or is there someplace you need to go?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#7",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I don't know."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Really? Then are you going back home?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#9",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, I'm sorry. I know, I know, there're so many people who run far away because their homes have been destroyed. I'm so stupid..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "No."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "No, maybe you're right."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh! The bell's ringing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#6",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "What's happening?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The village's bell only sounds in times of emergency..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Rober, Rober!"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Joni, weren't you working?"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hide yourself!"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What's going on?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "There's a pack of monsters near the village! They've hurt some of us already! We need to hold them off!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Get down to the cellar and hide, now!"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "O-Okay!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#9",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Skadi, you... you're not one of us. You'd better run."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you're scared, come with me. Our house's cellar can hide plenty of people."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "...No."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Since coming ashore, Skadi has had a constant feeling.\nThis feeling gradually grows ever stronger in the wake of these occurrences. Violent, relentless, restless.\nBut she has never dared convince herself.\nShe dares not convince herself— that she is why the sea monsters come."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eek! Noooo!!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Quick, hide behind me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Wh—What are these monsters?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I've heard tales! They're monsters from the sea!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Normally, they'd never crawl out to a dry inland place like this. Why would they show here...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And so many!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What now?! It doesn't look hurt at all!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...They don't move that fast. Run, meet with the others!"
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Okay..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eek! They're here too!"
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No! Stay back!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Damn things! I'll take you with me!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Guh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Terrified Villager",
      "speakerToken": "avg_npc_461_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No! Nooo!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "With just a single sword... Skadi, you're so strong!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you going to stay and help us?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Mm."
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You really are a good one!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I'm not."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "...Come with me."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "When Skadi opened her eyes on the beach, she found not a single soul by her side.\nÆgir. Abyssal Hunters. All lives on the line, flesh to flesh, blood to blood.\nNone of it seemed to exist.\nOnly the sounds of the waves and the wind stirred in her ears."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Countless times she tried to return to the ocean.\nBut every time, countless sea monsters would surround her, forcing her to turn back midway."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#8",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Out of the way."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "At some point, as she was forced yet again to swim back, she even felt a sort of misperception arise within her—\nThat the abyssal infinitude of monsters were not pursuing her, but rather sending her off."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#7",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "(Ægirian) Why—must you come near me?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Once she became aware of the possibility she may never return to the sea, she had no choice but to turn around on the shore and set foot onto this land she'd never been concerned with before.\nThis land."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Skadi's incredible..."
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Rober, what are you doing out here?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I was worried for Skadi... and besides, she's come to help us. Shouldn't we at least help defend our own homes?"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're right..."
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Absolutely right!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#3",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I don't need help."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "In her eyes, the people of dry land are by and large akin to the ones before her now.\nFrail, melancholic, leading lives devoid of efficiency or any positive qualities to speak of."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't be like that, Skadi. We can't let you bear everything for us."
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll go and help her! I don't know if I can hurt any of these monsters, but I can at least distract some of them!"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll help too!"
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Everyone, with Skadi!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#7",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "(Ægirian) I said—don't come near me!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "But she is forced to admit. There are some points of intersection between them, where they can understand one another. In the emotional.\nShe can understand what circumstances lead them to feel what sentiments.\nAnd it is exactly this that vexes her more and more. It is for this that she feels guilt.\nBut she cannot divulge these feelings to the villagers. She can only hasten the swing of the greatsword in her hand."
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What's she saying?"
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look, she's moving faster! I'm sure she's encouraging us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, watch this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Get out of my sight, monsters!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Rgh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't be scared! See how you like THIS, monster!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Appreciated!"
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're all friends. It's only right."
    },
    {
      "type": "dialogue",
      "speakerName": "Sea Monster",
      "speakerToken": "avg_npc_458_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "They're scared! Keep going, everyone, let's drive these monsters out!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villagers",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yeah!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Wonderful! I think the rest have run. I can't see any trace of them around the village anymore."
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Heh heh. We're pretty incredible ourselves, aren't we?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you so proud of? If it wasn't for Skadi, we'd probably all be done for."
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hahah, just leave him be. We all made it through, so let him have this one."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, alright."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#9",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "She too once had comrades-in-arms, ones who fought alongside her, shared in the revelry of battle with her.\nA vast number of them perished in that battle.\nIn the past, she was no stranger to sacrifice.\nBut as she watches the villagers share in the joy from the bottoms of their hearts, a thought suddenly comes to her—\nShe may be the very last Abyssal Hunter."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#9",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What's wrong, Skadi? You don't look happy."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#9",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "...It's nothing."
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you ask me, I bet she's hungry."
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Now that you mention it, I'm a little hungry too, haha!"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Enough of that. Still, Skadi, you saved the day today. I'll personally prepare a feast in honor of you tonight."
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And I'm sure nobody in the village is opposed to you becoming one of us, after you helped us in such a tremendous way."
    },
    {
      "type": "dialogue",
      "speakerName": "Brave Villager",
      "speakerToken": "avg_npc_459_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I was never opposed from the start!"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicky Villager",
      "speakerToken": "avg_npc_460_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No objections from me either! Hear hear, Skadi, stay in our village as long as you like, I say!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's true, Skadi. With your might, we'd also feel so much safer if you stayed."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't you have nowhere to go?"
    },
    {
      "type": "dialogue",
      "speakerName": "Friendly Villager",
      "speakerToken": "avg_npc_462_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You can live with us."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "No. I've decided now."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#5",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "If I can't return to the sea, then I'll go where there's no water."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, you hear about that Skadi business?"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Skadi? Don't think I have."
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Something tells me your grapevine sucks."
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Fine, fine, I'm out of the loop, just tell me already."
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Skadi's this Ægir who suddenly showed up out of nowhere a little while ago."
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ægir? Where's that from?"
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "You... whatever. Makes sense a Kazimierzian would never hear about Ægir. I don't know too much myself, but I know it's a country and that's enough."
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ohh... and? What's up with this Skadi?"
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "She's got this giant greatsword, and you wouldn't miss her clothes from a mile away, but she's refused to ever work with anyone else. At first, everyone thought she'd kick it in the middle of nowhere."
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "But she's not only been thriving, she's been stealing a lot of other people's work."
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Last month, 'Flamelung' announced he was going to sort her out. Guess what happened?"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "He drove her off?"
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, she took down the entire squad he sent at her!"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "That's... Where the hell did she come from?"
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't know. Got sources who say she showed up alongside a bunch of bounty hunters coming back from Iberia."
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Either way, apparently it's got 'Flamelung' pretty goddamn fuming now. Me, I'm looking forward to the show."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Taciturn Passerby",
      "speakerToken": "char_003_kalts_1#4",
      "operatorId": "char_003_kalts",
      "portraitKey": "char_003_kalts",
      "text": "Excuse me."
    },
    {
      "type": "dialogue",
      "speakerName": "Chatty Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh? Who're you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Taciturn Passerby",
      "speakerToken": "char_003_kalts_1#4",
      "operatorId": "char_003_kalts",
      "portraitKey": "char_003_kalts",
      "text": "Who I am does not matter, I'm simply curious. You just mentioned an Ægir. Where is she right now?"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "operatorId": "char_003_kalts",
