{
  "server": "en",
  "storyId": "main_9_level_st_09-01",
  "groupId": "main_9",
  "stageId": "st_09-01",
  "title": "Storm Assault",
  "storyCode": "9-1",
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_st_09-01.txt",
  "sourceHash": "ac0c30066b4fdebdd2c81e5a946d2e26ba29faf93cc54a999a96b81c571fd03a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "We've entered the warehouse. Investigation team, report status.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "Leader. Vital signs to the southeast. Seven shelves away from you, moving within one meter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Number of heads?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "One.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Any Originium response?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "None for the time being.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Good. Hold your positions.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Bagpipe?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Got it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "What are you looking for?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Doesn't it sound like someone's singin'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Don't get distracted. This means our target's guard is down.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Keep to the plan. Wait for my signal, then you charge. For now, keep moving in.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Five, four, three...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Ready—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Bunker destroyed!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Ack—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "*cough* *cough* *hack*... Wh—what's going on? All this smoke out of nowhere!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Don't move! Stay where you are, raise both your hands up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "I—I... you're... Victorian soldiers?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "What do you mean by that? Aren't you Victorian too?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Er...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "He's looking to run. Cello, watch to intercept!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Leader, he's not headin' for the exit, he's turned back—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Triangle! Target heading for the back shelves! If you pick up any Originium response, open fire immediately!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Everyone else, form behind my shield!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Quick!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Bagpipe, what are you doing?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "I'm coverin' it! Everyone, run!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "You—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "Leader, no Originium response. That's not a bomb under Bagpipe.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Oh! False alarm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "And the target...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Sorry, I knocked him a little hard. He won't be standin' for a while.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "And what of the boxes?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "I'll take a peek. All potatoes and carrots, and cauliflowers too! I squashed 'em flat. Shame, they seemed just fine for eatin'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Stay alert.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "This one, this one, and this one... they're all the same. Leader, it's all produce and grains in here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Triangle, watch for anyone else nearing our perimeter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Oboe, you search the warehouse with Bagpipe. Signal on any discovery.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Cello, take this man stuck on the floor and tie him up.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Urgh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Right now, sir, we're going to need you to answer a few questions.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "I—I don't know anything. I'm here for sorting the potatoes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Are you from County Hillock?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Yes...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Have you heard of any spectre force?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Spectre... what? *cough*, *cough* *cough*... Doesn't force mean people like you lot, all the soldiers?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "They took Lowry, Julia and Chris away... is it—is it my turn now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "I want you to calm down.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Listen. We have people who saw a batch of Originium goods enter this warehouse late last night. And now, those goods aren't here. You need to give me an explanation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Explanation? That's what you're looking for? You're not going to just hang me? I—I... *pteuch*.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Hey! What are you spittin' around for? You've gotta care about hygiene!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Any leads?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "None, it's potatoes everywhere. If our information wasn't wrong, then they must work a sight fast.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Alright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Bring him. He definitely knows something, he's just not willing to open up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "There it is... you're all the same! Dying to find faults in all of us, torturing us... you Victorian oppressor beasts!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Eh? Again? He thinks callin' another Victorian 'Victorian' counts as an insult? It's flyin' over my head.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "Leader, incoming.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "How many?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "(Prepare to break up.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "(Yes, Leader.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "Update, Leader, they seem to be our own.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "They're in here.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Victorian Soldier",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "(Leader, we're surrounded.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "(Going by the numbers, yes.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "(If you listen to the voices, there don't seem to be too many left outside. If I crack the wall by me, then we've got our chance!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "(Don't get hasty.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I see you've had a very fierce confrontation in here.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Rita Skamandros, 7th Frontline Infantry Battalion, 2nd Tempest Platoon Leader.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Nice to meet you, Lieutenant Skamm... Skamandros.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "My name isn't too easy to remember. You can call me Horn, Captain.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Very well, Horn. I'm Kelly, Louis Kelly. I'm sorry, codenames aren't our style.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Captain Kelly, you and your troops are presumably also here to investigate this warehouse.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Correct, we've received the tip-off too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Then you ought to understand how grave this situation is. A great deal of illicit Originium goods were stolen off a military transport a couple months ago, and ultimately came to vanish in this region.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Ahem...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "I need not remind you, Captain, with this much ordnance, coupled with recent thefts in surrounding counties—if fallen into felonious hands, the menace posed will reach far beyond County Hillock.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Good, thank you for the run-down. I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "And we're very thankful for your cooperation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Hill!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Adjutant Hill",
      "text": "Sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Take this young man... this suspect back to camp.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "What? It was mad for us gettin' this man as our lead!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Adjutant Hill",
      "text": "Sir, her spear is obstructing fulfillment of my duty.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Er...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Bagpipe, let it go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "But our mission—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "—We're on Hillock land right now.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Captain Kelly pulls a handkerchief from his pocket, and wipes the sweat on his forehead."
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Very glad we could persuade you, Lieutenant. You and this young Vouivre lady, and all others present...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Ahem—you must be certainly worn out by your hard journey, dashing here from Londinium.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "It's our duty as soldiers of Victoria.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Yes, quite right. Now, if you still have intention to operate in County Hillock...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "We're obliged to continue tracking the thieved Originium goods. This is an order from Londinium. I imagine Colonel Hamilton would see sense too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Of course, of course. You may accompany me back to camp.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Leader, do we really have to give him up to them? They have to be doin' this on purpose! Ever since we touched foot on the outskirt plate, they've been followin' right behind!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Right until now, just as we caught him—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "'Stationed troops of the Empire have a responsibility to address any threat to public safety that arises within their station.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "They haven't violated any code.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Ugh... alright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Captain, he's yours. As per code, we may also take part in the interrogation—we hope you recall.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Ha, hahah... yes, quite in line with code.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "N—No... let me go! Don't take me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Adjutant Hill",
      "text": "Heh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Help me... save my soul! I haven't done anything... I don't know...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Panicked Youth",
      "text": "Aaarghhh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Hill...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Adjutant Hill",
      "text": "Tara rabble like him always do make a scene like this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Captain Kelly",
      "text": "Take him away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "Ugh, really! What gives them the right!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bagpipe",
      "text": "(Leader, I think... that wee Feline wants us to help him. He's scared to death of goin' with them.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "(......)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "(Triangle?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "Here, Leader. Still in position, outside in the same tree. They haven't noticed me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "(Good. Take the reconnaissance group, and keep investigating along nearby transport routes. If you find any leads, immediately report back.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Triangle",
      "text": "Understood. Are we notifying their barracks?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "No need.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "text": "Be sure to defend yourselves.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
