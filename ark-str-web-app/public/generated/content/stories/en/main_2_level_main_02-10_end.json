  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Nngh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Ugh... Gahh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Aaah-!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Skullshatterer, are you okay?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Tch... What a troublesome bunch!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Skullshatterer, W just said that she's all finished on her end!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "She's successfully retrieved the target.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "W... she won?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "That's right, her assault went very smoothly!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Should we also retreat?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Send a signal to Talulah.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Roger!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...We're pulling back.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Hmph. Rhodes Island cowards...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "The next time we meet... will be at your execution.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Reunion... is retreating?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "They're retreating very rapidly. Something must have changed with their plans.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Despite all that talk, they sure know how to run away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Something... doesn't feel right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Are you saying...",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We weren't their objective in the first place...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "That they were only here to stall us...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "If that's the case...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Oh no, the L.G.D. is in trouble!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...We have to help Madam Ch'en right now!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Franka, call the recon squad back immediately!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Liskarm, try to get in touch with Madam Ch'en!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "Where's the Special Operations Division? Their reinforcements are supposed to be here by now!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "L.G.D. Agent",
          "text": "We were just notified that they've been stalled by Reunion...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "How's that possible? Reunion is nothing more than a gang of unruly thugs!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "L.G.D. Agent",
          "text": "...And they were only facing... a single enemy...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "Unless...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
