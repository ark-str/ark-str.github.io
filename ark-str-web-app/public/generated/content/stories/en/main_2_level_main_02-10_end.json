  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "Nngh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Ugh... Gahh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Aaah-!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Skullshatterer, are you okay?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "Tch... What a troublesome bunch!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Skullshatterer, W just said that she's all finished on her end!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "She's successfully retrieved the target."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "W... she won?"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "That's right, her assault went very smoothly!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Should we also retreat?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "Send a signal to Talulah."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Roger!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "...We're pulling back."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "Hmph. Rhodes Island cowards..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "The next time we meet... will be at your execution."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Reunion... is retreating?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "They're retreating very rapidly. Something must have changed with their plans."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "Despite all that talk, they sure know how to run away."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Something... doesn't feel right."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "Are you saying..."
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We weren't their objective in the first place...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "That they were only here to stall us...?"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "If that's the case..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Oh no, the L.G.D. is in trouble!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "...We have to help Madam Ch'en right now!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Franka, call the recon squad back immediately!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Liskarm, try to get in touch with Madam Ch'en!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1#2",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "Where's the Special Operations Division? Their reinforcements are supposed to be here by now!"
        },
        {
          "type": "dialogue",
          "speakerName": "L.G.D. Agent",
          "speakerToken": "char_015_lmg",
          "operatorId": "char_015_lmg",
          "portraitKey": "char_015_lmg",
          "text": "We were just notified that they've been stalled by Reunion...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1#2",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "How's that possible? Reunion is nothing more than a gang of unruly thugs!"
        },
        {
          "type": "dialogue",
          "speakerName": "L.G.D. Agent",
          "speakerToken": "char_015_lmg",
          "operatorId": "char_015_lmg",
          "portraitKey": "char_015_lmg",
          "text": "...And they were only facing... a single enemy..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1#3",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1#5",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "Unless..."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
