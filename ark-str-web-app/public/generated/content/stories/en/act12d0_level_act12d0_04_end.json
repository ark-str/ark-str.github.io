{
  "server": "en",
  "storyId": "act12d0_level_act12d0_04_end",
  "groupId": "act12d0",
  "stageId": "act12d0_04",
  "title": "Robotic Roar",
  "storyCode": "RI-4",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act12d0/level_act12d0_04_end.txt",
  "sourceHash": "83f0d93cfa7eb155b13980df4b4cbe122157cd40158cd1b9694b746e2e9dfcfc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Archosauria Punk A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gah..."
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria Punk B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "S-She's strong..."
    },
    {
      "type": "dialogue",
      "speakerName": "Uda",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're not half bad, I'll give you that!"
    },
    {
      "type": "dialogue",
      "speakerName": "Aruna",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't get cocky, Eunectes!"
    },
    {
      "type": "dialogue",
      "speakerName": "Aruna",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "All of you, on me!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#2",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "speakerToken": "char_411_tomimi_1",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "Mm, I knew it! Zumama's so tough!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "speakerToken": "char_411_tomimi_1",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "She may be fighting alone, but just like Gavial, your everyday Archosauria goonies are no match for her."
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "speakerToken": "char_411_tomimi_1",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "But..."
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "It sounds like you know her pretty well.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Yep, Zumama and Gavial have always been the strongest around here."
            },
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "But as far as I know, Zumama has never managed to beat Gavial!"
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Doctor. I bet you don't see people this strong on the outside!"
            },
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "But Gavial's even stronger than her!"
            }
          ]
        },
        {
          "label": "She's so cool...",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Yeah, I agree. Zumama is cool."
            },
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "But Gavial's way cooler!"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Right, Gavial?"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Huh? Where's Gavial?"
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria A",
          "speakerToken": "avg_npc_071",
          "operatorId": null,
          "portraitKey": null,
          "text": "Hey, look! Over there!"
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria B",
          "speakerToken": "avg_npc_070",
          "operatorId": null,
          "portraitKey": null,
          "text": "I saw her on my way here! Isn't that—"
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria C",
          "speakerToken": "avg_npc_072",
          "operatorId": null,
          "portraitKey": null,
          "text": "She really is back!"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "You—"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Everyone",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Gavial!"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Wahhhh!! Gavial rushed onto the platform!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "It's been a while, Zumama!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Or should I call you the leader of the Eunectes now?"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "You came back, Gavial."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "That's right, Tomimi asked me to come back."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Hm? Hold up. You know Sargonian?"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "...Since you're speaking Sargonian too, I guess this really is what they speak on the outside."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "I've been studying it for a long time."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "...I thought you weren't ever going to come back."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Oh, I'll come back. Not right now, but someday. This is my home, after all."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Are you trying to become the Great Chief?"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Nope, I need you for something else, and I was gonna wait till you were done."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "I didn't expect to see you get this badass, though. How am I supposed to hold myself back from fighting you?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Are you really a doctor now?"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Sure am."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Hehe, I'm a pretty famous doctor out there!"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "That's amazing."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "What about you? You didn't show up last time because you were tinkering with something, right? You done with that yet?"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#3",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "...Yeah."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#3",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "You'll get to see it very soon."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#4",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Ugh... didn't Gavial say she wasn't going to fight her...?"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "It's Gavial. Are you surprised?",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Hm? N-Not at all! I-It's just..."
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Even the Doctor's taken with her..."
            },
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Ughh... I mean, she does look super cool, but..."
            }
          ]
        },
        {
          "label": "That's the Gavial we know and love.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Tomimi",
              "speakerToken": "char_411_tomimi_1#4",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "Oh... it's true."
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "You're as strong as I remember."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Heh, you ain't half bad either!"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "But you rely on your fists too much."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Oh?"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "You can do all sorts of things with your fists, so you don't ever think of using anything else."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "That's what's holding you back, and it's what's holding all of us back."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "What are you talking about?"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "What I'm trying to say is it's time for change."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Just then, a thunderous, uniform roar reverberates through the forest. Something gigantic is approaching the Temple.\nWhatever it is, it is slowly but surely stomping its way towards the Temple, and although it has so far remained largely out of sight, it has already proven to be an imposing presence."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "You're strong, Gavial. There's no doubt about that."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "I wasn't going to use this until after I took the throne."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "But I have to use it against you now."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "It doesn't matter. The end result will still be the same."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "This is going to bring us change."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "I've got no idea what you're talking about, but I'm not going down that easy!"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Yes you are."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "...High Priest. Aim. Fire!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "What's... that?!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "See? I told you, Gavial."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "But using it against you isn't what I'm trying to accomplish here."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "We won't have a future if we always rely on our fists."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "From here on out, we're in the age of machines."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
