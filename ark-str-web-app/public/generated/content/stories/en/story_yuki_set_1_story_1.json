  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "Yuki-chan."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "Here."
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "I've informed Yenwu. Now, I've arranged for you to enter a pharmaceutical company called Rhodes Island as an operator."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki#2",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "Rhodes Island?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "Yes. You've likely already heard of it."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "Only that the Miss has deep ties with them."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "Does the Princess want me to protect the Miss?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "Hm... that has been part of my intent. After all, this is an Infected organization. However, I believe Hui-chieh should be able to handle things herself."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki#4",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "Infected... does the Princess consider them reliable?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "Yes. Be assured. I've met their leader before. She is quite a good girl."
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "And I've looked into things a little. I feel the company itself is good too. So, I feel this is a good opportunity."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki#2",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "Opportunity?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "Yes. You've followed me since childhood. Even now in Lungmen, you haven't once left my side."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki#5",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "It is my mission."
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "But you also ought to see the sights outside."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "I need only to know what sights the Princess sees."
    },
    {
      "type": "dialogue",
      "speakerName": "Fumizuki",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "This is an order, Yuki-chan."
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki#4",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "...Understood."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shirayuki",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "I am Shirayuki. Princess Fumizuki told me to assist Madam Ch'en and follow all your orders."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Hello.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "......"
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "......"
            }
          ]
        },
        {
          "label": "Welcome!",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "4",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Shirayuki",
          "speakerToken": "char_118_yuki",
          "operatorId": "char_118_yuki",
          "portraitKey": "char_118_yuki",
          "text": "......"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "5",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Several days' observation. The Doctor, a strange sort."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Directly heats instant food in mouth with kettle. Genius."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "But holds true requisite ability, in command of people and handling of sundry affairs."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Further, Rhodes Island. More than meets the eye."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Surface-level, a pharmaceutical company. In reality, close to a military organization. With fair strength. No surprise Lord Wei would cooperate with this company."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "The Princess spoke it not forth, but as Miss Ch'en is here, I am presumably willed to investigate this organization, and protect the Miss in full."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Doctor aside, two others are leaders here."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Amiya, I have met. In the Princess's words, a very kindly person."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "But as she has proven a leader, exceptionality must reside. Cannot be taken lightly."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "The other, a Kal'tsit, not yet met. From others' conversation, the true core figure of this company. Further understanding of her required."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Rough structure of accessible ship interior area committed to memory. Time, one in the morning. I shall move out."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Entered."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Rhodes Island's pipeline design, adequate."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Ordered systematically, omnidirectional... and correspondingly monitored."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "But such levels, a mere trifle."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Most passages are connected with dormitories via toilets. Only some windows give sight of what happens within dormitories, due to planning... Fair."
            },
            {
              "type": "dialogue",
              "speakerName": "???",
              "speakerToken": "char_2013_cerber_1#3",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "Hwaaah... Gummy, I wanna eat meat..."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Ceobe."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Abysmal sleeping posture."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Midnight",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "Phew... Wonderful. That's enough training today to hit standards."
            },
            {
              "type": "dialogue",
              "speakerName": "Midnight",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "It's late now. Though there are no missions tomorrow, I should quickly do my skincare, and then it's beddy-byes."
            },
            {
              "type": "dialogue",
              "speakerName": "Midnight",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "Ah. Ever since I became an Operator, I haven't been properly managing my appearance."
            },
            {
              "type": "dialogue",
              "speakerName": "Midnight",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "But what can you do? Some things are a necessary sacrifice."
            },
            {
              "type": "dialogue",
              "speakerName": "Midnight",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "And I suppose even if I don't take care, I'm handsome enough as is."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "(Shudder)"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Operator codename, Midnight."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Narcissist."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Yet, ample muscle definition."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Dobermann",
              "speakerToken": "char_130_doberm_ex",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "Hm? Is it already this late?"
            },
            {
              "type": "dialogue",
              "speakerName": "Dobermann",
              "speakerToken": "char_130_doberm_ex#4",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "Whatever. Just a bit longer. I'm almost done drawing up the training program for Kroos's group."
            },
            {
              "type": "dialogue",
              "speakerName": "Dobermann",
              "speakerToken": "char_130_doberm_ex",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "Kids really mature fast, don't they? You wouldn't recognize them now compared to when they just arrived at Rhodes Island."
            },
            {
              "type": "dialogue",
              "speakerName": "Dobermann",
              "speakerToken": "char_130_doberm_ex#2",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "Heh. Though they're still a mile from where I want them to be."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#5",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Instructor Dobermann."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#5",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Steel-cold, heart of gold."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Most have already fallen asleep."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Rhodes Island's people by and large, seem used to life here."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Just as the Princess's words, a good place."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Ahead leaves the dormitory area. Tread carefully."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Rosa",
              "speakerToken": "char_197_poca_1#3",
              "operatorId": "char_197_poca",
              "portraitKey": "char_197_poca",
              "text": "*Pant*... *pant*..."
            },
            {
              "type": "dialogue",
              "speakerName": "Zima",
              "speakerToken": "char_115_headbr_9",
              "operatorId": "char_115_headbr",
              "portraitKey": "char_115_headbr",
              "text": "Natalya... uh, should be calling you Rosa now. About time you call it."
            },
            {
              "type": "dialogue",
              "speakerName": "Rosa",
              "speakerToken": "char_197_poca_1",
              "operatorId": "char_197_poca",
              "portraitKey": "char_197_poca",
              "text": "Phew... You go to bed first. I'll do a little more training by myself."
            },
            {
              "type": "dialogue",
              "speakerName": "Zima",
              "speakerToken": "char_115_headbr_9#2",
              "operatorId": "char_115_headbr",
              "portraitKey": "char_115_headbr",
              "text": "...Fine. You've got me for a while longer."
            },
            {
              "type": "dialogue",
              "speakerName": "Zima",
              "speakerToken": "char_115_headbr_9#2",
              "operatorId": "char_115_headbr",
              "portraitKey": "char_115_headbr",
              "text": "I let you live. Think how bad I'd look if you just went and bit it on the battlefield."
            },
            {
              "type": "dialogue",
              "speakerName": "Rosa",
              "speakerToken": "char_197_poca_1",
              "operatorId": "char_197_poca",
              "portraitKey": "char_197_poca",
              "text": "Aha. If I could trouble you, then."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Two students from Ursus. Seemingly, refugees admitted prior."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Chernobog. A tragedy."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "I wish you good luck."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Hm? That..."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "speakerToken": "char_003_kalts_1",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "Amiya, we'll conclude our work for today here."
            },
            {
              "type": "dialogue",
              "speakerName": "Amiya",
              "speakerToken": "char_002_amiya_1#6",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "Alright, Dr. Kal'tsit."
            },
            {
              "type": "dialogue",
              "speakerName": "Amiya",
              "speakerToken": "char_002_amiya_1",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "I'm not sure if the Doctor's asleep yet. I'll go and take a quick look."
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "speakerToken": "char_003_kalts_1",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "Dr. {@nickname} possesses a peculiar set of norms."
            },
            {
              "type": "dialogue",
              "speakerName": "Amiya",
              "speakerToken": "char_002_amiya_1",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "That might be true, but the Doctor's wellbeing is also very important!"
            },
            {
              "type": "dialogue",
              "speakerName": "Amiya",
              "speakerToken": "char_002_amiya_1#3",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "I'll turn in after I've checked on the Doctor. Is that alright, Dr. Kal'tsit?"
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "speakerToken": "char_003_kalts_1#4",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "...Suit yourself."
            },
            {
              "type": "dialogue",
              "speakerName": "Amiya",
              "speakerToken": "char_002_amiya_1#10",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "Mm-hm!"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "So this should be Dr. Kal'tsit..."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "speakerToken": "char_003_kalts_1#3",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "......"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Her gaze, as though it flickered hither! Have I been found?!"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Kal'tsit",
              "speakerToken": "char_003_kalts_1#2",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "......"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "(Seemingly, she has not noticed me. Yet that sensation, it was...)"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Forget it. As I am not found, I shall proceed."
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "(Hm? Ahead, an impression of great noise... surmising from direction, likely the Engineering Department.)"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Wait wait wait! No way! You're meant to kiss right freaking here, aren't you?! What are you hesitating for?! You're the heroine!"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Ugh, come on, one of these scenes is enough! Don't do it every time! What's your PROBLEM, scriptwriter?!"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Euuugh, I haaate this kind of development... How are they on their seventh season by now? And the reviews get crappier each time."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "They're just dragging it out! That's all they're doing!"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "...Dammit, but that boy's so hot. And he's in every episode!"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Fine. I'll hang in there. Can't say it won't get better!"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Chief Engineer Closure."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "'Tis alleged that the Rhodes Island ship was her plan alone. Fearsome."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Yet this is not where the show's true ruin lies. The fourth season's spontaneous introduction of the supporting man; such was a nightmare."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "What? You're kidding me?! I thought this was bad enough!"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...You catch upon my words?!"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Oh, shoot, I knee-jerked that one out."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "Whatever, come down here."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "......"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...Since when?"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#5",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "The start."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "......"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Oh, don't get me wrong, your ninja techniques are real amazing stuff. Thing is, I just knew you were gonna do this from the start."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...'Twas my individual action, untied to anyone."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Alright, alright, loosen up. You think I'm treating you as a spy here or something?"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Princess Fumizuki specially phoned up Amiya when she sent you over."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "......?"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "When she did, she told Amiya, even if she had no ulterior motive sending you here, she was worried you might go a little overboard. So, she specifically warned us beforehand to keep our ears perked."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "And she gave Amiya a couple details on your MO, so I've been a little extra aware of you the past while."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...This has naught to do with the Princess."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Jeez, you are some tough customer."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Y'know, now I get the feeling I can't really talk you over."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "But if we actually treated you like a spy, wouldn't Kal'tsit have just dealt with you back there?"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "......"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#2",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Basically, seeing as this is your first offense, don't you worry that anyone's gonna punish you, or that it'll reflect badly on your Princess."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "But I don't recommend you try prowling around Rhodes Island like that again."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "On the one hand, you'd absolutely, aaaaaabsolutely never get into the core. At least, the pipes won't let you."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "But on the other hand, snooping into other people's privacy isn't super cool."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "And don't you get tired doing that?"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "I do not."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "I will not repeat this."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#2",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "And you're gonna go find some other way instead, aren't you?"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...I make no guarantee."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Wowie, do I wanna let Kal'tsit sic you. Loyal people are such a pain in the neck, honestly."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "But whatever, Kal'tsit wanted me to tell you this instead. 'You may use your methods to observe Rhodes Island, but Rhodes Island is observing you too.'"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...I understand."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Hey, honestly, if you're so bored at night you wanna roam around, you can come watch these stories with me."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "You gave me the impression you've done a little research into them. Most of Rhodes Island are all outdoorsy types, and I'm starving for any compatriots of my own. It's killing me, c'mon."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "In continuing to watch this, you will truly find no value."
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "I may recommend some. I know not if you possess them."
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#5",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Alright, alright!"
            },
            {
              "type": "dialogue",
              "speakerName": "Closure",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "Lay 'em on me, and if I don't have them, I'll go find them for us to watch together!"
            },
            {
              "type": "dialogue",
              "speakerName": "Shirayuki",
              "speakerToken": "char_118_yuki#5",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "...Very well."
            },
            {
              "type": "sceneBreak"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Shirayuki",
          "speakerToken": "char_118_yuki",
          "operatorId": "char_118_yuki",
          "portraitKey": "char_118_yuki",
          "text": "......"
        }
      ]
