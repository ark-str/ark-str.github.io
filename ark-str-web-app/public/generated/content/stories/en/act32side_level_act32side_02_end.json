    {
      "type": "dialogue",
      "speakerName": "Tecno",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Go right once you leave the alley. The left side may look empty, but sometimes Papá goes out there to smoke."
