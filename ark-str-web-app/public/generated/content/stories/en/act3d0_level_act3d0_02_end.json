    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "speakerId": "char_348_ceylon",
      "text": "Quick! Doctor! Let's head towards the beach!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "speakerId": "char_348_ceylon",
      "text": "There are a ton of tourists gathered on the beach, so we'll be able to blend into the crowd and shrug them off!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard",
      "speakerId": "avg_npc_020",
      "text": "Stand still!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "speakerId": "char_348_ceylon",
      "text": "You wish!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerId": "char_340_shwaz",
      "text": "..."
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Huh?  You're...",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerId": "char_348_ceylon",
          "text": "Schwarz! Great! You're finally here!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerId": "char_348_ceylon",
          "text": "I'm so glad you're here. What's going on with Cronin?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerId": "char_348_ceylon",
          "text": "Doctor, she's the one I was telling you about..."
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "speakerId": "char_340_shwaz",
          "text": "Milady, Master Doykos is currently out of town. You ought to listen to Cronin."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerId": "char_348_ceylon",
          "text": "Schwarz? What are you saying...?"
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "speakerId": "char_340_shwaz",
          "text": "Let's head back to Cronin now and hand these people over."
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "speakerId": "char_340_shwaz",
          "text": "I do not wish to resort to violence, milady."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerId": "char_348_ceylon",
          "text": "...Schwarz?"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
