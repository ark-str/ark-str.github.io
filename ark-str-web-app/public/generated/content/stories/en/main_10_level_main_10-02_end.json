{
  "server": "en",
  "storyId": "main_10_level_main_10-02_end",
  "groupId": "main_10",
  "stageId": "main_10-02",
  "title": "Heads Down",
  "storyCode": "10-3",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_10-02_end.txt",
  "sourceHash": "f57777077eaf4dee0c27584671694c6f7f047a0b39189ab395a40283d7c4bf0e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "speakerId": "avg_npc_012",
      "text": "Amiya, at this rate, Mr. Thomas is going to get captured by Dublinn again!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "avg_npc_394_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "speakerId": "avg_npc_012",
      "text": "Are you planning to..."
    },
    {
      "type": "dialogue",
      "speakerName": "Indra",
      "speakerId": "avg_155_tiger_1",
      "text": "That bloody bugger!"
    },
    {
      "type": "dialogue",
      "speakerName": "Indra",
      "speakerId": "avg_155_tiger_1",
      "text": "I'll bring him back."
    },
    {
      "type": "dialogue",
      "speakerName": "Dagda",
      "speakerId": "avg_npc_396_1",
      "text": "No."
    },
    {
      "type": "dialogue",
      "speakerName": "Indra",
      "speakerId": "avg_155_tiger_1",
      "text": "Why are you stopping me? Didn't we go through all the trouble to rescue that bloke?"
    },
    {
      "type": "dialogue",
      "speakerName": "Dagda",
      "speakerId": "avg_npc_396_1",
      "text": "The situation's changed. We can't blow Siege's cover."
    },
    {
      "type": "dialogue",
      "speakerName": "Indra",
      "speakerId": "avg_155_tiger_1",
      "text": "So you're just gonna let him go? That's not how the Glasgow Gang does things!"
    },
    {
      "type": "dialogue",
      "speakerName": "Morgan",
      "speakerId": "avg_npc_405_1",
      "text": "Don't make a ruckus here, either of you."
    },
    {
      "type": "dialogue",
      "speakerName": "Morgan",
      "speakerId": "avg_npc_405_1",
      "text": "Vina..."
    },
    {
      "type": "dialogue",
      "speakerName": "Siege",
      "speakerId": "avg_npc_407_1",
      "text": "Listen to Amiya and the Doctor."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "avg_npc_394_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "avg_npc_394_1",
      "text": "Sniper operators, on the enemies holding our mark."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "The important thing is that caster.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "Caster......\nIf I recall correctly, Doctor."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "According to Misery's intel and Bagpipe's report, she's the leader of Dublinn's forces inside Londinium."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "And one of the instigators of the County Hillock incident."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Rhodes Island doesn't put the blame for Outcast's sacrifice entirely on her shoulders, but it's not just Misery and Bagpipe who hold a grudge against her."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Mandragora.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Bagpipe tells us she's very hard to deal with."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "We could get into a fight with Dublinn here, rescue Mr. Thomas, and even eliminate Mandragora, a formidable enemy who may pose a significant threat to our future operations."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "But..."
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "speakerId": "avg_npc_012",
          "text": "The Sarkaz are coming!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "We're too late."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "All squads, continue to conceal yourselves––"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Be ready to engage."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "What's going on over here? So noisy."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen",
          "speakerId": "avg_npc_416_1",
          "text": "Ugh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Oh, if it isn't you traitorous lot."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Don't you dare use that word."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "We have nothing to do with Victoria now, devil."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Hmph... Who said you could call us that?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Hah... A motley band of exiles, taking advantage of the chaos to occupy a city. What made you delusional enough to think yourselves the masters of Londinium?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Haha, don't lump me in with your sorry band, thinking we actually give a damn about Londinium."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "The place is shiny and clean, isn't it? Doesn't reek of death. But if you ask me, it'll be more pleasing to the eye once it's burnt to cinders."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "The Sarkaz are only here because our King is here."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Their King? The Sarkaz King?"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Are they talking about Theresis?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "The regent finally decided to crown himself?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "I haven't heard anything about that."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "But a lot of intel reports disparate Sarkaz fighters gathering in Londinium from across Terra, and it's not just the mercenaries we're familiar with."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "There are... older, stronger powers now hovering around the heart of this city."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Doctor, I can feel it."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Since coming here, with each step closer I take, those emotions flow into the depths of my heart... tangle around my thoughts, and grow stronger and stronger."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Are you alright?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "I'm fine, Doctor."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "It's just that... for a split second, it's as if..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "When I heard those Sarkaz mention their 'King,' a wisp of those emotions... sprung up and latched onto me."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "I don't think I can give a better description of what I felt..."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We need to discuss this.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "I'd love to spend some time talking this through with you... but not now."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Even if there were... a Sarkaz King who now controls Londinium, that doesn't change our mission."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "We came here to prevent a war."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "We need to figure out exactly what they're doing, and what they're trying to do."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "––And that has nothing to do with what Theresis decides to call himself."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "So, can we skip past the shitty pleasantries, Dublinn?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Turn over the man you captured."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Why should I?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "We'll take good care of your old home."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "You bastard––!"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Stop."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Captain...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Not just you. You too, Sarkaz."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "I know who you are, Feline. You're their commander."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "But why should I listen to you?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Because I've been to the Palace of Westhaleg."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Haha, we've all heard the story. You wanted an audience with His Majesty, but he had you escorted out."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Do you really think you mean anything to the Sarkaz?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Captain, why do we just sit here and let the devils mock us?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "I can't take it anymore. Ever since we came to Londinium, we've had to live with this inferior race—"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Not one more word."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "We can go back and bring this up with the Leader..."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "I said, not one more word!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Sarkaz, no matter how hard you try to provoke me, I'm not leaving."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "We are your guests, as the one you call 'His Majesty' and his privy council agreed."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Do you really want to find out how the Sarkaz deal with rowdy 'guests?'"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Well, at least one of us understands proper etiquette."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "We promised your regent and your generals that Dublinn's troops would not set foot into Central Londinium."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Likewise, you should not be detaining me here, Sarkaz."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Or, do you devils struggle to keep your word? Can you even spell 'trustworthy?'"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Hah, you uppity Feline... Isn't the fact that I haven't chopped you into pieces right here and now already proof that I'm honoring our little pretend friendship?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "If a Sarkaz ever forgot his objective and started picking fights, he'd be found dead in a bar near a warzone pretty quick."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "We're here to root out some bottom feeders. These nobodies haven't learned their place yet. They're sneaking around, making a mess of our work––"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "By the sound of things, they're not looking for Mr. Thomas either."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Could that be the friends the Messenger mentioned, the ones who can help us with our operation?"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "The Sarkaz certainly would call them an enemy."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "If they really are right here, maybe we could help them..."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "The line stopped moving."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "I hear fighting... the Sarkaz must've gotten into a row with someone."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "Lieutenant, I saw their uniforms... it's Dublinn!"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Her."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "The Dublinn caster?"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "She... She's a scary one..."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "She's killed some of our people. She impales them on stone pillars that come out of nowhere. Her methods are even more brutal than the Sarkaz!"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "I know."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "Lieutenant, have you fought her too? What am I even saying? You've saved so many from Dublinn, you must've beaten her..."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "I lost."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "But you... still managed to get away from her with your life. That's already amazing enough."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "I'm still not exactly sure why she didn't kill me on the spot... but I have my guesses."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "At the Barracks outside Londinium, I saw them having secret meetings with a count's Messenger."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "I figured she must've shown me deliberately."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Or maybe it wasn't her. Someone like her would have no way of knowing that my grandfather and the count's father served together. They were very close."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "And the count himself... If I recall correctly, was squire to a duke."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "Lieutenant...?"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Sorry, I shouldn't be saying all this."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "During the long period of time I was hiding in the dark bowels of this city, I... got used to talking to the metal crabs. They didn't have much to say back."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "I didn't have to worry about my words casting a shadow over anyone else."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Some things, I just had to say to myself so I wouldn't forget them."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "I didn't mean to interrupt you, Lieutenant!"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "I'd actually like to hear more. For the longest time, I've been wanting to know who's pulling the strings up there, causing us all this misery!"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "The duke I was thinking of isn't even in Londinium right now. Or rather, I should say... he never cared a lick about the vacant throne in the city."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "If he really were secretly supporting Dublinn, that would answer a lot of questions. But at the same time, it would also greatly complicate the crisis we have on our hands..."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Listen to me. Everything I've said to you up to this point is just baseless speculation. If you want to hear more, we'll continue another time."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Provided... you're willing to follow me into the shadows."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "What are we going to do now?"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Right now... we need to find an opportunity to escape."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Dublinn has been trying to get something from the Sarkaz. It might be one individual or several, which is why they've set up in Sudean."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "In addition to troops like you, hunted by the Sarkaz, they've captured a good lot of civilians with some connection to the Sarkaz."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Whatever Mandragora is trying to accomplish..."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "As long as it creates conflict between Dublinn and the Sarkaz, it'll work in our favor."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "Sounds like you have a plan."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Robben, did you make sure to hide the crossbow I gave you? Up your sleeves, right?"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen?",
          "speakerId": "avg_npc_413_1",
          "text": "Of course, Lieutenant!"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Aim at that Dublinn soldier, the one closest to the Sarkaz."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "It looks like Dublinn isn't backing down."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "The Sarkaz have a limit to their patience. This is going to boil over into a fight, sooner or later."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "Doctor, we're going to have to use our backup plan."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "C'mon, turn him over and you all get to walk out of here alive. Let's make things easy for each other, why don't we?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "...Captain, shouldn't we..."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "No."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "I don't understand..."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "No means no."
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Even if it fractures our relationship with the Sarkaz?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "You heard what they had to say."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "When... have we ever been friends?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "There you go. Those are your words, not mine."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "––Formation! Round up these Dublinn wretches!"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "He is absolutely critical to Dublinn. Non-negotiable."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "If we can't bring him with us, our only option is to kill him here."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen",
          "speakerId": "avg_npc_416_1",
          "text": "Waaaah!"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Shut your trap."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Actually, our other option... is to kill all these Sarkaz."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_npc_402_1",
          "text": "Isn't it about time we make our entrance?"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_4040_rockr_1",
          "text": "Hold on, we're still calibrating the aerial coordinates."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_npc_402_1",
          "text": "Look, if we don't act now, someone's gonna get killed."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_4040_rockr_1",
          "text": "Give me a sec... Seventeen meters in a straight line... Sixteen... Fifteen..."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_npc_402_1",
          "text": "Best to get a bit closer or you might have trouble aiming, right?"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_4040_rockr_1",
          "text": "No can do. They'll spot us if I get any closer!"
        },
        {
          "type": "narration",
          "text": "Just do as I say. It won't miss, trust me, or I'll let you use my head as a rivet— Move it a little eastward and the reflection of light should cover its wings...\nNow!"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_4040_rockr_1",
          "text": "Rock-5, you're up!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "That's our cue."
        },
        {
          "type": "dialogue",
          "speakerName": "Horn",
          "speakerId": "avg_4039_horn_1",
          "text": "Robben, now!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Hey, hey, hey–– Gah!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "Urgh..."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "What's the meaning of this?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dublinn Soldier",
          "speakerId": "avg_npc_406_1",
          "text": "The hell are you talking about? You're the ones who tried to snipe us––"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Fight back!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Those who spill Sarkaz blood will pay the blood debt with interest!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Don't let a single one out of here alive!"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Remember, you started this."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "––With me. Slaughter every last Sarkaz."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "Don't let a single one live to tell the tale."
        },
        {
          "type": "dialogue",
          "speakerName": "Mandragora",
          "speakerId": "avg_npc_233_1",
          "text": "The devil leadership mustn't learn what happened here today."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen",
          "speakerId": null,
          "text": "Aaaaaaaahhhh––!"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Citizen",
          "speakerId": null,
          "text": "Save me! Someone, anyone!"
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "speakerId": "avg_npc_012",
          "text": "Amiya, these civilians have nowhere to run... It's not just Mr. Thomas, so many are going to get caught in the crossfire!"
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "speakerId": "avg_npc_012",
          "text": "Neither the Sarkaz nor Dublinn have any regard for civilian lives!"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Doctor, Amiya, I'm sorry, but I can't just stand by and let this happen."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "I just can't."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We have no other choice.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "I understand."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "All operators, there's been a change in plans!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "All non-combat personnel are to remain hidden. All combat personnel, save as many lives as you can. But mind your own safety!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Another bolt from behind?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "It came from those ones, in civilian clothes... They're carrying unauthorized weapons!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Something's not right. We've got more hostiles in the elevator!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Hah... Looks like we've grabbed the pest's tail."
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Turns out the rebels ARE here––"
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "speakerId": "avg_npc_419_1",
          "text": "Report this to General Manfred right away!"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
  "observedOperators": []
}
