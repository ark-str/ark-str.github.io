    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Phew—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mayer",
      "text": "Here I am!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mayer",
      "text": "So, what's up?",
