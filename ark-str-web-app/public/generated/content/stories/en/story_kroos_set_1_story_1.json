    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "See ya~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Scene",
      "text": "U m m—",
