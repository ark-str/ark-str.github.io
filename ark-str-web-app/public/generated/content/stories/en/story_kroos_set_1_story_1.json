    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Oh, that might be it~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lens",
      "text": "'Looks like Lens's deduction is correct.'",
