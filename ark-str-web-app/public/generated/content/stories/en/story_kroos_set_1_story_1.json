    },
    {
      "type": "dialogue",
      "speakerName": "Scene",
      "text": "E h h—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Let me guess~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Oh, is it—Mayer?",
