    },
    {
      "type": "dialogue",
      "speakerName": "Mayer",
      "text": "Let me finish up here. I'll be right with you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Okay, *cough* *cough*.",
