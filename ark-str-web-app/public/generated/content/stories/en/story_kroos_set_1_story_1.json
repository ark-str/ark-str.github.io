    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "I need a favor. Is it okay~?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "May— *cough*...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mayer",
      "text": "Hm? Need me?",
