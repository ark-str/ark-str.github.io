    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "(Ohh—)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "(The door's broken.)",
