    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "(Is it this button here?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Mayer~",
