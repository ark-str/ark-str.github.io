{
  "server": "en",
  "storyId": "act19side_level_act19side_05_beg",
  "groupId": "act19side",
  "stageId": "act19side_05",
  "title": "Dorothy's Promise",
  "storyCode": "DV-5",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act19side/level_act19side_05_beg.txt",
  "sourceHash": "477fd660f88620d3cce8ae793ca7596f6db632e958c87027fbb797e3eba519fe",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Muelsyse..."
    },
    {
      "type": "dialogue",
      "speakerName": "Muelsyse",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Urgh... nngh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I never expected to see you here."
    },
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry."
    },
    {
      "type": "dialogue",
      "speakerName": "Muelsyse",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I would have killed you if the Doctor didn't warn me."
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "speakerToken": "avg_npc_521_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Is that what the enemy wanted? Did they want you to murder your former colleague?"
    },
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Not necessarily."
    },
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It wasn't just because of the Doctor that I stayed my hand."
    },
    {
      "type": "dialogue",
      "speakerName": "Saria",
      "speakerToken": "avg_npc_532_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "She said, 'Don't be too eager to make an enemy of anyone.' She was alluding to Muelsyse."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "That would explain her behavior.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "She was guiding us to Muelsyse.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "speakerToken": "avg_npc_521_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "She wanted us to find her?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "speakerToken": "avg_npc_521_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But one wrong move, and we might've killed Muelsyse..."
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "speakerToken": "avg_npc_521_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Alright, I get it. She doesn't care if Muelsyse lives or dies."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "She's treating this as a test.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Saria",
              "speakerToken": "avg_npc_532_1#1$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "A test of the power armor technology, and a test to see how Rhodes Island and I react."
            },
            {
              "type": "dialogue",
              "speakerName": "Saria",
              "speakerToken": "avg_npc_532_1#3$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "Every word she said in the bar was calculated to probe my response."
            }
          ]
        },
        {
          "label": "She wants Saria to act quicker.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Saria",
              "speakerToken": "avg_npc_532_1#9$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "She's guiding us in the direction that she wants."
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Muelsyse",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Ugh...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Feeling better, Muelsyse?"
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You were injected with a sedative a few hours ago, but you'd regained consciousness by the time we saw you in the power armor."
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The nausea and numbness that you feel are mainly lingering effects of hypoxia and extreme stress."
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I patched you up a little, but it'll take you another half hour or so to fully recover."
        },
        {
          "type": "dialogue",
          "speakerName": "Muelsyse",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Stop... stop..."
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Stop?"
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Stop... who?"
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The one who put you in the power armor?"
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The Liberi?"
        },
        {
          "type": "dialogue",
          "speakerName": "Muelsyse",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "No..."
        },
        {
          "type": "narration",
          "text": "Muelsyse begins sweating from her brow and the back of her hand.\nShe grabs your hand, and the drops of sweat rise into the air, splashing against your clothing.\nThe stain quickly spreads to form a message.\nIt is not the name of the Liberi, nor of Ferdinand."
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "...359."
        },
        {
          "type": "dialogue",
          "speakerName": "Saria",
          "speakerToken": "avg_npc_532_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Site 359."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Not often I see you here."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You did give me a temporary work permit, didn't you?"
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "'Bibliology consultant'. What's a tech firm like Rhine need with that?"
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You're in a good mood. I take it your experiments are going well?"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Don't talk about experiments right now."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Ten minutes. A man like me only gets ten minutes to himself a day."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I could spend it on a video call with the children, or dinner with Elena and the others."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But I prefer to spend it doing nothing but standing here and watching."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It's just an ordinary street out there."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yes. It's everything."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "They must be tired after a long day of work. Why is there no sign of dejection on their faces? Why are their steps so springy?"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Because they have a chance."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "They believe their hard work is giving them a chance at better lives for them and their families."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Just like those Pioneers outside the city."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Yes, them too."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Trimounts. The city of three burdenbeasts."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Three burdenbeasts carried seven Pioneers to build the first settlement on this soil."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "And now? Look at the streets below."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "The Pioneers and their descendants bring a constant stream of vitality to this place. No other country can claim to rival Columbia's enterprising spirit."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Our country's prosperity has given people confidence, which in turn feeds into our vitality."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "If the country keeps advancing, so will the lives of everyone across all the lands."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I know what you think of me. You, Kristen, Saria... you call me an opportunist."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It takes a smart man to take a chance when he comes across it."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Thank you."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I can't deny that I would rather be up here than down there."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But I've earned the chances I've been given."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "My projects have generated wealth, which fed into the next project, and driven technological progress."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "We stand on the cutting edge, leading Terra into a new era."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "They will build monuments, and our names will be immortalized upon them."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Our?"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Victory belongs to each and every trailblazer."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "—"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "My ten minutes are almost up."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You didn't give me any time to talk."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I know what you came for, Ho'olheyak."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Oh?"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I forgive you."
        },
        {
          "type": "dialogue",
          "speakerName": "Ho'olheyak",
          "speakerToken": "avg_npc_536_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Kristen, Muelsyse, Saria, Parvis... and you. I'm not wasting my time trying to guess your petty little thoughts."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Dorothy's experiments are one step away from success."
        },
        {
          "type": "dialogue",
          "speakerName": "Ferdinand",
          "speakerToken": "avg_npc_522_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "All I care about is the final result."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#12$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "S-Sonny..."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#12$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Dorothy says we're safe here... why do you have your crossbows out?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Safe?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You're not stupid, Doctor."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The biggest danger is right there."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "...Dorothy?"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I thought you were willing to hear us out?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I'm sorry."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Out of the way, you and the other docs. We're not here for you."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But..."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "We've been tricked, Elena."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Stopping the attack on Joyce was just a show."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "He showed us his anger, his hesitation, and his bottom line, all of this to hide one thing."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "He was always prepared to commit a crime."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I didn't think it'd be Myers. The whole part of making you trust me... especially Dr. Urbica... I was gonna make Sam play the bad guy."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But that's all behind us now."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "We're here, right at the source."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Me...?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You planned the kidnapping and came all the way here to kill me?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "May I ask... why?"
        },
        {
          "type": "narration",
          "text": "A voice so soft it could melt the hardest heart.\nWatery eyes opened slightly wide.\nFilled with innocence, surprise, even hurt.\nAs though it was those who picked up arms to defend themselves who should be reproached."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Why? You can still ask why?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I saw the whole it all."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The monsters you made, stalking us. How you fed them the blood of my friends."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You... evil..."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "There are no monsters!"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Those are byproducts of the experiments, made of a special material that's sensitive to neural signals..."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "No, Elena. He's not making a blind guess."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It really does seem like he's seen those silver things before."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "And more."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yeah."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Three days ago, I snuck into the lab complex to find you."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I wanted to ask if I could volunteer to be a test subject."
        },
        {
          "type": "dialogue",
          "speakerName": "Pioneer Team Member",
          "speakerToken": "avg_npc_534_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Sir! Didn't you say it was too risky? That the corps could be lying to us?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Risky? Haha... hahaha!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Sorry, Sam. I was the one lying."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But I wanted to fix my mistakes."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Listen, everybody."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I saw silver monsters taking shape around her that night. She talked to them like they were her pets."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Dorothy Franks is the one behind all this."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#1$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Do you find it hard to accept what I'm telling you?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Can't say I'm into sci-fi."
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#1$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Then maybe you could take a look at this letter."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Letter?"
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#1$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Mr. Sonny gave it to me. He might've known he'd be in danger."
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#1$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "He said to me, and I quote, 'Give this letter to Mary Banner if anything happens to me.'"
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#1$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "I'm sure he wouldn't mind you reading it... a little early."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Give it to me."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "............"
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#8$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Er... what does it say?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Where the hell did that guy go?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#5$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Er..."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You don't know Sonny Romano, Greyy."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "He's a ball of anger and hate, all over his insurance."
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#5$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Insurance again..."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yes, every Infected in Columbia deals with that word a lot."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "People outside think Columbia is kind enough to the Infected."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You get to live a normal life, as long as you can pay for your health insurance. That sounds pretty darned fair, doesn't it?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "That's what Sonny told me when he first got sick."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But where did that end up?"
        },
        {
          "type": "dialogue",
          "speakerName": "Greyy",
          "speakerToken": "avg_1027_greyy2_1#1$2",
          "operatorId": null,
          "portraitKey": null,
          "text": "Was it... very expensive?"
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "On a cop's salary? I couldn't afford it, even if I quit eating altogether."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It wasn't meant to ensure keeping the Infected healthy. The premiums are way out of line with the treatment they actually get."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It's more like a fine. Or a little trick that forces the Infected to down a certain path."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Sonny Romano never wanted to face the truth."
        },
        {
          "type": "dialogue",
          "speakerName": "Mary",
          "speakerToken": "avg_npc_527_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "If he's not stopped, he could end up going down a path you don't come back from."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "What you saw were neither monsters nor pets."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But they do have something to do with my experiments."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "So you admit it."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The truth will do you no good."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The more you know, the more danger you're in."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "People up high always like to make decisions for the little guy."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Why don't you put down those pointy things? My instruments can be fragile."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Or if you have to aim, aim this way."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I don't mind."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "She takes a step towards the Pioneers, almost touching the crossbows.\nSonny's hand trembles ever so slightly. He forces himself to look away from that warm pair of eyes.\nThis is a ploy. A trick to get them to submit again."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Aren't you afraid to die?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I am."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But I'm more afraid that you'll hurt yourselves."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You're not a murderer, Sonny, and neither are your friends. You're just ordinary men, trying to live better lives."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Didn't you consider participating in my experiments?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You still have a chance. Join us, and you'll get what you've always wanted."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I'll never turn you down."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "She extends a hand to the Pioneers, as though waiting for them to clasp it.\nDoes she not understand that they came to kill her?\nNo. Don't look at her. Her eyes, her hands, they're too soft and warm.\nThey, the people who walk the barrenlands, have never known anything but cold refusal from the cities and those who live in them.\nShe is controlling them, like she controlled the others whose wills were weak.\nBut, the word 'chance'...\nWhen was the last time we heard it?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Hm..."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Strange Entity",
          "speakerToken": "avg_npc_533_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "—"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It's those silver constructs!"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerToken": "avg_135_halo_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Where did they come from? I didn't see..."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Sonny... was right."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "This lab is where they were born."
        },
        {
          "type": "dialogue",
          "speakerName": "Silence",
          "speakerToken": "avg_108_silent_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "They're protecting Dorothy."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Stop. Don't hurt each other..."
        },
        {
          "type": "dialogue",
          "speakerName": "Strange Entity",
          "speakerToken": "avg_npc_533_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "—!"
        },
        {
          "type": "dialogue",
          "speakerName": "Pioneer Team Member",
          "speakerToken": "avg_npc_534_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It's coming!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Pioneer Team Member",
          "speakerToken": "avg_npc_534_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "More over there!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Look out!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Grab Dorothy Franks—no, destroy the lab!"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerToken": "avg_npc_535_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "We gotta destroy this cradle of evil to stop the monsters, once and for all!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "No!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "That is the one thing that I will not permit."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "The experiments must continue."
        },
        {
          "type": "dialogue",
          "speakerName": "Dorothy",
          "speakerToken": "avg_4048_doroth_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It was my promise to you... to them."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
  "observedOperators": []
}
