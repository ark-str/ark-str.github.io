      "portraitKey": "char_457_blitz",
      "text": "Clear!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Okay, you're on guard duty!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Alexsandr, see if any of the mercs on the ground are alive!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "On it."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Tina, get your bandages. Take a headcount and patch up the wounded."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerToken": "char_458_rfrost_1#3",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "Roger!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "No playing dead!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait, please... lower your gun! I'll tell you anything!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Kötz, tie him up."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#6",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Sure."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Where's the doctor? Dr. Miarow!"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "Over here!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...*cough*..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Tina! Bandages! Hurry!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Stay with me! Don't close your eyes, boy!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Why... what happened?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "When you push yourself to use Originium Arts... it worsens your Originium infection..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Rhodes Island doesn't have a countermeasure? Isn't this what you people do?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Between the blood loss, burns, and acute Oripathy symptoms, even if we were back on the landship..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...*cough*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "I said stay with me, kid."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "...You can do this. Remember how you wanted to travel the world? Picture that Columbia you were dreaming about."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "...Stay with me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough* *cough*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...*cough*..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#4",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "...Doctor..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerToken": "char_458_rfrost_1#3",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "...He's gone."
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "...I'm sorry. I couldn't..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#4",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "No... it's not your fault."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "...No... I had nothing to do with that. It wasn't me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "(Russian profanity), I'm going to twist your *profanity* head off."
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "I just...don't..."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "You're done for, (Russian profanity). You're toasted."
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "No! Don't hurt me! It wasn't me! No!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Alexsandr! Stop! Calm down!"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Where did that guard captain go? The Lord's daughter?"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "She chased someone trying to get away. Rangers went with her, don't worry."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait... the crystals on the doctor's skin... are glowing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "So soon? How?"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "! !"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "We've got bigger problems! Find an empty room here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "What are you doing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No time to explain! Move!"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "We need cloth! Curtains, bedspreads, anything!"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "Get the doctor into that little house! Hurry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "What's happening?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#9",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "What's wrong with the doctor? Why...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "M-Miss Cohen, please calm down. Franka's dealing with the doctor's—"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#9",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Dealing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#9",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Dealing with what?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You've never seen it before? I'll explain it to you later—"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Cover the doors and all the windows! No cracks!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "The chimney! Block it! And the vents!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "What... are they doing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "I'm not sure? What's wrong with... the doctor's corpse?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Don't look."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Why?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Don't look..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're good here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Doors and windows good! Ready."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Hey, is that room lighting up? The window's glowing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Miss Cohen! Get back!"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't watch..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "What on earth is going on?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "The doctor..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Oh..."
