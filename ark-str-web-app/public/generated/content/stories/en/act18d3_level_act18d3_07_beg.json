    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "And that's because... Singer, you are still here. You will help us, and fight off these monsters, like, bam bam bam!"
