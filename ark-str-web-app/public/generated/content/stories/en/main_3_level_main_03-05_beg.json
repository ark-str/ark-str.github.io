        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "We won't be able to get the upper hand unless we reveal them!"
