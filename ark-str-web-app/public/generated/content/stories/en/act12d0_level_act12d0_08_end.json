{
  "server": "en",
  "storyId": "act12d0_level_act12d0_08_end",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "Gavial's Fist",
  "storyCode": "RI-8",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act12d0/level_act12d0_08_end.txt",
  "sourceHash": "3750042045ecd7bb4d75e1c32dbededbbc521e3bee9e5de762bc7249f5f906eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "text": "Waaaaahhhh! Ugh, hold on. I should do a different cry next time, I'm getting rather tired of this one...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Hey, is he alright?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "No need to worry, he'll be back in a minute.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Okay... is he like... a person? I've never heard of anyone like him before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "No idea, the High Priest only told me he's lived here for a very long time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Alright then. What else can we say...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Phew, he's really something...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Gavial, your head is bleeding. Are you okay?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "It's fine, just a scratch. Tomimi, bring me my medical bag here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Hm? Where did Tomimi go?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Utage",
      "text": "Here's your bag. And Tomimi, I think I saw her running off somewhere right before we won the fight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Thanks. She didn't get scared, did she? Anyway, let's patch ourselves up first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "You go check if anyone's injured, and bring them to me if they are. I'll take care of them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ceobe",
      "text": "Leave it to me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Haha, no problem.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Utage",
      "text": "Ugh, what a pain. Fine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Quit yer belly-achin'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Doctor... hmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "The Big Ugly...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Sorry, Zumama. We had to take it apart.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "I know.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "I checked your engine, I think it's working fine. You can have it back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Oh yeah? That's great!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "You really won't stay, Gavial?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Yeah, just like you, I've found my calling.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "To be a doctor?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "That's it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "Is doctoring fun?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Is building machines fun?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "It is.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Same here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "But you still have to be the Great Chief.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "Any way you slice it, you beat the Big, Ugly Thing. You won, Gavial.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "text": "Look, everyone's here again. They're looking to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Tch. Doctor, what do we do?",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Your call.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "You're not giving me anything here!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Doctor, I know you're awake! I'm a doctor!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "All hail Great Chief Gavial!",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Tch. Doctor, I really want to punch you right now.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Gavial, are you hurt?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hm? I'm fine. Where did you run off to?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Huh? Oh, that... I had to go pee!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Okay... Hm?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "What's wrong, Gavial? Why are you looking at me like that?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hm... Haha, I've got it!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Everyone, listen up!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "I beat the Big Ugly, so I'm going to be the Great Chief.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "And so, my message to you is——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Your fists are everything!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Eh? Gavial, are you staying here to be the Great Chief?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "But!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "I have something very important I must do, so I have to leave.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Worry not, though! When I'm gone, Tomimi will give orders on my behalf!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Just treat Tomimi as you would treat me!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Eh, w-w-what?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Utage",
          "text": "Is that really gonna fly? Don't these people worship strength over everything?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Gavial is the Great Chief after all. She defeated everyone, so her word is law.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Haha. Zumama, machines are pretty cool, but I think I'll stick with my fists after all.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Hmph. Don't forget, I still don't recognize you. I'll build an even greater machine and challenge you again.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Sure, I'll be waiting.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Oh, right. Before that, you need to come with me for a bit.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Why?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "You need to come with me to Rhodes Island to get an Oripathy checkup.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Can I refuse? I still have to work on the Big Ugly...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "You don't have a choice this time. Besides, until Tomimi takes over, I'm still the Great Chief. I'll bring you back even if I have to kidnap you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "text": "Fine.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "...Gavial, are you going to leave after all?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Yep, I'll probably be leaving right as soon as we get the engine back in the aircraft.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "No.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hm?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "I-I won't let you leave!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
