{
  "server": "en",
  "storyId": "act12d0_level_act12d0_08_end",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "Gavial's Fist",
  "storyCode": "RI-8",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act12d0/level_act12d0_08_end.txt",
  "sourceHash": "3750042045ecd7bb4d75e1c32dbededbbc521e3bee9e5de762bc7249f5f906eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Waaaaahhhh! Ugh, hold on. I should do a different cry next time, I'm getting rather tired of this one..."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Hey, is he alright?"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "No need to worry, he'll be back in a minute."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Okay... is he like... a person? I've never heard of anyone like him before."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "No idea, the High Priest only told me he's lived here for a very long time."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Alright then. What else can we say..."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Phew, he's really something..."
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "speakerToken": "char_017_homura_summer",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "Gavial, your head is bleeding. Are you okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "It's fine, just a scratch. Tomimi, bring me my medical bag here."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Hm? Where did Tomimi go?"
    },
    {
      "type": "dialogue",
      "speakerName": "Utage",
      "speakerToken": "char_337_utage_summer_1",
      "operatorId": "char_337_utage",
      "portraitKey": "char_337_utage",
      "text": "Here's your bag. And Tomimi, I think I saw her running off somewhere right before we won the fight."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Thanks. She didn't get scared, did she? Anyway, let's patch ourselves up first."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "You go check if anyone's injured, and bring them to me if they are. I'll take care of them."
    },
    {
      "type": "dialogue",
      "speakerName": "Ceobe",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "Leave it to me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "speakerToken": "char_017_homura_summer",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "Haha, no problem."
    },
    {
      "type": "dialogue",
      "speakerName": "Utage",
      "speakerToken": "char_337_utage_summer_1#3",
      "operatorId": "char_337_utage",
      "portraitKey": "char_337_utage",
      "text": "Ugh, what a pain. Fine."
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd_summer",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "Quit yer belly-achin'."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Doctor... hmm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "The Big Ugly..."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Sorry, Zumama. We had to take it apart."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "I know."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "I checked your engine, I think it's working fine. You can have it back."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Oh yeah? That's great!"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "You really won't stay, Gavial?"
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#3",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Yeah, just like you, I've found my calling."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "To be a doctor?"
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#3",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "That's it."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "Is doctoring fun?"
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#3",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Is building machines fun?"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#5",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "It is."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#5",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Same here."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "But you still have to be the Great Chief."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#5",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "Any way you slice it, you beat the Big, Ugly Thing. You won, Gavial."
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#5",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "Look, everyone's here again. They're looking to you."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Tch. Doctor, what do we do?"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Your call.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "speakerToken": "char_187_ccheal_1#2",
              "operatorId": "char_187_ccheal",
              "portraitKey": "char_187_ccheal",
              "text": "You're not giving me anything here!"
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "speakerToken": "char_187_ccheal_1#2",
              "operatorId": "char_187_ccheal",
              "portraitKey": "char_187_ccheal",
              "text": "Doctor, I know you're awake! I'm a doctor!"
            }
          ]
        },
        {
          "label": "All hail Great Chief Gavial!",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "speakerToken": "char_187_ccheal_1#2",
              "operatorId": "char_187_ccheal",
              "portraitKey": "char_187_ccheal",
              "text": "Tch. Doctor, I really want to punch you right now."
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Gavial, are you hurt?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Hm? I'm fine. Where did you run off to?"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#4",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Huh? Oh, that... I had to go pee!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Okay... Hm?"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#4",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "What's wrong, Gavial? Why are you looking at me like that?"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Hm... Haha, I've got it!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Everyone, listen up!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "I beat the Big Ugly, so I'm going to be the Great Chief."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "And so, my message to you is——"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Your fists are everything!"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Eh? Gavial, are you staying here to be the Great Chief?"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "But!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "I have something very important I must do, so I have to leave."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Worry not, though! When I'm gone, Tomimi will give orders on my behalf!"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Just treat Tomimi as you would treat me!"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "Eh, w-w-what?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Utage",
          "speakerToken": "char_337_utage_summer_1#3",
          "operatorId": "char_337_utage",
          "portraitKey": "char_337_utage",
          "text": "Is that really gonna fly? Don't these people worship strength over everything?"
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Gavial is the Great Chief after all. She defeated everyone, so her word is law."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Haha. Zumama, machines are pretty cool, but I think I'll stick with my fists after all."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Hmph. Don't forget, I still don't recognize you. I'll build an even greater machine and challenge you again."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Sure, I'll be waiting."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Oh, right. Before that, you need to come with me for a bit."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Why?"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "You need to come with me to Rhodes Island to get an Oripathy checkup."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Can I refuse? I still have to work on the Big Ugly..."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "You don't have a choice this time. Besides, until Tomimi takes over, I'm still the Great Chief. I'll bring you back even if I have to kidnap you."
        },
        {
          "type": "dialogue",
          "speakerName": "Eunectes",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "Fine."
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "...Gavial, are you going to leave after all?"
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Yep, I'll probably be leaving right as soon as we get the engine back in the aircraft."
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "No."
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "Hm?"
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "I-I won't let you leave!"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
