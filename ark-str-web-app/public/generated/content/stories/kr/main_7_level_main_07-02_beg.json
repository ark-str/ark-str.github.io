{
  "server": "kr",
  "storyId": "main_7_level_main_07-02_beg",
  "groupId": "main_7",
  "stageId": "main_07-02",
  "title": "변절의 칼날",
  "storyCode": "7-3",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/main/level_main_07-02_beg.txt",
  "sourceHash": "f9b64ffa94a363ab947c123cee0b960d7c96d6f1ffcec2c4e74fce9423562508",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "용문 북부, 7:00 p.m. 일몰"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원",
      "speakerId": "char_015_lmg",
      "text": "비밀 수배령? 첸 팀장님을?!"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원",
      "speakerId": "char_015_lmg",
      "text": "무슨 소리야? 설마 그럴 리가……"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원",
      "speakerId": "char_015_lmg",
      "text": "어이! 돌아와! 사실이냐고 묻잖아!!"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원",
      "speakerId": "char_015_lmg",
      "text": "젠장, 첸 팀장님이 어째서…… 이게 대체 다 어떻게 된 거야!"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원",
      "speakerId": "char_015_lmg",
      "text": "첸 팀장님을 찾아 직접 물어보는 수밖에!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "흠…… 알겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "회색꼬리",
      "speakerId": null,
      "text": "더 분부하실 일이라도?"
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "없네. 전에 지시해둔 일은 잘 처리해두도록 해. 마무리되면 바로 몸을 피하도록 하고."
    },
    {
      "type": "dialogue",
      "speakerName": "회색꼬리",
      "speakerId": null,
      "text": "명심하겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "가라, 서둘러."
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "거 참……"
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "후우…… 천하의 웨이 옌우를 곤란하게 만드는 사람이 있다니."
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "탈룰라, 탈룰라…… 이게 바로 그 숙명이라는 놈인가."
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "둘째 도련님, 이런 광경은 저승에서도 별로 보기 싫겠지?"
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "에휴, 됐다. 용문도 결국 이 꼴이 났구먼."
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerId": null,
      "text": "하지만 훼이지에…… 훼이지에! 조심하거라, 훼이지에…… 목숨만은 잃지 말거라!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "용문 선착장 접현 구역, 7:20 p.m."
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토의 가축",
      "speakerId": null,
      "text": "아…… 아! 우으, 윽……"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "으아, 숫자가 정말 어마어마한데…… 아직 근위국이 이곳은 소탕하지 않은 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "어제는 리유니온이 들이닥치고, 오늘은 특수 감염자들이라…… 아무리 우리라도 슬슬 감당하기 버거운데. 그렇다고 도시에서 대형 무기를 사용할 수도 없고……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "speakerId": null,
      "text": "오퍼레이터 여러분 안녕. 저게 이번 적이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "로즈몬티스! 휴우, 이제 살았네."
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "speakerId": null,
      "text": "오리지늄 아츠로 변이된 감염자들……? 저들의 움직임을 억제할 방법은 없는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "그래, 우리에게 보급된 장비는 대부분 방어용인데다, 와이어나 고섬유 그물도 저놈들에겐 안 통하더라고. 저놈들을 상대하려면 제대로 된 전쟁용 병기 정도는 있어야 할걸."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "방어선에도 슬슬 무리가 와서, 본대에 지원을 요청할 수밖에 없겠어. 그래도 네가 와줬으니 이제 숨통이 좀 트이겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "감염자 체내의 오리지늄 구조가 놈들의 신체를 단단하게 강화해서, 강한 화력을 사용해야만 움직임을 멈출 수 있을 것 같다. 게다가…… 저놈들, 대뇌 활동의 흔적이 검출되지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 오퍼레이터",
      "speakerId": null,
      "text": "관찰한 결과, 저놈들…… 실질적으로는 이미 사망한 거나 다름이 없어. 지금은 순전히 아츠에 지배당해 움직이고 있는 거지. 아아, 정말 지독하군."
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "speakerId": null,
      "text": "이런 일을 벌인 자…… 그 대가를 치르게 할 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "speakerId": null,
      "text": "아, 물론 모두의 안전이 최우선이지만."
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "speakerId": null,
      "text": "처치 계획을 세우자. 내가…… 저들을 멈출게."
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "너도 싸운다고?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "응."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "하지만 넌……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "로도스 아일랜드 오퍼레이터",
          "speakerId": null,
          "text": "……박사님…… 로즈몬티스가 싸우는 모습, 본 적 없죠?"
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "박사, 뒤로 물러나."
        },
        {
          "type": "dialogue",
          "speakerName": "로도스 아일랜드 오퍼레이터",
          "speakerId": null,
          "text": "위험하니까 멀리 떨어지십쇼, 박사님. 이런 광경은 살면서 본 적 없으실걸요."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "문 안의 철제 상자가 떠올랐다?!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……?",
          "value": "2",
          "blocks": []
        },
        {
          "label": "공중에 떠있는 저 기계, 네 장비인가?",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "내 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "오퍼레이터, 목표의 특징을 알려줘."
        },
        {
          "type": "dialogue",
          "speakerName": "로도스 아일랜드 오퍼레이터",
          "speakerId": null,
          "text": "알았어. 매뉴얼에 분명 있었는데…… 음, 목표는, 어, 활성화된 대량의 불안정 개체?"
        },
        {
          "type": "dialogue",
          "speakerName": "로도스 아일랜드 오퍼레이터",
          "speakerId": null,
          "text": "집단 활동을 하고, 특별한 약점은 밝혀지지 않았으며, 움직임은 명확하나 목적은 불명. 대충 이 정도야!"
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "……알았어. 나한테 맡겨."
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "닥터 켈시가 당부한 건데, 이 일 처리하고 나면, 로도스 본함은 즉시 용문에서 출항한대……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": null,
          "text": "좋은 저녁~ 첸."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "호시구마……? 네가 왜 여기에, 상처는 어쩌고?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "나는 오니잖아. 그까짓 작은 상처는 진작 다 나았지."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그래, 그럼……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "잠깐, 여기서 날 기다리고 있었던 건가?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네가 끌고 있는 이 버기 카, 림 빌리턴의 최신 모델 맞지?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "\"방진 기능으로 들판도 산지도 쾌적하게, 연비는 낮추고 주행거리는 늘렸습니다~ 환경의 영향을 최소화하여 최고의 승차감을 누리세요!\" 맞나?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "아, 미안. 광고를 하도 많이 봐서 나도 모르게 문구까지 줄줄 다 외워버렸네."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "정말 괜찮은 녀석이네. 오프로드에 흥미 없는 나도 한 대쯤 사고 싶어지는걸."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "하고 싶은 말이 뭐야?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "여기저기서 충분히 고생했으면서, 또 어딜 가려는 거야?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "내가 여기 있는 건 어떻게 알았어……?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "넌 개인적으로 도시를 벗어날 때마다 항상 여길 지나가니까. 남들은 모르는 통로나 개구멍 하나까지도, 우린 전부 알고 있잖아."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……근위국에서 지명 수배가 내려왔어."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "믿는 건 아니겠지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "물론이지. 네가 어떤 사람인지는 내가 제일 잘 알잖아."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "용문을 빠져나가려면 이 길뿐이야."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "여기까지 오면서 계속 몸을 숨겨야 했어. 근위국의 모두가 너처럼 상식적이었다면 좋았겠지만……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "넌 절대 용문에서 나갈 수 없어."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……뭐?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "대체 무슨 소리야?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "나도 그들과 마찬가지로, 널 보내기 싫다는 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "호시구마…… 날 방해하겠다는 거야?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "어째서 너까지 날 막는 거야, 호시구마?!"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "막아서는 게 당연하잖아, 첸. 나는 용문근위국의 경감이자, 네 친구니까."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "혈혈단신으로 영웅 같은 대모험이라도 떠나고 싶나? 널 막을 이유는 이거 하나로도 충분해."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "넌 용문 사람이다, 호시구마!"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "우리에겐 더 이상 다른 기회가 없어. 또다시 웨이 옌우의 방식대로 일을 처리했다간, 더 많은 희생자만 생길 뿐이야!"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네 방식으로는 해결할 수 있고?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "널 오니 누님이라 부르며 따르던 사람들이야. 네가 그들이 사랑하는 용문을 지켜줄 거라 믿고 있을 거라고. 호시구마, 날 보내줘."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "하…… 진짜……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "첸, 그 녀석들이 정말 용문을 사랑하는 줄 알아?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "너……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "내가 원래 좀 레트로 한 사람이라서 말이지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "만화도, 영화도, 술도, 비 내리는 거리도, 우산이 없어 급하게 지나가는 사람까지도. 전기 자전거만 빼면, 나는 옛날 것들이 좋아."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "누군가에겐 시대에 뒤떨어져 보일 수도 있겠지. 근데 있잖아 첸, 우리가 정말 시간을 쫓아갈 수 있을까?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "나는 무리야, 못 하겠어. 시간은 너무 빠르게 지나가고, 내 소중한 모든 것을 산산조각냈지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "이제 나한테 남겨진 건 이 정도뿐이야. 베인 상처 하나, 부러진 뿔 하나, 흉터 하나. 하나하나 이름을 읊을 수도 있어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "난 시간이 싫어. 시간이 내 주변의 사람들을 데려가는 게 싫어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그 녀석들 전부 자신들의 터전을 위해 몸이 부서져라 노력하는데, 나는?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "나는 그저 하나하나씩 사라지는 걸 지켜보기만 했어. 심지어 내 손으로 직접 녀석들의 꿈을 깨부순 적도 있지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그 녀석들은 용문을 사랑하지 않아. 어디에도 속하지 않는 몸이거든. 최후의 최후까지, 내가 그들을 아무 데도 속하지 못하게 만들었어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "너까지 보낼 순 없어, 첸."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그럼 아팟의 죽음도, 용문을 위해 목숨 바친 많은 사람들도…… 모두 못 본 척하겠다는 뜻이냐?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "모든 걸 다 안다고 착각하지 마."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그 녀석들과 보낸 시간은 내가 더 길어. 녀석들에 대해서는 너보다 훨씬 잘 알고 있다고."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "하지만 용문을 지키는 건 내 사명이야. 내 앞을 막는 게 누구든, 그 사명은 변하지 않아."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "아직도 네가 팀장이라고 생각해? 그 사명은 누가 네게 줬지?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "나 자신이다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……스스로에게 들려주려고 하는 말 같네."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "생각해봐, 너 혼자의 힘으로 용문을 구한다? 혼자 모든 리유니온을 무찌르고? 객기도 정도껏 부려야지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "참 웃기지. 이전까지는 네가 웨이 장관님의 명령을 이행했지. 네가 그 사람을 가장 잘 이해하니까. 그런데 지금은, 내가 그 사람의 뜻을 더 잘 이해하면서 명령을 이행하고 있어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "웨이 장관님 생각은 대충 짐작이 가. 어차피 누군가 죽어야 한다면, 자신이 죽겠다는 거지. 너는 첸 씨 집안의 핏줄이니, 이 일로 네게 책임을 묻는 일은 없을 거다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "네 말은 그가……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "웨이 장관님은 설사 자신이 죽는 한이 있더라도, 너만은 살아남길 바라는 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "너무 좋게만 생각해주는군."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네가 장관님을 너무 나쁘게만 보는 걸지도 몰라, 첸."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "죽길 원하면 마음대로 하라지. 하지만 그가 죽어서 해결되는 게 뭐가 있어? 무슨 소용이 있지? 그가 죽으면 전쟁이 일어나지 않게 되나? 용문이 공격받지 않게 되나?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "장관님이 죽으면, 적어도 용문이 분풀이 대상이 되진 않겠지. 장관님이 죽으면, 모든 책임이 그와 같이 사라질 거라고 생각한다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "과연 그렇게 순조로울까?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "물론 순조롭지만은 않겠지. 그래서 네게 근위국을 맡기려고 하시는 거고."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네가 장관님의 뒤를 이을 거야. 근위국의 차기 국장 자리는 진작부터 네 것이었어. 이제 네가 이 도시의 주인이 될 차례다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네가 해결하지 못한 문제들과 대대로 이어진 악습들을 뿌리뽑는 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "난 장관님이 무슨 생각을 하는지 잘 알겠던데? 장관님은 항상 이 순간만 기다려온 거지. 장관님의 눈빛과 생각은, 처음 본 순간부터 지금까지 한번도 변한 적이 없어."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "용문엔 네가 필요해. 용문은 네가 이런 위험을 무릅쓰길 바라지 않아."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "역겨운 느낌만 드는군."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "웨이 장관님의 죽음이 너를 움직이는 이유로는 부족할지도 몰라. 하지만 장관님이 죽은 후엔, 네가 용문을 바꿀 수 있다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "한 가지 사실을 알려주지, 호시구마. 내가 용문에 속할 수 없는 이유를 말이야."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그럴 일은 없어, 첸. 너보다 이 도시에 어울리는 사람은 없으니까."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "나는 감염자다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……뭐?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……언제부터……?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "3년 전부터."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "나한테까지 숨기고 있었던 거야?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "일부러 그런 건 아니야……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "왜 나한테 조차 비밀로 한 거지……?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "웨이 옌우가 이 사실을 아무도 모르길 바랐으니까. 근위국에 감염자가 있어선 안 돼, 그러니까 난 안된다는 거다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "호시구마, 이 도시에 감염자가 있을 곳은 없어. 이 세상 어디에도 마찬가지지만."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "지금까지 웨이 옌우에겐 충분히 조종당했어. 더 이상은 그에게 휘둘리지 않을 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "아니. 이제 알겠어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "이제서야 겨우…… 완벽하게 이해했어, 첸. 왜 네가, 용문을 떠나선 안 되는지."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……호시구마?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네가 만약 코어로 떠나버리면, 웨이 장관님은 널 적으로 여길 수밖에 없어. 단순한 적이 아니라 감염자로서, 용문을 적대하는 위험한 감염자로서 말이야……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "모든 도시에서 네가 감염자라는 걸 알게 될 테고, 심지어 리유니온과 한패라고 의심받을 수도 있겠지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "한번 엎지른 물은 다시 주워담지 못해. 이 도시로 영영 돌아올 수 없게 된다고."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "상관없어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그건 내가 할 말이다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "\"네가 감염자라고? 나야말로 상관 없다.\""
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "나도, 스와이어도, 나인도, 근위국도, 그 누구도 신경 쓰지 않아."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "장관님도 마찬가지다. 그러니까 널 쫓아내는 대신, 네가 이 용문을 바꿔주길 바라는 거지."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그가 감염자에게 얼마나 무자비한지 모르니까 그런 말이 나오는 거야. 난 이 두 눈으로 직접 봤다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그리고 나인이라면, 이미 여길 떠났다. 그녀가 근위국을 떠난 이유 역시, 감염되었기 때문이다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……나인도……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "지금 생각해 보니, 나와 나인은 같은 임무에서 함께 광석병에 걸렸던 것 같군."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "이후 그녀는 내 스파이로서 리유니온에 잠입했지만…… 나중에는 리유니온을 위해 용문을 버렸다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그녀도, 이 도시의 진상을 알아버렸기 때문이겠지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "하지만 넌 애초에 용문을 배신하지도 않았어. 저지르지 않은 죄까지 떠안게 할 순 없다고."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "호시구마, 너는…… 내가 무엇을 위해 코어에 간다고 생각하나?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "수수께끼는 질색이야. 알아듣게 말해."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "음……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "리유니온의 리더가 누군지 아나?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "이름까진 기억 안 나는데."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "탈룰라다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "스와이어가 네게 말해주지 않았나?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "뭘?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "탈룰라가 내 언니라는 걸."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "아. 아…… 와…… 그렇구나."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "첸, 너는 오늘 여길 절대 지나갈 수 없을 거다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……무슨 뜻이야……? 설마 내 가족, 내 가족은…… 중요하지 않다는 거냐?!"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "중요하기 때문에……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "중요하니까, 더더욱 너를 보낼 순 없어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "내가 오늘 이 자리에서 죽는다 해도, 너를 보낼 수는 없다고."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "네가 함부로 결정할 일이 아니야, 호시구마."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "반야가 결정하겠지."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "……오늘 내 앞을 가로막는 게 재앙이라 할지라도 순순히 포기할 생각은 없다. 하물며 상대가 방패 하나와 오니 하나라면야 더더욱!"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "이 방패, 반야를 주조한 대장장이는 방랑하는 악귀 떼에게 온 가족을 잃었다. 그 사무치는 원한은 재앙보다도 깊지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그리고 이 방패에 묻힌 피와 그로 인한 참극은…… 재앙보다 더 사악할 거다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "첸, 웨이 장관님이 좋은 사람이 아니라면, 우리가 같이 손봐주면 되는 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네가 뭘 하든 내가 함께할게. 뭐든 상관없어. 너 내 컬럼비아 엔진 70vv 갖고 싶어 했지? 그것도 너 줄게."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "첸, 지금은 안 돼. 가지 마. 날 밀어내지 마. 진짜 내 마지막 부탁이다."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "널 밀어내? 웨이 옌우와 똑같이 말하네? 그렇게 말하지 마……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "웨이 옌우가 일을 벌였을 때부터…… 아니,"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그가 자기 형제들을 팔아넘기고, 내 어머니를 배신하고, 이 도시가 그의 어두운 죄악에 침식당했을 때부터 난 결심했었다."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "다 너와 연결 지으려고 하지만, 나는 웨이 장관님이 무슨 짓을 했든, 너와는 아무 상관 없다고 생각해."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "뭔 소리를 하는 거냐……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그가 한 일, 널 위해 한 일, 너와 함께 해야 할 일, 모두 다른 별개의 일이라고."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "웨이 장관님도 그런 결과를 기대하진 않았을 거다. 악역이 되려고 하지도 않았고, 지배를 꿈꿨던 것도 아니었잖아……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……너한테, 검을 줬잖아."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "넌 아무것도 몰라……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……내가 뭘 모르는데?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "한 번에서 그치지 않고, 또 한 번, 또 한 번, 계속해서…… 나는 내 집을, 내 가족을 부쉈어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "난 언제나 피투성이인 채로, 마지막까지 홀로 서서 싸웠지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "그게 옳은 거라고 생각했으니까. 그리고 지금은 그게 틀렸다는 걸 알아버려서……"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……그래서 항상 생각해. 내가 살아있을 자격이 있나?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "아마 없겠지. 하지만 난 계속 살아가고 있어. 더 이상 나 자신만을 위해 살 수는 없으니까."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "잘못을 인정하고 앞으로 나아간다…… 인생에서 할 수 있는 가장 어리석은 짓이지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "후회의 쓴맛이 언제나 입안에 맴돌고 있는 거 같아."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "너 혼자만 세상에 있는 모든 짐을 다 짊어진 거 같지? 어? 첸 아가씨?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그런 식으로 말하지 마!"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "……내 마음을 조금이라도 이해해줄 순 없어?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "우리가 동거동락한 시간이 얼마인데, 왜 나에게 털어놔 주지 않은 거냐?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "너에게도 나에게도 괴로운 기억들이 잔뜩 있다는 거, 우리 서로 잘 알고 있어. 아주 잘 알고 있지……"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "너야말로 왜 이해해 주지 않는 거야? 난 그 누구도 휘말리게 하고 싶지 않을 뿐인데, 내가 너흴 이해하지 못한다고?!"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "지금까지 무의미하게 죽어간 사람들을 너무 많이 봐왔어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네 신분 따위 상관없어. 네가 어디로 가는지가 중요하지."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "넌 절대 못 보내. 적의 리더가 이렇게까지 나온 이상, 네가 가도 변하는 건 없어. 개죽음당할 뿐이라고."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "네 개죽음을 바라는 사람은 그 어디에도 없어. 근위국도, 용문도, 그 누구도 바라지 않아."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "고맙다…… 호시구마."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "하지만 그래도 가야겠어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "진심이야?"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "정말 검을 뽑아야 한다면, 망설이지 않겠어."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "무조건 가야겠다 그거야? 넌 지금 네 마음이 강철처럼 막 단단한 줄 알지?"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "전에도 말했잖아. 넌 자신만의 생각에 빠져 주변을 둘러보지 못하는 경향이 있다고. 다른 사람들이 널 위해 얼마나 애쓰고 있는지조차 보지 못하게 된다고."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "계속 고집부렸다간 너만 다쳐."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "흥."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "됐다. 옛날의 나처럼, 한번 두들겨 맞아봐야 알겠지. 지가 부리는 고집이 그저 철없는 충동에 불과하단걸."
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "speakerId": "char_136_hsguma",
          "text": "싸울 거면 말이야, 첸…… 2년 동안 얼마나 성장했는지 보여달라고."
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "speakerId": "char_010_chen",
          "text": "그렇게 말하지 말라고!!!!!!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "EX-42 오리지늄 아츠 원격 조작형 기기, 사용자 로즈몬티스, 승인 부탁해."
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "speakerId": null,
          "text": "방위전에서의 사용이 승인되었습니다."
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "speakerId": null,
          "text": "사용자: 섬멸전 전문 요원, 로도스 아일랜드 정예 오퍼레이터 로즈몬티스, 사용 승인되었습니다."
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "응, 그럼 갔다 올게."
        },
        {
          "type": "dialogue",
          "speakerName": "로즈몬티스",
          "speakerId": null,
          "text": "로도스 아일랜드 함선 가동하는 일은, 클로저한테 전해줘."
        },
        {
          "type": "dialogue",
          "speakerName": "로도스 아일랜드 오퍼레이터",
          "speakerId": null,
          "text": "박사님, 어서 안쪽으로 들어오세요. 구경하지 마시고요."
        },
        {
          "type": "dialogue",
          "speakerName": "로도스 아일랜드 오퍼레이터",
          "speakerId": null,
          "text": "로즈몬티스가 싸울 때 날아오는 파편에 맞으면 죽을 수도 있단 말입니다."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
