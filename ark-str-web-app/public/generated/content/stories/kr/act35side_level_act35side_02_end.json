    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": "avg_4138_narant_1",
      "isRemote": false,
      "text": "(설마…… 경호원이라도 주변에 있었나?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_black"
    },
