  "sourceHash": "a4eee0c83a7aaaf328f33fb5e0a2f8f6e9e362ae7ccee443254c354174d9d6ef",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十一关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "리유니온의 추격 부대도 이게 마지막이에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온",
      "text": "…커헉!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "클리어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "안전 확인!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "적의 지휘관은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "…이 부대 안에는 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "기척을 숨기고… 우리의 움직임을 지켜보면서 미행하는 게 아닐까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "우리 체력이 떨어지는 걸 기다렸다가… 승기가 확실히 보일 때 공격하려는 거 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아마 그렇겠죠. 리유니온은 기습이 주특기니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "체르노보그에서 봤던 것처럼 말이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "우선은 잠시 퇴각하기로 해요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "퇴로의 안전은 보장할 수 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "만약 빌딩이 파괴되기라도 해서 길이 막힌다면 그야말로 아무것도 할 수 없는 상황이 될 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…빨리 다른 경로를 찾아주세요! 눈에 띄지 않을수록 좋아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "아미야, 네 시 방향에 있는 사다리를 타고 내려가는 건 어떨까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "저기는 좀 힘들 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온",
      "text": "으아아! 로도스 아일랜드 놈들!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "복병이에요! 조심하세요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "계속 쫓아라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "놈들에게 숨 쉴 틈조차 주지 마라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…첸 팀장.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…슬럼가에는 감염된 아이들이 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "만약 가능하다면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그 아이들을… 보살펴 줬으면 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "용문을 지키는 건 근위국이 해야 할 일이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "하지만, 감염자는 용문의 시민이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그래도 용문의 감염자라면, 용문에 속한다고 해야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아무것도 보장해주진 못하겠지만, 난 내게 주어진 책무를 다하겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어차피…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그 아이들이 그랬어. 예전에도…",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "="
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이건 내가 여태까지 해온 일이기도 하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "고마워…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…왜 우리가 너를 찾고 있었는지 아나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…모르겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "내 어디에 그럴만한 가치가 있는지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "다만, 혹시라도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "너희가 날 노리는 이유는 내가 아니라, 우리…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아버지 때문이 아닐까 싶은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "네 부친은 체르노보그에서 가장 유명한 과학자였지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그리고 체르노보그의 중요 정치 인물 중 하나이기도 하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어쩌면, 네게도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "확실한 증거가 있는 건 아니지만 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "하지만, 네가 리유니온의 손에 넘어가는 것만은 막아야 했다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "후후, 찾았다. 용문근위국.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너희에게 원한이 있는 건 아니지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "정말 재미있는 시나리오를 준비해 뒀거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "시나리오를 더 재미있게 하려면 너희가 꼭 참여해줘야 해서 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그럼 시작하지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
