  "blocks": [
    {
      "type": "narration",
      "text": "第二十一关（后）"
    },
    {
      "type": "background",
      "backgroundId": "bg_lungmen_r"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "리유니온의 추격 부대도 이게 마지막이에요!"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "…커헉!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "클리어!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "안전 확인!"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "적의 지휘관은?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "…이 부대 안에는 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "기척을 숨기고… 우리의 움직임을 지켜보면서 미행하는 게 아닐까?"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "우리 체력이 떨어지는 걸 기다렸다가… 승기가 확실히 보일 때 공격하려는 거 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "아마 그렇겠죠. 리유니온은 기습이 주특기니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "체르노보그에서 봤던 것처럼 말이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "우선은 잠시 퇴각하기로 해요…"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "퇴로의 안전은 보장할 수 없다."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "만약 빌딩이 파괴되기라도 해서 길이 막힌다면 그야말로 아무것도 할 수 없는 상황이 될 거다."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "…빨리 다른 경로를 찾아주세요! 눈에 띄지 않을수록 좋아요!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "아미야, 네 시 방향에 있는 사다리를 타고 내려가는 건 어떨까?"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "저기는 좀 힘들 것 같은데."
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "으아아! 로도스 아일랜드 놈들!"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "복병이에요! 조심하세요!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "계속 쫓아라."
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "speakerId": "char_1500_skulsr",
      "isRemote": false,
      "text": "놈들에게 숨 쉴 틈조차 주지 마라."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "…첸 팀장."
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "…슬럼가에는 감염된 아이들이 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "만약 가능하다면…"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "그 아이들을… 보살펴 줬으면 해."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "용문을 지키는 건 근위국이 해야 할 일이다."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "하지만, 감염자는 용문의 시민이 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "그래도 용문의 감염자라면, 용문에 속한다고 해야겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "아무것도 보장해주진 못하겠지만, 난 내게 주어진 책무를 다하겠다."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "어차피…"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "그 아이들이 그랬어. 예전에도…"
    },
    {
      "type": "narration",
      "text": "="
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "이건 내가 여태까지 해온 일이기도 하다."
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "고마워…"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "…왜 우리가 너를 찾고 있었는지 아나?"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "…모르겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "내 어디에 그럴만한 가치가 있는지…"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "다만, 혹시라도…"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "너희가 날 노리는 이유는 내가 아니라, 우리…"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "speakerId": "char_012_misa",
      "isRemote": false,
      "text": "아버지 때문이 아닐까 싶은데."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "…맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "네 부친은 체르노보그에서 가장 유명한 과학자였지."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "그리고 체르노보그의 중요 정치 인물 중 하나이기도 하고."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "어쩌면, 네게도…"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "확실한 증거가 있는 건 아니지만 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "speakerId": "char_010_chen",
      "isRemote": false,
      "text": "하지만, 네가 리유니온의 손에 넘어가는 것만은 막아야 했다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "isRemote": false,
      "text": "후후, 찾았다. 용문근위국."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "isRemote": false,
      "text": "너희에게 원한이 있는 건 아니지만…"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "isRemote": false,
      "text": "정말 재미있는 시나리오를 준비해 뒀거든."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "isRemote": false,
      "text": "시나리오를 더 재미있게 하려면 너희가 꼭 참여해줘야 해서 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "isRemote": false,
      "text": "그럼 시작하지."
    },
    {
      "type": "sceneBreak"
    }
  ],
