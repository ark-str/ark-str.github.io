    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……가비알, 아무래도 우리의 여행은 잠시 보류해야 할 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그럼 난 어떡해?"
