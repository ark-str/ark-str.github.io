{
  "server": "kr",
  "storyId": "story_ccheal_set_1_story_1",
  "groupId": "story_ccheal_set_1",
  "stageId": null,
  "title": "의학의 길",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_ccheal_1_1.txt",
  "sourceHash": "e30e554fd13d433754f48b05be71eb731d57f87049e5841a29bcadbe1826e0a2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "고마워요, 가비알 선생님."
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "조금 나아진 것 같아요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……내가 할 수 있는 건 이 정도뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "괜찮아요. 어차피 광석병은 치료할 수 없으니, 조금이라도 더 살 수 있으면 그걸로 된 거죠."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "내가 여기는 처음 와 봐서 그런데, 이 도시에 혹시 광석병을 연구하는 의사가 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "왜 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그게, 몇 달 전에 살카즈 의사가 와서 서쪽의 폐허를 사들였어요."
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그리고는, 광석병을 치료할 수 있는 특별한 사탕이 있다고 소문을 내더라고요."
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "피를 조금만 뽑게 해주면, 그 사탕을 준대요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……그런 말을 믿는 사람이 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "처음엔 아무도 믿지 않았어요. 그런데 어떤 사람이 지푸라기라도 잡는 심정으로 아이를 보냈는데, 증세가 진짜로 나아졌대요. 그 이후로 점점 더 많은 사람이 믿기 시작했어요."
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "원래는 여기서 끝났을 일이지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "최근 빈민가에서 한 아이가 실종되었다는 소문이 돌고 있어요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "실종이라…… 그 의사를 의심하는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "아이를 마지막으로 본 사람이, 아이가 그 의사에게 갔다고 하더군요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그럼 왜 바로 그 의사를 찾아가지 않은 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……감히 그럴 수 없었어요. 거기에 가봤던 사람들 말로는, 그 의사의 방에 혈액팩이 가득한 데다……"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그 의사의 태도도 엄청 사나워서, 수틀리면 언제든지 사람을 해칠 것처럼 보였다고 하더군요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "왜 아미르에게 말하지 않았지?"
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……실종된 건 고작 갈 곳 없는 고아 한 명일 뿐이잖아요. 귀족들은 그런 일에 신경도 안 쓰니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그렇다면, 내가 가볼게."
    },
    {
      "type": "dialogue",
      "speakerName": "빈민가 주민",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "정말 가시려고요?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……우선 그 의사가 정말로 광석병을 치료할 수 있는지 확인해볼 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "만약 그게 거짓말인 데다 아이까지 납치한 거라면, 내가 반드시 처벌받게 하겠어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "살카즈 의사가 거주하는 건물은 매우 허름했다. 발을 막 들여놓았을 때, 가비알은 자신이 잘못 찾아온 게 아닐까 하는 의심까지 들었다."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "잠깐, 이 냄새는……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이건……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "피 냄새야."
    },
    {
      "type": "narration",
      "text": "그녀가 발걸음을 내딛자마자, 무언가 발에 걸렸다.\n고개를 숙여 보니……\n그것은 신발 한 짝이었다. 크기를 보니 분명 어린아이의 것이었다.\n그리고 신발 옆에는 한 무더기의 핏자국이 있었다.\n그녀는 문득 등골이 오싹해졌다."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……여기서, 도대체 무슨 일이 있었던 거지?"
    },
    {
      "type": "narration",
      "text": "그녀는 쪼그리고 앉아 핏자국의 냄새를 자세히 맡았다."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이건 진짜 피잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "설마 정말로 아이가 여기서 죽은 걸까……"
    },
    {
      "type": "narration",
      "text": "그녀는 바로 핏자국 옆 사탕 하나를 발견했다."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이게 그 의사가 아이들에게 준 사탕인가?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이건…… 그냥 평범한 사탕이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "고작 이런 사탕으로 아이들을 속이다니……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "누구야?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "가비알이 고개를 들어보니, 2층 계단 입구에 한 여자아이가 멍하니 서서 그녀를 바라보고 있었다."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……!"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "꼬마야, 여기서 무슨 일이 있었는지 말해줄 수 있을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "잠깐만!"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "쳇……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "도대체 뭐가 어떻게 된 거야!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "왜 또 돌아온 거야?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "잠깐만."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "꼬마야, 무서워하지 마. 난 널 구하러 온 거야!"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……그렇게 된 거로군."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "너…… 네가 여기 의사야?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "가비알은 방 안에 걸려 있는 혈액팩을 보고 놀랄 겨를도 없었다. 왜냐하면, 그녀 바로 앞에 백발과 붉은 눈을 가진 살카즈가 서 있었기 때문이다.\n가비알은 문득 교양서적에서 읽었던 뱀파이어에 대한 내용이 떠올랐다.\n그들은 살카즈 아종 중 하나로, 매우 강력했지만 그만큼 악명이 자자했다.\n그들은 그림자 속을 거닐며 타인의 피를 마셨고, 살인을 일삼았으며, 온갖 악행을 저질렀다……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "너는…… 뱀파이어?!"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그렇군. 네가 사탕으로 도시 아이들을 유인했던 건, 네 먹이로 삼으려는 거였구나!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "넌 누구지?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "내 이름은 가비알, 의사지. 오늘, 네 악랄한 음모를 밝히러 왔다!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "지금은 너를 상대할 시간 없으니까 잠깐 자고 있어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "너…… 나한테…… 무슨 짓을 한 거야……"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "혈액순환을 살짝 조정했을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "얌전히 잠이나 자."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "윽…… 몸이 타들어 가는 거 같아……"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "응? 내 오리지늄 아츠를 맞고도 바로 쓰러지지 않다니."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "재미있네."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "넌 누구야?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "말했잖아…… 가비알이라고……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "나는…… 의사야……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이 아이를 구하러 왔어…… 하앗!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "빠져나오기까지 하다니, 이거 참……"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "점점 더 흥미로워지는데."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "어떻게 해야 저 여자의 피를 얻을 수 있을까……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그 아이를 놔줘!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하하…… 그럼 이렇게 하지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "뱀파이어가 여자아이의 머리를 살짝 쓰다듬었다. 그러자 여자아이는 그대로 의식을 잃고 천천히 뱀파이어의 발치에 쓰러졌다."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그 아이에게 무슨 짓을 한 거야!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "저 아이는 식량으로 이곳에 보관될 거야. 걱정하지 마, 고통은 느끼지 않을 테니."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이, 이 망할 자식!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "만약 아이를 구하고 싶다면, 너랑 교환하자. 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "교환?"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그래. 그 아이 대신 네 피를 뽑게 해준다면 아이를 풀어줄게, 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "좋아."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "오? 시원시원하군."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "여기서 너랑 크게 붙었다간, 아이가 다칠 수도 있으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하지만 약속은 지켜, 아이는 풀어줘야 해."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……그렇지 않으면, 내가 오늘 여기서 죽는 한이 있더라도 절대 너를 가만두지 않을 테니까!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "어떻게 가만두지 않는다는 거지? 그대는 곧 죽을 텐데 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "부족의 제사장 할아버지는 아카후알라의 용사가 죽으면, 영혼이 아카후알라의 호수로 돌아간다고 말했거든."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "“내 영혼은 호수에 씻겨 숲 속 바람에 녹아들고, 하늘의 비가 될 것이다.”"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "두려워해야 할 건 오히려 너다, 이 사악한 뱀파이어야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "바람이 네 얼굴을 스치고, 비가 네 어깨를 적실 때마다, 너는 나를 떠올리게 될 거니까!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "사르곤의 부족에는 정말 흥미로운 전승이 많네."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하지만, 넌 뱀파이어를 모르는 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "바람은 내 근처에서 나는 피 냄새에 흩어지고, 비는 머리 위에서 피로 변해 내게 스며들겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "아마 네 영혼은 내게 조금도 상처를 입히지 못할 거야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "가비알은 분노에 찬 채 눈을 감고, 제 죽음을 받아들일 준비를 했다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "가비알은 정글을 떠나기 전까지, 눈을 가장 따갑게 하는 것은 태양이라고 생각했다.\n한 번은 용기를 내어 태양을 정면으로 바라보다 눈에 화상을 입는 바람에, 며칠 동안 물체가 겹쳐서 보인 적도 있었다.\n그때 그녀는 태양보다 따가운 것은 없을 것이라고 생각했다.\n하지만 정글을 떠나고 나서야, 그녀는 자신이 틀렸다는 걸 깨달았다.\n사실 가장 따가운 것은 다른 사람의 시선…… 다른 사람이 그녀의 몸에 있는 오리지늄 결정을 바라보는 시선이었다.\n그녀는 그 시선 속에 담긴 악의를 두려워하지 않았다. 하지만 그 시선을 마주하려 할 때마다 사람들은 먼저 시선을 돌렸다.\n그녀는 시간이 지난 뒤에야 깨달았다. 자신이 걸린 병이 '돌멩이병'이 아니라 '광석병'이라고 불리는 것이며, 자신 같은 사람은 '감염자'라고 불린다는 것을.\n광석병은 불치병으로 여겨진다는 것을.\n감염자의 삶은 대부분 힘들다는 것을.\n정글에서는 이런 구분이 전혀 없었고, 누구도 광석병에 걸린 사람을 차별하지 않았다.\n아무리 생각해도 이유는 알 수 없었지만, 한 가지는 알았다. 불치병이라 하더라도 광석병 환자의 증세를 완화할 수 있다면, 환자들의 삶을 조금이나마 나아지게 만들 수 있을지도 모른다는 것이다.\n그래서 그녀는 광석병에 대처할 수 있다고 자칭하는 의사들을 여기저기 찾아다니며 그들에게서 방법을 구하고자 했다.\n하지만 결국 매번 얻는 것은 실망뿐이었다.\n어떤 이들은 그저 명성만을 좇았고, 또 어떤 이들은 감염자 치료라는 명목하에 불법 행위를 저질렀다.\n가비알은 단지 그 점을 지적했을 뿐이었지만, 오히려 그들이 가비알에게 누명을 씌웠기에 한때 지명 수배자가 되기도 했었다.\n왜일까?\n…………\n그녀는 주삿바늘이 팔에 꽂힐 때 느껴지는 약간의 통증과 함께, 피가 뽑혀 나가는 상실감이 느껴졌다.\n아, 맞아. 아카후알라의 동료들은 아직 그녀에게 무슨 일이 일어났는지 모를 텐데.\n이럴 줄 알았으면, 미리 한 번 만나고 올 걸.\n상실감은 금방 지나갔다.\n그리고는 고요해졌다.\n이게 바로 죽음인가?\n뱀파이어가 사람을 죽이는 방법은 원래 별로 아프지 않은 거였구나……\n………………\n…………\n……\n아니 잠깐, 안 죽었잖아?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "음…… 혈액 속의 오리지늄 결정 밀도는 낮지 않지만, 의외로 혈액 상태가 아주 건강하네."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "역시, 네 신체 능력은 보통 사람을 훨씬 뛰어넘는구나."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "날 왜 안 죽인 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "내가 왜 너를 죽여야 하는데? 내가 말한 건 아이 대신 피를 뽑게 해달라는 거였잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하지만 넌 뱀파이어잖아…… 피를 뽑는다는 건…… 사람을 죽인다는 거 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "뭐, 확실히 동족 중에는 그런 짓을 즐기는 자도 많긴 하지만, 최소한 나는 그런 거에 흥미 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그럼 도대체 왜 이런 짓을 한 거야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "방금 넌 네 의지만으로 내 오리지늄 아츠에서 빠져나왔잖아? 그래서인지 네 피에 엄청 관심이 생겼어."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하지만 그렇다고 너랑 싸우자니, 그건 조금 번거로울 거라고 생각했어. 그래서 임시방편으로 이런 방법을 떠올린 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "사악한 뱀파이어",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "협조해 줘서 고마워."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……넌 대체 누구야?"
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "와파린, 의사야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "꼬마야, 일어나."
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "음…… 응?"
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "언니도 병을 치료하러 왔어요?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "난 널 찾으러 온 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "밖에서는 네가 실종된 걸로 알고 있거든."
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "아닌데."
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "의사 선생님이 나보고 너무 약해졌으니 우선 쉬라고 해서, 그래서 밖에 나가지 않은 것뿐인데요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그럼 정말 거짓말이 아니었다고……?"
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "누군가는 뱀파이어가 의사가 될 수 있다는 것조차 믿지 않더라고. 굳이 그런 사람을 설득해서 자기 상상을 넘어서는 일까지 믿게 할 순 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "너…… 그러면 해명은 안 할 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "난 이미 몇백 년 전부터 다른 사람의 시선은 신경 쓰지 않고 살아왔어."
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그런 일에 시간을 쓸 바에야, 차라리 혈액 연구를 더 하겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "의사 선생님, 감사해요. 이제 많이 좋아진 것 같아요."
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "피를 받고 약을 준 것이잖아, 각자 필요한 걸 얻었을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그럼 이제 둘 다 돌아가 줘. 연구에 방해되니까."
    },
    {
      "type": "dialogue",
      "speakerName": "감염자 아이",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "네, 의사 선생님, 안녕히 계세요!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "잠깐, 그 사탕들은……"
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그건 그냥 평범한 사탕이야."
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하지만 환자가 효과가 있다고 믿는다면, 효과가 생기는 법이지."
    },
    {
      "type": "dialogue",
      "speakerName": "와파린",
