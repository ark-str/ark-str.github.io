{
  "server": "kr",
  "storyId": "story_vigna_set_1_story_1",
  "groupId": "story_vigna_set_1",
  "stageId": null,
  "title": "해야 하는 일",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_vigna_1_1.txt",
  "sourceHash": "a81a5d426f03ab5553bf790b7bfbe8a5f053ab5d8dbf5b877041a322bba02568",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 红豆"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "비켜, 비켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "도망치지 마, 얌전히 나한테 잡히라고!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "이봐, 비그나, 너무 앞으로 가진 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나가 오늘따라 왜 이렇게 들떠있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "몰랐어? 우리가 정박한 도시에서 오늘 밤에 록 콘서트가 있는 모양인데, 비그나가 몹시 기대하더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "아, 어쩐지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "맞지? 빨리 따라가자. 사고라도 나면 정말 큰일 나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "알았어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나, 네 기분은 알겠는데, 너무 흥분하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "아, 알겠습니다. 죄송해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "아니야. 나도 널 탓하려는 게 아니라, 알려준 것뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그래. 아주 잘했어. 조금 성급하긴 했지만, 판단력은 잃지 않았어. 할 일도 했고 성장했군, 비그나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "헤헤, 매일 단련했으니까요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "하하, 대단해. 난 네 나이 때 그렇게 독하게 못 했는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그런데 오늘 네 열정을 보니, 어지간히 엄청난 콘서트인가 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "네! 제가 진짜 좋아하는 밴드에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "게다가 우리가 정박한 도시에서 콘서트가 열리는 건 아주 드문 기회잖아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그건 그렇지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "게다가 록 콘서트는 라이브랑 음반 듣는 거랑 느낌이 전혀 다르다고요. 두 분도 같이 가요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "하하, 난 됐어. 난 록은 너무 시끄러워서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "나도 비슷해. 하지만 우리, 비그나의 콘서트를 위해 우리 둘 다 조금은 노력하자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그래!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "쳇, 이 녀석들이 매복하고 있었을 줄이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "이 정도 규모라면 분명 리더 같은 게 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "맞아. 하지만 우리가 쫓는 무리에는 없을 거야. 그랬으면 우리가 봤겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "어떡하지? 주변을 수색해볼까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "마지막 한 마리!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "더는 없겠죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "하하, 됐어. 오늘은 이만 끝내자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "리더는 못 찾았지만, 오늘 각 팀이 함께 저들의 수를 많이 줄여놨으니까 한동안 별일은 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "하하, 그래. 그리고 어쩌면 처음부터 리더 같은 건 없었을지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나, 콘서트 안 늦었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "지금이 오후 2시 10분. 음, 돌아가서 보고하는 데 한 시간쯤 걸릴 테고, 도시로 나가는 데 또 한 시간. 콘서트는 오후 5시 시작이니까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "아직 늦진 않았어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그럼 다행이네. 돌아가서 보고하자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "다녀왔습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "수고했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "다른 팀은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "다른 팀도 이미 각자 임무를 마치고 무사히 돌아왔어. 너네가 마지막 팀이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "좋아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "그럼 임무는 끝났네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "음, 확실히 그렇긴 한데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "그게 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "C팀에서 비스트를 쫓을 때, 놈들의 리더로 보이는 비스트의 습격을 받았다고 했어. 상대의 수가 적지 않아서 C팀은 철수를 했고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "거봐, 내가 뭐랬어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "우쭐대지 마. 나도 그 생각 했거든!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "우리가 시 정부와 계약한 내용에는 주민을 괴롭히는 비스트의 위협을 없애겠다고 명확히 규정되어 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그러니까 우리가 다시 가서 그 위협을 완전히 없애야 한다는 말이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "그래. 물론 임무 상황이 바뀌었으니 팀도 다시 구성해야겠지. 그러니 너네한테 참여를 강요하는 건 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그렇게까지 말했는데, 우리가 안 갈 수가 있나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그래, 도우려면 끝까지 도와야지. 그런데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "비그나, 넌 콘서트 가야지? 넌 빠져도 되니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "뭐, 콘서트?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "……네, 몇 시간 뒤면 시작해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "그래, 그럼 비그나는 참가 안 해도 돼. 일단 콘서트 보러 가",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "……아니에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "저도 임무에 참가할래요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "아니야. 그닥 위험한 임무도 아니고, 비스트에 리더 몇 명 추가됐을 뿐이잖아. 우리끼리 해결할 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그래, 네가 정말 좋아하는 밴드잖아. 걱정 말고 갔다 와.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "하지만……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "비그나, 마음만 받을게. 정말 그럴 필요 없어. 넌 이미 임무를 완수했으니, 마음 놓고 원하는 걸 하러 가면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "……알겠어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리드 보컬",
      "text": "다들 준비됐습니까?!!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "관중들의 환호성",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리드 보컬",
      "text": "오늘 밤은 신나게 놀아보자고!!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "오!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "역시 현장 분위기는 스크린이랑 완전히 다르네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "두 분도 데리고 와서 보여줬어야 했는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "두 분은……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "하하, 난 됐어. 난 록은 너무 시끄러워서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "나도 비슷해. 하지만 우리, 비그나의 콘서트를 위해 우리 둘 다 조금은 노력하자고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나, 콘서트 안 늦었지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "하아, 됐어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "관객A",
      "text": "야, 뭐 하는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "관객B",
      "text": "밀지 마세요, 아가씨! 왜 나가려는 거예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "비켜요, 비켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "관객C",
      "text": "내 팝콘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "앗, 죄송합니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "어머, 비그나, 왜 이렇게 빨리 왔어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "밤새 콘서트 한다고 하지 않았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "두 분은요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "후방 지원 오퍼레이터",
      "text": "두 분?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "오늘 같이 임무를 수행한 분들이요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "이 비스트들, 진짜 교활한 녀석들이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그러게. 우리의 위협을 알고 숨은 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "이 녀석들, 괜히 이 일대에서 이렇게 오랫동안 기승을 부릴 수 있었던 게 아니었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "어떡하지. 다른 팀한테 돌아가서 지원 좀 보내달라 하라고 해볼까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "다시 찾아보자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "비그나 앞에서 큰소리쳤는데, 지금 가면 너무 쪽팔리지 않을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그러게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나는 진짜 좋은 아이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나처럼 이렇게 활발한 살카즈는 본 적이 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "뭐야, 살카즈 무시하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "뭐래? 허튼소리 하지 마. 로도스 아일랜드에서 이렇게 오래 지냈는데 누가 살카즈한테 편견을 가지겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그러게, 난 너한테 편견이 있었나 보다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "넌 좀 맞아야겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "그래 그래, 내가 잘못했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "나도 비그나가 너무 좋아. 우리까지 콘서트에 데리고 가려고 하고, 임무도 따라오고 싶어 했잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "비그나는 활기차면서도 책임감이 있어. 그건 쉬운 게 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "하지만, 이렇게 착한 아이가 하고 싶은 일을 하게 해주려는 것도 우리가 노력하는 이유니까 쓸데없는 소리 그만하고 빨리 찾자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "어째 좋은 말은 네가 다 하는 거 같다?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "응? 9시 방향에 움직임 확인.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "도망가는 소리야. 쫓아가는 소리도 나는 것 같은데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "혹시 다른 팀인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "가보자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "에이, 분명히 이쪽으로 도망치는 걸 봤는데 놓쳐버렸네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "다른 사람도 못 찾았잖아. 짜증 나.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "어? 비그나, 여기 왜 왔어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "아, 여기 있었네요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "인기척이 있길래 와봤지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "콘서트 간다며?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "불안해서 돌아왔어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "에이~ 그건 너무 아깝다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "야, 내 엉덩이는 왜 차?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "말을 그렇게 밖에 못 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "비그나, 정말 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "괜찮아요. 이미 후방 지원 쪽에도 말했어요. 아무래도 전 임무가 더 중요한 것 같아서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "좋아, 그럼 우리랑 한 팀 하자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "비그나, 뒤에 있는 건 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "아, 제 기타에요. 여기다 사인받으려고 했는데, 급하게 오느라 그대로 들고 와버렸네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "알겠어. 네가 쫓아가봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "내가 왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "말실수한 사람한텐 인권이 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그래! 간다, 가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "비그나, 가자. 오늘 밤 이 비스트들을 다 쓸어버리자고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "이쪽이야, 놈들의 소굴을 찾았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "나머지 두 팀에도 신호를 보내서 같이 공격하자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "제가 할게요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비스트 리더",
      "text": "크오오오오!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "내 창을 받아라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비스트 리더",
      "text": "크어어어어……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "처리했어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "잘했어, 비그나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "헤헷.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "이제 진짜 끝났겠지. 일단 여기서 좀 쉬다가 현장 수색하고 돌아가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "그래. 비그나, 너도 좀 쉬어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "비그나, 기타는 왜 꺼내?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "헤헤, 두 분한테도 콘서트를 보여주고 싶다고 했잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "비록 콘서트는 끝났지만, 제 연주를 들려줄 수는 있죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 A",
      "text": "어? 그럼 너무 좋지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터 B",
      "text": "하하, 그럼 다른 사람들도 부르자고. 오늘이 바로 우리의 록스타 비그나의 첫 번째 콘서트니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "헤헤, 준비됐나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "비그나",
      "text": "오늘 밤은 신나게 놀아보자고요!!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
