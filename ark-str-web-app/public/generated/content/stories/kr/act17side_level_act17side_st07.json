{
  "server": "kr",
  "storyId": "act17side_level_act17side_st07",
  "groupId": "act17side",
  "stageId": "act17side_07",
  "title": "연회장",
  "storyCode": "SN-ST-7",
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act17side/level_act17side_st07.txt",
  "sourceHash": "ee03fbdc8fc22a0b4c6ae580bc876a5ce9d3739610543828b7af5b3fbe43f511",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "아, 돌아왔구나.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "헌신해 줘서 고마워. 너한테 있어서 신앙을 배신하는 것이 고통스러운 일이란 건 나도 잘 알고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "하지만 아름다운 미래가 바로 앞에 있어. 이건 허망한 약속이 아니라, 실질적인 구원이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "카르멘 님은 가늠할 수 없는 사람이야. 그분을 속이는 건 큰 의미가 없어. 그분은 곧 진실을 발견할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "너도 티아고한테 고마워해야 할 거야. 우리가 한 이 거짓말은 그가 반드시 재판소의 손에 죽임을 당한다는 것을 의미하는 거니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "……난 바다의 사자를 만나 본 적이 없지만, 떠도는 말에 의하면, 사자는 절대 동족의 요구를 거절하지 않는다고 하더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "그 이유는, 동족의 선택은 반드시 그 종족에 이로운 것이고, 동족의 생각은 반드시 그 종족의 생각이기 때문이지. 우리가 배워야 하는 것도 그 중의 일환인 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "그런 건 티아고 혼자 고민하게 내버려 둬.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "아, 걱정하고 있군. 그럴 필요 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "우리의 선지자, 아마이아 님은 정말 돌아올 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "그녀는 단지 길과 사자, 그리고, 잠들어 버린 도시의 흔적을 찾기 위해서, 우리보다 한발 먼저 바다에 돌아가는 선택을 한 것뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "그녀가 돌아온다면 동포를 돕기 위한 것일 테고, 그녀가 돌아오지 않는다고 해도, 단지 미래를 위해 준비하기 위해서일 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "우린 그녀를 걱정할 필요가 없어. 단지 아마이아 님은 재판소에서 자신의 행방에 대해 너무 많은 관심을 기울이지 않기를 바란다는 정도만 알고 있으면 돼. 그녀가 어디에 있든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "……그럼 우리는 이 이베리아인을 왜 잡아온 건데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "이 이베리아인의 여주인이 카르멘과 모종의 협의를 한 거 같아. 그러니 이 이베리아인은 적이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "하하…… 제발 그런 호칭으로 나와 선생님의 관계를 설명하지 않았으면 좋겠는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "넌 계속 우리를 조사하고 있었지, 아닌가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "난 적지 않은 시간을 들여서, 너한테 우리의 진리를 설명했다. 우린 네가 다치길 원치 않아, 알겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "너희의 위선에 대해서 이미 충분히 알고 있으니, 더 말할 필요 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "……위선? 음…… 넌 아직도 인간 세상의 도덕을 논하고 있군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "일단은 시본, 시테러, 이런 것들이 도대체 무엇인지는 논하지 않을게. 내가 본 것은 이베리아와 재판소에 불만을 품고, 각종 핑곗거리를 대면서 재판소를 해칠 궁리만 하는 녀석들이었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "나는 이베리아인이야. 비록 이베리아에서 생활한 시간이 별로 길지는 않지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "많은 곳을 가봤고, 많은 것들을 봐왔지. 너희 같은 인간은 사실 많아. 게다가 항상 자신들이 특별하다고 생각하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "만일 너희가 말하는 신이 사실이라면, 그렇다면, 음, 무슨 진화하는 숭고함이라든가 생명의 극치라든가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "……그런 것들이 사실이라면, 그 신은 너희 같은 사람은 거들떠보지도 않겠네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "냉정한 마을 주민",
      "text": "너……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "……아니, 네 말이 맞다. 그래서 사자는 연락을 끊은 거야. 오로지 선지자 아마이아 님만이 바다의 언어를 알아듣고, 우리에게 지령을 전달해줄 수 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "(아마이아는 역시 문제가 있어……쳇, 왜 진작에 증거를 못 찾았지?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "(하지만……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "……상황은 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "너희의 그 명흔들은 도시의 핵심구역엔 전혀 접근을 못 하더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "저 시커먼 괴물은 날 수 있을 뿐만 아니라, 무서운 뜨거운 액체까지 내뿜을 수 있군. 명흔이 퍼지는 속도가 놈이 불태우는 속도를 따라가지 못하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "이렇게 가다가는, 징벌군을 저지하고 있는 시테러들이 전부 전멸하고, 그란파로는 재판소의 손아귀에 들어가게 될 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "우린 모두 죽겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "아니, 티아고, 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "적의 발걸음을 늦추기 위해서 희생을 자초한 동포들 얘기를 할 때…… 넌 전혀 슬퍼하지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "다시 말하면, 넌 언제든지 종족을 위해 희생할 준비가 되어 있지 않다는 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "그런 식으로 나한테 말하지 마라, 우린 단지 손익 관계가 일치한 것뿐이야. 난 바다를 품는 것에는 관심 없어, 난 이미 늙었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "……어리석고 고지식한 하등 생물……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "피차일반이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "그리고 자네, 젊은이. 난 진작에 남의 일에 참견하지 말라고 했었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "티아고 씨, 당신은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "너희, 서로 아는 사이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "아니. 늘 예배당에 앉아있던 외지인이다. 난 이곳의 촌장이니, 기억에 남아 있는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "너는 참견하지 말았어야 했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "됐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "우리도 움직여야 하는 거 아닌가? 설마 재판관과 저 괴물을 거느리고 있는 공모자가 내 마을을 흔적도 없이 태우기만을 기다리려는 건 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴팍스러운 신자",
      "text": "그럴 리가. 넌 정말 이 마을에 집착하는군, 왜지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "그란파로는 우리가 몇 세대에 걸쳐서 재건하려던 이베리아의 축소판이지. 이교도, 너희에게 가담한 현지인들한테 물어보면 알게 될 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "티아고",
      "text": "재판소는 많은 것들을 파괴했지. 놈들에게 배로 갚아줄 거다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "나는 스카디지, 이샤-믈라가 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "그럼 이샤-믈라, 이 발음이 뭘 의미하지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "스카디는 알고 있었지만, 감히 대답할 수 없었다.\n글래디아는 그녀한테 괜찮다고, 믿고 싶다고 말했다.\n하지만 이건 일종의 도피일 뿐이었다. 그녀는 이 이름이 무엇을 의미하는지 알고 있었다.\n그것은 심연 속의 대폭발을 의미한다. 피와 살은 암벽에 부딪혀 추락하지만, 오직 의지만은 끝까지 기어 올라가, 바다를 뚫고 나간다.\n그러한 격전 이후, 자기 몸속에 남아 있던 모종의 '물건'을 의미한다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "나에게는 너와 같은 피가 흐르고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "우리가 너의 냄새를 맡은 것처럼, 너도 우리의 냄새를 맡았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "너희는 우리를 찾아내어 죽였다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "우리도 미처 깨닫지 못하였을 때, 우리도 너희를 죽였다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "우리는 바다에 먹이를 준다. 우리의 시체는 바다를 키운다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "이샤-믈라, 우리의 고향은 같다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "재판관! 네가 어떻게 감히 저들과 한패가 된 것이냐?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "뭐, 뭐라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "지금 당장, 내 배에서 꺼져라! 아니면 너는 저놈들과 똑같이 이번 사냥의 사냥감이 될 것이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "잠깐만요, 선장님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "당신은 어떻게…… 그 이름을 아는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "이유를 알려주지. 놈들의 피와 살을 삼키면 우리의 몸은 변하게 된다. 마지막까지 내 손으로 직접 세 자릿수의 생존자를 처형했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "이제 내가 질문을 해야겠군. 난 너의 몸속에 놈들의 피가 흐르고 있다는 걸 냄새로 알 수 있다. 게다가 넌 다른 사람에 비해 더 특별하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "무슨 말을 하는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "내 손을 봐라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "스카디는 아래를 봤다.\n선장의 한쪽 손은 이미 시본의 형태로 변해 있었다. 새로 생긴 물갈퀴는 투명했고, 촉수 형태로 뻗어나가며 끊임없이 움찔거렸다.\n그는 무언가를 억누르려고 노력하고 있었다. 손 위의 그것이 선장의 몸을 교란하고 있다는 걸 알 수 있었다."
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "놈은 내 생각을 갈구하고 있다. 너를 구해주겠다, 너에게 털어놓겠다, 너의 생각을 들려달라라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "당장 내 배에서 꺼져라. 그렇지 않으면 내가 너희들까지 죽일 것이다. 너를 죽여야지만, 내가 인간으로서의 의식을 유지할 수 있으니까…… 당장 사라져라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……우리는 많은 희생을 치러가며 이곳에 왔어. 만일 너에게 정말로 이베리아 영웅의 의식이 남아있다면, 우리에게 협력해야 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……잘 생각해 봐라, 어린 재판관.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "내가 이곳에서 아등바등 버틴 세월은 고향에서 전투에 참여했던 날들보다 훨씬 길다. 네가 과연 이해할 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "1년만 유폐 생활을 해도 인간의 의지는 무너질 수 있다. 넌 우리가 얼마나 많은 세월 동안 파도와 시시덕거리며 살았는지 알고는 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……그……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "7, 8년 전, 내 손으로 직접 마지막 남은 선원 한 명을 처형시키고 바닷속으로 던졌다. 그는 인간의 의지를 유지한 채 죽은 마지막 한 명이었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "이베리아 최고의 선원, 전사, 신념이 굳건한 과학자, 그들이 이 배에서 가장 많이 목격한 죽음은 자살이었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "너는 내가 겪은 것들을 상상도 할 수 없을 것이다. 내 왼쪽 절반의 몸이 내 꿈을 앗아갔다. 수면이 필요 없다는 것은 일종의 고통이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "그리고 이 기나긴 고통 속에서, 내가 유일하게 할 수 있었던 건, 끊임없이 크고 작은 괴물들을 사냥하고, 내 배를 청소하면서 시간을 보내는 것이었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "나와 나의 일등 항해사가 같이 있게 해다오. 너흰, 너희가 가야 할 곳으로 돌아가라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "난 너희한테도 속하지 않고, 바다에도 속하지 않아. 나는 단지 나의 이베리아, '스툴티페라 나비스'의 소속일 뿐이다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "글래디아는 걸음을 멈추었다.\n그녀는 이곳이 왜 이렇게 깨끗한지에 대해 생각하면서, 냄새의 변화에 주의를 기울였다.\n시본, 이곳에는 당연히 시본이 있다.\n하지만, 이런 불순한 냄새가 나는 건 무슨 까닭일까? 그리고, 자신이 줄곧 느끼고 있는 흐릿한 예감은 어디에서 오는 걸까?\n글래디아는 머릿속 기억의 노선에 따라, 계속해서 걸으며 이 배의 깊은 곳까지 갈 수밖에 없었다.\n그 순간 갑자기, 글래디아는 걸음을 멈췄다."
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……60여 년간 해안에 접근하지 않은 이 원시적인 운송 도구에서, 당신은 너무 뜬금없지 않나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "심해 주교.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "한눈에 알아보시네요, 제가 나타난 장소가 그다지 좋은 곳이 아니라서 그런가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "당신은 우리를 따라온 것이군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "아니요, 순서를 말하자면, 제가 먼저 이 배에 돌아왔어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "바다는 저와 교류하고, 저를 받아들이고, 저를 도와주고 있어요. 이 배에 오는 것은 저에게 어려운 일은 아니었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "절 죽이고 싶은 충동을 억누르다니, 대단하네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "이 배가 당신의 원대한 계획에 있어, 매우 중요한 부분이라고 생각했기 때문인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "원하는 게 뭐죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "……당신은 퀸투스를 죽였어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "어머, 왜 눈치채지 못했을까요. 당신 같은 시시한 실험의 쓰레기들…… 미안해라… 동료의 복수를 하려는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "아니요, 오해예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "퀸투스가 좀 성급하게 성공을 추구하긴 했지만, 그 사람의 그런 성격은, 실패를 초래했을 뿐만이 아니라, 그가 여전히 인간이었다는 것을 더더욱 증명해줬죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "그건 그다지 수치스러운 일이 아니에요. 우리의 사고방식으로 생각만 해서는, 영원히 우리가 되고 싶은 대로 될 수 없죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "“육체와 신경의 변화만이 진실이다.” 맞나요, 어비설 헌터스?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "우린 적이 될 필요가 없어요. 전 아무것도 안 할 거거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "결말은 생명이 탄생하는 그 순간에 이미 여기까지 뻗어나갔어요. 무엇도 그 사실은 바꿀 수 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "당신은 고작 몇 마디 쓸데없는 말을 하려고, 힘들게 바다까지 따라온 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "그것에 관해서는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "……당신은 알 필요 없어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "이런 저열한 생물로는 절 막을 수 없답니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "아마이아가 대답 없이 생긋 웃었다. 푸른색 빛이 그녀의 발아래에서 떠오르더니, 곧 복도 전체를 뒤덮어 버린다.\n'명흔'"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……그란파로의 명흔, 함정들, 모두 당신의 작품이었군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "아니요. 당신들은 항상 모든 재난의 씨앗을 심해 교회 탓으로 돌리면서, 이 모든 현상의 배후 진리에 대해서는 생각하려고 하질 않아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "이 아이들은 더 오래전에 그란파로에 이미 존재했어요. 저는 단지…… 저들을 찾아낸 것뿐이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "흥, 상관없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "이곳은 바다의 중앙이에요. 눈에 보이지 않는 것들이 곳곳에 있죠. 이 배는 당신들이 에기르로 돌아가는 데 큰 도움이 되지 않을지도 몰라요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "근데 당신은 정말로 에기르로 돌아갈 계획인가요? 당신은 정말 아주 약간이라도…… 사자들의 말을 들어볼 생각은 없나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "당신은 그 미련한 주교와 별반 차이가 없어 보이는군요. 심지어 그럴듯하게 전투한 적도 없겠죠. 그렇지 않았다면, 당신이 헌터한테 그런 어리석은 말을 할 리가 없잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "아니요. 그리고 모든 헌터가 오만함을 달콤하게 여기지도 않죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "다시 만나요, 글래디아. 절 약간 실망하게 했지만, 괜찮아요. 그래도 돌파구가 있다는 건, 좋은 일일 테니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "무슨 말이죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "다만, 당신의 거취를 결정하고, 에기르의 거취를 결정할 사람은 제가 아닐 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "당신이 제 앞에서 떠날 수 있을 것 같나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "그래요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "(귀가 찢어질 듯한) 크르르르르…………!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "퀸투스 곁에는 사자가 한 명 있었겠죠. 당신은 그 사자와 싸우고, 대화를 나누었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "당신들은 계속 머뭇거렸지만, 바다는 지금껏 멈춘 적이 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "진화를 저지하려 한다면, 에기르가 어리석은 것이죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "거기 서세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "글래-디아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "말 못하는 약한 사냥감은 짐승에 더 가깝죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "빨리 죽으세요, 그래야 제가 그 주교를 찾아가 결판을 낼 테니까요. 물어볼 말이 있거든요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……들리나? 일등 항해사? 사냥감이 울부짖으며, 우리를 부르고 있다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "일등 항해사라고 불리는 괴물이 살짝 고개를 끄덕이자, 머리에 쓴 관이 미끄러져 떨어지려 한다. 그러자 그 괴물은 발톱으로 관을 바로 잡는다."
    },
    {
