      "text": "우오오?! 무슨 일입니까? 왜 다들 갑자기 일어나시고……"
    },
    {
      "type": "dialogue",
      "speakerName": "사가",
      "speakerId": "char_362_Saga",
      "isRemote": false,
      "text": "……하늘이?"
    },
    {
      "type": "dialogue",
      "speakerName": "라이",
      "speakerId": "avg_npc_139",
      "isRemote": false,
      "text": "날이 밝았……?"
