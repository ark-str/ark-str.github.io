      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "isRemote": false,
      "text": "……이, 이게 어떻게 된 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "isRemote": false,
      "text": "왜 태양이……"
