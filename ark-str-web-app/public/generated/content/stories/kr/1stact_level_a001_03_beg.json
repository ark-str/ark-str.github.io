{
  "server": "kr",
  "storyId": "1stact_level_a001_03_beg",
  "groupId": "1stact",
  "stageId": "a001_03",
  "title": "뜻밖의 여정",
  "storyCode": "GT-3",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/a001/level_a001_03_beg.txt",
  "sourceHash": "7ab777c83a6054387888ac26f75939e898da524f11e047fc1f5c4cd131f84480",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "큭……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "너, 너냐! 내 동료들을 다 해치워버린 게?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "……오, 오지 마! 제발!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "내, 내 금화를 다 줄게! 무기도 다 주마! 네가 필요한 건 모두……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그 여자애, 어딨어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "무슨 소리야……??",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "다가오지 마……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "이 괴……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "맑음 / 가시거리 14km\n타라트산 부근 산림"
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "……이 바위는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "너희, 따라와라. 발밑을 조심해. 내 발자국을 밟고 와라. 절대 아무 것도 만지지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "이 숲은 너희 상상보다 훨씬 위험하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "돌에 뭔가 적혀 있었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "이건 바운티 헌터가 남긴 암호다. 여기에 적힌 대로 움직이지 않으면 함정에 걸리게 되지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그럼 함정을 피하면서 나아간다는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "그래, 내 움직임을 봐라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "……로프와 베어 트랩을 조합한 것이군. 낡아빠진 장난감이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "게다가 여기에는 나무 뒤에 해머가 숨겨져 있다. 아무것도 모른 채 나아가면 직격당하겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "거기, 클로어 아가씨. 조심해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "아… 네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "그 한 발자국 앞에 꼬챙이가 가득 박힌 구멍이 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "앗……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "역시 바운티 헌터야. 전부 간파하고 있는 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "물론이다. 난 예전에……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "함정을 전부 피해서 가는 건 현실적이지 않군. 역시 모두 해제하면서 가는 게 효율적이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "이런 함정투성이의 길로 나아갈 거라고는, 다른 바운티 헌터는 생각도 못 할 거다. 그러니 우리에겐 가장 안전한 루트라는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "가자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "멈춰.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "뭔가 이상해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "또 함정이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "아니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "피의 암호다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "\"……괴물?\"",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "무슨 의미지? 이런 암호를 사용하는 바운티 헌터는 못 봤는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "설마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "괴, 괴물이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "오지 마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "역시 너였어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "스카디…… 스카디 맞지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……네가 물방울 마을의 촌장을 데리고 있었구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "앗, 어떻게? 클로어를 아는 거야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그 여자를 넘겨. 지금 당장.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "그라니, 저 여자, 눈빛이 좀 이상해…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그건 좀 어렵겠는데? 일단 이야기를……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "아, 앗?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "으앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이건 경고야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "안돼! 클로어, 밥 아저씨……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "왜 너를 공격하는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "너와 저 여자는 아는 사이 아니었나? 어째서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "지, 질문은 됐으니까! 지금은 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "하아, 하아…… 아직도 쫓아와??",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "그, 그라니…… 더는…… 못 뛰겠어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "저 여자는 정말로…… 괴물같군. 전혀 숨차하지도 않는 것 같은데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "도망쳐봤자 시간 낭비야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "진짜로 날 베려고 하다니…… 아니 근데, 대체 왜 클로어를 찾는 거지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "저 사람의 눈…… 빨개…… 그, 그라니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "아 정말!! 왜 하필 또 이런 일이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "멈춰!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "복병이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'대위'",
      "text": "지금이다! 쏴!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "음?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'대위'",
      "text": "녀석이다! 우리를 습격했던 '액성'이다! 빠, 빨리 사살해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그만해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'대위'",
      "text": "꼬마 녀석이! 무슨 속셈이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "왜 우리를 쫓는지는 모르겠지만, 일단은 내 동료라고!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "'대위'",
      "text": "대, 대체 왜 우리를 방해하는 거냐! 이 빌어먹을 녀석……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "이 틈에 도망치자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "……동쪽으로 돌파한다! 간다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "도망칠 수 있을 거라 생각하지 마라! 이 괴물, 죽어라!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(에기르어) 비켜!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
