{
  "server": "kr",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "가수",
  "storyCode": "SV-2",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "f160e4d13ce6b032cd05d2941ef7a7fa4d0a82445478778fd85b235be1111e93",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "3:23 P.M. 날씨/흐림\n이베리아, 살비엔토"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "지도상의 장소는, 여기가 맞는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……공기의 냄새는, 좋은 편은 아니네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "안녕하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "저기……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "또 다른 남자 주민",
      "text": "(고개 숙인 채 말이 없다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……괴물인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "모두 인간이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(이베리아어)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이젠 이렇게 말하지 않나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(발음이 약간 변한 이베리아어)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……게다가, 난 지금 가수잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "가수는 일 처리를 이렇게 하지 않아. 호세 씨가 말했어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "구십구……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "누군가가 말하고 있어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "구십구.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "어린…… 아이? 아이가 수를 세고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내가 잘못 들은 게 아니야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내 목걸이가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "거기 서!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "어린이 주민",
      "text": "구십구, 구십구……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "넌 도망갈 수 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "어린이 주민",
      "text": "흑…… 흐윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "왜 내 물건을 훔친 거지? 날 여기로 데려오려고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "구덩이 하나에 밧줄 몇 개. 바깥의 그 진흙 얼룩을 한 매복도 이것보단 그럴듯하겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너희들, 나와.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "마침 너희에게 물어볼 게 있으니, 빨리 좀 나와.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "저 여자 수상해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "그러게, 철판, 이런 사람, 나도 처음 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "나도 본 적 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너희들, 말을 할 수 있었네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "당신, 누구지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "떠돌이 가수.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "떠돌이 가수, 뭔지 난 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판, 저 여자랑 얘기하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "얼굴, 낯설어. 차림새, 괴상해. 여기 사람이 아니야. 뭘 하러 온 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "뭐 하나 물어보려고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "너의 옷, 아주 새거네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내 동료를 본 적 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "넌 아주 건장해. 넌 배불리 먹고 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "나보다 먼저 이곳에 왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "너의 가방, 아주 무거워 보여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "악기는 가볍지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "손에 든 것, 아주 이상해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "너희 악기도 비슷하게 생겼어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(하프 줄을 튕긴다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "귀가, 괴로워. 무기야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "아닐 수도 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판, 이 사람, 괴상해. 신경 쓰지 마. 말하기, 너무 피곤해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "벤치, 놔줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "벤치…… 이 아이를 말하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난 이 아일 어쩔 생각 없어. 이 아이가 내 물건을 가져갔어. 아주 중요한 물건이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "물건을 빼앗으러 왔군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "난 단지 내 물건을 돌려받고, 내 말을 알아들을 수 있는 사람을 찾고 싶을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "어린이 주민",
      "text": "흑…… 흐윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "우리 아이, 건드리지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "우리 물건, 빼앗지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "우리 규칙, 깨뜨리지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판, 점점 가까워지고 있어. 뭘 하려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "저 여자 우리 아이 해치고, 우리 물건 빼앗고, 우리 규칙 깨뜨리려고 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "저 여자, 우리 자매인가? 그렇다면, 그녀도 몫이 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "절대 아닐 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……내 말을 못 알아듣는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "다른 사람에게 물어보겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "가지 마.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "잠깐, 철판……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "으악!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "여, 여기 구덩이가 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "나무틀의 구덩이. 까먹었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "어머, 쓸모가 있었네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 A",
      "text": "이방인, 우리 땅에, 들어오면 안 돼!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
