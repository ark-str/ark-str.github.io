    {
      "type": "dialogue",
      "speakerName": "꼬마 주방장",
      "speakerId": "avg_2026_yu_1",
      "isRemote": false,
      "text": "휴…… 그간 수많은 요리를 만들고 수많은 사람들을 만났어."
