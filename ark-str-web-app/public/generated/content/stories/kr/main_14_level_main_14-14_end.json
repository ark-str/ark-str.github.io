        {
          "type": "dialogue",
          "speakerName": "비행선의 '유령'",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "아미야, 네가 찾고 있는 사람들은 전부 죽게 될 것이다."
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……?!"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "비켜주세요."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "당신들……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "비행선의 '유령'",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "감정을 읽는 수고는 덜어주지."
        },
        {
          "type": "dialogue",
          "speakerName": "비행선의 '유령'",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "더 이상은 지나갈 수 없다……"
        },
        {
          "type": "dialogue",
          "speakerName": "비행선의 '유령'",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "아니면 우리의 시체를 밟고 지나가."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "당신들 머릿속의 그 부서진 화면을 봤어요……"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "설마……"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "당신들이 바벨 멤버였다니?!"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
