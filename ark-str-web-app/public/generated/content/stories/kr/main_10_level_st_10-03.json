    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "avg_npc_412_1",
      "isRemote": false,
      "text": "켈시, 설명해 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "speakerId": "char_003_kalts",
      "isRemote": false,
      "text": "……아직 살아 있었나."
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "speakerId": "char_003_kalts",
      "isRemote": false,
      "text": "이번엔 또 뭘 설명해야 하나, W?"
