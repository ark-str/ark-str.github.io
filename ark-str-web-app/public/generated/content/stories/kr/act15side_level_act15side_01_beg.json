    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": "avg_322_lmlee_1",
      "isRemote": false,
      "text": "뭐지…… 방금……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "speakerId": "avgnew_455_nothing_1",
      "isRemote": false,
      "text": "은인님, 조심하세요!"
