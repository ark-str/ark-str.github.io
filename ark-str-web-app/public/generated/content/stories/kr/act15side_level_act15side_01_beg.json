      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "speakerId": "avg_npc_296_1",
      "isRemote": false,
      "text": "잠깐!! 나를 아주 무시하네!? 너희 멋대로 가려고?"
