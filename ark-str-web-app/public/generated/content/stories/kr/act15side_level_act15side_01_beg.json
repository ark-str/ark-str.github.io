    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "speakerId": "avgnew_455_nothing_1",
      "isRemote": false,
      "text": "미안하지만 여기는 통행금지입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "speakerId": "avg_npc_296_1",
      "isRemote": false,
      "text": "그걸 왜 네가 정해!?"
