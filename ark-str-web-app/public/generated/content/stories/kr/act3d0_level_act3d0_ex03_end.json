  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act3d0/level_act3d0_ex03_end.txt",
  "sourceHash": "e17e9350547ad242691334754e2345f55b94e333efc5e5183aab895209ec2e65",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "방금 지진 일어난 거 같지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "어!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "우리 위치 무대랑 엄청 가깝다! 봤어?! 저 방금 D.D.D. 표정 봤어?! 표정 바뀌는 거 어떻게 한 거지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "D.D.D. 무대에서 내려간 지가 언젠데…… 하여간 D.D.D. 만 나왔다 하면 그냥…… 잠깐, 또 지진 난 거 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "어어, 이거 어쩌면 우퍼 스피커 때문일 수도 있어…… 잠깐만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "어…… 어? 너도 느꼈지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "……빨리 가자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "무, 무슨 일인데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "질문은 됐으니까 빨리!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "관중",
      "text": "밀지 마! 좀 비켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "관중",
      "text": "발 밟지 마!! 꺼져!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "관중",
      "text": "사람이 쓰러진 거 안 보여?! 조심해!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "왜, 왜 갑자기 이렇게 소란스러운 거야… 설마…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "……헐, 완전 대박.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "……엠퍼러야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "헤이 가이즈 와썹, 오늘 날씨 죽여주네.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "우와아아아아아아아!!!!!!!!!!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "엠퍼러다! 진짜 엠퍼러가 나타났다!! 우와~~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성 관광객",
      "text": "정신 차려! 지금 지진 신경 쓸 때가 아니라고!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "아, 아냐, 엠퍼러를 봐서, 잠깐만, 내가 조금, 숨이 안 쉬어져서……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "엠퍼러 선생님, 이쪽으로 오시죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "관중 여러분! 뒤로 물러서 주세요! 선 뒤까지 물러서 주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "헤이, 거기 사브라 젊은이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "괜찮으니까 좀 더 가까이 오게 해도 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "하지만 엠퍼러 선생님, 잠시 후 또 공연이 있는데 만약에 사고라도 일어난다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "사고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "총격, 암살, 납치, 자살 위협, 사고라면 이런 것들?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "그런 것들이 뭘 막을 수 있지? 날 막을 수 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "노우, 그것들도 내 무대의 일부분. 마치 언어의 의미가 리듬에 풀리듯. 알겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "모, 모르겠습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "바꿔 말하면 이것도 하나의 연출이라 이거지. 긴장 풀어, MSR은 너희가 실수해도 절대 책임을 묻진 않을 테니.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "엠퍼러!! 엠퍼러!! 엠퍼러!!"
    },
    {
      "type": "dialogue",
      "speakerName": "관중",
      "text": "엠퍼러!! 엠퍼러!! 엠퍼러!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "요, 드디어 왔어 그럼 서둘러, 긴장 풀어, 좀 더 대담하게 너 자신을 믿어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "컬럼비아의 랩 갓은 개뿔, 너, 너는 그냥 깡패일 뿐이야! 그냥 재수 좋게 얻어걸린 행운아가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "메킷 라우더 브로, 큰 소리로 말해봐! 헤이, 사브라인, 저 사람 쫓아내지 말아봐. 일단 묻고 저 사람한테 마이크 넘겨 봐. 당황하지 마, 여긴 다 내 말 들으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "넌 우리 인생을 망쳤어. 그런데도 넌 잘 나가고 있고, 너…… 너는 죽어야 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성 관광객",
      "text": "꺄아아악!! 저 사람 크로스보우 꺼냈어! 빨리 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "내 탓이 아니야. 맞아. 다 네 탓이야…… 너의 랩 제국이 얼마나 많은 가수의 희생으로 세워졌는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "뭐가 엠퍼러냐! 엿이나 먹어라, 이 비열한 펭귄 놈아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "워워워, 한 번 생각해보자구. 시답잖은 잔재주 부리는 건 대체 누구? 미디어 매수, 여론 조작, 인신공격, 그리고 총살, 게스 후?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "하수도 쓰레기 더미 한 바퀴 구르면 못 알아볼 줄 알았니 그 와꾸? 애꿎은 젊은이들 향해 돌린 총구, 투두두두 갈겨대니 이제 좀 만족하니, '가수'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "너……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "혹시라도 내 눈에 체킷아웃 안 됐다면은, 너흰 분명  '제낄라고' 했겠지, 띠꺼운 신인 래퍼들을.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "니넨 욕조에 쌓아놔 애들 재끼고 주은 지폘, 그런 주제에 또 혐오하니 컬럼비아 전첼?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "닥쳐! 죽어버려!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "빨리 엠퍼러 선생님을 지켜라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "엠퍼러 선생님이 총에 맞았다. 빨리…… 어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "아니다, 엠퍼러 선생님이 총으로 저 녀석의 크로스보우를 날려버린 거다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "깜짝 놀라 라타타탓! 빵!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "이상하지 말은 내가 더 많이 했잖아, 근데 왜 내 총구에서 연기가 날까? 허?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "배짱이 없었나? 아니면 내가, 눈부시게 빛나, 잠깐 눈이 멀었나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "큭…… 윽…… 총을 갖고 있었다니…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "꼬우면 니도 매일 여러 번 죽어봐, 그럼 생길 거야 무기 휴대 습관.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴상한 표정의 관광객",
      "text": "콜록…… 내가 혼자 왔을 거라 생각 마라! 네가 과거에 만든 적들을 생각해봐. 너는 이 시에스타에서 절대 나갈 수 없어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "내 과건 겁나 넓어 이 허구의 바다보다 더, 네가 말한 적은 어느 구석에 박혀있지 또?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "엠퍼러 선생님! 관중 속에 저놈의 동료가 많이 뒤섞여 있습니다. 저희 쪽에선 처리가 어렵습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "테이킷 이지 당황하지 말어. 너희는 그냥 잘 지켜 여기 현장 질서. 이제 남은 건 프로에게 맡겨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "댓츠 롸잇 프로페셔널스. 예를 들면 라잌 펭귄 로지스틱스.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "……우리 원래 휴가 나왔던 거 아이가? 시작하기 전에 미리 물어보고 싶은데, 휴일근무수당은 주는 거 맞제?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "호텔에 그렇게 오래 있었으니, 적당히 몸 좀 풀어주는 것도 나쁘진 않겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그건 텍사스가…… 아니, '소라' 네가…… 계속 호텔에서 책만 읽어서 그런 거잖아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……그래, 그것도 약속한 것 중 하나였지. 전투할 때 제대로 반응할 수 있겠어? 텍사스?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "문제없어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "보스, 여기는 전부 처리했어! 내일 공연 티켓은 맨 앞자리로 끊어주기다?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "보디가드",
      "text": "엠퍼러 선생님, 이, 이 사람들은 대체?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "우리는 그냥 보스의…… 아니, 엠퍼러 선생님의 개인 보디가드라고 생각해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "뭐… 물류 회사긴 하지만서도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "원래 우리 사업 스펙트럼이 좀 많~이 넓거든. 얼마 전에는 재즈바도 하나 샀다 그러지 않았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "맨날 샌드백 취급당하던 시라쿠사의 깡패 조직들, 요즘엔 너무 조용해서 뭔 일 있나 싶다니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "우리가 용문에서 한 달에 몇 번을 싸우는지 알기나 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "싸우는 건 우리가 프로페셔널. 절대 따라잡을 수 없어 넌.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 관중",
      "text": "이 순간을 기다렸다! 웨스트코스트의 펭귄! 떳떳한 척한다고 대놓고 나타나다니, 여기가 네 무덤이다!!",
      "portraitKey": null
