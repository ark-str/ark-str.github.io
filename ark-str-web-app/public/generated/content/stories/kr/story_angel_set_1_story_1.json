{
  "server": "kr",
  "storyId": "story_angel_set_1_story_1",
  "groupId": "story_angel_set_1",
  "stageId": null,
  "title": "보내온 편지",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_angel_1_1.txt",
  "sourceHash": "e11115bf8282ecf6235169668d12a29b900185b6cc8bce6791c52dcc1e3a4b14",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 能天使"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "탕탕탕!\n파팟! 타앙!\n두두두두! 퍼엉!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "슈슈슉! 콰쾅!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "최후의 1인, 최후의 고무탄! 이거야말로 오염도 낭비도 없는 친환경, 에너지 절약 아니겠어? 어떻게 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아직까지 쫓아오다니, 너무 끈질긴 거 아냐? 물건은 나한테 없다고 했잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴한",
      "text": "젠장, 친환경? 지금 장난해?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "눈치챈 거야? 어쩔 수 없지, 너흴 해치우는 건 따분할 정도로 쉽단 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "좋아. 이제 게임 끝이야! 이봐, 할 말 있으면 지금 하는 게 좋을 거야. 더는 기회가 없을 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴한",
      "text": "오, 오지 마! 저리 가!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "3, 2, 1. 땡!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "파앗! 잘 가!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "괴한",
      "text": "헉, 으윽!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "명중!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "역시 나라니까, 정확하게 맞췄어. 흐흥~ 그런 의미에서 오늘은 애플파이를 한 조각 더 먹어야지! 내게 주는 상이랄까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그럼 이제…… 일이다, 일!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으음, 오늘의 마지막 주소는…… 센터 스트리트 12-7번지, 아초이 반점……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……앗, 미안, 어디 다친 데 없어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "행인",
      "text": "괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "행인",
      "text": "아초이 반점을 찾는 거라면 저쪽이에요. 반대로 오셨어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "앗, 정말이네…… 알려줘서 고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "행인",
      "text": "별말씀을. 같은 지역 출신을 만나 반가웠어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(라테라노 사람? 전달자 같은데……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(편지……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(……서우인 전에 집으로 편지 보내는 것도 나쁘진 않겠어.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "기지에 편지지 정도는 있겠지. 으음…… 특산물을 같이 보내는 것도 좋을 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "일단 일부터 하자, 일! 아초이 반점이라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "찾았다, 여기구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "저기, 누구 있어? 펭귄 로지스틱스에서 왔거든……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "누구…… 아악! 어, 어떻게 된 거예요? 이, 이 사람들…… 전부 죽었나요?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "헤헤, 별거 아니니 신경 쓰지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "펭귄 로지스틱스의 특급 택배 서비스야. 재건축 지역 특별 서비스로 오늘부터 사흘간 배송료가 50% 할인이거든! 주문한 게 이거 맞아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "……택배요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "잠깐, 제대로 배달된 거 맞아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "물건을 주문하긴 했지만, 주문한 지 몇 시간도 안 됐는데 벌써 도착했을 리가 없잖아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그건 아니지. 몇 시간 전에 주문했으니 당연히 상품이 배달되어야 하는 거 아닌가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "우리한텐 스피드가 생명이라구!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "확성기, 조명, 그리고 화환. 오올~ 신장개업이라도 한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "아, 네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "축하해~ 자, 주문한 상품! 어때, 문제없지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "확실히 제가 주문한 상품이랑 같기는 한데 ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "설마 정말로?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "틀림없을 거야. 도시 내 배달은 식은 죽 먹기거든. 길가에서 소란을 피우던 녀석만 아니었어도 더 빨리 끝낼 수 있었는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "뭐라고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "크흠, 아무것도 아니야! 신경 쓸 거 없어! 문제없으면 사인 좀!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "아, 네, 사인……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "오케이, 배달 완료!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "안녕~! 평점은 높게 부탁해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "이봐요, 잠깐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴한",
      "text": "윽, 크헉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "하아, 정말이지 요즘 여자들이란……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "평범한 용문 주민",
      "text": "어쨌든 자기가 가져온 “쓰레기”는 치우고 가야 할 거 아냐……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으음…… 마지막 배달도 끝!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이렇게 해서 오늘 일도 다 끝났네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "여어~ 텍사스, 크루아상! 너희 쪽 일은 끝났어?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "응, 전부 배달했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "보스가 찾던 물건도 찾았다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "경쟁자가 으마무시하게 많았지만 내가 다 처리했다 아이가. 그냥 상자 같아 보이는데, 어따 쓰는 건지도 모르겠다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "설마 무슨 위험한 건 아니겠지? 뭐 상관없어. 말썽 피우는 녀석들은 해치워 버리면 되니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "오~케이! 슬슬 마무리해 볼까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "괴한",
      "text": "머, 멈춰……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "엑시아, 여긴 네 담당이지? 저 녀석, 아직도 숨이 붙어 있잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "시내에서는 실탄을 쓰면 안 된단 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "마피아 쪽 녀석은 아닌 것 같은데…… 규정을 어겨서 체포되기라도 하면 귀찮아진다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "게다가 이번에는 재건축을 도우러 온 거잖아. 사고 치지 말라고 해서 일부러 급소는 피했다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "하긴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "목숨만 남겨둬. 나머지는 이곳 주민들이 알아서 하겠지. 별일 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "지난번에 엑시아 언니야가 실탄 썼던 게, 로도스 아일랜드 파견 임무 때였제?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "그때 진짜 끝내줬다 아이가. 보스가 로도스 아일랜드에 꽤 호의적이었지. 장기적으로 협력할 생각도 한 거 같드만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아마도 그런 것 같아. 재미있는 녀석들이라 보스가 마음에 들어 할 만도 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "시끄러울 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "헤헤, 그래서 보스가 마음에 들어 하는 거잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "맞따!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "근데 파견 임무는 듣자 하니 꽤 성가신 일 같드만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "발에 땀 나도록 돌아다니는 것뿐이야, 예전에 했던 일이랑 비슷해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "월급이랑 야근비까지 나와서 제법 쏠쏠했지. 게다가 보스가 주는 보수까지 합치면 두 달 치 월급은 충분히 될 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "진짜가? 두 달 치?! 그러니까 이번 부수입까지 더하면 이번 달은 이 정도 벌 수 있단 거제?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "나도 갈란다! 엑시아 언니야, 다음에는 내도 델꼬 가래이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하하, 그렇게 말할 줄 알았다니깐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……이런! 시간이 벌써 이렇게 됐잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "서둘러, 텍사스! 속도 최대로 올려. 최대한 빨리 기지로 돌아가야 해, 안 그러면 늦을지도 몰라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "타, 벨트 매고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "잠만 잠만! 됐다. 제대로 맸으니 출발하자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "와이래 서두르노…… 에이, 텍사스 언니야, 뭔 일로 이래 서두르는지 물어보지도 않나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "어차피 별일도 아닐 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "뭐, 하긴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "대놓고 까기 있어? 나 엄청 진지하다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "빨리 안 돌아가면 오븐에 넣어둔 애플파이가 타버린다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "대체 뭐가 진지하단 거고! 아, 아아아~! 텍사스 언니야, 급가속하면서 코너 돌지 마라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "느려 터져가지곤!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "대앰! LP판 세 장을 다 들었네 니 기다리는 동안. 발에 껌 붙어서 노래라도 불렀니 휘바휘바? 아님 대체 왜 늦는데, 벌써 눈에 왔니 노안? 물건 하나에 이 정도 걸리는 거 진심 에바.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "앗, 다행이다. 애플파이는 무사해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으음, 맛있는 냄새! 온도 조절도 괜찮았어. 완벽해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "헤이! 유노와람쌩?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "우리도 미친 듯이 밟아서 돌아온 거데이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "교통경찰한테 안 걸려서 다행이지, 안 그럼 기지로 날아온 벌금 고지서만으로도 텍사스 언니야 이번 달 월급은 다 날아갔을 끼다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "맞아! 텍사스는 월급이 날아갈 위험을 무릅쓰고 왔는데 그만 툴툴거리라구.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "텍사스, 말해봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "보태줘 너희 힘을, 혼내줘 저 멍청이들.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "쳇, 재미없긴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "느려 터진 너희들, 참아야지 내가 늘, 저스트 라잌 중대장의 실망감, 낫 어 스페셜 뉴스! 그래서, 내가 말한 물건은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "여기.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "헬 예 댓츠 마이 걸! 엑시아, 내 전용 의자 좀 가져다줘. 최신 전자 고글도 같이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "자자~ 대령했습니다요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이번엔 또 뭐야? 윽…… 엄청 무거운데 안에 뭐가 들어있는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "어! 옆에 붙어있는 이 상표, 이 조이스틱 형태, 본 적 있는 것 같다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "설마 이게 시장에서 완전히 자취를 감췄다는…… 아주아주 오래전에 유행했다는 그 게임기? 이거 구할라고 엄청 큰돈을 쓴 사람이 있다는 이야기도 들은 적 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "게임! 우리 삶도 마치 게임과 같지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "텍사스, 선 꽂아 봐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "이건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "엇, 화면이 떴어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으응? 횡스크롤 레이싱 게임 같은데…… 방향키, 가속키……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "마지막 이 버튼은, 으응? 폭탄인 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "폭탄이라 카기보다는 뭐랄까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "오리지늄 폭발물 발사체야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "역시!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "잠만! 이거 장애물 피해서 결승점에 도착하는 레이싱 게임 아이가. 어째서 오리지늄 폭발물 발사체 같은 게 장착된 거고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "스튜핏! 달리면서 장애물을 피해, 도착해야 한다고 엔드 라인에? 누가 그렇게 얘길 해 대체?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "알았다, 그러니까 이렇게 쭈욱 달려가면서 길을 막는 녀석들을 전부 날려버리면 되잖아! 이 게임, 멋진데! 규칙도 엄청 쉬워서 마음에 들어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "조작도 쉬워 보이는데. 아, 둘이 같이하면 재미있겠다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "보스, 나랑 한 판 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "감히 내게 챌린지? 이건 너무 뻔한 아이스버킷 챌린지! 너는 맞지 않아 나와의 눈높이! 뻔하게 보이지 너의 패한 모습이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엠퍼러",
      "text": "텍사스, 네가 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "좋았어, 탄약도 채웠으니까 이제 내 실력을 보여주지!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "앞에 있는 건물을 날려버리다니, 역시 엑시아 언니야 답네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하하하! 이 정도로 놀랄 것 없어. 이번 판은 내가 이겼다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "허점 발견!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "(반대편 차선을 향해 폭발물을 발사한다.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "와앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "상대 트랙을 공격할 수도 있단 말이가?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "안 된다고 한 적 없잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "확실히 그렇게 얘기한 적은 없지! 그렇게 나온다면 나도 가만히 있진 않겠어, 뭐라 하기 없기다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "눈에는 눈, 이에는 이, 받은 만큼 돌려줄게! 도망칠 생각하지 마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "쳇!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "오오, 다른 상대를 직접 공격하는 것도 가능하네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "안 된다고 한 적 없다고 하지 않았어? 헤헤, 이 기세를 몰아서!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "어? 누가 왔나 본데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "모두들 안녕~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "뭐 하고 있어? 함성 소리가 들려서 깜짝 놀랐다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "어, 소라 아이가! 일로 온나, 앉아라. 엑시아 언니야, 텍사스 언니야랑 게임하고 있던 참이다. 보스가 구해온 고전 게임기인데, 우리 먼저 한 판 하게 해줬다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "같이 할래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "게임? 난 됐어, 이런 건 잘 못 해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "참, 우편함에 들어있던 편지를 가져왔어. 이번 달 고지서도 잔뜩이던데, 이렇게 지내도 정말 괜찮은 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그리고…… 이거, 엑시아 앞으로 온 편지도 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "나한테? 고지서인가, 아니면 도전장?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "헉, 설마 학교에서 추가로 발급한 졸업장은 아니겠지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "에엥? 엑시아 언니야는 졸업장도 없나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그럴 리 없잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "지난번에 마피아를 상대하다가 보스가 준 위조지폐랑 위조 서류랑 같이 실수로 다 태워버렸거든. 헤헤.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……조심하라고 했잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그랬나? 미안, 전혀 기억나지 않아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "엑시아 다운 일을 한 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "하지만 이건 평범한 편지 같은데? 아까 말한 그런 건 아닐 거야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그거야 모르는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "자, 크루아상! 조이스틱 좀 받아 봐. 나 대신 플레이해 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "오케이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "음, 어디 보자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……엇, 언니가 보낸 거잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그러고 보니 낮에 라테라노의 전달자를 확실히 만나긴 했었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "와아, 뭐가 이렇게 길어?! 언니는 아직도 내가 걱정되나 보네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "엑시아의 언니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "잠깐, 하지만 네 언니는 사고를 당해서…… 엑시아 네가 모스티마를 찾아 용문까지 쫓아갔다고 들었는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "응? 그거 맞는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "언니는 몇 년 전, 임무 수행 중 사고를 당하는 바람에 오랫동안 혼수상태로 병원에 입원해 있었어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그럼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하지만 내가 라테라노를 떠나기 전에 언니는 깨어났지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "응? 왜 그래, 소라? 무슨 보스가 콘서트에서 디스코 추면서 발라드 부르는 꼴이라도 본 것처럼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "예를 들어도 왜 하필 그런 걸, 너무 끔찍하잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아…… 아냐, 아무것도. 신경 쓰지 마. 진심으로 널 걱정했던 내가 너무 멍청했다 싶어서 그런 것뿐이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으흠, 그러니까…… 설마 그동안 뭔가 오해한 건 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "으으……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "에엥? 정말이야? 아니지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "당시 언니 상태가 안 좋았던 건 사실이야, 하지만 지금은 점점 회복하고 있어. 안 그랬다면 언니를 혼자 두고 나올 수 없었을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……그것도 그렇네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그렇지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으음…… 그래도 오해할 만도 하네. 확실히 그때는 정말 위험했으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "나도 언니가 그렇게 심한 부상을 입을 줄은 몰랐어, 온몸이 피투성이가 된 것도 모자라 의식마저 없었지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "피투성이?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "진짜야, 평소 우리가 떠들어대는 것보다 훨씬 심각했다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "난 그래도 제법 겁이 없는 편이라고 생각했는데, 그땐 정말 놀라서 식은땀을 줄줄 흘렸었지. 지금도 그때 생각하면 몸에서 피가 빠져나가는 것 같다니까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "농담이 아니라, 어떤 상황인지 파악도 못 했는데 하마터면 언니를 데려다준 녀석한테 달려들어 한판 붙을 뻔했다니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "상상이 되고도 남아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그런데 네가 말한 그 사람, 설마…… 모스티마인 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "맞아, 바로 그 녀석이었어. 언니를 데려다준 뒤에 어딘가로 사라졌지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "언니는 의식을 되찾았지만, 당시에 어떤 일이 있었던 건지 아무 얘기도 하지 않았어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "뭐가 뭔지 모르는 상황을 도저히 못 참겠더라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그래서 그때 있었던 일을 확실히 밝혀내려고, 모스티마를 따라 라테라노에서 용문까지 달려가던 중에 보스랑 만난 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "아…… 난 또……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "이곳에 들어온 이유랑, 모스티마에 대한 이야기를 꺼낼 때마다 머뭇거리길래, 둘 사이에 뭔가 엄청난 원한이라도 있는 줄 알았지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "모스티마가 주말마다 언니를 데리고 야근하는 바람에 언니와의 약속이 취소된 것도 원한이라면, 확실히 엄청난 원한이라고 할 수 있겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "뭐가 그렇게 유치해?! 무슨 초등학생도 아니고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "으음…… 안 되겠어, 엑시아의 언니가 어떤 사람인지 전혀 상상이 되지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "엑시아 너 같은 사람이 둘이나 있다니, 상상만 해도 머리가 아픈걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하하, 잘못 짚었어. 나랑 언니는 정말 하나도 안 닮았거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "응. 왜냐면 우린 피를 나눈 자매는 아니거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "엣?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "그런 거였나?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "맞아…… 잠깐! 크루아상, 넌 왜 듣고 있는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "엑시아 언니야가 하도 자기 이야기를 안 하니까, 나도 모르게 그만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이야기를 잘 안 하는 편이었나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "앗, 잠깐! 넌 한눈팔지 말고 화면 보란 말이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "늦었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "내가 이겼다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "앗, 텍사스 언니야! 고새 추월하다니, 너무 치사하다!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으아아…… 져버렸네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(모두들 엄청 궁금한가 보네.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(그건 그렇고 언니에 대한 이야기를 꺼낸 적이 없었던 건가?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(그것도 그럴 수밖에, 아무도 물어보지 않았으니까……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(그나저나 모스티마는 왜 아직도 감감무소식인 거지? 보스가 날 속이는 건 아니겠지?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "(……뭐, 됐어. 될 대로 돼라지! 어쨌든 답장부터 쓰자……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으음, 오랫동안 보관할 수 있으면서도 잘 부서지지 않는 간식 같은 게 있을까나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "어, 엑시아? 어디 가? 게임 안 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "응, 너희끼리 해. 나가서 특산물 좀 사려고, 금방 돌아올게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "저녁때 한 판 더 붙자, 텍사스! 방금 대결은 무효야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "헤헤, 두고 봐. 다음엔 내가 반드시 이길 테니까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
