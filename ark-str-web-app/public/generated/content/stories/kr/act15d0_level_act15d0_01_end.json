{
  "server": "kr",
  "storyId": "act15d0_level_act15d0_01_end",
  "groupId": "act15d0",
  "stageId": "act15d0_01",
  "title": "밀회",
  "storyCode": "MB-1",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act15d0/level_act15d0_01_end.txt",
  "sourceHash": "3d4505d4cdef64c8fc6c965eded070144958e7be5f3a0f779df4211d351514e1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "이거나 먹어라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수",
      "text": "큭, 젠장……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "우왓! 뭐, 뭐야 이거? 왜 갑자기 싸우기 시작하는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "카프카, 잘 숨어 있으라고 했잖아. 왜 쫓아왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카는 괜찮으니까, 어서 설명이나 해줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "딱 보면 몰라? 감염자와 비감염자가 서로 눈에 거슬려 하는 건 흔한 일이잖아. 그래서 둘로 갈라져 싸우는 거지 뭐겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그게 흔한 일인 건 맞지만, 그럼 교도관들은?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "저기다, 네가 직접 봐라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "하핫, 역시 죄수들 싸움 구경이 제일 재미있다니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "오늘 당직은 편하게 돈 벌겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "하하, 그러게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "이 빌어먹을 곳에서 일하는 유일한 낙이라니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "힘내, A 구역! 난 너희한테 걸었으니까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "봤지? 저 자식들이야말로 이 싸움을 가장 즐기는 놈들이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "이기는 쪽은 한동안 식사가 좀 더 좋아지기도 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그럼 즐거움을 몽땅 녀석들에게 빼앗기는 거잖아, 안 싸우면 안 돼?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "안 싸운다고? 카프카, 내가 감옥에 어떻게 들어왔는지 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "날 무시하는 저놈들을 한 대 때렸기 때문이었어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "이 감옥은 아마 감염되지 않은 그 잡놈들을 처치해도 뒤탈이 나지 않는 유일한 곳일 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "싸우다 상대를 죽여도 한동안 감금 처벌받으면 그만이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "싸우다 죽으면 그냥 죽는 거야, 감옥에 들어오는 사람 중 누가 그런 걸 두려워하겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "이야기는 이쯤 하지. 난 가서 계속 싸워야 하니까, 넌 잘 숨어 있어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "쳇, 카프카를 너무 얕보는 거 아냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그런데 감염자와 비감염자 간의 갈등은 이곳에도 존재하는구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그냥 존재하는 게 아니라, 완전히 왜곡된 모습으로……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "밖에서도 여러 일을 겪어봤지만, 이런 광경은 처음이야…… 사일런스가 봤다면 아마 못 견뎌 했겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "하지만 카프카는 다르지, 헤헹~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카는 혼란스러워질수록 더 좋더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "싸울 사람들은 싸우라고 놔두고, 카프카는 얻을만한 게 없는지 좀 봐야겠어. 뒷일에 대비할 것도 준비하고 말이야……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "어라, 누가 다 먹지도 않은 밥을 몰래 가져왔지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "웬 양말이 한 짝만 있는 거야……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "역시 관청의 감옥답네, 할 건 하잖아? 바로 사용할만한 게 없나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그런데……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수",
      "text": "죽어라, 이 잡놈아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수",
      "text": "너나 죽어 이 자식아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "오오, 정말 치열한데. 죄수 선배들도 정말 대단하네, 온갖 이상한 무기를 몰래 만들어 놨잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "더 거칠게 싸워서 카프카한테도 물건 좀 떨어뜨려 달라고~ 헤헤.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수",
      "text": "나도 떨어지는 것 좀 주워보자, 헤헤헤……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "앗, 저 여자애가 위험해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "여자애를 도와줘야겠어……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수",
      "text": "헤헤……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "어라, 저 여자애는 한 손을 숨기고 있는 것 같은데, 재밌네……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "무슨 일이야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "발톤 대장님께 보고드립니다. 죄수들이 싸우기 시작했습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "그런데 니들은 멀뚱멀뚱 지켜만 보고 있었어?!! 어?!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 B",
      "text": "아, 대장님, 슬슬 때가 된 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "때가 되고 안 되고 가 어딨어! 죄수를 관리하는 게 바로 우리 교도관의 직무 아니야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "네, 알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "교도관 A",
      "text": "어이 너희들! 대장님이 말씀하시잖아, 멈춰!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수들",
      "text": "저 *컬럼비아 비속어* 들 언제 한 번 *컬럼비아 비속어*져 놔야 되는데 저거……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "A 구역 죄수들",
      "text": "*컬럼비아 사투리*이나 까잡숴, 니*컬럼비아 사투리*럴……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "어이, 내가 몇 번이나 말했나! 여긴 감옥이지, 너희들을 위한 전쟁터가 아니라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "이곳에서 열심히 일하고, 성실한 태도도 보여야 밖에 있는 가족들 친구들도 빨리 만날 거 아니야, 그래 안 그래?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "이게 다~ 너희를 위해 하는 소리라~ 이 말이야……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "쳇, 또 시작이네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "와, 몸에 상처 많이 났는데, 괜찮겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "괜찮아, A 구역의 잡놈들을 여럿 쓰러뜨렸는데 이 정도 상처쯤, 별거 아냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "매번 이런 식으로 끝나는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "아…… 발톤 저 양반 말이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "거의 그래. 교도관 대장인 발톤은 매번 이럴 때마다 능청을 떨며 제지하는 척하다가 그럴듯한 말로 마무리하곤 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "특히 지금은 교도소가 도시 가까이에 있는 시기라서 교도소장이 없다 보니, 지가 무슨 이 감옥의 주인인 것처럼 굴고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "못된 놈이야 아주.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "하지만 매번 그랬냐고 묻는다면, 그건 또 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "싸움이 벌어지고 멈출 수 없었던 경우가 여러 번 있었는데…… 아니 멈출 수 없었다고 하는 게 더 정상이지. 오늘처럼 말 한마디에 바로 끝나는 건 드문 일이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "뭐, 싸움을 못 멈추겠다 싶으면, 발톤은 대개 구원병을 보내지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "구원병?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "봐, 왔네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "앤소니?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "아는 척만 한 건 아니었나 보네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "카프카가 본 건 정복 입은 모습밖에 없지만……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "너희 말야, 여기 앤소니 씨를 좀 본받으란 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "죄수 신분인데도 이성적이지, 폭력도 잘 안 쓰지, 평소에 책 읽고, 글 쓰고, 음악 듣는 것을 좋아하지, 봐봐 이거 사람이 얼마나 고상해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "윽.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "앤소니를 안 좋아하나 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "아니 그런 건 아니고, 확실히 알아둬, 카프카.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "이 감옥에서 앤소니에게 불복하는 사람은 아무도 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "앤소니는 평소에 발톤의 말처럼 다른 사람에게 잘해주지만, 우린 알고 있지. 앤소니야말로 이 감옥에서 가장 무서운 자라는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "앤소니는 처음 감옥에 들어오자마자 C 구역의 모든 사람을 굴복시켰다고 들었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "맞아. 그리고 보통 C 구역 사람들은 우리와 접촉은 적지만, 저 녀석은 정말 사람들에게 잘해줘서, A 구역이든 B 구역이든 저 녀석한텐 모두 복종하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "그리고, 내가 토할 것 같은 건 발톤 저 자식의 낯짝 때문이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "들어봐, 저 자식이 정말 앤소니를 칭찬하는 걸까? 사실 모욕하고 있는 거라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "앤소니는 유일하게 저 발톤 녀석을 고개 들지 못하게 하는 상대야. 하지만 발톤은 앤소니에게 의지해 우리를 관리해야 하기 때문에 어쩔 수 없이 저렇게 나오는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "우리 주립 맨스필드 형무소는 수도의 특별 허가 시범 감옥으로써, 앞으로 다른 주에 롤모델로 홍보될 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 B",
      "text": "쳇, 그래봤자 죄수들인데 뭐가 롤모델이라는 건지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "어쨌든, 너희들은 자신을 위해서, 그리고 나를 위해서 생각해 보길 바란다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "발톤",
      "text": "앤소니, 가지. 오늘은 특별히 독서 시간을 한 시간으로 주마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앤소니",
      "text": "네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "평소에는 앤소니를 볼 수 없는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "그렇겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "앤소니와 같은 흉악범은 시간이 우리와 다르게 배정되고, 대부분 C 구역의 탑에 머무르고 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "뭐야, 저 녀석을 만나고 싶은 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "그렇다고 할 수 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카프카",
      "text": "한 가지 상의하고 싶은 게 있거든. 물론, 교도관이 알면 안 되는 그런 일 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "B 구역 죄수 A",
      "text": "그래, 알겠어. 귓속말이라도 하고 싶다 이거지? 여기 있다 보면 기회가 없는 것도 아니겠지만……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
