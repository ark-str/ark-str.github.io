  "sourceHash": "d3bb4a5ffba473fd4c3d47785370b1e2cbd4414857887f490f2a7e145f364ac2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=2>1099년 12월 5일</>"
    },
    {
      "type": "dialogue",
      "speakerName": "부두의 노동자",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "운반할 물건이 뭐지?"
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "와인."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "부두의 노동자",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "화물 운송장 번호."
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "SZ990183."
    },
    {
      "type": "dialogue",
      "speakerName": "부두의 노동자",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "소속 회사명은?"
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "미안하군, 질문을 이해하지 못하겠는데?"
    },
    {
      "type": "dialogue",
      "speakerName": "부두의 노동자",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "당신 차에 실은 물건이 어느 회사 물건이냐고. 이해하기가 어렵나?"
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하하…… 아무래도 일을 시작한 지 얼마 안 된 모양이군. 규칙도 모르고."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "괜찮아, 내가 친절하게 가르쳐 주지. 이럴 때는 공손하게 '어느 패밀리 소속이십니까?'라고 묻는 거다."
    },
    {
      "type": "dialogue",
      "speakerName": "부두의 노동자",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "당신들……"
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "미안한데, 소속 회사명이 뭐야?"
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……살루초 와이너리."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "음…… 됐어. 정보 확인되었으니 통과해도 괜찮아."
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 멤버",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "날 그렇게 쳐다보지 마. 옛날 방식으로 일을 처리하려고도 하지 말고. 위에 있는 표지판을 보라고."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "뉴 볼시니에 온 걸 환영해."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=2>1100년 11월 6일 7:00 A.M.</>"
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "보스, 마침 잘 왔어. 상의할 일이 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "우린 오늘 운행을 하지 않고 캠프 내의 도로를 전반적으로 정비할 생각이야."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "만약 산드로가 또 후진하다가 타이어를 터트린다면, 그건 운이 없다고밖에 못 하겠지. 하하."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그리고 주문한 텐트도 도착했어. 서쪽 출구 쪽에 칠 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "공간이 넓어서 어닝, 정수기, 바비큐 그릴을 놓을 자리도 충분해. 게다가 그쪽은 조용해서 신입 친구들도 더 빨리 적응할 수 있을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "야외 스크린도 하나 더 샀어. 앞으론 캠프에서 즐길 거리가 하나 더 늘어났네."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "나중에 랭크우드의 명작 영화도 좀 빌려오고…… 아, 뭐라고 할지 알 것 같아. 마피아 영화는 뺄게."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그리고, 시청에서 새로운 정착지 건설을 위해 작업에 착수했다고 하더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하하, 그럼 서둘러서 움직이는 게 좋겠네. 늦장 부렸다간 이사 가기 아쉬워질지도 모르니까."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "트럭을 캠프에 세워둘 수밖에 없으니 모두들 트럭에서 지낼 수밖에 없어. 가족들과 함께 살기엔 불편한 게 많긴 하지……"
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "하지만 적어도 더 이상 패밀리 놈들한테 당할 일은 없게 됐지. 이 트럭은 진짜 우리 것이고 모두가 함께 지키고 있으니까. 마음 놓인다고."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "가끔 눈앞의 캠프를 보고 있으면 그런 생각이 들어, 1년 전 이곳이 황무지였다는 걸 누가 믿을 수 있을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그나저나 보스, 왜 어제저녁엔 돌아오지 않았던 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "아, 얘기하다가 정작 중요한 걸 깜빡할 뻔했어!"
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "각 구역의 책임자를 모두 불러줘. 산드로, 긴터, 소머……"
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "소머는 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "응? 오늘 쉬는 날 아니었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "구리의 병을 고치기 위해 하루빨리 뉴 볼시니로 데려오고 싶어 하는 마음은 이해하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "구리는 내 동생이기도 하니 나도 함께 방법을 찾아볼 거라고 한 데다, 무리하지 말라고 몇 번이나 말했었는데."
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "보스, 화내지 마. 아마 보스가 생각하는 그런 건 아닐 거니까."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그 재수 없는 놈은?"
    },
    {
      "type": "dialogue",
      "speakerName": "트럭 기사 B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "걔도 없어. 어젯밤부터 못 본 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "에이레네",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이상하네. 뭐, 됐어. 캠프에 있는 사람들에게 모두 모이라고 해줘…… 라비니아 판사님을 도와서 조사할 일이 조금 있어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "햇살이 눈부시게 비추고 있었다.\n경계선이 쳐져 있었고, 북적였던 길거리는 한산하게 변했다. 바닥의 핏자국과 날카로운 타이어 자국의 흔적이 남아있었고, 경찰은 분주하게 오가고 있었다.\n뉴 볼시니는 시라쿠사의 여느 도시들처럼 비가 자주 내리는 곳이 아니었기에, 눈가림이 되어줄 비가 한 방울도 내리지 않아 사고 현장이 유난히 도드라져 보였다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……새로운 정보가 있나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "이 도로 주변의 CCTV가 고장 나서 중요한 영상 증거를 확보할 수가 없습니다. 흔적을 더 자세히 감식할 수밖에 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "보고 계시는 이 흔적이 바로 레온투초 씨가 몰았던 개인 차량과 현장에서 사라진 차량이 남긴 타이어 자국입니다……"
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "모퉁이에서 충돌했기 때문에 사각지대가 있긴 하지만, 당시 신호등을 보면 두 차량이 부딪칠 일은 없었습니다. 그런데도 마치 약속이라도 한 듯 이상하게도 양쪽 모두 방향을 틀었죠……"
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그 결과 레온투초 님의 차량과 부딪히게 됐고, 다른 차량은 현장을 벗어났습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "단순한 교통사고일 가능성도 있겠지만, 그렇지 않은 경우도 배제할 수가 없군요……"
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "네."
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "또 다른 차량에 대한 정보는 확인됐나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "어젯밤의 내용과 다르지 않습니다…… 대형 컨테이너 트럭입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "음. 화물차, 셔틀버스, 소방차, 특수 장비 차량……뉴 볼시니에서 이런 규모의 컨테이너 트럭을 볼 수 있는 곳은 많지 않죠."
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "에이레네에게 우리를 도와달라고 부탁해 놓았어요. 이런 정보에 대해서라면 우리보다 트럭 기사들이 더 많은 단서를 찾을 수 있을 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "경찰",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "라비니아 판사님, 레온투초 님께선……"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주치의",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "골절과 내출혈 쪽은 수술로 해결했지만, 심각한 뇌진탕 증상으로 인해 환자가 아직 의식을 회복하지 못하고 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "주치의",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "다른 의미로 보자면, 아직 위험한 고비를 넘지는 못한 상태입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그 사람이…… 깨어날 수 있을까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "주치의",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "의사로서 말하자면, 그 무엇도 장담할 수 없습니다…… 하지만 뉴 볼시니 시민으로서 레온투초 씨가 건강을 되찾길 진심으로 기원합니다. 저희는 최선을 다할 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "주치의",
      "speakerToken": null,
      "operatorId": null,
