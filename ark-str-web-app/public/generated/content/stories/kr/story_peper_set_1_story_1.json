{
  "server": "kr",
  "storyId": "story_peper_set_1_story_1",
  "groupId": "story_peper_set_1",
  "stageId": null,
  "title": "어린 용병",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/memory/story_peper_1_1.txt",
  "sourceHash": "cc196fc13b5ec960cebf3f3d19f1790740f0f4f62aec2b917a041295b64245d7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "용병대 대장",
      "speakerId": null,
      "text": "어떻게 됐어?"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "아직도 뒤따라오고 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "그 아이의 고집은 너도 잘 알잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "용병대 대장",
      "speakerId": null,
      "text": "……조금만 더 설득해 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "그림, 너도 참 바보 같다니까."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "이제 와서 후회할 거면, 그때 여자애는 왜 데리고 나왔어?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "시끄러워."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "암시장 쪽 문제가 심각해. 양쪽 거물이 서로를 죽이네 마네 하고 있는데, 이제 물건도 없으니 우리 탓으로 돌리겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "데려오지 않았다면 걔는 벌써 죽었을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "그 정도는 나도 알아. 하지만 지금 쫓아내도 갈 곳 없는 건 똑같잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……가는 길에 마을을 찾으면 어떻게든 먹고 살 방법이 있겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "진짜 그렇게 생각해?"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "진심으로 그 아이를 위한다면 여러 가지를 가르쳐 줬어야지. 그 녀석, 아직 한 번도 피를 본 적이 없잖아? 사냥할 때 조금 묻는 피 말고, 진짜 피 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "그림, 현실을 봐. 런디니움으로 가는 동안 계속 그런 일을 피할 수는 없을 테니까."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "그 아이도 살카즈잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……됐어, 적당히 해."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "나도 다 생각이 있다고."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "바보, 멍청이……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "자꾸 어린애 취급하면 진짜 화낼 거예요!"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "어이."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……! 기습 공격?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "기습 공격이었다면 이미 죽었겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "아…… 뭐예요, 괜히 겁주지 마세요."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "괜히 겁줄 정도로 한가하진 않거든. 지가 놀라놓고선 왜 남 탓을 해?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "전 의료 담당이라 전투엔 소질이 없는걸 어떡해요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "게다가 조금 전엔 다른 생각을 하느라 더 놀랐던 거예요……"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "뭐, 그렇다고 치자."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "그래서, 지금 여전히 그림한테 화난 상태야?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……흥, 당연하죠!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "이런 시기에 떠나라고 하다니, 그림도 너무한 거 아니에요?"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "흠."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "저도 용병이자, 용병대의 일원이라고요. 그런데 무슨 근거로 절 쫓아낸다는 거예요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "왜 런디니움에 같이 가면 안 되는데요? 지금껏 저도 얼마나 많은 임무에 참여했는데요!"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "이번엔 좀 달라."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "저는 뭐가 다른지 잘 모르겠어요…… 런디니움이 좀 멀긴 해도 보수는 넉넉하잖아요!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "굳이 다른 점을 꼽자면……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림이 돌아왔던 그 날, 당장 출발해야 한다고 얘기할 때 모습이에요. 그렇게 흥분한 그림은 처음 봤어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "평소에는 시큰둥한데, 그날은 뭔가 달랐거든요. 게다가 이번에 이기기만 하면 앞으로 좋은 날이 올 거라고도 했죠."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "근데 그게 정말인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "……글쎄."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "난 돈 말고 다른 생각은 해본 적이 없어서."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "하긴, 그건 그렇죠."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림은 제가 아무것도 모른다고 생각하지만, 어쨌든 용병은 돈만 벌면 되는 거잖아요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "우리 할머니를 잘 모실 수만 있다면 무슨 일을 하든 다 똑같아요. 다른 건 신경 쓸 필요도 없다고요……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그 돈을 받으면…… 할머니께 새집을 마련해 드리고 싶어요. 지금 사는 곳은 빗물이 새서 그런가 비 오는 날이면 무릎이 쑤신대요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "참, 그림한테도 더 좋은 생일 선물을 주고 싶은데……"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "생일을 챙겨주려고? 그림이 생일같이 무의미한 날을 기억하기나 할까?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "무의미하다뇨! 생일이 얼마나 중요한데요!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "매년 생일을 챙기지 않으면 한 해가 어떻게 지나갔는지, 자신이 나이를 먹었는지 잊어버리게 될 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "정말 무서운 일 아닌가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "……그런가?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "무슨 대답이 그래요, 영혼이 없잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "하여간 말로는 이길 수가 없다니까."
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "조금 전 그 얘기를 그림에게 직접 들려주면 동의할지도 몰라…… 아니다, 어쩌면 네가 오는 걸 더 반대할 수도."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네? 그게 무슨 뜻이죠……?"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "(잘 달래서 보낼까 했더니만……)"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "(됐다, 관두자.)"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 용병",
      "speakerId": null,
      "text": "아니야. 난 이만 앞쪽으로 가볼 테니 계속 따라오도록 해."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "뭐야, 난 말을 하다 마는 사람이 제일 싫은데……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "진짜 수상하네……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "궁금해하는 파프리카를 뒤로 한 채 용병은 이미 떠났다. 앞쪽의 대원은 스무 명 남짓이었다. 파프리카의 눈에는 가장 끝자락에 서 있는 사람만 어렴풋이 보일 뿐이었다.\n잠시 아무 말이 없던 파프리카가 고개를 숙이고는 주머니에서 뭔가를 꺼냈다.\n그건 털실로 짠 쨍한 색감의 손가락 보호대였다."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림은 분명히 색이 너무 화려하다며 싫어하겠지……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "화려하면 좀 어때, 예쁘기만 하면 되지."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……또 날 쫓아내려고 하면……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "선물이고 나발이고 안 줄 거야!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(무슨 소리지?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(……)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(……착각인가?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "누구야? 당장 나와!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "핫!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "text": "——!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "맞혔다!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "넌 누구야? 대체 무슨 목적으로……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "저기……!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "잠깐…… 도망치지 마!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "헉…… 허억……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "자, 잡았다……!"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "……고작 여자애한테 들키다니."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……그럼 여자애한테 잡힌 넌 뭔데?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "도망칠 생각 말고 어서 불어! 정체가 뭐야?"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "하, 순진하긴. 실력은 인정하지. 너네 살카즈가 이쪽으로 특출나다는 건 익히 알고 있었으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "아무리 실력이 뛰어나 봤자 네가 멍청한 어린애라는 건 변하지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "이 자식이……!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(……참자, 파프리카. 상대는 지금 날 도발하고 있어. 말려들지 않도록 침착해야 해……)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "경고하는데 쓸데없는 말로 시간 끌지 마!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "묻는 말에 대답하지 않으면 가만히 있지 않겠어!"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "공짜로 한 수 가르쳐 주지, 살카즈 꼬마야."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "묻는 말에 대답이나 하라니까!"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "상대가 시간을 끌고 있단 사실을 눈치챘다면 더는 꾸물거리지 말았어야지."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그게 무슨……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자 B",
      "speakerId": null,
      "text": "대화는 끝났어?"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자 B",
      "speakerId": null,
      "text": "뭐 그렇게 할 말이 많다고."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "이런! 어, 어느 틈에……"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "……시작하자고!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "제길! 너무…… 비겁하잖아!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(무리야. 양쪽에서 공격하면…… 피할 수가 없는데!)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "윽!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "눈 감지 마! 상대에게 시선을 고정하고 무기로 막아!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "으윽!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "쳇, 성가신 녀석이 왔군……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "다른 놈은 신경 쓰지 말고 네 사냥감에 집중해."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "다치는 걸 두려워하지 말고. 전투 중엔 무슨 일이 있어도 절대 무기를 놓지 마!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네, 넵!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자 B",
      "speakerId": null,
      "text": "날 무시하지 말라고!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "지금이야! 공격해!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "흐압!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "으윽!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "아…… 아하하! 무시하지 말라더니……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그건 내가 할 말이라고! 이 나쁜 놈들, 감히…… 날 무시했겠다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자 B",
      "speakerId": null,
      "text": "어이, 꼬마야. 어딜 노린 거냐?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "뭐 하는 거야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "내가 가르쳐 준 걸 그새 까먹은 건 아니겠지? 항상 급소를 노려야 한다고 했잖아!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "아, 알고 있어요……!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "이야아압……!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "헉…… 허억……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "후……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "겨우 해치웠네……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "봤어요? 제가 이 나쁜 놈들을 처치했어요!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림……?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "왜 그래요? 화, 화났어요?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "전에 내가 뭐라고 했지?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "상대를 무시하지 말고, 인정사정 봐줄 것 없이 급소를 노리라고 했어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "근데 넌 어떻게 했어?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그게…… 일부러 급소를 피해 공격한 게 아니라…… 어……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림이 있으니까 괜찮을 거라고 생각했어요."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "만약…… 내가 죽으면 어쩔 건데?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "하지만, 하지만 그림이 죽을 리가 없잖아요?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……그건 누구도 장담할 수 없는 거야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "암시장 추격자",
      "speakerId": null,
      "text": "으으……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "아직 살아 있는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그게…… 시, 실은 기절만 시켰거든요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "왜 그냥 죽이지 않고?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그야……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그럴 필요가 없으니까요……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "아, 차라리 묶어버리는 게 어떨까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그럼 이 일을 보고하러 가지 못할 거예요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "파프리카."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "잘 봐."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "노련한 용병이 허리춤에 차고 있던 칼을 뽑아 패배자의 목에 그대로 찔러 넣었다.\n검붉은 피가 무릎 보호대와 신발에 튀자 파프리카는 마치 그 뜨뜻한 피에 피부가 타는 것만 같은 기분을 느꼈다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "대, 대체 왜……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "암시장에서 우릴 노리고 온 놈들이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "아까 인기척을 느끼지 못했다면, 저기 누워 있는 건 너일 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……알아요!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "저 사람들이 나쁜 마음을 품었다는 건 저도 알아요! 그림이 없었으면, 정말 위험했을 거예요……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그리고 한 명 남았어요…… 저 사람은 내 사냥감이니, 내가 직접 처리할게요."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(저 사람을 죽여야 해…… 그래, 죽이는 게 맞아.)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(그냥 찌르기만 하면 돼. 파프리카, 긴장하지 말자. 아주 쉬운 일이야……)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "뭘 망설이는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "마, 망설이지 않았어요……!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(망설이지 말자…… 용병으로서…… 적을 죽이는 것뿐이야!)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "(망설일 것도 없잖아? 그, 그러니까……)"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "지금 바로…… 죽일게요!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "그만해."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네? 하지만 아직……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "넌 죽일 수 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "아니에요! 할 수 있어요…… 믿어주세요!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "아니, 넌 아무것도 몰라."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "이런 놈들조차 처리하지 못한다면, 내가 장담하는데 넌 용병 일을 할 수 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "넌 금방 죽을 거야. 전장에서 죽는다면 나름 괜찮은 결말이겠지. 하지만 어쩌면 으슥한 곳에서 홀로 죽는 바람에 내가 가서 네 시체를 처리해야 할지도 몰라."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……하지만 전 용병이에요!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림이 그랬잖아요, 우리 같은 용병은 언젠간 모두 죽는다고!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "우리 같은?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "하, 넌 사정이 다르지……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……그림, 나도 가끔은 두려워요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "뭐가?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림이 말한 대로 오늘 여기 쓰러질 사람은 나였을지도 몰라요. 그림이 오지 않았다면 저들처럼 죽었겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "아마 내 시신은 한참이 흐른 후에야 발견될 거고, 이 소식이 마을에 계신 할머니의 귀에 들어갈 때까진 더 오랜 시간이 걸리겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "전에 프레드 때도 그랬잖아요. 아직 그 일을 기억해요."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "이별이란 아주 흔한 일이지."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네…… 알아요. 그림이 늘 하는 말이잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "난 죽음이 무서운 게 아니에요. 정말로요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "하지만 내가 영영 돌아오지 못하게 됐는데도 할머니가 계속 기다리실까 봐 무서워요."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "이번은 그렇다고 치자."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그림……! 잠깐만, 나 정말 할 수 있어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "소란은 이 정도로 충분해."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "명심해. 계속 우리를 따라온다면 언젠간 직접 누군가를 죽여야 할 날이 올 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "네…… 알고 있어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "진짜 아는 거 맞아? 이해하지 못한 것 같은데."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……어쩌면 네가 죽을지도 모른다고."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "파프리카."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "런디니움 가는 건 포기해. 넌 아직 부족하니까."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "이번에 이기기만 하면 앞으로 좋은 날이 올 거라면서요!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "나도 싸울 수 있어요, 도울 수 있다고요!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "이건 단순한 전투가 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "내가 이번 임무에 모든 걸 걸 수 있는 이유는, 직접 봤기 때문이야."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "뭘 봤는데요?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "우리 살카즈에게 돌아갈 집이 있는 모습을."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "집……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "어쩌면 상황이 그리 좋지 않을지도 모르지만, 일말의 가능성만 있다면 맞서 싸울 생각이야."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "하지만 넌 달라. 넌 선택할 수 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "선…… 선택이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "잘 모르겠어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "모두와 함께 하지 않는다면, 저 혼자 어딜 갈 수 있겠어요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "마을로 돌아가 예전처럼 지내고 싶지만…… 그럴 수 있을까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "생각해 봤는데…… 이번 런디니움 임무가 지금껏 해온 다른 임무보다 훨씬 어려운 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "그렇다고 할 수 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그리고 그림도 언제 어디선가 세상을 떠나게 되겠죠……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "……그럼 내년 생일 선물은 준비하지 않을게요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "받아요, 올해 선물이에요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……손가락 보호대?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "화려하다는 말 금지! 시간 낭비라는 말도 금지! 필요 없다는 말도 금지!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그, 그림이 죽더라도 절대 슬퍼하지 않는다고 약속할게요. 살카즈에게 이별은 아무것도 아니니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "하지만 죽지 않는다면…… 한 대 얻어맞거나, 보수를 받지 못해도 괜찮을 것 같아요."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "뭐가 됐든 다 괜찮아요. 허탕 치고 돈을 받지 못해도 상관없어요!"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그냥……"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "임무가 끝난 후에 모두가 함께 돌아올 수 있다면 좋겠어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……순진한 생각이군."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "살카즈 애들은 다 너처럼 순진한 건가? 내가 아는 살카즈는 이런 모습이 아닌데."
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "왜 또 혼내요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "살카즈는 주변 사람들이 무사하길 바라지도 못해요?"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그래도 전…… 제가 살카즈라고 생각해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "그런 살카즈는 전장에서 죽기 마련이지."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "……하지만 난 네가 죽는 걸 보고 싶지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "그림",
      "speakerId": null,
      "text": "이만 가자."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파프리카",
      "speakerId": null,
      "text": "그게 무슨…… 앗, 같이 가요!"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
