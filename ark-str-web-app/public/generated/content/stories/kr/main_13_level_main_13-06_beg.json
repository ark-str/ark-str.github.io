    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": "avg_npc_1067_1",
      "isRemote": false,
      "text": "과거를 그리워하는 바보들이나 계속 이 이름을 사용하고 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "speakerId": "avg_4088_hodrer_1",
      "isRemote": false,
      "text": "그럼 이름을 바꾸면 될 텐데."
