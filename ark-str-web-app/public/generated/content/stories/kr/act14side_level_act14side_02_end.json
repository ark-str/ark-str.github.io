erId":"avg_npc_255_1","isRemote":false,"text":"……"},{"type":"dialogue","speakerName":"노시스","speakerId":null,"isRemote":false,"text":"계획을 계속 진행해라. 라타토스와 시우루스는 네 꼬리를 잡을 수 없을 거다."},{"type":"dialogue","speakerName":"묀히","speakerId":"avg_npc_255_1","isRemote":false,"text":"네."},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[]}
