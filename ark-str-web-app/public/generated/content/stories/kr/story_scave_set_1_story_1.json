    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스캐빈저",
      "speakerId": "avg_149_scave_1",
      "isRemote": false,
      "text": "말했잖아, 넌 안 된다고."
