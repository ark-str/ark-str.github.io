{
  "server": "kr",
  "storyId": "story_skfire_set_1_story_1",
  "groupId": "story_skfire_set_1",
  "stageId": null,
  "title": "옛 동창",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_skfire_1_1.txt",
  "sourceHash": "ed6c2981ddaa6502b42837f1984207023de5e5ed48abbac7e434e123a2c9d12f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그거 알아? 마운트벨란가 아가씨가 빅토리아에 돌아왔대. 지금 칼라돈에 있다는데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "대도시가 아니라 이 시골 촌구석에? 여긴 감염자도 많고, 전에 리유니온도 나왔잖아. 그런 거 가장 싫어하는 사람이?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "의회에서 일한다고 들었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아…… 의회. 마운트벨란가 아가씨라면 이런 시골 의회에서도 앞길은 순탄하겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "뭐야, 그게 끝이야? 엄청 기뻐할 줄 알았는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "내가 왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "네 공장 말이야. 계속 기회를 찾고 있던 거 아니었어? 그녀 같은 족속들은 워낙 오만하기 그지없잖아. 게다가 얼마 전에 일어난 사건을 보면, 그녀가 감염자를 싫어하는 게 틀림없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "마침 의회에서 일하고 있겠다, 지금이라도 찾아가서 로비도 좀 하면서 공장의 사정을 슬쩍 꺼내면……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……이게 뭐지? 초대장?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "“이번에 귀하를 초대하여…… 함께 축하하면서 샴페인을 시음…… 오늘 밤 8시에 부디 참석해 주시길 바랍니다.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "동창회네…… 왜 이런 시간만 낭비하고 거절하기 어려운 것들이 '예의'로 둔갑했는지 모르겠다.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "퇴근하고 가봐야겠네. 그 노인네들이 퇴근 전에 일만 주지 말았으면……\n후, 안 돼. 일할 때 화내봤자 소용없어."
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "바로 일을 시작해야겠다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "거만한 귀족 동창",
      "text": "오랜만이군. 지난주 연회 때도 봤지만, 너의 미모는 역시 숨이 넘어갈 지경이야. 다들 다시 한번 너를 만나고 싶어 안달이 났던데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자신만만한 귀족 동창",
      "text": "미모?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자신만만한 귀족 동창",
      "text": "내가 소유한 산업 때문이겠지. 불과 몇 개월 만에 1년 치 수익을 올렸으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자신만만한 귀족 동창",
      "text": "아담 백작의 머리카락이 영양 불량 옥수수수염처럼 까칠해져도, 다들 잘 생겼다고 칭찬만 하잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "거만한 귀족 동창",
      "text": "크, 크흠! 그 유머는 여전하군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "거만한 귀족 동창",
      "text": "하지만 재력에 관한 거라면, 역시 내 와이너리가……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "(서로 비교하고 재산을 자랑하고 자리에 없는 사람을 비웃기나 하고. 흥, 여전하네.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "기회를 노리는 상인 동창",
      "text": "앰뷸러스 백작님, 덕분에 제 공장이 정상 궤도에 올랐습니다! 다만 당신을 위해 더 많은 이익을 창출하기 위해서는 자금을 어떻게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아하하, 아직도 절 기억하고 계시다니, 정말 영광입니다! 그때는 제가 당신의 뒷자리에 앉았거든요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "그래서 제가 소유한 산업도 좀 봐주셨으면…… 아, 네네, 알겠습니다. 실례했습니다……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "(파티를 출세의 발판으로 삼으려는 녀석이나 아첨을 즐기는 녀석이나, 정말이지…… 이젠 질렸어.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "(충분히 오래 있었으니 이만 가야겠다. 칼라돈에 돌아가는 것도 시간이 걸리고.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨, 역시 당신이군요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "괜찮으시다면 샴페인 한 잔 어떠세요? 제가 가져다드릴게요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "설마 마운트벨란 씨가 올 줄은 몰랐어요! 저 기억하시죠? 그때 당신 뒷자리에 앉았는데! 이야, 이렇게 출세했을 줄이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "죄송합니다만, 급한 일이 아니라면 이만 실례할게요. 제게 볼 일이 있어서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아, 실은 말입니다, 마운트벨란 씨가 의회에서 일한다는 걸 들었습니다. 마침 저도 작은 공장을 운영하고 있는데, 규모는 작지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "분명 이사벨라가 소유한 산업만큼이나 수익을 낼 수 있는 잠재력이 있거든요! 그러니까, 저를 도와주신다면 당신 같은…… 저의 귀인께, 꼭 만족스러운 답례를 해드릴 수 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "예를 들면, 의회로부터의……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "관심 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "(이 녀석, 설마 내 공장에 대해 전혀 모르는가?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "(쳇, 세상 물정 모르는 귀족 주제에…… 하찮은 혈통에 얽매어 사람만 깔보는 족속들이라곤…… 내가 이렇게 저자세로 나왔는데!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨, 아실지 모르겠지만 저의 공장은 칼라돈에 있습니다. 당신과 의원님들 덕분에 차릴 수 있었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "당신은 그 저속한 폭도들을 가장 싫어하지 않았나요? 당신이 사랑하는 애완동물을 위해 놈들도 대가를 치른 셈이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "지금은 이 정책들에 감사하고 있습니다. 의회도 우리 편을 들어주지 않나요? 그 저속한 무리는 우리를 위해 존재하는 거니까요. 그리고 저는 그들을 이용하는 방법도 터득했죠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "여기서 한 걸음 더 나아갈 수 있다면, 저는 반드시 더 큰 성과를 이룰 수 있습니다! 그때가 되면 마운트벨란 씨, 당신의 도움에 제가 최선을 다해 보답할게요.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "(이 녀석을 확 불태워버릴까……\n안 돼.)"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "그건 그렇고, 왠지 방안이 조금 더워진 것 같네요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨는 어때요? 아니면 나가서 얘기할까요?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "(정말 안 돼?\n……안 돼.)"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "이건 제 명함입니다. 부디 받아주십시오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……흥, 어디 한 번 볼게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "'배럼 공장'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "네네, 맞습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "아, 배럼 공장이었군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨도 알고 계셨어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "물론이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "일전에 의회에서 당신의 공장을 사례로 새로운 의안 계획에 대해 논의한 적이 있거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "사적으로도 저와 제 선생님이 당신의 공장을 눈여겨보고 있어요. 당시 보내온 리스트에 '배럼 공장'이 가장 위쪽에 있었으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "저, 정말인가요! 정말 영광이군요! 그러면 혹시……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "비밀 유지 계약에 서명한 상태라서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아, 그럼요! 비밀을 함부로 누설할 수는 없죠! 저는 단지 그런 자리에 살짝 참여하고 싶은 것뿐입니다. 기껏해야 식사 후 잡담하는 것처럼 말이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "예를 들자면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "예를 들자면 작업 시간에 대한 새로운 규칙이 있을지…… 같은 거 말인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "맞습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "만약 저의 공장에 오셔서 시찰해 주신다면, 대단히 영광입니다만……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "이야, 이런 곳까지 직접 와주시다니, 대단히 감사합니다! 며칠 전에 청소를 시켜놓았으니 먼지 한 톨 없을 겁니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "평소 모습을 보고 싶다고 했을 텐데요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "그냥 불필요한 먼지를 청소했을 뿐입니다. 공장을 시찰하시는 데 지장은 없지요",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "자랑은 아니지만, 보십시오. 이러한 규모라면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "확실히 칼라돈에서 손꼽힐 정도는 아니지만, 그래도 크긴 하네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "음, 설비나 방호 조치도 훌륭하군요. 규정에 맞게 잘 정돈되어 있네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "안전 조치도 완벽하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "그럼요, 마운트벨란 씨. 이런 기본적인 작업은 마땅히 잘 해둬야죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "작업장도 둘러보실 겁니까? 안쪽은 감염자 작업장이라 방호 조치는 해뒀습니다만, 당신이라면 분명……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "들어가 보죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "네?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아, 아, 그렇군요. 몇 년 전의 사건이긴 하지만, 그래도 안에 리유니온이라는 녀석들이 있는지 확인하고 싶은 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "아, 맞아요. 리유니온.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "저희 일꾼들은 전원 신분 심사를 마친 상태라, 안심해도 됩니다. 만약 심기를 거스르는 녀석이 있다면, 제가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그건 직접 보고 판단할게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "네, 네. 그럼 방호복을 입으세요. 저도 같이……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "여기인가요? 일꾼들은요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨가 이곳에 그렇게까지 신경 쓰실 줄은 몰랐습니다. 당신이 어찌 감염자들과 같은 공간에 있을 수 있겠습니까. 그래서 전부 돌려보냈고, 정화 장치도 최대 출력으로 가동하고 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "저희도 이만 나가죠. 솔직히 저도 처음…… 앗, 한동안 여기에 오지 않았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "네, 대충 둘러보면 돼요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "어쨌든 이곳이 당신에게 돈을 벌어주는 곳이군요. 그러니까 저도 관심을 기울이고 있어요. 게다가 잊었나요? 저와 제 선생님이 당신의 공장에 관심이 있다고 했던 거요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아이고, 정말 영광입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "감염자는 값싸고 별다른 보장도 필요 없죠. 이토록 좋은 노동력이라니, 전부 의회 덕분입니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "저것들은 뭔가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아, 감시 장치입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아시다시피 감독과 감시가 없다면 게으름 피우는 녀석들이 생기기 마련이니까요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "이 진압 방패는……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "아, 이건 신경 쓰지 않으셔도 됩니다. 감염자는 말도 잘 안 듣는 약삭빠른 녀석들이라, 가끔 수단을 써서 굴복할 필요가 있습니다. 아마 저보다 더 잘 아실 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "진압 장비를 이렇게 대놓고 보여주면 감염자들이 공포심에 폭동을 일으키지 않을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "그건…… 하하, 마운트벨란 씨도 걱정이 많으시군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "그들은 볼 수 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "볼 수 없다니요……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "…… 마운트벨란 씨, 꽤 오래 있었으니 일단 나갈까요? 비록 방호가 잘 되어있기는 하지만 만일의 경우라는 게 있으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "자, 엘리베이터 타러 가시죠!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨, 저희는 동창이고, 엘리베이터에도 둘밖에 없으니 솔직하게 얘기할게요. 그러면 아마 공장에 더 관심을 가지게 될 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "눈에 보이는 것들에 실망하지 마세요. 게다가 당신도 눈치채지 않았나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "감시와 진압, 그리고 무기까지. 아시다시피 돈 버는 법을 대놓고 보여줄 수는 없잖아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "지하에 있는 거야말로 진짜입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "다만, 너무 더러운 곳이라 구태여 보여드릴 필요가 없을 뿐이죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그렇군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "조금 전의 이야기…… 아주 만족스러웠어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……재미있군요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "옛 동창은 다시 더워진 걸 느꼈다.\n그는 이걸 스카이파이어의 흥분으로, 돈 냄새를 맡은 흥분, 그 버러지들을 계속 짓밟을 수 있다는 흥분으로 이해했다."
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "짐승도 사냥감을 잘 확인하고 움직이듯이, 저도 진짜를 내놓지 않으면 아마 마운트벨란 씨의 마음을 움직일 수 없겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "공장이야 칼라돈에 쌔고 쌨으니, 저도 색다른 걸 내놓아야 하지 않겠습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "훗! 확실히 그렇죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "하하하하! 이야, 이해해 주셔서 다행입니다. 자자, 마운트벨란 씨, 이건 제가 오랫동안 아껴둔 좋은 술입니다. 건배 한 번 하시죠!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "잠재력이 넘치는 공장에 투자할 당신을 위하여! 그리고 더욱 높은 곳을 향해 나아갈 저를 위하여!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "하하하……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "건배.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "스카이파이어의 발밑에서 아지랑이가 피어오르기 시작했다.\n그녀라면 순식간에 이 공장을 불태우고 지하에 갇힌 모든 사람을 구할 수 있다.\n하지만 이 순간만큼 그녀는 마음속에 타오르는 분노를 억눌렀다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "선생님, 무슨 일이에요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "“자칭 '리유니온'이라는 감염자 폭도들이 '왕의 지팡이'라는 단체에 제압당해”…… 이런 소식이 들려오는구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "하지만 선생님, 그 녀석들은 필을 죽였다고요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "그렇다고 그게 유일한 해결책이 돼서는 안 되지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "폭력으로 폭력을 제압하는 건, 마운트벨란, 나의 가르침과 완전히 괴리되는 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "내가 뭐라고 가르쳤는지 벌써 잊어버렸나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "리유니온은 감염자만의 문제가 아니다. 네가 그 길을 계속 갈 생각이라면, 내가 추천한 곳에 가. 가서 더 배우고 바깥세상을 제대로 느껴보거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "날 실망시키지 마, 마운트벨란. 너는 주관이 뚜렷한 학생이다. 자신의 감정에 휩쓸리지 말고, 사물의 본질을 판별하란 말이다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "불은 모든 걸 태울 수 있지만, 문제는 해결하지 못한다.\n그녀는 술잔을 들고 거세진 호흡을 간신히 다스렸다."
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "다음 의회가 열리는 시간, 당신도 아실 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "좋은 소식을 기다리세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "하하하하! 마운트벨란 씨, 정말 감사합니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "선생님, 이렇게 된 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "배럼 공장은 전에 정리했던 감염자 권익 조사 명단에 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그때 선생님의 의견을 물어봤고, 최종적으로 정보원을 보내 몰래 조사하기로 했었죠. 그리고 공장의 내막은 이미 문서로 정리해 뒀어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그리고 바로 며칠 전에 알았어요. 거기 공장주가 제 동창이더라고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "사실 그 자리에서 전부 태워버리고 싶었어요…… 물론, 그러면 안 되고 오히려 불필요한 문제만 늘리게 된다는 것도 알아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "하지만 그 사람이 하는 짓이 정말 역겨웠어요. 파티에서 개인적으로 의회의 내막을 알아내려고 한 거나, 감히 의회의 일원에게 공장의 내막을 노골적으로 드러낸 것 말이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그가 그런 짓을 한다는 건 비슷한 일이 백 번은 더 있었다는 얘기겠죠. 무수한 사람이 같은 방식으로 사사로운 이익을 챙겼을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "이건 명백히 현행 조례를 위반하는 일입니다, 선생님. 그런데 그자들은 아무런 벌도 받지 않았고, 오히려 이익을 채우게 됐죠. 그러니까 계속 그런 비열한 수법을 반복하는 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "사실 전 이 동창을 기억하고 있었어요. 그가 절 찾아왔을 때 했던 '뒷자리였다'라는 말이 사실이라는 것도요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그 자리에 있었던 모든 귀족에게 똑같이 말했지만…… 확실히 제 뒷자리였거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "예전에는…… 그런 사람이 아니었는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "예전에는 좋은 사람이었나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그렇지도 않았어요. 하지만 이런 사람도 아니었죠…… 본성 때문에? 그건 아닌 것 같아요, 선생님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그는 조례의 빈틈을 노렸고 아무도 신경 쓰지 않는다는 사실을 알게 된 후에, 조금씩 조금씩 지금 이 모습이 되고 만 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "저는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "망설여지는 건가, 마운트벨란?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "아니, 망설이지는 않아요. 단지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "어떻게 말해야 할지 모르겠지만, 제가 뭘 해야 할지는 똑똑히 알고 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "암모스, 선생님께 그 공장에 대한 사실을 다시 설명해줄 수 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "네, 마운트벨란 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "저는 마운트벨란 씨가 주신 정보에 따라 공장 근처에 잠입했습니다. 하지만 지하 공장에 가까워질수록 통신 신호가 엄청나게 방해받더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "지하 공장 내부에 통신 차단기가 설치되어 있는 것 같았습니다. 안쪽의 감염자 일꾼들은 외부와의 연락이 완전히 차단되어 있었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "제가 관찰한 바에 따르면 며칠 내내 죽은 감염자들이 비밀리에 운반되어 처리되고 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "안쪽의 무장 전투원들은 모두 지하 공장을 지키기 위해 배치되어 있었어요. 지상의 감염자 일꾼들은 진실을 모른 채, 그저 중요한 물건을 지킨다고만 알고 있더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "마운트벨란 씨가 주신 자료에 따르면 그 안쪽에는 사라졌던 중증 감염자들이 있는 것 같습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정보원",
      "text": "중증이기 때문에 치료할 필요도 없죠. 그러니 일회성 노동력으로 간주되어 지하에 갇혀 죽을 때까지 일하고 있는 겁니다. 그리고 그들이 죽어버리면 공장은 다시 새로운 감염자 일꾼을 채워 넣고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "그렇군…… 알겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앵스트 의원",
      "text": "그럼…… 마운트벨란. 이 일은 어떻게 처리할 생각인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "보고는 이상입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "그래. 하지만 우리가 어째서 그런 작은 공장 때문에 여기서 십 분이 넘도록 설명을 듣고 있어야 하는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "우리에겐 그다지 의미 없어. 당신도 이해했으면 좋겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "앵스트 의원은 그런 작은 공장이나 지켜보라고 당신을 여기 데려온 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "이 건에 대해 여러분께 알려드리고 싶은 건 실종된 감염자 일꾼들이 폭력으로 그곳에 갇혀, 일말의 자유도 없고, 심지어는 죽어서도 비밀리에 처분된다는 것입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "게다가 오리지늄 분진 밀도가 높은 환경에서 아무런 방호 조치도 없이 일하고, 외부와는 통신 자체가 되지 않습니다. 이 모든 게 현행 조례를 심각하게 위반하고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "감염자에 대한 관용적인 정책 때문에 많은 감염자들이 칼라돈에 일하러 오게 되었고, 그게 칼라돈이 발전하게 된 근본입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "하지만 이 사건이 세간에 알려진다면 칼라돈의 이미지가 무너지는 건 둘째치고, 감염자들이 더 이상 칼라돈에 오지 않을 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "여러분도 그런 결과는 보고 싶지 않을 거라고 믿습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "따라서 이번 건은 의안이 아니라, 어디까지나 블랙 기업에 대한 처분이라고 생각하시면 됩니다. 아울러 칼라돈의 명성을 지키기 위해, 구출된 감염자 역시 적절하게 배치해야 합니다. 의회의 이름으로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "물론, 이번 압류 작전도 의회의 이름으로 외부에 보여야겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "이곳에 계신 여러분이 보기에는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "됐어, 표결하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "귀족 의원들",
      "text": "다들 어떻게 생각하시나?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "3일 후"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "이, 이게 어떻게 된 거야! 당신들은 누구야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "이게 무슨 짓이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "앗, 기다려! 이 안쪽에는 감염자들뿐이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 장교",
      "text": "다들, 밑으로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "밑? 밑에는……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 군인 A",
      "text": "보고드립니다! 대량의 불법 무장 인원을 발견했습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 군인 B",
      "text": "보고드립니다! 불법 통신 차단기를 발견하여 제거했습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 군인 A",
      "text": "지하에서 대량의 감염자를 발견했습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 군인 B",
      "text": "지하에 불법 공장이 있는 걸 확인했습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 장교",
      "text": "음, 보고받은 대로군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 장교",
      "text": "의회의 조례에 따라 이 공장은 폐쇄 조치한다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 장교",
      "text": "그리고 너, 관련 규정에 따라 5년간 관련 사업 참여 금지를 선고한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 장교",
      "text": "……감염자들을 이송해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "마운트벨란 씨!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "아, 당신이군요…… 무슨 일이죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "당신, 내 공장이?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "어째서 갑자기 내 공장에 사람들이 온 겁니까? 지하도 그렇고, 대체 어떻게 된 거죠?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "아하! 공장 폐쇄요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "제게 도와달라고 하지 않았나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "그래서 도와드린 것뿐이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "연줄을 찾고 있는 상인 동창",
      "text": "무슨……?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "어디서 제 소문을 들었는지 모르겠지만, 제대로 들은 것 같진 않군요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카이파이어",
      "text": "저는 의회의 일원일 뿐만 아니라, 동시에 로도스 아일랜드의 오퍼레이터입니다. 아직 이해가 안 된다면, 확실하게 알려드리죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "저는 감염자들을 위해 일하고 있습니다.\n더 중요한 건, 제가 감염자들의 권익을 지키기 위해 일하고 있다는 것이죠."
    },
    {
      "type": "sceneBreak"
    }
  ]
}
