    {
      "type": "dialogue",
      "speakerName": "혼",
      "speakerId": "avg_4039_horn_1",
      "isRemote": false,
      "text": "모두에게 알려. 애도할 시간이 없다."
    },
    {
      "type": "dialogue",
      "speakerName": "빅토리아 병사",
      "speakerId": "avg_npc_422_1",
      "isRemote": false,
      "text": "……!"
