    {
      "type": "dialogue",
      "speakerName": "빅토리아 병사",
      "speakerId": "avg_npc_422_1",
      "isRemote": false,
      "text": "혼 중위님, 그러실 필요 없습니다. 즉시 명령을 내려 주십시오!"
