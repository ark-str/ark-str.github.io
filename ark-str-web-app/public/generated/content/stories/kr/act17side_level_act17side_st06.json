{
  "server": "kr",
  "storyId": "act17side_level_act17side_st06",
  "groupId": "act17side",
  "stageId": "act17side_07",
  "title": "하층부 로비",
  "storyCode": "SN-ST-6",
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act17side/level_act17side_st06.txt",
  "sourceHash": "c859d01941063adb8507d00423799c1e28b0871236ce315e7eb211d3e8caab6e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "쳇, 깊이 들어갈수록 시테러의 수가 많아지고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "서둘러 합류하지 않으면…… 위험해지겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "선생님…… 제가 어떻게 하면…… 저 사람들처럼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……크……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "시본……?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "(갑판 위에서 봤던 그놈이야. 그 헌터의 일격을 받고도 상처 하나 없다고……?!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "(……어떻게 공격해 올까? 팔다리로? 이빨로?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "(아니야, 핸드캐논, 거리를 반드시 벌려야 해, 난……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……잠깐만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "자, 잠깐만 기다려! 너 허리춤에 뭘 차고 있는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "네가 왜…… 너 설마……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "으아아악……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "으윽! 콜록…… 콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "(이 정도의 힘이라니……! 다행히 막았어……!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "뭘 말하고 싶은 거야? 이 괴물아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "난 절대로…… 이곳에서 쓰러질 순 없어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "나는, 이베리아의 재판관이다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관 다리오",
      "text": "……콜록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관 다리오",
      "text": "명흔을 불태워 버리는 데 시간을 너무 소비했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대재판관 다리오",
      "text": "……결코 낙관적이지는 않군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시테러",
      "text": "(무리를 짓는 사르륵 소리)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "조르디",
      "text": "(여기에서는 아래 상황을 볼 수 있어……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조르디",
      "text": "벌써 몇 시간이 지난 걸까? 대재판관님은…… 얼마나 더 버틸 수 있을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조르디",
      "text": "마…… 만일 내가…… 아니야, 이런 생각 하지 마. 조르디, 집중 좀 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조르디",
      "text": "재판소…… 서둘러……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "왜 그러지, 벌써 끝이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "……크…… 아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "들어 봐. 너의 동료들이 벌써 울부짖고 있어. 살비엔토의 작은 꽃에는 적어도 약간의 아름다움이라도 있었지만, 너는 어떻지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "잠에서 깨어난 후의 첫 댄스 레슨치고는, 정말 지루하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본",
      "text": "크……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "놈이 도망치려 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "제가 쫓을게요. 당신은 그 이베리아의 아기 새한테 가보세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "지금 기분이 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "아주 좋아요. 기억이 마치 은하수 폭포처럼 밀려들고 있어요. 그렇지만, 저 자신의 모든 것을 보기에는 아직 시간이 필요할 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "그리고, 지난 몇 년간의 일들을 떠올리려니, 민망함에 숨이 약간 막힐 정도네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……상태가 아직 불안정해 보이니까, 내가 갈게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "왜요, 제 사냥감을 가로챌 셈인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "놈은 바닷속으로 도망칠 방법을 생각할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "당연히 그럴 수 있겠죠. 하지만, 시본은 우리를 이길 수 없을 것 같아서 도망친 게 아니에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "시본이 발견한 게 뭐죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "우리에겐 그럴 시간이……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "콜록…… 콜록……! 여전히 핸드캐논은 제대로 못 다루겠어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "도망치지 마, 너는 결국……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……응? 어비설 헌터스?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "좋은 아침이에요, 아이린. 우리한테 사냥감을 또 데리고 와줘서 매우 기쁘네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……나를 아이린이라고 불렀어? 너…… 너 기억이 돌아온 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "아직은 완전히 돌아왔다고 말할 순 없지만, 지금 컨디션이 아주 좋아서, 기분이 좋아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그런 걸 말할 때가 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이놈이 바로 갑판 위에 있던 그놈이야. 저놈의 반응 속도는 제2대대장의 찌르기 공격도 피할 수 있을 정도였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "정말 대단하네요. 이런 상대를 만났는데, 상처 하나 없이 우리 쪽까지 쫓아 보낸 거군요. 칭찬해줄게요, 아이린.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "아니야, 이건 내가 저 녀석을 쫓은 결과가 아니야. 놈은 거의 공격하지 않았어…… 지금도 마찬가지고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "그렇군요…… 전 또 허점투성이로 수다를 떨면, 녀석이 습격하고 싶은 욕망을 억누르지 못할 줄 알았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "너의 친구는 방금 떠났어. 지금 쫓아가도 너무 늦지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "아니면, 너도 평화주의자인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "(카시미어는 스카디가 전에 들렀던 내륙 국가야. 광활한 초원과 숲이 있는 기사의 나라였지.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "(기사……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……우연일까? 아니면 무언가가 그를 끌어들인 걸까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "이 배, 브레오간, 당신은 고향에 무엇을 남기고 싶으셨나요? 당신은 해답을 어디에 숨겨놓았나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……음.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "(시테러의 시체? 이것뿐만이 아니라……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "(깔끔한 상처, 시테러들이 반항한 흔적조차 없어. 냄새가 뒤섞여 있어서, 이곳의 공기는 너무 혼탁해.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "(이 배에는…… 또 뭐가 있을까?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "네 허리춤의 허리띠와 회중시계는 의심할 여지 없이 인간의 것이야. 게다가 이베리아의 제식이라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "넌 도대체 뭐야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "놈은 시간을 끌고 있는 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "다른 한 마리가 바다에 돌아가면, 귀찮아질 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "그래도 공격하려 하지 않네요…… 정말 소극적인 댄스 파트너예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "스카디, 공격하죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "좋아.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……큭!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……크…… 크어어어…… 크……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "우리가 공격해도, 반격을 하지 않는다니. 왠지 불쌍해지기 시작했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……아니야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "놈은 동료를 위해 시간을 끌려는 게 아니었어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "조, 종소리?! 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(귀를 찢는 듯한) 크르르르……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "아무도 없는 황금빛 홀 안에 종소리가 울려 퍼진다.\n홀의 불빛이…… 깜박거리고, 세 사람이 잠깐 정신을 딴 데 판 순간, 시본은 왕좌 근처에 착지했다.\n왕좌.\n이 이베리아의 함선에는 왕좌가 있었다. 오만함의 결정체, 권력의 열매, 우매한 문명의 공범."
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "저것은 마치……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "스스로도 너무 터무니없다고 생각한 스펙터는 계속 말을 이어갈 수가 없었다.\n그것은 머리에 왕관을 썼고, 커튼과 똑같은 색상의 망토를 걸치고 있었다. 그리고 조용히 왕좌 한쪽에 꿇어앉는 모습으로 보아, 그것이 왕좌에 가장 친숙한 대상이라는 것을 알 수 있었다.\n마치 옛날 왕비와 신하들처럼, 이베리아 황금의 태양을 섬기고 있다.\n왕좌 뒤에서 한 사람이 걸어 나온다.\n아이린은 그 사람의 모습을 보기 위해, 등불을 머리끝까지 들어 올려 그림자 쪽을 비추었다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "시본?",
      "text": "왜, 내 배에 오른 것이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본?",
      "text": "쿨럭…… 쿨럭쿨럭…… 퉤.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "시본?",
      "text": "……대답하라. 이 위대한 알폰소에게. 너희는 무엇을 하러 온 것이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "왜, 적막을 깨고, 몇십 년 동안 아무도 찾지 않은, '나의 이베리아'를 찾아온 것이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "너부터 시작하지. 대답하라, 옛 이베리아인이여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "아이린은 믿을 수 없었다.\n그녀는 저 시본의 얼굴을 본 적이 있다. 어린 나이에 재판관이 되기 위해서, 그녀는 당연히 열심히 공부했었다. 열심히 경전을 읽었으며, 역사를 마음에 새겨, 그녀의 신조가 힘이 되도록 했다.\n저 시본이 알폰소라고?\n그 이베리아의 가장 위대한 선장을 자칭하고 있는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……너, 네가 이 배의 선장일 리가 없어! 괴물아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "60년 전에도 알폰소 선장은 이미 반백이 넘는 나이였어. 네 모습은 심지어 그때의 영웅보다 더 젊어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "아이린은 자신이 동요하고 있다는 걸 알고 있었지만, 이렇게 연약해서는 안 되겠다고 생각했다.\n그녀는 자신의 장관처럼 조건반사적으로 등불을 들어 올렸다."
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "정체를 드러내라! 시본!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "불빛이 흔들린다. 황금빛 홀의 빛보다 재판관 손에 있는 작은 등불이 오히려 실의라는 의미와 더욱 부합했다.\n황금의 시대.\n'시본'은 잠시 아이린을 응시하다, 깔보듯 외면했고, 이미 인간의 것이 아닌 '알폰소'의 팔을 살살 문질렀다.\n잠깐의 침묵이 영웅의 주변을 감쌌다."
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……'시본'이라? 고약한 호칭이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "옛 이베리아인, 네 이름을 말하라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "이베리아의 재판관, 아이린이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "'옛 이베리아인'이라, 웃기는군. 네가 이베리아의 명예를 더럽히는 걸 용납할 수 없다. 나는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "어찌 감히 이리도 무엄하게 말을 하는 것인가?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(말을 끊으며) 크르르르……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "으윽!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "우리가 빅토리아의 함대를 불태우고, 사자왕의 명예를 호수 바닥으로 던져버렸을 때, 넌 어디에 있었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "내가 손수 배에 실은 순금이 살비엔토를 가득 채웠을 때, 넌 어디에 있었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "그리고, 군대가 검은 구름처럼 라이타니엔의 아침 햇살을 덮어버렸을 때, 넌 또 어디에 있었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "너……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "(격렬한 기침) 쿨럭쿨럭…… 쿨럭, 카악, 퉤.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "내 이름은 알폰소, 과거 이베리아의 공작이자, 대함대의 총지휘관, 스툴티페라 나비스의 함장이고, 나 자신의 왕이다. 보잘것없는 재판관 주제에, 감히 날 의심하는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……(불만스러운 듯 고개를 살짝 흔든다.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "무지한 국교회에서 바다를 건너 날 찾은 것을, 설마 칭찬해주길 바라는 건 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "돌아가라, 너희가 어떻게 왔든지 간에, '스툴티페라 나비스'는 너희를 환영하지 않는다. 가르시아…… 나의 일등 항해사, 저자들을 상대하지 말거라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "네가 흘린 이 피는, 저자들이 천배로, 이 바다에 돌려줄 것이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "일등 항해사",
      "text": "아…… (고개를 끄덕인다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "재판소를 모욕하는 행위는 이베리아에서 중죄다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……내 말을 못 알아들은 건가? 떠나라. 이 배의 사람들은 이미 모두 죽었다, 옛 이베리아인이여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "(포효하며) 우리가 그렇게 많은 대가를 치른 건……!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……이곳에 와 네 동의를 구하기 위해서가 아니야……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "시끄럽군…… 국교회 사람을 다시 만나니, 혐오감이 더 심해졌어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "중죄라고? 나약한 왕족 앞에서조차 아무것도 하지 못했던 국교회 따위가? 하……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "네가…… 만일 정말로 옛 이베리아에서 왔다면, 그럼 현재 국교회 교황은 누구냐? 카르멘인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "……! 성도님의 이름을 알고 있다니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "성도? 성도라…… 풉.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "하하, 성도? 하하하!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관 아이린",
      "text": "왜, 왜 웃는 거지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "놈은 부끄럽지도 않은 건가? 아니면, 교황이 될 용기조차도 없었던 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "어쩐지 너희들이 이곳을 찾는 데 60년이나 걸렸다 했더니, 재난이 옛 이베리아를 나약한 겁쟁이로 만든 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……하지만, 괜찮다. 늙은 선의가 산호로 변하기 전, 나와 옛 이베리아의 현 상황에 대하여 추측한 적이 있지. 우린 많은 가능성을 토론했었고…… 난 일찌감치 짐작하고 있었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "현재, 너희가 밟고 있는 바닥, 그리고 이 먼지 한 톨 없는 황금빛 홀, 이것이야말로 내 기억 속의 조국이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "이곳이야말로 이베리아다! 네 입에서 나온 국가는 너무 협소하다. 오로지 보고 싶은 것과 이해하고 싶은 부분만 있을 뿐이지, 퉷.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "한때는 테라 대륙을 마음껏 넘나들었던 국가가 이미 이렇게 나약해져 버린 것인가? 60여 년을 허비해서야 겨우 이곳을 찾을 정도로 겁이 많아진 건가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "알폰소가 계단을 내려왔다.\n아이린이 한 걸음 물러서니, 손안의 등불이 한바탕 흔들렸다."
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……그리고, 왜 에기르인이 두 명이나 있지? 나의 이베리아는 에기르를 환영하지 않는다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "무례를 범했군요, 선장님. 우린 단지 구역질 나는 괴물들을 쫓고 있었을 뿐이에요. 당신과 당신의 일등 항해사를 괴물로 헷갈렸을 뿐이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……당신은 어떻게 이곳에서 이렇게 오랫동안 살 수 있었던 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "잘 물어봤다, 멍청한 에기르인. 나와 놈의 사냥놀이도 오랫동안 지속되었다. 오늘, 혹은 내일이 본래는 수확의 날이었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "그런데 너희가 내 사냥감을 내쫓았지. 우린 또 그것들을 의지해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "……아니, 자…… 잠깐만!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "너…… 너는 에기르인이 아니잖아. 에기르인일 뿐만이 아니었어! 너희 모두 다 아니야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "네 이름은 뭐냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……스카디라고 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "아니, 아니다, 그렇지 않다. 에기르인, 날 속이지 마라. 우리가 이 배에서 몇십 년간 갇혀있긴 했지만, 멍청하지는 않지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "선장 알폰소",
      "text": "놈들은 널, 이샤-믈라라고 불렀다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "……종소리가 들리나요, 울피아누스?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "이 배가 아직 작동하는 부분이 있었다니, 정말 기적이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "이곳에서의 종소리는 사냥의 시작을 의미해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "누가 사냥꾼이고, 누가 사냥감이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "바다의 백성은 그런 것들은 염두에 두지 않아요. 만일 그들이 알폰소를 동포…… 허약한 동포로 인정한다면, 그들 스스로 피와 살을 바쳐, 강한 개체의 생존을 확보하려 할 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "헌터 한 명이 이곳으로 오네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "글래디아, 그 사람은 매우 민감해. 육지에서 배운 재주는 도움이 되지 않을 거야. 곧 나를 발견하겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "당신은 어떻게 할 계획인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "넌 어떻게 할 계획이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "반문하는 건가요? 저는…… 당신의 선택이 무척 궁금해요, 울피아누스.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "저는 저 자신이 더 이상 어비설 헌터스에 관심이 없을 줄 알았어요. 하지만 로렌티나가 제 마음에 쏙 들었죠. 저는 그 사람에게서 가능성을 봤어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "그리고 당신, 당신은 자발적으로 선택을 했고, 이성도 유지하고 있어요. 당신은 자각하고 있나요? 헌터님, 당신은 곧 우리와 별반 다르지 않게 될 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "당신은 진실에 다가설 수 있나요? 신탁을 포기하고, 신의 육체를 해부해서, 바닷속 신의 진상을 이해할 수 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "당신이 쫓는 답은 너무 매력적이에요, 저조차도 궁금하거든요. 후훗, 보세요. 저도 호기심이 있어요. 정말 유감이에요, 이건 제가 아직도 인간답다는 걸 말해주는 거겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "신탁은 그 자손의 본능 안에 새겨져 있지. 처음부터 우린 사고방식이 완전 달랐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "……어머.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아마이아",
      "text": "그 말을 들으니…… 당신은 저보다도 더 시본에 가까운 것 같네요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
