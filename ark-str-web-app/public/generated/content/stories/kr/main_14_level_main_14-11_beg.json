    {
      "type": "dialogue",
      "speakerName": "키사르투슈타지",
      "speakerId": "avg_npc_654_1",
      "isRemote": false,
      "text": "수천 년 동안 키사르투슈타지는…… 친족의 배신으로 수차례 죽어 왔습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "키사르투슈타지",
      "speakerId": "avg_npc_654_1",
      "isRemote": false,
      "text": "당신이 원한다면, 그걸 일종의 처벌이라 생각해도 좋습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "키사르투슈타지",
      "speakerId": "avg_npc_654_1",
      "isRemote": false,
      "text": "하지만…… 그게 어떻다는 거죠?"
