    {
      "type": "dialogue",
      "speakerName": "샤이닝",
      "speakerId": "avgnew_147_shining_1",
      "isRemote": false,
      "text": "눈앞의 어둠을 몰아내겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "마가렛",
      "speakerId": null,
