{
  "server": "kr",
  "storyId": "story_shotst_set_2_story_1",
  "groupId": "story_shotst_set_2",
  "stageId": null,
  "title": "딜레마",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_shotst_2_1.txt",
  "sourceHash": "2317e87d3659294ba3dc5c6d86c32a065afed1842eba3d5db80fafe65575af08",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "流星"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "다들 수고했어. 며칠 동안 길을 재촉했으니 오늘은 일찍 쉬도록 해. 임무 목표 지점까지는 25km 남았으니 내일 아침에 일어나서 서두르면 아마 오후엔 도착할 수 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "네, 메테오 언니도 수고했어요. 외근 나오면 건조식품만 먹을 줄 알았는데, 따뜻한 밥을 먹을 수 있을 줄은 몰랐어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "그러게. 요리 솜씨가 이렇게 좋을 줄이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "참, 메테오 언니, 텐트 칠 때부터 맛있는 냄새가 나던데, 오늘은 어떤 요리를 하는 거예요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "내 고향에서 먹던 가정식이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "가정식이라…… 대대로 전해져 내려오는 비법이라도 있는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그건 아니야. 난 어렸을 때부터 부모님이 안 계셔서 산 아랫마을에 사는 사람들의 도움으로 자랐거든. 다들 착한 분들이셨지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "이 수프는 그분들이 나한테 가르쳐 주신 건데 간편해서 야외에서 만들기 좋아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "아…… 쓸데없는 걸 물어서 미안해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그게 뭐 어때서, 괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "오, 엄청 맛있네. 레시피 좀 물어봐도 돼?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "물론이지. 간단한 재료만 있으면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "내가 방금 캔 고수 뿌리, 생강이랑 오후에 잡은 크로스스케일 핀을 절인 고기랑 소금으로 간하고, 끓는 물에 넣어 15분간 익힌 후 뚜껑을 열면 끝이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "다들 널 따라가면 후회할 일은 없을 거라는 게 이런 뜻이었구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아니야. 난 야외에서 만들 수 있는 간단한 요리를 좀 할 수 있을 뿐인걸. 마터호른 씨 같은 사람이랑은 비교도 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "후, 근데 가능하다면 스타 시트러스 씨를 좀 넣어주면 더 좋아. 약간 매운맛이 나거든. 이런 날에 그 씨를 넣은 매운 고깃국 한 그릇 먹으면 속이 따뜻해져.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "스타 시트러스……? 똑같은 이름의 희귀한 나무에 대해서 들어본 것 같은데. 명문 귀족들이 좋아하는 가구용 목재라 했던 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "아, 기억났어요. 카시미어에만 있는 나무일 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(하아……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니 고향이 카시미어잖아요. 본 적 있으면 얘기 좀 해줘요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "그래. 메테오 네가 살던 곳이 어떤 곳인지 알고 싶어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니? 메테오 언니, 왜 말이 없어진 거예요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "응?! 아, 고향 말이지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "떠난 지 너무 오래돼서 어떤 모습이었는지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "갑자기 생각이 안 나서 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "아, 아쉽네…… 잠깐만! 왜 때리는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "빨리 밥이나 먹어 이 녀석아. 안 그러면 키 안 큰다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니! 쟤 좀 봐요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그만, 시간이 늦었어. 수프 좀 더 먹어, 마터호른 씨가 만든 비스킷도 가져왔으니까 같이 먹어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "와, 대박, 고마워요, 메테오 언니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "먹고 일찍 쉬자. 난 조금 피곤하니까 먼저 가서 잘게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "여긴 어디지? 엄청 어둡네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "메테오, 메테오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "누구야?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "빨리 와, 메테오. 오랫동안 기다리고 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "누구?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "메테오, 따라와. 오늘 밤하늘엔 문섀도우가 있어. 성연 나무에 올라가면 두 개의 달을 볼 수 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "라나, 네가 어떻게 여기에 있는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "계속 여기서 널 기다리고 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "들어봐. 바람이 촉촉한 나뭇잎 사이를 지나며 나를 재촉하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "바람? 무슨 바람이 분다는 거야. 라나, 빨리 이쪽으로 와. 여기서 떠나지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "나는 갈게, 메테오. 빨리 따라와……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "라나, 빨리 돌아와! 어디로 가려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "빨리 와, 메테오. 내가 기다리고 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "라나가 왜…… 안 보이는 거지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "메테오! 메테오!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "어…… 아저씨, 아저씨가 여긴 어떻게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "뭐, 됐어. 참, 아저씨 혹시 라나 못 봤어? 방금 여기 왔었는데 어디론가 가버렸어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "너도 정신이 없구나. 라나는 병에 걸린 지 한 달이나 됐는데 어떻게 돌아다닌다는 거냐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "병?! 하지만 방금 그건 분명히 라나였는데…… 이상하다…… 아, 라나는 어때? 좀 나아졌어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "하아, 아직 나아질 기미가 안 보여. 아침에 흰죽 한 그릇을 겨우 먹었는데 분홍빛이 나는 걸 반 그릇이나 토해냈어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그럴 수가! 그럼 의사는, 아저씨, 의사는 다녀갔어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "메테오, 그게 바로…… 내가 오늘 너를 찾아온 이유란다. 더 이상 손을 쓸 수가 없어. 이번 가을은 너무 짧았고 겨울은 너무 길어서 아무것도 남아있지가 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "마을 아이들 여럿이 이미 심한 병을 앓고 있단다. 라나가 어서 약을 먹지 못한다면 이번 겨울은 나지 못할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "내가 저축해둔 게 좀 있어. 다 줄 테니까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……메테오, 그거로는 부족하단다…… 지나가던 어르신이 스타 시트러스 나무가 필요하니 나무를 주면 돈과 물자를 주겠다고 하셨어. 그게 있으면 우리는 이번 겨울을 날 수 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "성연 나무 숲을? 그 숲은 지금까지 우리 조상님들이 대대로 지켜오신 건데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "다른 나무, 다른 나무는 안 된대? 부탁할게. 조금만 더 기다려줘. 다른 방법이, 다른 방법이 있을지도 몰라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아니, 메테오, 다른 방법은…… 없어. 우리도 너처럼 그 숲을 사랑한단다. 하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "서글픈 목소리",
      "text": "살려줘, 메테오. 콜록콜록, 우리에겐 다른 방법이 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "앳된 목소리",
      "text": "메테오 언니! 살려줘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "노인의 목소리",
      "text": "메테오…… 이 할머니 좀 살려주거라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "초조한 목소리",
      "text": "메테오, 메테오!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아아아, 내가 구해줄게. 내가, 하아하아, 윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니, 왜 그래요? 악몽이라도 꿨어요? 괜찮아요. 괜찮아요. 우리 모두 여기 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "그래, 메테오. 물 좀 마실래? 한잔 가져다줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "후우, 너희들이었구나. 난 또……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "구조 임무의 스트레스가 너무 컸던 걸 거예요. 자, 메테오 언니, 땀 좀 닦아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "괜찮아, 고마워. 매일같이 길을 재촉한 것 때문에 긴장돼서 조금 지쳤었나 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "메테오, 무슨 일이 있으면 말해 줘. 우리가 꼭 도와줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "진짜 괜찮아. 서둘러 가야 하니까 정리하고 출발하자. 나는 괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "(고개를 젓는다) 됐어, 키이라, 그만 물어봐.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아펑, 목표 지점까지는 얼마나 남았지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "얼마 안 남았어. 3km 정도만 더 가면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "이런, 메테오 언니, 목표 지점 방향을 봐요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 B",
      "text": "연기가 저렇게 짙다니, 보고서 불이 났다는 얘기는 없었잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "키이라, 근처에 살아남은 마을 사람이 있는지 찾아서 같이 불을 꺼! 아펑, 약을 준비해두도록 해! 불이 이렇게 크게 났으니 분명히 다친 사람이 있을 거야! 빨리!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "알겠어요, 메테오 언니. 언니는요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "불이 난 곳 근처에 가서 다른 생존자가 있는지 찾아볼게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "그럼 메테오 언니, 조심해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그래, 너희도 조심해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(불길이 너무 세. 살아남은 사람이 있을지 모르겠어.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아무도 없어요? 들리면 대답해주세요! 아무도 없어요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아무도 없어요? 들리면 대답해주세요! 아무도 없어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "움직일 수 없는 마을 주민",
      "text": "메, 메테오구나! 어서 도망쳐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아저씨, 방금 여기서 큰 폭발음이 나서 서둘러 왔는데 이게 대체 무슨 일이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "움직일 수 없는 마을 주민",
      "text": "이쪽으로 오지 말고 어서 도망가거라. 기사님이 가져온 벌목기의 오리지늄 엔진이 폭발해서 여긴 온통 오리지늄 분진투성이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아저씨, 더 이상 말하지 마. 내가 응급처치해줄게. 그리고 여기 다른 사람들도 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "움직일 수 없는 마을 주민",
      "text": "아니다, 메테오, 내 말 듣거라! 빨리 도망가! 빨리 가지 않으면 늦을 거다! 그 기계는 언제든 다시 폭발할 수 있어. 그랬다간 너도…… 병에 걸릴 거야! 빨리 이곳을 떠나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아저씨, 나, 난 마을 사람들을 두고 갈 수는 없어. 버티고 있어. 내가 데리고 나갈게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 마을 주민",
      "text": "아, 눈이 너무 아파!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울부짖는 마을 주민",
      "text": "내 다리! 내 다리가 없어졌어! 도와줘! 살려줘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(어떡하지, 어떡하지, 어떻게 해야 하지. 크윽, 어떻게 해야 하는 거야!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "움직일 수 없는 마을 주민",
      "text": "계속 우두커니 서서 뭐 하는 거야! 빨리 가라니까! 여긴 위험해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "콜록콜록, 목이…… 컥…… 콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(손등에…… 피가 나고 있어. 다친 건가?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아저씨! 아저씨, 괜찮아? 아저……씨…… 다들……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "대답 좀 해줘. 콜록콜록, 대답 좀 해…… 흑.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "움직일 수 없는 마을 주민",
      "text": "메…… 테오…… 이리 와봐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아, 아저씨! 나 듣고 있어! 얘기해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "움직일 수 없는 마을 주민",
      "text": "그래. 콜록콜록, 모두 너에게 미안한 마음을 가지고 있단다…… 라나를…… 부탁하마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아저씨! 아저씨!",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "............"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "왜 이렇게 된 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "뭘 해도 틀린 일이고 소용이 없다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "어떻게……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "원래대로라면 이글거리는 공기 때문에 건조했을 자신의 얼굴에 촉촉한 물방울이 흐르는 것이 느껴졌다."
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(손등으로 뺨을 닦는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "으…… 제길, 이럴 때 갑자기 그때 일이 생각나가지고는.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "흐흐흐흑, 내 아가야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(무슨 소리지? 누가 울고 있나?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬픔에 빠진 여자",
      "text": "흑흑흑, 아가야. 이 바보! 왜 날 구했어? 난 죽게 두고 아이를 구했어야지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "여보, 내가 쓸모없는 놈이라 딸아이를 구하지 못했어. 흑흑, 아가야. 아빠가 미안하다. 흑흑.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "왜 아직도 여기 있는 거야, 빨리 이곳을 떠나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬픔에 빠진 여자",
      "text": "가라고? 어떻게 가라는 거야? 우린 못 가. 평생동안 일궈온 모든 게 여기서 무너지고 말았다고. 흑흑흑.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "아가씨, 난 다리를 다쳐서 걸을 수가 없으니, 내 아내를 데리고 가줘. 나는 신경 쓰지 말고, 빨리!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬픔에 빠진 여자",
      "text": "난 안 가. 흑흑흑흑. 죽어도 당신과 아이와 함께 죽겠어. 흑흑. 우리 아가야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "무슨 말이지? 방 안에 사람이 더 있는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "그래. 흑흑흑. 내 딸이 아직 안에 있어. 상황이 급박해서 아내는 구했지만, 내가 머저리 같은 놈이라 아이는, 아이는 버려두고 나와버렸어. 흐흐흑.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "알았으니 그만 울어. 아이가 집의 어디쯤에 있었는지 기억나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "이미 늦었어. 불길이 거세니 내 아내를 데리고 가. 아가씨가 어떻게 할 수 있는 일이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(남자의 옷깃을 잡아당기며) 어디에 있냐고!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "침실. 다, 다락 남쪽 끝에 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "알았어. 아내를 잘 돌보고 있어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "조심해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "슬픔에 빠진 여자",
      "text": "콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "괴로워하는 남자",
      "text": "여보, 여보 왜 그래! 누구 없어! 내 아내 좀 살려줘!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(불길이 너무 거세서 눈이 아파.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아가야, 들리니? 콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(다락 남쪽…… 아, 저기다!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "앗, 뜨거워…… 콜록콜록.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(걷어차서 부술 수밖에 없겠어.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(크윽, 연기가 너무 짙어서 아무것도 안 보여.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아가야, 콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "사…… 살려줘……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(장롱에서 들려오는 소리야!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "찾았다. 천만다행이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "의식이 흐린 여자아이",
      "text": "아빠…… 엄마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "벌써 의식이 혼미하구나. 견뎌내야 해. 내가 널 데리고 나가줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(여자아이를 안는다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "메테오는 뒤를 돌아보고 나서야 자신이 왔던 길이 이미 불에 집어삼켜진 것을 알아챘다.\n선홍색의 화염은 벽, 계단 그리고 문을 따라 점점 번져갔고 뜨겁게 타오르는 불길은 끊임없이 혀를 날름거리며 집 안에 있는 메테오와 아이를 집어삼키려는 듯 옷과 피부를 핥아댔다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(아, 어떻게 해야 하지!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "젠장…… 무너지겠어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "콜록콜록, 후우……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(등에 뭐가 떨어진 것 같아. 너무 아파. 맞다, 애는 어떻게 됐지!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(하아…… 다행이다. 아이는 괜찮아. 빨리 나갈 방법을 생각해봐야겠어. 일어나야 해)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아, 진짜 아프네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "의식이 흐린 여자아이",
      "text": "사, 살려…… 줘……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "내가 널 구해줄게. 꼭 구해줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(주변을 둘러본다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(저쪽에 기어나갈 수 있을 것 같은 구멍이 있어. 아마 방금 무너질 때 벽이 부서진 거겠지.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(이 구멍은 너무 작아서 나갈 수가 없겠어. 아이만 먼저 보낼 수밖에 없겠는걸.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니! 있어요? 콜록콜록, 어디 있어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "키이라!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "키이라구나! 여기야, 여기! 남쪽이야! 여기에 작은 구멍이 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니! 아, 보여요. 구멍이 너무 작아서 언니는 못 나올 것 같은데 어떡하죠, 흑흑.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "울지 마. 일단 난 신경 쓰지 말고 아이를 데리고 가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "애 잘 받아. 나무에 안 찔리게 조심하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "그럼 메테오 언니는 어떻게 할 거예요! 저는 가서 아펑 오빠 데려올게요! 기다려요! 꼭 버티고 있어요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "내 말 들어. 난 이미 늦었으니 신경 쓰지 마. 빨리 아이를 데려가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니, 아, 안 돼요. 방법이 있을 거예요. 꼭 같이 돌아갈 수 있을 거예요. 으아아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "으윽…… 안 되겠어, 키이라. 너무 무거워서 밀어낼 수 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "다시 해봐요. 내 손을 잡아요, 메테오 언니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "빨리 가, 안 그랬다간 너희들도 위험해질 거야!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "이런, 어서 아이를 데리고 떠나!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니!!!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "메테오……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "라나…… 오래 기다렸지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "(고개를 저으며 웃는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "미안해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "너도, 다른 사람들도 모두 구하지 못했어. 결국은…… 누구도 보호하지 못했어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "아니야. 이미 충분히 잘 해줬어. 이미 충분해…… 충분해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "나랑 같이 가려고 기다린 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "아니, 난 작별 인사를 하러 온 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "작별 인사?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "(껴안는다) 난 떠나야 해. 메테오, 따라오지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……떠나야 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "응. 울지 마. 넌 제일 용감한 사냥꾼이잖아. 넌 아직 해야 할 일도 많고, 많은 사람이 아직도 너를 필요로 하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "네가 정말로 그리울 거야. 정말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "나도야. 하지만 때가 됐어. 날 보내줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라나",
      "text": "그럼 안녕……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "메테오, 깨났구나. 좀 어때?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "미……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "그렇게 심각한 부상을 당하고도 살아남은 건 정말 기적이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "다음부턴 그러지 마. 임무를 수행할 때 자기 안위는 전혀 신경 쓰지 않으니까 나랑 지아나가 널 걱정하는 거잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "푸흡.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "아! 아파.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "어떻게 아직도 웃을 수 있는 거야! 등과 호흡기에 화상을 입은 데다 척추는 골절까지 됐어…… 더 말해줘?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "네가…… 호되게 혼낼 거라…… 생각했어. 콜록콜록!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "뭐? 날 그런 사람으로 봤단 말이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "윽…… 후우, 미안해, 미나. 너하고 의료부 사람들에게 폐를 끼치고 말았네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "미안할 게 뭐 있어. 우리도 해야 할 일을 했을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "읏…… 그래도, 미안해. 다시는 안 그러겠다고 약속할 수 없어서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "너……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "이번엔 의료부가 전력을 다해서 널 살려냈지만 다음엔 어떻게 될지 우리도 장담할 수 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "난…… 그런 일이 일어나는 걸 보고만 있을 수가 없어. 난…… 누군가가 그런 처지가 되는 걸 절대 보고 싶지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……이러지도 저러지도 못하는 처지 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "누구라도 헤어지거나 잃는 선택을 강요받아선…… 안돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "난 못 해. 그냥…… 못 할 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "……메테오, 아직도 옛날 일을 마음에 담아두고 있는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "너에겐 아무것도 숨기질 못하겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그때 난 지켜오던 숲을 희생하면 라나와 마을 사람들의 평화로운 삶을 되찾을 수 있을 거라 생각했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "하지만 운명은 너무나도 탐욕스러웠고, 내가 양보한 것보다 더 많은 걸 원했지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그리고 끝내 내가 가진 모든 걸 가져가려 했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "전에도 얘기했지만 이미 지나가 버린 일을 계속 붙들고 있는 건 좋지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……그렇지. 나도 그걸 모르는 건 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "라나가 병으로 죽은 후에 나는 라나의 활을 들고 다른 광석병 환자들과 같이 그 숲을 떠났어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "떠도는 동안 무책임하게 떠나버린 귀족을 증오하며 오랜 시간을 헛되이 보냈어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그리고 사랑했던 사람들과 소중한 것들을 지키지 못한 자신도 증오했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "하지만 내가 너를 처음 만났을 땐 그런 상태가 아니었잖아? 무슨 일이 있었던 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "많은 것을 보고 생각이 달라졌어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "같이 다니던 사람들은 하나둘 떠나갔고, 나 혼자 남아 아무런 목적 없이 떠돌아다녔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "이 땅에는 나와 같은 일을 겪은 사람들이 아주 많다는 걸, 모두 이런 절망적인 딜레마 속에서 발버둥 치고 있다는 걸 차츰 알게 됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그러니 어떻게 다른 사람이 나와 같은 고통을 받는 걸 보고만 있겠어. 그래서 난 기꺼이 그 사람들을 위해 헌신하는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그 사람들이 웃음을 되찾는 걸 보면 내 마음이 다시 채워지는 느낌이 드니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "……그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "네 생각이 그렇다면…… 나도 뭐라 할 말이 없네. 네가 기절했던 동안 지아나가 계속 곁을 지켰으니까 고맙다고 하는 거 잊지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "난 일이 있어서 먼저 가봐야 돼. 잘 쉬어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "지아나, 메테오 언니는 방금 깨어났으니까 나중에 만났을 때 메테오 언니한테 막 달려들면 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지아나",
      "text": "알겠어, 키이라 언니. 메테오 언니한테 주려고 장미를 병 하나 가득 채울 정도로 접었어. 한 송이마다 좋은 말도 써놨으니까 이걸 주면 메테오 언니가 금방 좋아질 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "(웃으며 고개를 가로젓는다) 쟤도 참.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "메테오 언니, 미나한테서 깨어났다는 말을 들었어요. 몸은 좀 어때요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지아나",
      "text": "메테오 언니, 어, 언니, 으아앙…… 드디어 깨어났구나. 진짜 무서웠어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "지아나, 울지 마. 언니는 곧 나을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지아나",
      "text": "……응. 이 병 언니 주려고 가져왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "이게 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "말도 마세요. 메테오 언니가 기절해 있을 때 지아나가 엄청 오랜 시간을 들여서 접은 거예요. 잠에 잠도 안 자고 접다가 미나한테 몇 번이나 걸렸다니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "……미안해, 지아나. 내가 걱정시켰구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지아나",
      "text": "메테오 언니, 미안하다는 말은 안 해도 되니까 다시는 다치지 않겠다고 약속해줘. 언니를 다시는 보지 못할까 봐 너무 무서워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오",
      "text": "그럴 일은 없을 거야, 지아나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지아나",
      "text": "으아아앙, 메테오 언니!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외근 오퍼레이터 A",
      "text": "지아나, 그만 울어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
