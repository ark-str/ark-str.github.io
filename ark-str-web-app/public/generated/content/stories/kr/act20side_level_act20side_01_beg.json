    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerToken": "avg_4054_malist_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "……적응이 너무 빠른 거 아니야?!"
