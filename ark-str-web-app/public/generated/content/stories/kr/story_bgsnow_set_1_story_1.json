{
  "server": "kr",
  "storyId": "story_bgsnow_set_1_story_1",
  "groupId": "story_bgsnow_set_1",
  "stageId": null,
  "title": "먹물 자국",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/memory/story_bgsnow_1_1.txt",
  "sourceHash": "54d5a0a89f064b54405e7d2b8c7cd95e66314b14a799a7828611a218d363ee42",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "이것이 의뢰의 세부 사항이야. 장담하는데 한 글자도 빠짐없이 적었다."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "확신할 수 있어? 특히 맨 뒤의 이 부분, 엄청 작게 말했었잖아. 제대로 들은 거 확실해?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "글쎄."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "벌써 보름이나 지났는데, 그때 작게 말했다는 건 어떻게 기억하는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "이상하지 않아? 처음에는 만년필이 필요하다면서 우리 스타일대로 만들어달라고 했었잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "뒤에 있는 이 말, 정말 우리에게 한 말 맞아? 혼잣말 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "글쎄."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "……아, 잠깐만. 벌써 보름이나 지났다고?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "그런데 우린 아직 시작도 안 했고?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "겨우 보름일 뿐이잖아. 그때는 내 연필도 제대로 안 깎아놓은 데다…… 벌꿀주도 다 마셔버렸었으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "그렇긴 하지. 자, 우선 한잔하자고."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "건배! ……끅. 형씨, 그 요구 사항은 대체 무슨 뜻이었을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "이 단어들을 봐…… 엄청 강하고, 엄청 차갑고, 엄청 무겁다는 뜻이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "음, 그렇다면 모종의 금속으로 만들어진 커다란 무기라는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "거기에다가 만년필의 디자인을 약간 더해주는 거지."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "약간이면 된다고? 그럼 이 부분에 더하면 될 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "그래! 그냥 대충 선을 그은 것뿐이지만 멋진 스케치인 것 같아!"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "그래서 이게 뭔데?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "보기에는…… 석궁 같아. 넌 어떻게 생각해?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "비슷하긴 하네. 구조를 디자인해 봐야겠어. 날 믿어, 분명 위대한 작품이 될 거야, 《기담괴론》에 기록된 그 무엇보다도 더."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "당연히 그래야지. 아니면 어떻게 지상인을 만족시킬 수 있겠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "맞는 말이야. 다시 건배!"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족?",
      "speakerId": null,
      "text": "오늘의 작업이 끝난 것을 축하하며!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "“……그건 쎄루에르차 역사상 가장 커다란 형광 버섯이었다.”"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "하아, 《전설의 탐험가가 밝히는 쎄루에르차의 비밀》에도 쓸만한 정보는 없네요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "3년 전의 17판 광산 노선도로는…… 이 도시가 어떤 일을 겪었는지, 권력자들이 어떤 야심을 품고 있었는지 보여줄 수 없어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "어쩌면 더 이른 시기의 외부인이 남긴 서적을 찾아봐야 할지도 모르겠네요. 아니면 두린어를 배워야만 이 조각조각 거짓으로 포장된 낱말 속에서 쎄루에르차의 역사를 찾아낼 수 있을 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……어찌 됐건, 내가 직접 목도한 건 거짓이 아닐 테니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이곳 사람들은 진짜 하나같이 주정뱅들 뿐이에요!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아니죠…… 난 이미 그곳에서 빠져나왔어요…… 그 땅은 이제 잊어야 합니다."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이 두린족들 역시 똑같을지도 몰라요. 공통적인 고통스러운 기억이 있고, 그래서 다 같이 술을 마시는 것으로 도피하는 거죠."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "저들의 고통과 금기를 이해하지 못한다면 저들 사이에 녹아들 수 없어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "겉으로는 무사태평해 보이지만, 속으로는 날 받아들이지 않고 있어요. 심지어 적의로 가득하죠."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그렇지 않다면 보름이 지나도록 의뢰한 만년필이 아무런 소식도 없을 리 없잖아요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "안녕, 아브도티야. 무슨 일이라도 있는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……아, 죄송합니다. 제가 도서관에서 너무 시끄럽게 굴었죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "길고도 외로운 여정을 겪고 나니 혼잣말하는 습관이 잘 고쳐지지 않네요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "취한 목소리",
      "speakerId": null,
      "text": "자…… 이거 봐! 내가 뭐라고 했어! 우리가 견과류 아이스크림 먹기 시합했던 건 1201호에 실린 게 맞다니까!"
    },
    {
      "type": "dialogue",
      "speakerName": "비교적 차분한 목소리",
      "speakerId": null,
      "text": "아니, 책이 뒤집어졌잖아. 이건 1051호야. 게다가 이 사진은 너도 아니고."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "네 목소리가 그렇게 큰 편도 아닌 걸."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "그나저나 전에 도서관의 로봇이 무슨…… 군사 시설 같아서 봐 무섭다고 했잖아. 그래서 네게 다가오지 말라고 해놨어."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "찾고 싶은 책이 있다면 나한테 얘기하면 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "고맙습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "제게 도서 분류법을 알려주시면 그걸로 충분해요. 그럼 필요한 책을 직접 찾을 수 있을 테니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "음, 도서 분류법이라…… 거기에 대한 책이 있었던 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "하지만 지금 어디에 있는지는 기억나지 않아. 잠깐만, 사다리 좀 가져올게."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "분류법에 어디에 두어야 하는지는 정해져 있지 않나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "음, 그것도 기억이 잘 안 나네."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "왜냐하면 80%의 책이 분류법에 맞지 않는 곳에 놓여 있거든."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "도와주지 않으셔도 괜찮을 것 같아요. 감사합니다."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그냥 거리를 좀 돌아보고 올게요. 당신들에게 녹아들 수 있는 방법을 찾을 수 있을지도 모르니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "아브도티야, 도서관에 있는 걸 이렇게 좋아하는데, 쎄루에르차를 위해 책을 써볼 생각은 안 해봤어?"
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "《기담괴론》에 기록된 것과 같은 지상인들이, 이 두린족의 도시를 어떻게 생각하고 있는지 궁금한데……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "쓰고 싶지는 않아요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "내…… 내가 실례되는 말을 했나?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아뇨. 그냥 제 스스로 마주해야 할 문제일 뿐이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "지상에서의 기억에서 완벽하게 벗어나기 위해, 과거에 했던 것과 비슷한 일은 하기 싫거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "아쉽네. 넌 문학가가 되고 싶은 게 아니었구나. 그럼 탁 트인 곳에 가서 한 번 돌아다녀 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "읽던 책은 전부 저 책장에 두고 가면 돼. 그리고 나갈 때 조심해. 요즘 입구에서 술 취한 두린족들이 늘 경주를 하거든."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……알려줘서 고마워요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "참, 궁금한 게 있어요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "무슨 일인데, 아브도티야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "두린족들의 성씨에는 어떤 규칙이 있나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "별다른 규칙은 없어. 예를 들자면 내 성은 실버민트잖아. 장로님의 성은 어스하트고……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "전부 사물의 이름에서 비롯된 거군요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "(두린족들에게는 평범한 성씨겠지만, 나는 단어 속의 의미와 은유를 지나칠 수가 없어.)"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……고마워요, 이해했어요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "모든 곳을 비추는 인공 햇빛과 영원히 겨울이 찾아오지 않는 도시."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "어떻게 해야 내 몸에 배어든 눈보라의 기운을 숨기고 두린족의 날카로운 시선을 벗어날 수 있을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "만약 과거의 모든 것을 털어내고 추방도 배신도 없이 저들의 지붕 밑에 머물 수 있다면…… 더 바랄 게 없을 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……도착했네."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그 두 장인의 집이 이쪽이었던 걸로 기억하는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……응?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "커다란 미끄럼틀…… 하지만 올라갈 수 있는 사다리가 없어……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "울타리가 없는 반쪽짜리 트램펄린……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……이것들은 다 뭐지?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "안녕하세요. 여기는…… 어째서 반쪽짜리 놀이 기구만 모여있는 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그리고 예전에 이곳에 주문 제작을 하는 장인들이 있었지 않았나요……"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "오! 한 명 더 잡았다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……잡았다고요? 절 어디로 잡아가려는 거죠?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "당연히 투표 현장이지!"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "오! 그렇게 놀라는 걸 보니, 너도 은둔형 외톨이인가 보지? 이 거리의 재건 대회를 놓치다니!"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "벌써 세 번째 시합 작품이라고."
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "이 거리를 어떤 식으로 재건할지 투표하기 위해, 이번 대회는 새로운 규칙을 도입했어."
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "모든 참가자가 자신이 디자인한 설계도의 반쪽만 짓는 거야. 그리고……"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "……관객들이 '완성본을 가장 보고 싶은 디자인'에 투표하는 거지!"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "어때? 더 매력적이지 않아?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아니요, 전 그냥 원래 이 거리에 있던 사람이 어디로 갔는지가 궁금해요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그대로 추방당한 건가요? 아니면 두린족의 어두운 광산에 유배당한 건가요?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "자, 투표하러 가자!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "만약 이게 두린족의 생활 방식이라면, 거절할 수 없겠죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "하지만 전 키가 크니 사람들 사이에서 눈에 띌 거예요. 만약 제 선택이 대다수 사람의 선택과 다르면…… 두린족들은 절 어떻게 생각할까요……"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "맞네, 넌 키가 크니까"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "투표 기록 담당자로 딱이겠어!"
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "미리 기록원 세 명을 찾아두기는 했는데, 오늘 잔뜩 취해서 세 명 다 안 왔거든."
    },
    {
      "type": "dialogue",
      "speakerName": "흥분한 두린족",
      "speakerId": null,
      "text": "그래서 지금 기록원 자리가 비어있어."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……알겠습니다. 그럼 어서 가죠."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……'슈퍼 알코올 회오리 범퍼카', 20표!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그리고 기권표, 309표!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "절반이 넘는 사람이 아무것도 선택하지 않았네요!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……하아, 두린족의 대화 방식은 너무 흉내 내기 힘들어."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "내가 아무리 두린족의 삶에 녹아들고 싶다고 해도…… '기록' 같은 단어를 내 성씨로 삼기는 싫어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "역시 기권자가 많군. 아무래도 네 번째 시합을 할 수밖에 없겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "놀이 기구는 이제 유행이 끝난 거 아니야? 다음에는 조각상을 주제로 하는 게 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "흐음, 어차피 내 디자인이 네 것보다는 항상 인기가 많으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "시합에 참여한 디자이너니까 저 거리에 익숙하시겠네요?"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "당연하지."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그럼 보름 전에 저 거리에 있던 두 명의 장인이 운영하던 가게를 알고 있나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그 가게에 만년필을 의뢰했는데 그대로 사라져 버렸거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "오……"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "아무래도 그거겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "그렇겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "뭔가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "실수로 네 의뢰를 잊어버린 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "네?"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "그게 아니었다면 집을 허물 때 너한테 연락해 줬을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "하지만 그런 사소한 일은 잊어버려도 별문제 없으니까 걱정하지 마."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "제게는 중요한 일이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "오, 만년필 애호가구먼!"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "서예를 좋아하는 거야, 아니면 글을 쓰는 걸 좋아하는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "저는……"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "자자자. 왜 그렇게 우거지상이야? 어차피 큰 공사를 할 때는 취하지 않은 장인이라면 다들 도와주러 온다고. 그때 녀석들을 찾을 수 있을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "예를 들어 이 시합의 결과가 나올 때쯤 말이지."
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "참, 시합이라고 하니 네가 내게 영감을 줄 수도 있을 것 같은데! 어서 알려 줘. 지상은 어떤 모습이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "이봐, 그건 내가 물어보려던 거란 말이야!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "그러면 지금 투표해 보는 건 어때? 지상으로부터의 영감을 누구에게 줄지 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "좋아."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……잠깐만요. 그럴 필요 없어요."
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "말하고 싶지 않은 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……두 분께 들려드릴게요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "전 그냥 누구든 모든 두린족을 납득시킬 수 있는 디자인을 뽑아낼 수 있기만을 바랄 뿐이에요. 그래야 제가 의뢰를 맡긴 두 장인을 빠르게 찾을 수 있을 테니까요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "찾아서 죽인다고?"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "아…… 알겠다! 그러니까 다른 사람을 방해할 수 있는 추월 레이스 말이구나!"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "높은 벽! 하지만 좁은 길에서 대치 상황!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "커다란 연회장에서 모두가 취해서 쓰러지는 거지!"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "폭력! 엄청난 폭력!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "아이디어가 떠올랐어! 어서 가자!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "두린족들은…… 설마 정말 '찾아서 죽인다'와 '독을 쓴다'라는 말이 뭔지 모르는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그런데 난……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "잠깐만. 나 방금 이 추악한 지식을 저들에게 알려준 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "“그녀의 마음속에 떠오른 것은…… 차가운 공기를 차단하는 높은 돌담이었다. 인테리어 액자가 가득한 복도에는 뜨거운 음식과 술이 차려진 테이블이 놓여 있었다……”"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "“하지만 이곳에서 시작되는 그녀의 문장은 높은 벽을 무너뜨렸고, 자애로운 그림은 불길 속에서 타올랐으며, 붉은 술은 새하얀 냅킨을 물들였다.”"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이미 엎지른 물이야. 죄악이 가득한 생각은 시작된 이상 끊을 수 없어. 지금 내가 할 수 있는 건……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "저들이 쎄루에르차에 이 이야기를 퍼뜨리지 못하게 막는 것뿐이야!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "왜 예전에는 이런 생각을 떠올리지 못했던 거지! 분명 이런 시합 방식이 있는데 말이야!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "맞아. 이러면 오래도록 서로 겨룰 수 있겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "이게 바로…… '초대형 물대포 대결'이다!"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "봐, 모든 창문에 물총을 배치했어. 길 맞은편에 있는 네가 디자인한 작품을 쏠 수 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "하지만 모두가 가장 원하는 시설로 우리 둘 중에 한 사람만 뽑히게 된다면, 대결할 수 없게 되잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "아, 그렇네."
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "그러니까 우리 둘이 팀으로 네 번째 시합에 참여하는 게 좋을 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "좋은 생각이야!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "술통을 안고 있는 두린족",
      "speakerId": null,
      "text": "새로운 벌꿀주 판매를 도와주고 싶다고? 음…… 넌 누구야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "저…… 저는 술을 좋아하는 사람이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "술통을 안고 있는 두린족",
      "speakerId": null,
      "text": "오…… 우리가 만든 벌꿀주를 좋아하다니, 뭘 좀 아네."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이곳에 온 뒤로 두린족들이 이런 술을 마시는 걸 본 적이 있어요. 한 잔이면 쓰러지는 것 같던데…… 분명 엄청나게 독한 술이겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "술통을 안고 있는 두린족",
      "speakerId": null,
      "text": "하하하, 맞는 말이야. 나도 두 잔이면 며칠은 취해 있다고!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "제 생각엔, 당신의 잔이 좀 큰 게 아닌가 싶은데요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "하지만 정말 좋네요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "일이 급해서 미룰 수 없으니 지금 바로 술을 가지고 출발할게요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "(홍보 형식이라면 두 디자이너에게 술을 계속 줘도 의심하지 않을 거야. 오히려 신나게 마시고 잔뜩 취하겠지)"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "(디자인 대회의 마감일을 놓치게 만들면…… 그들의 디자인을 통해 지상의 이야기가 퍼질 일도 없을 거야. 어쩌면 완벽하게 잊을지도 몰라.)"
    },
    {
      "type": "dialogue",
      "speakerName": "술통을 안고 있는 두린족",
      "speakerId": null,
      "text": "좋아. 우리의 순조로운 홍보를 위해, 일단 건배!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "잠시만요, 저는 술을 마셔 본 적이 없는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "(방금까지 그렇게 날카로운 눈을 했으면서, 왜 이 타이밍에 술을 마시자는 걸까요? 대낮부터 잠들어 버릴 수는 없어요.)"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아니, 그러니까…… 일하려면 맑은 정신을 유지하고 있어야 하잖아요. 그러니 건배는 나중에 해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이, 이만 가볼게요!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "거기 두 분, 한번 시음을……"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "오, 오!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "핀치 씨, 훌륭해!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……할 생각이 없군요."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "엄청나잖아, 우아하고 간결한 건축 라인이라니. 불필요한 곡면 때문에 공간이 낭비되는 일도 없을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "게다가 핀치 씨의 말대로 디자인을 마치면 이 상가 거리의 채광도 인조 직사광선과는 좀 달라질 거야. 그런 빛 속에서라면 상품들도 더 매력적으로 보이겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "핀치 씨의 천재적인 디자인을 하루빨리 보고 싶어!"
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "처음에는 거기에 놀이 시설을 만들고 싶긴 했지만 말이야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "무대 위의 목소리",
      "speakerId": null,
      "text": "그럼 이 디자인에 동의하시는 분은 손을 들어주세요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……엄청 많잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "대충 봐도 대부분이 지지한다는 걸 알 수 있겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "하지만 저 디자이너, 무대에서 계속 두린족들의 생활 방식을 질책하지 않았었나?!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "하아, 그럼 우리 디자인은 물거품이 됐네."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "핀치 씨의 말이 맞긴 해. 지금 쎄루에르차의 4분에 1이 놀이 시설이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "기대하는 두린족",
      "speakerId": null,
      "text": "어, 키다리, 언제 왔어? 핀치 씨의 연설 들었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "네, 조금은요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "예전에 그 디자인은 포기했다고 들었는데요……"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "새로 빚은 벌꿀주잖아! 이 향, 확실해!"
    },
    {
      "type": "dialogue",
      "speakerName": "편안한 두린족",
      "speakerId": null,
      "text": "우리도 이제 꽤 친한 사이니까, 사양하지 않을게!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아, 방금 그 연설자가 말했던 '절제하는 삶'이 뭔지 전혀 이해하지 못한 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……하지만, 이런 것도 나쁘지 않네요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "비켜, 저리 비켜! 이건 핀치 씨가 우리에게 만들어달라고 했던 판매 차야. 이제 성능을 시험해 볼 시간이라고!"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "달려, 더 빨리! 앞쪽에 있는 복도 기둥을 끼고 급커브!"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "커브를 돌기엔 공간이 부족하지 않나?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "그럼 충돌 테스트나 한번 해보자고."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "음, 안전한 편이네. 뒤쪽의 적재함에 아직 아무것도 없어서 그럴 수도 있어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……안녕하세요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이 거리 공시가 시작된 뒤로 계속 기다렸어요."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "응? 음…… 뭔가 익숙한 사람인데."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "어이, 누군지 기억나?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "뭐라고?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "모처럼 바닥에 누웠으니 한숨 자야겠는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "하아, 다시 알려드려야겠네요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "저는…… 그러니까 제가 아는 사람이 이 거리에서 두 장인에게 두린 스타일의 만년필을 만들어달라고 의뢰했어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그 사람의 짐에는 책이 담겨 있었고, 머릿속에는 고향의 언어가 있어요. 하지만 더는 건드리고 싶어 하지 않아요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "펜을 드는 순간, 눈에 젖은 망토를 두른 자신이 보낼 곳 없는 편지를 써 내려가던 모습이 떠오르거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "왜 보낼 곳이 없는데? 이웃 마을로 향하는 길이 전부 끊어진 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……죄송해요. 주제를 벗어났네요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아무튼 자신이 봉인한 과거를 기념하고 싶어 했어요. 그리고……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "음, 그리고 뭐……"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "서기라도 되고 싶은 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그건 과거와 완벽하게 작별한 게 아니에요."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "그럼 그 사람은 그 만년필을 원한다는 거야, 원하지 않는다는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……됐어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이 이야기에서 그녀는 벌꿀주 판매원이 되는 걸로 하죠! 그리고 모두와 함께 즐겁게 술을 마시는 거예요. 술 향기가 인공 호수 전체를 가득 채우는 거죠!"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "오, 정말? 좋은 결말이야! 마음에 들어!"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "다행이야. 차에 다른 건 없지만 벌꿀주 두 통은 있었네."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "뭐라고? 네가 가져온 거야? 빨리 말했으면 진작 일어났을 거라고."
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "자, 건배!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……저도 한 잔 주세요. 감사해요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "사실 20일 전에 두 분께 만년필을 만들어달라고 했었어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그래서…… 제 만년필은요?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "아아, 앗! 너였구나, 생각났어!"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "완성하기는 했는데, 누가 의뢰했는지를 까먹어서……"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "……잠깐만. 만년필?"
    },
    {
      "type": "dialogue",
      "speakerName": "게으른 두린족",
      "speakerId": null,
      "text": "우리가 만든 건 만년필이 아니었던 것 같은데?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "엄밀히 말하자면 만년필인 부분도 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "하지만 전체적으로 봤을 때, 우리가 만든 건 석궁이야."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "석궁이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "제가…… 왜 무기를 원하겠어요?"
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "누구의 의뢰였던 지는 까먹었지만, 그때 했던 말은 아직도 기억나."
    },
    {
      "type": "dialogue",
      "speakerName": "꼼꼼한 두린족",
      "speakerId": null,
      "text": "너무 생생한 묘사였거든. 어째서 만년필로 심장을 찌르는지는 알 수 없었지만, 마치 가슴에 화살이 박힌 것처럼 아팠어!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……네?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……그래요. 역시 다시 만년필을 만들어 주세요. 그리고 타자기도 필요해요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "아브도티야, 또 왔네."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "네. 두린족들 사이에서 유행하는 잡지를 찾고 있어요. 어떤 슬로건이 매력적인지 궁금해서요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "그런 책은 입구에 있는 책장에 있어. 아마 맞을 거야, 매일 많은 사람이 보는 책이니까!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "감사합니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "맞다, 아브도티야. 아브도티야…… 최근 어디선가 네 이름을 본 것 같은데?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "네. 투고를 위해서 두린족 스타일을 흉내 제 성씨를 만들어 봤거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "그렇다면 최신 잡지에서 봤었겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "더는 글을 쓰지 않는 줄 알았는데 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……두 명의 두린족이 제게 과거의 추억을 봉인하기에 더 적합한 소장품을 만들어 줬거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "만년필과 타자기는 계속 사용해도 나쁠 것 없으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "디컬처 실버민트",
      "speakerId": null,
      "text": "아, 찾았다! 아브도티야……"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……'라조르펜'."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "저는…… 계속 글을 쓸 수밖에 없어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "왜냐하면, 모든 걸 진정으로 버릴 수는 없다는 걸 알았거든요."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
