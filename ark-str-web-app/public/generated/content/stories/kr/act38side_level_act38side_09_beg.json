      "type": "dialogue",
      "speakerName": "안토니오",
      "speakerId": "avg_npc_1544_1",
      "isRemote": false,
      "text": "그럼, 시작하죠."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "56_g6_courtsquare_n"
    },
    {
      "type": "dialogue",
      "speakerName": "'카르네발레 행인 A'",
      "speakerId": "avg_npc_1557_1",
      "isRemote": false,
      "text": "해피 카르네발레! 경찰 선생님, 풍선 받으세요!"
