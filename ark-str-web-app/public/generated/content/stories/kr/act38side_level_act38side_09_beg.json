    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "56_g14_governmentoffice_n"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerId": "avg_4065_judge_1",
      "isRemote": false,
      "text": "몇 시인가요, 텍사스?"
