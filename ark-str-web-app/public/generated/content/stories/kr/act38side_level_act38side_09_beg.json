    {
      "type": "dialogue",
      "speakerName": "드미트리",
      "speakerId": "avg_npc_690_1",
      "isRemote": false,
      "text": "언제나처럼."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_wilderness_n"
    },
    {
      "type": "dialogue",
      "speakerName": "레드",
      "speakerId": "avg_npc_1549_1",
      "isRemote": false,
      "text": "할머니, 괜찮아?"
