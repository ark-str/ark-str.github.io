    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "speakerId": "avg_1028_texas2_1",
      "isRemote": false,
      "text": "자, 네가 달라던 위스키. 얼음도 넣었어."
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "speakerId": "avg_4065_judge_1",
      "isRemote": false,
      "text": "고마워요."
