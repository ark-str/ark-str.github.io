    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "순찰 중인 호위병",
      "speakerId": "avg_npc_1637_1",
      "isRemote": false,
      "text": "호부의 당 대인이셨군요, 실례가 많았습니다."
