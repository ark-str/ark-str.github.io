    {
      "type": "dialogue",
      "speakerName": "아나트",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그래도 전 긴장…… 앗, 갑자기 왜 귀를 만지는 건가요?!"
    },
    {
      "type": "dialogue",
      "speakerName": "메제티케티",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "지금은 좀 나아?"
