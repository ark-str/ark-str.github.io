  "blocks": [
    {
      "type": "narration",
      "text": "第十一关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "리유니온의 포위망을 돌파했다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "하지만… 놈들은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "…나… 는… 으읍…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "쉿.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "…아미야가 들어선 안 된다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "아미야도 알고 있을 거다! 저 아이는 우리가 생각하는 것보다 훨씬 성숙해져 있다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…으으…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…으응…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "그렇다고 해도 아미야에게 알려줄 순 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아미야를 더 괴롭게 하는 건 현명한 선택이 아니다. 아미야는 이미…너무 많은 것을 짊어지고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "동료들의 노력을… 헛되게 할 수는 없어!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "다른 동료들이 목숨을 바쳐 우리를 구해준 이상, 우리는 박사와 아미야를… 무슨 일이 있더라도 안전한 곳까지 데려가야 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "맞는 말이군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아직 침울해하고 있을 때가 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "기사라면, 어떤 일이 있더라도 사람들을 인도하는 빛이 되어야 하지 않나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "…난 잘 모르겠다. 하지만 내가 할 일은 해야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "대열을 갖춰라! 신속하게 움직여! 곧 도착이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "훗…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "생각해보니… 나한테 안심하라고 했던 놈들은, 이제까지 누구 하나 돌아오지 못했군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "{@nickname} 박사님…? 무슨 일이… 있었던 건가요…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저, 저 좀… 내려주세요…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 괜찮아요. 혼자 걸을 수 있어요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "잠시… 의식을 잃었을 뿐이에요… 이제 괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…탈출에 성공한 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "에이스 씨와 다른 분들은…",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "그렇게 되었군요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "괜찮아요. 에이스 씨라면 문제없을 겁니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "로도스 아일랜드 분들은 모두 강하니까요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "이제 곧 남쪽 출구네요. 체르노보그에서 탈출만 하면 우리는……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "우리는…… 그걸로……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "박사님…… 잠시…… 기대도 괜찮을까요……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "잠시…… 아주 잠시만이라도 좋으니까……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "탈룰라",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "탈룰라",
          "text": "성가신 녀석이군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메피스토",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메피스토",
          "text": "이렇게까지… 싸울 수 있을 줄이야… 이 녀석…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메피스토",
          "text": "거리의 절반이 숯덩어리가 되고, 광장은 불바다에… 강철도 다 녹아 흘러내렸건만…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메피스토",
          "text": "그런데 어떻게…… 이 녀석은 아직 싸울 수 있는 거지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "뼈가 가루가 될 때까지 싸울 생각인가…… 훌륭하군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "탈룰라",
          "text": "기억해 두도록 하지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "탈룰라",
          "text": "…로도스 아일랜드.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
