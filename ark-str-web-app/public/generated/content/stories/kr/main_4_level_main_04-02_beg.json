  "groupId": "main_4",
  "stageId": "main_04-02",
  "title": "빗 속을 거닐며",
  "storyCode": "4-2",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_04-02_beg.txt",
  "sourceHash": "5fb81630c4146bfd20baf00770378141fb2b435c0552f22441a248fb1f09f41a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "아, 아직 적이 두 명 남았습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "동쪽에서 건물을 향해 도주 중…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "이미 조준하고 있다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온멤버",
      "text": "으아악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "정중앙에 맞혔네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "소리가 좀 요란한 거 아닌가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "이 버려진 도시에선 여기저기서 폭발음이 계속 들리잖아. 적도 그렇게 신경 쓰지는 않지 않을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "켈시 선생님한텐 연락 드렸어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "전투 돌입 전에 이미 연락해뒀지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "여기서 리유니온의 활동을 증명하는 흔적이 발견되었다고 말야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "사실, 지금도 통화 중이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그보다 우리, 좀 더 은밀하게 행동해야 하지 않을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아까 마주쳤던 리유니온은 탐색형 아츠를 쓰고 있던 것 같았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "우리 위치가 발각되기 전에 선제공격을 할 수밖에 없었다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "적어도 다른 동료에게 연락을 취하지 못하도록 막아야 하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "후우… 이제야 겨우 정리됐네요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "프로스트리프, 정찰을 부탁해. 상황을 확인해줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "잠깐 통신기 좀 맡아줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "제시카, 아직 한숨 돌릴 때가 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "그 정도는… 저도 알아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "그래 그래. 이제 잔소리 안 할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "켈시 선생님, 들리세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "계속 듣고 있었다. 네 말대로 아직 한숨 놓을 상황은 아니군…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "제시카, 네 뒤에 아직 적이 남아있을 수도 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "으아앗!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온멤버",
      "text": "어… 어떻게… 뒤에서… 공격을…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "…어??",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "내게 등 뒤를 내준다는 건, 네가 그만큼 느리다는 얘기다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "일단은 괜찮은 것 같습니다 켈시 선생님. 적은 처리했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "너, 진짜 빠르구나…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "어떻게 저쪽으로 갔는지도 몰랐는데, 어느새 다시 여기로 돌아와 있다니…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…사실 아직 정찰을 안 갔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "레드한테서 연락이 왔다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "용문 내부에 잠복해있는 리유니온의 활동 흔적은 아직 찾지 못했다고 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "현시점에선 괜히 벌집을 건드리는 일은 없도록 해야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "그리고, 버려진 도시에서 임무를 수행 중인 다른 정찰팀의 정보를 종합해보니… 그곳에 숨어있던 리유니온의 규모가 예상보다 훨씬 클 가능성도 있다는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "그말은, 우리 고생문이 활짝 열렸다는 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "우리 정찰팀 규모로는 조금 어려울 거 같은데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "저흰 이미 리유니온 두 소대를 쓰러뜨린 상황이에요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "제시카, 우리가 처음에 교전했던 적도 리유니온이었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "네, 틀림없어요. 그렇게 보고를 드리고 나서 공격하셨잖아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…제대로 안 듣고 있었어. 탄도 계산하느라 정신이 팔린 상태였었거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "적의 수는 얼마나 되지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아직 구체적으로는 잘 모르겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "프로스트리프, 그쪽은 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "왜 저러지…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "다녀와라, 이상 징후가 보이면 수시로 연락하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "프로스트리프 씨가 있는 곳으로 가볼까요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "무슨 일 있었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…안 느껴지나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "네? 뭐가 말인가요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "온도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "그 말씀을 들으니… 조금 추운 것 같기도 하네요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "온도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…확실히, 바깥이랑 5도 이상은 차이 나는 거 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "아무런 전조 현상도 없이 날씨가 변하다니, 무슨 일일까요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "하늘을 봐라. 날씨는 변한 게 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "…네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "날씨 탓이 아니란 말이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "이것 때문이야. 직접 만져 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…폐허의 벽이잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그래, 이 벽이 열을 흡수하고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "…그럴리가?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그러나 열을 흡수하는 반응 자체는 이미 사라진 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "조금씩 원래 온도로 돌아오고 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "그보다도, 이유가 뭘까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "이런 흔적을 남길만한 녀석들이 누구겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…이곳에서 활동하는 건 리유니온밖에 없겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "리유니온? 그들이 어떻게요…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "감염자…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "예전에 들었던 전설 중에…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…눈의 악마에 대한 전설이 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…왠지… 굉장히 불길한 느낌이 드는데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
