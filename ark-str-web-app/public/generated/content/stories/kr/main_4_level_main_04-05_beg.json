  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프로스트리프 씨?! 프로스트리프 씨?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "대체 무슨 일이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "아미야 씨! 여기는 제2정찰팀…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "지금 퇴각 중입니다! 하지만 적이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "리유니온…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "또 끊어졌어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "제3정찰팀! 들리나요?! 제3정찰팀!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "켈시 선생님! 저예요! 들리시나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "그래, 관제실에 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "나 대신 옆에 있는 첸 팀장님께 물어봐 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "물어볼 내용은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "켈시",
      "text": "용문은 대체 언제까지 쓸데없는 고집을 부릴 생각이냐고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그 말은 못 들은 걸로 하겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "다만 지금은 확실히 꾸물대고 있을 상황은 아니군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "잠깐 보고서 가지러 갔다 온 사이에 무슨 일이 있었던 거야? 둘 다 표정이 심각한데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "…임무 때문인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "여러분… 장비를 정비해주세요. 이제 출발해야겠어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님, 용문에 정식으로 요청합니다. 근위국도 로도스 아일랜드의 구출 임무에 협력해주실 수 없을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그곳에는 리유니온의 임시 사령부도 있을 것으로 추정됩니다…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그리고 정찰팀 분들은 지금도 우리가 모르는 곳에서 분명 고군분투하고 있을 거예요…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
