      "type": "dialogue",
      "speakerName": "카포네",
      "speakerToken": "avg_npc_027#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "너희… 그렇게 된 거였나, 너흰 처음부터 계속…"
