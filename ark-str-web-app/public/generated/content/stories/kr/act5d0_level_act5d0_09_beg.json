    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerToken": "avg_npc_034#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "일찍 죽기 싫으면 말은 좀 아끼시게, 젊은이."
