      "type": "dialogue",
      "speakerName": "마피아",
      "speakerToken": "avg_npc_031",
      "operatorId": null,
      "portraitKey": null,
      "text": "……우린 단지, 더 쉬운 방향을 선택했을 뿐입니다."
