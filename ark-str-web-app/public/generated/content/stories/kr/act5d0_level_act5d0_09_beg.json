    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerToken": "avg_npc_034#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "흠… 비즈니스라…"
    },
    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerToken": "avg_npc_034#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "그렇지, 이건 확실히 괜찮은 장사지. 합리적이라 할 수 있겠군."
    },
    {
      "type": "dialogue",
      "speakerName": "카포네",
      "speakerToken": "avg_npc_027",
      "operatorId": null,
      "portraitKey": null,
      "text": "그럼…!"
