      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerToken": "avg_npc_034#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "난 애당초 자네의 충성심 따윈 필요로 하지 않았네."
