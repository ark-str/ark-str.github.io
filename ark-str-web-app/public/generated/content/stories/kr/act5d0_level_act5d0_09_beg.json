    {
      "type": "dialogue",
      "speakerName": "래트킹",
      "speakerToken": "avg_npc_034#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "잘 알아들었으면, 이제 그만 꺼져주겠나."
