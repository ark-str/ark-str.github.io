    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "파스콸라",
      "speakerId": "avg_4163_rosesa_1",
      "isRemote": false,
      "text": "젠장…… 젠장! 피가 안 멈춰!"
