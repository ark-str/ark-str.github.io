{
  "server": "kr",
  "storyId": "act20side_level_act20side_03_beg",
  "groupId": "act20side",
  "stageId": "act20side_03",
  "title": "기담괴론",
  "storyCode": "IC-3",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/activities/act20side/level_act20side_03_beg.txt",
  "sourceHash": "6c5c3d9a2ba889141b9673a85efaf20b7aa7e8477b9be51618e758ef50881c24",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "그러니까 슬라이드를 폭파하고 철도를 다시 세우려면 상업 대표 크로크 다이아몬드페이스, 공업 대표 디컬처 실버민트, 그리고 캐치라는 녀석까지 설득해야 한다는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "맞아. 그 사람들의 입장이 가장 중요하고, 대부분 두린족은 그 사람들의 태도를 참고해서 선택하니까."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "네가 가면 되잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "아무래도 별로 환영받지 못하나 보네."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "그렇게 대놓고 말할 필요까지 있나."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "영 귀찮은 것 같긴 하지만, 어쩔 수 없네. 아카후알라를 위한 셈 치지 뭐."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "그래서, 어딜 가야 그 사람들을 만날 수 있는데?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "후우, 드디어 끝났다. 가비알이랬나, 정말 무서운 녀석이네."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엣지 어스하트",
      "speakerId": null,
      "text": "아무래도 네 뜻대로 된 것 같구나."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "엣지 영감, 이제 만족해?"
    },
    {
      "type": "dialogue",
      "speakerName": "엣지 어스하트",
      "speakerId": null,
      "text": "솔직히 난 '그레이트 아쿠아핏'이 너무 아쉽구나."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "하! 누가 철도교 한가운데 지으래? 아니면 나도 손을 댈 이유가 없지!"
    },
    {
      "type": "dialogue",
      "speakerName": "엣지 어스하트",
      "speakerId": null,
      "text": "하지만 내게 좋은 생각이 있다. 돔이 부서져서 폭포가 떨어지고 대형 슬라이드를 세운 지도 반년이 넘었잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "엣지 어스하트",
      "speakerId": null,
      "text": "다들 아직 즐겁게 놀고는 있지만, 아마 조금 싫증은 났을 거다."
    },
    {
      "type": "dialogue",
      "speakerName": "엣지 어스하트",
      "speakerId": null,
      "text": "차라리 이번 기회에 새로 만드는 건 어떠냐? 전에 캐치한테 초대형 물대포를 얘기했다지? 이미 사람들 사이에 소문이 쫙 퍼졌다!"
    },
    {
      "type": "dialogue",
      "speakerName": "엣지 어스하트",
      "speakerId": null,
      "text": "솔직히 나도 흥미롭긴 하고……"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "……하아!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그 아다크리스! 미개하고 무례하고 무모한데다 제멋대로예요! 크로크 씨, 상상이나 갑니까? 창작이 막혀서 기분전환 겸 동굴에 찻잎 따러 갔는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "안긴 채로 폭포에서 뛰어내렸다면서?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "정말 최악이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "하지만 평범한 쎄루에르차 주민이라면 그런 유혹을 참을 수 없을걸. 그걸 이야기로 쓰면 대박 날지도 몰라."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "“가비알 씨를 믿어요.”, “아브도티야, 꽉 잡아!” 음, 꽤 로맨틱한데."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "됐거든요!"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "적어도 너의 그 눈에 관한 이야기보다는 재밌어."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그러고 보니 이틀 전에 아이들이 단편 소설을 읽고 싶다며 찾아왔길래 드디어 독자가 생긴 줄 알았는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "감상은?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "“너무 웃겼어, 또 올게.”라더군요."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그렇겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "아브도티야, 그들에겐 악의가 없어. 다만, 우리 두린족은 아마 너의 경험을 상상할 수 없어서 그럴 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "내가 몇 번이나 듣고 나서야 너의 느낌을 약간이나마 이해했을 것 같아? 평범한 두린이라면 더 말할 것도 없겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "우리는 진짜 눈조차 본 적이 없는데, 하물며 네가 쓴 글이라니…… 그 단어들을 뭐라고 하더라, '교활', '도망'?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그 단어들이 문학 속에만 존재한다면 더할 나위 없이 좋은 일이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아무튼 저는 지금의 생활에 매우 만족하고 있습니다. 착취하지도, 착취당하지도 않고, 무서운 음모도 없고, 함정이나 암살 따위에 휘말릴 일도 없으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "상가에서 쓸 광고 문구를 쓰거나 간판을 설계하는 것만으로도 먹고 살 수 있는데, 더 바랄 게 뭐가 있겠어요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "매일 한가롭게 안락의자에 앉아 일광욕하는 걸로…… 뭐 인공 광원이긴 하지만, 그거면 충분해요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이런 평화로운 날이 계속됐으면 좋겠어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "여기가 상업 대표 크로크 다이아몬드페이스의 사무실인가?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "안녕, 저 대형 슬라이드를 폭파하고 싶은데."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "……하아."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "오, 아브도티야, 너도 있었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "안색이 안 좋은데."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "죄송합니다, 크로크 씨. 저는 이만 실례할게요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "집에 가서 크로스보우를 다시 손봐야겠어요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "정말 나 때문에 화난 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "크흠, 너희들은 쎄루에르차에 온 지 얼마 안 됐지? 캐치한테 들었어."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "뭐랄까, 이번에는 캐치가 꽤 정확하게 평가했네."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "“두린보다 더 두린다운 녀석들.”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계",
      "speakerId": null,
      "text": "도망! 도망!"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "음, 구조가 신기하네. Lancet-2 언니랑 완전히 다른 느낌이야."
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계",
      "speakerId": null,
      "text": "가까이! 오지 마!"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "언니처럼 똑똑한 것 같지는 않네. 하지만 몇 가지 기본적인 반응은 무슨 원리지?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계",
      "speakerId": null,
      "text": "위협도! 높음! 낯선 이, 거리 유지!"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "긴장하지 마, 난 주마마라고 해. 나쁜 사람 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계",
      "speakerId": null,
      "text": "신원 정의, 주마마."
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "넌 이름이 뭐야?"
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계",
      "speakerId": null,
      "text": "속성: 두린족을 위해 일하는 영광의 모델 R3-E3 어시스턴트 로봇, 넘버 0429."
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "안녕, 0429. 완충 시스템에 문제라도 생겼어? 왜 그렇게 비틀거리는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계 0429",
      "speakerId": null,
      "text": "셀프 체크 결과: 복역 기한 임박, 부품 노후화."
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "내가 도와줄게. 봐, 모든 수리 도구를 챙겨왔거든."
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계 0429",
      "speakerId": null,
      "text": "수리…… 실행 가능성, 낮음. R3-E3, 복역 만기 후 즉시 폐기."
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "꼬마야, 별문제도 없어 보이는데 자포자기하지 마. 아마 나사 몇 개만 조이면 될걸."
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "네가 너무 귀여워서 도와주고 싶은데, 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "우리 친구 하자."
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계 0429",
      "speakerId": null,
      "text": "친구? 이해 불가, 친구."
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계 0429",
      "speakerId": null,
      "text": "수리, 가능한가?"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "물론이지."
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "하지만 우선 네 케이스부터 뜯어야 해."
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기계 0429",
      "speakerId": null,
      "text": "거부, 작업 신청 취소, 작업 신청 취소. 위험! 위험!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "speakerId": "char_416_zumama",
      "text": "괜찮아, 도망치지 마!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지나가던 두린",
      "speakerId": null,
      "text": "……음? 지상에서 온 피디아가 어시스턴트 로봇을 쫓는 거 같은데?"
    },
    {
      "type": "dialogue",
      "speakerName": "지나가던 두린",
      "speakerId": null,
      "text": "이상하네, 술이 덜 깼나?"
    },
    {
      "type": "dialogue",
      "speakerName": "지나가던 두린",
      "speakerId": null,
      "text": "그러고 보니 아브도티야의 감이 안 잡히는 이야기에서 묘사한 게 대충 저런 장면이겠지? '추격' 이런 거."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지나가던 두린",
      "speakerId": null,
      "text": "음, 왜 코미디가 아니라고 하는지 대충 알겠네."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "이남 씨, 차라도 마실래?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "두린족이 술이 아닌 다른 액체를 마시기도 하는구나."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "가끔은 입맛도 바꿔줘야 하니까. 게다가, 크흠, 지금은 근무 중이고. 술은 쉴 때 마셔야지."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그래서, 나를 따로 보자는 용건이 뭔데?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "가비알의 싸움 실력은 의심할 여지 없어. 하지만 이런 일에서 가비알의 주먹은 아무런 소용도 없지."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "게다가 우리는 같은 부류의 사람인 것 같고 말이야, 쎄루에르차 상업 대표 씨."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "아무래도 너는 사업 얘기를 좋아하는 것 같군. 마침 잘됐네, 나도 싫지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "쎄루에르차는 작은 두린 마을에 불과하지만, 몇 년 전만 해도 우리가 다른 도시와 연결되어 있을 때, 상업 대표로 나도 여러 가지 일을 했거든."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "하지만 지난번 지진으로 유일한 철도가 끊겨버렸어. 다행히 쎄루에르차는 자급자족이 가능하고 시민들도 욕심이 없는 편이라, 교통을 회복하는 게 그렇게 시급하지 않았던 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "지금 내가 하는 일은 쎄루에르차 시민들의 요구를 충족시켜줄 놀거리를 추진하는 것뿐이고."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "이를테면 '그레이트 아쿠아핏' 주변의 노점상을 관리하거나, 새로운 자율차 장비를 출시하거나. 뭐, 꽤 한가로운 편이야."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "……내가 두린족의 사고방식은 잘 모르지만, 일반적으로 만취한 상태에서 서핑하는 걸 욕심이 없다고 할 수 있나?"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그런 셈이지."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "하지만 지상인의 기준으로는……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그래도 우리 기준으로는 그게 욕심이 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그러니까 스티치가 너희에게 뭘 약속했든, 슬라이드 폭파 계획에 내가 동의하길 바란다면, 내 마음을 움직일 수 있는 무언가를 내놔야 할걸."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "서로 교환할 게 있어야 거래가 성사되는 거잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "이남 씨, 너라면 쎄루에르차의 상업에 뭘 가져다줄 수 있어? 아카후알라의 수공예품은 별로 매력이 없는데."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "약삭빠른 자율차 업자들은 이미 너희 외지인들의 이미지를 접목할 생각이던데, 그걸로는 부족해."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "너…… 생각보다 지상에 대해 많이 알고 있네."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "내가 지상에 가 본 적은 없지만, 도서관에 있는 책은 장식물이 아니니까."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "너희의 풍습에 대해서도 잘 알고 있지……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "아카후알라 사람들은 메탈 크랩을 둘러싸고 계속 춤을 추면서, 마지막까지 버티는 사람이 대왕이라는 칭호를 얻는다면서?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "……그런 건 어디서 본 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "《기담괴론》. 이건 쎄루에르차에서 가장 유행하는 책인데, 예전에 한 모험가가 지상에서 대량으로 가져왔거든. 지상 세계의 백과사전이라 해도 과언이 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "그건 헛소리나 나불대는 엉터리 잡지잖아!"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "……서, 설마? 난 그걸 읽으려고 힘들게 사르곤어까지 공부했는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "……그래서 억양이 거의 없었던 거구나."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "하아, 갑자기 힘이 쭉 빠지네. 최신판 《기담괴론》 몇 권이면 바로 너를 매수할 수 있을 것 같아……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "최신판? 그 책이 아직도 나와?! 음…… 구해줄 수만 있다면 나도 고, 고민해 보겠지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "내게 더 좋은 물건이 있긴 한데."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "이게 뭐야?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "비디오테이프, 한번 볼래?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "여기 있었군요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "어, 아브도티야다. 또 아이디어 수집하러 나왔어?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "당신들은 도대체 뭘 하고 싶은 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "크로크 씨 쪽은 이남이 맡겨달라고 해서 저희는 주마마를 찾으러 나왔어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "아니, 제 말은 지상인, 당신들이 무엇 때문에 이 도시에 왔냐는 말이에요. 당신들의 진정한 목적은 뭐죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "제가 초간편 대승강기 1호 주변에서 한참을 지켰습니다만, 당신들의 주력 부대는 어디에 있습니까? 사르곤의 아미르들이 드디어 이 지하의 재부에 눈을 뜬 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "이 도시에는 당신들이 원하는 자원이 없으니 얼른 돌아가세요. 평화로운 이곳을 피로 더럽히고 싶지 않다면요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "오해라고 했잖아. 스티치가 철도 수리할 사람이 필요해서 우리를 속여서 데려온 거라니까."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……그건 일꾼이 아닌가요? 거기에 속았다고요?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "이봐."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "걔가 그때 얼마나 심각하게 얘기했는지 알아? 거기다 토미미가 과장까지 보태는 바람에…… 하아, 내가 얼마나 걱정했는지. 주마마랑 함께 밤새 싸울 준비를 하고 전속력으로 달려왔단 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "흐흑, 죄송해요. 전 가비알 씨가 좀 쉬길 바란 거였는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "하아, 됐다…… 기왕 이렇게 된 거 기분전환이라도 해야겠다."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……그러니까 진짜 악의는 없는 겁니까? 어느 귀족의 명령을 받고 약탈하러 온 게 아니라?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "믿든지 말든지."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……하긴, 아무리 사르곤이라고 해도 당신처럼 거친 사람을 부리지는 않겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "거칠다고? 난 단지 돌려 말하는 걸 싫어할 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "내 계획은 아주 간단해. 스티치 꼬마를 도와주고, 티아카우가 쓸 수 있는 기술을 배운 다음 바로 떠나는 거야. 그게 다야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "로도스 아일랜드에 날 기다리는 환자가 얼마나 많은데."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "그렇다면, 당신은 의사입니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "왜, 그렇게 안 보여? 면허도 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "차라리 여기 토미미 씨가 의사라면 어떻게든 믿어보겠지만."
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "아, 의사라면 저도 할 수 있어요! 가비알 씨가 마취술을 가르친 적이 있으니까요!"
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "부위를 잘 겨냥해서 쿵, 이렇게……"
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "로도스 아일랜드에서는 이걸, 어, '가비알식 운동 에너지 마취법'이라고 불러요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "……그런 비정상적인 방법은 나도 특수한 상황에서만 쓰는 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "예를 들면, 마침 마취약이 다 떨어졌는데 싸우다가 보급 팩마저 잃어버렸다든가."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……아무래도 당신들을 따라다니는 게 좋겠어요."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "쎄루에르차에서 멋대로 굴 생각하지 마세요. 여기는 저의 집이에요. 당신들이 망가뜨리게 두지 않을 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "마음대로."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "당신들이 할 일을 다 끝내고 쎄루에르차를 떠날 때까지 지켜볼 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "speakerId": null,
      "text": "그럼 아직 할 일을 못 끝냈으니 구경이나 좀 할까."
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "저기, 아브도티야 씨…… 당신은 여기 주민이니까 쎄루에르차를 안내해 주실 수 있나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……미리 말해두지만, 도시 지형을 조사하려는 거면 포기하는 편이 좋을 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "아, 아니에요! 제 말은……"
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "아브도티야 씨의 옷이 너무 예뻐서요! 구경할 만한 두린족 패션숍 같은 게 없을까요? 저도…… 견학하고 싶거든요!"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "……?"
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "좋아요. 그런 거라면…… 확실히 몇 군데 갈만한 곳이 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "아브도티야",
      "speakerId": null,
      "text": "두린 스타일의 액세서리를 보러 갈래요?"
    },
    {
      "type": "dialogue",
      "speakerName": "토미미",
      "speakerId": null,
      "text": "좋아요!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "스티치……"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "……캐치인가, 여긴 어쩐 일이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "전에는 늘 집에만 틀어박혀 있더니, 오늘은 웬일이래."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "나도 가끔은 햇볕을 쬐고 싶거든. 그 말 하려고 여기까지 온 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "내 슬라이드를 폭파할 생각이면서, 너랑 얘기하러 오는 것도 안 돼?"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "……흥, 알고 있었구나."
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "마스터 엣지가 알려줬어."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "그 영감탱이가…… 그래서, 따지러 온 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "아니, 사실 난 반대하지 않아. 이번 여름은 충분히 길었어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "건축 설계사로서 최고의 작품은 항상 다음 작품이니까, 안 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "쳇, 너의 그런 모습이 제일 꼴 보기 싫어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "어떤 모습?"
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "시도 때도 없이 낙관적인 거."
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "하하하, 높게 평가해 주네!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "하지만 대형 슬라이드를 없애는 데 동의하는 조건으로 너랑 돔에 관해 얘기하고 싶어."
    },
    {
      "type": "dialogue",
      "speakerName": "스티치 캔버스",
      "speakerId": null,
      "text": "……난 할 말 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐치 라이트레이스",
      "speakerId": null,
      "text": "가자, 산책이나 하러 가자. '그레이트 아쿠아핏'을 폭파하기 전에 그래도 몇 개는 타 봐야지 않겠어?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "또 있어? 다음 시즌은 어디서 볼 수 있어?!"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "크…… 하! 술맛 좋다! 이남 씨, 더 마실래?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "난 아직 남았어……"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "너무 느린 거 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그 '와인과 커피'라는 팀이 너무 아쉽다. 거의 우승할 뻔했는데! 하아! 그 배까지 정말 얼마 안 남았는데 말이야!"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "마음에 드나 보네."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "지상인의 생활이 내 상상 이상으로 즐거울 거라고는 생각지도 못했어!"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "그런데 이게 도대체 무슨 비디오야?"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "도솔레스의 '익스트림 철인 그랑프리'야. 카라반 하는 친구가 구해 준 오래된 비디오지."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "저번에 사고가 났다던데, 요즘도 계속하는지 모르겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "저기…… 나 더 보고 싶은데! 진 팀이 다음 해에 복수하는 거 꼭 보고 싶단 말이야!"
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "크로크, '경쟁'이라는 요소를 조금만 가미하면 아무리 따분한 오락이라도 더 짜릿해지는 법이야."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "본인이 지지하는 팀을 응원하면서, 친구들과 신나게 맥주를 마시는 거지. 아마 두린족이라면 이런 생활을 거절할 사람이 없을걸."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "게다가 경기 기간에는 주류나 패스트푸드의 매출이 배가 될 거고. 어때, 두린들에게 아주 딱 어울리지?"
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "평소에도 술은 잘 팔리니까 대회까지 열면서 자극할 필요는 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "크로크 다이아몬드페이스",
      "speakerId": null,
      "text": "하지만, 음, 신나게 노는 관점에서 보면 확실히 매력적이긴 해."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "단도직입적으로 말할게, 상업 대표 씨."
    },
    {
      "type": "dialogue",
      "speakerName": "이남",
      "speakerId": null,
      "text": "슈퍼 수상 레이스를 만들어 볼 생각이 없어?"
    },
    {
      "type": "sceneBreak"
    }
  ],
