    {
      "type": "dialogue",
      "speakerName": "부상당한 필라인",
      "speakerId": "avg_npc_423_1",
      "isRemote": false,
      "text": "이 군복이 제가 유일하게 가진 정장이어서요. 네, 전 빅토리아의 장교였어요."
