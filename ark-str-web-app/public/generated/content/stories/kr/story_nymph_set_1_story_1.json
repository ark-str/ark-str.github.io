    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "님프",
      "speakerId": "avg_4146_nymph_1",
      "isRemote": false,
      "text": "어디 보자…… 네 이름이……그레텔?"
