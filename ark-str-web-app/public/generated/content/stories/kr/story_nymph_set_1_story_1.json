    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "49_g6_babeloffice"
    },
    {
      "type": "dialogue",
      "speakerName": "님프",
      "speakerId": "avg_4146_nymph_1",
      "isRemote": false,
      "text": "바벨 사무소는 얼마 전에 새로 인테리어를 한 것 같네."
