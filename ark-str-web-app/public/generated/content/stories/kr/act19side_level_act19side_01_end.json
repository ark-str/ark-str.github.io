  "blocks": [
    {
      "type": "narration",
      "text": "//战斗音乐\n//预约替换沉重的机器脚步"
    },
    {
      "type": "dialogue",
      "speakerName": "수상한 기동 장갑",
      "speakerId": "avg_npc_526_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "메커니스트",
      "speakerId": "avg_npc_521_1",
      "text": "……믿을 수가 없네."
    },
    {
      "type": "dialogue",
      "speakerName": "메커니스트",
      "speakerId": "avg_npc_521_1",
      "text": "난 분명히 신호 간섭 모드를 기동했어. 클로저가 개발한 최신 드론도 우리 위치를 탐지하지 못할 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "메커니스트",
      "speakerId": "avg_npc_521_1",
      "text": "이 기동 장갑은 어떤 센서 기술을 쓴 거지?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "멈출 수 있겠어?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "시선을 끌고 싶지 않았는데……"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "박사, 꽉 잡아."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "10% 출력으로 조준……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "명중."
        },
        {
          "type": "dialogue",
          "speakerName": "수상한 기동 장갑",
          "speakerId": null,
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "오른팔에 부분 파손 확인."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "속도가 줄지 않았네. 명중한 순간에도 전혀 멈출 기미가 안 보이고."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "기동 장갑 안에 도대체 누가 있는 거지? 통증을 못 느끼는 건가?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "수상한 기동 장갑",
          "speakerId": "avg_npc_526_1",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "수상한 기동 장갑",
          "speakerId": "avg_npc_526_1",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "좌측 상완부 파괴."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "우측 정강이 파괴."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "박사, 녀석은 손상돼도 아무런 반응이 없어."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "저걸 멈추려면 동력 코어를 정지시키는 수밖에 없는데……"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "하지만 이건 말이 안 돼."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "아무리 잘 훈련된 병사라도 이런 인내력은 가질 수 없어."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_npc_532_1",
          "text": "맞아."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_npc_532_1",
          "text": "살아 있는 개체라면 자신의 가장 기본적인 반사 신경을 완전히 통제하는 것은 불가능한 일이지."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "수상한 기동 장갑",
          "speakerId": null,
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "//机械倒地的声音\n갑자기 손날이 기동 장갑의 중심을 꿰뚫었다. 무수한 기계 파편이 불꽃과 함께 튀는 모습은 마치 또 다른 생명체의 피가 흩뿌려지는 것 같았다.\n그리고 손은 곧 제자리로 돌아갔다.\n그녀의 손에 뽑힌 장갑의 파편은 그녀의 손가락을 덮은 순백의 갑옷과 함께 가루가 되어 떨어졌고, 바닥에는 얇은 칼슘 결정이 만들어졌다.\n바닥에 쓰러진 기동 장갑의 에너지 불빛은 이미 꺼진 상태로, 몸 가운데에 동그란 구멍만이 남았다."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "……맨손으로 기동 장갑의 코어를 파괴했다고?"
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "엄청난 위력이네. 게다가 내 방어포보다 훨씬 조용했어."
        },
        {
          "type": "dialogue",
          "speakerName": "메커니스트",
          "speakerId": "avg_npc_521_1",
          "text": "박사, 우리 그 오리지늄 제품 관리국인가 뭔가 하는 곳에 폭파범으로 끌려갈 걱정은 안 해도 되겠어."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "나도 로도스 아일랜드에 새로운 전과가 늘어나는 건 바라지 않아.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "컬럼비아의 형무소 같은 건 하나도 그립지 않아.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "고마워, 사리아.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "speakerId": "avg_npc_532_1",
          "text": "고마워할 필요 없다, 박사. 그리고 메커니스트."
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "speakerId": "avg_npc_532_1",
          "text": "로도스 아일랜드를 라인 랩 내부 일에 끌어들인 건 나니까……"
        },
        {
          "type": "dialogue",
          "speakerName": "사리아",
          "speakerId": "avg_npc_532_1",
          "text": "나는 두 사람한테 피해가 가지 않도록 책임질 의무가 있다."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "……퍼디낸드 예상대로네."
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "로도스 아일랜드가 사리아와 합류했어."
        },
        {
          "type": "dialogue",
          "speakerName": "컬럼비아 용병",
          "speakerId": "avg_npc_399_1",
          "text": "계속 쫓을까요?"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "내가 널 아까 그 기동 장갑에 넣었다면, 넌 살아남을 수 있었을까?"
        },
        {
          "type": "dialogue",
          "speakerName": "컬럼비아 용병",
          "speakerId": "avg_npc_399_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "긴장할 거 없어."
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "그냥 가설이야."
        },
        {
          "type": "dialogue",
          "speakerName": "컬럼비아 용병",
          "speakerId": "avg_npc_399_1",
          "text": "오올헤약 님, 저 사리아가 얼마나 대단한지는 몰라도 놈들은 고작 3명입니다."
        },
        {
          "type": "dialogue",
          "speakerName": "컬럼비아 용병",
          "speakerId": "avg_npc_399_1",
          "text": "저희는 인원도 많고 비밀 병기도……"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "어떤 상대도 절대 얕봐서는 안 돼."
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "라인 랩을 그렇게 오래 접하고도 모르겠어? 지능적이고 나약해 보이는 과학자일수록 더 잔인한 수법을 사용할지도 몰라."
        },
        {
          "type": "dialogue",
          "speakerName": "컬럼비아 용병",
          "speakerId": "avg_npc_399_1",
          "text": "저, 저 정비사랑 얼굴이 안 보이는 학자 말인가요? 설마 저 둘이 라인 랩 방위과 주임보다 더 대단할까요?"
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "로도스 아일랜드는…… 인재가 많아."
        },
        {
          "type": "dialogue",
          "speakerName": "오올헤약",
          "speakerId": "avg_npc_536_1",
          "text": "가자. 방금 세운 가설이 아주 마음에 들어. 시도해 보고 싶은 새로운 아이디어들도 있고."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "안녕하십니까, 대령님."
        },
        {
          "type": "dialogue",
          "speakerName": "대령의 목소리",
          "speakerId": "avg_npc_522_1",
          "text": "……클루니."
        },
        {
          "type": "dialogue",
          "speakerName": "대령의 목소리",
          "speakerId": "avg_npc_522_1",
          "text": "기지 일을 설명해 보게."
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "작은 소란이 있었을 뿐입니다…… 아시다시피 우리가 아무리 좋은 조건을 내세워도 개척자들은 만족하지 못하잖습니까."
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "개척자들의 도전정신은 컬럼비아를 끊임없이 발전시키는 기반이자 그들의 장점이긴 하지만 가끔은…… 성가신 일도 생기기 마련입니다."
        },
        {
          "type": "dialogue",
          "speakerName": "대령의 목소리",
          "speakerId": "avg_npc_522_1",
          "text": "성가신 일이라면 해결하도록."
        },
        {
          "type": "dialogue",
          "speakerName": "대령의 목소리",
          "speakerId": "avg_npc_522_1",
          "text": "내가 원하는 건 라인 랩이 언급된 사회면 기사가 아니라, 자네가 약속한 성과네."
        },
        {
          "type": "dialogue",
          "speakerName": "대령의 목소리",
          "speakerId": "avg_npc_522_1",
          "text": "컬럼비아의 과학기술 회사는 자네 회사만 있는 게 아니라는 걸 명심하게."
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "……알겠습니다."
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "걱정 마십시오, 대령님."
        },
        {
          "type": "dialogue",
          "speakerName": "퍼디낸드",
          "speakerId": "avg_npc_522_1",
          "text": "라인 랩의 제품을 보시면 절대 실망하시지 않을 겁니다."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "대장, 그만두고 싶다는 사람이 여럿 나왔어."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "대장의 방법은 안 먹히고, 아무도 우릴 신경 쓰지 않는대. 우리 목소리는 절대 전해지지 않으니 어떤 방법을 써도 다 헛수고일 거라면서."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "그리고 라인 랩이 뭘 하든 그냥 내버려 두자고 했어."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "애초에 여기 일을 마무리 짓고 돈을 받은 뒤에 다음 장소에 가서 계속 일했어야 됐어."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "실종된 사람들은…… 운이 나빴을 뿐이야. 어차피 이런 오지에서 일하는 개척대는 해마다 우리보다 훨씬 많이 죽잖아."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……그만해."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "다른 애들한테는 조금만 더 기다려 보자고 전해줘. 내가 반드시 동료를 데려올 테니까."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "어떻게 할 생각인데?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "잠깐 나갔다 올게."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "어디 가? 너무 위…… 위험하지 않아?"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "경찰이 저격수를 배치했다면 지금 네가 나오길 기다리고 있을 텐데……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……그럼 잘됐네."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "자, 잘 됐다고? 긴장해서 머리가 어떻게 된 거 아니지?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "경찰 쪽이라면 내가 잘 아는 사람일 거야. 석궁 실력이 워낙 확실하니까, 정말 끝까지 가게 된다면 별 고통 없이 죽을 수 있겠지."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "사니……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "우르비카 박사, 무어 씨……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "나랑 함께 나갔다 올 수 있을까?"
        },
        {
          "type": "dialogue",
          "speakerName": "프틸롭시스",
          "speakerId": "avg_128_plosis_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "가식 떨지 마. 우리한테 거절할 권리는 있고?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "미안, 조금만 참아줘."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "너희들의 상황을 직접 보면 바깥에 있는 놈들도 생각이 바뀌어서, 우리 요구 사항을 더 진지하게 생각해 줄지도 몰라."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "보안관님, 누군가 나옵니다!"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "드론 사격 준비……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "아니, 일단 멈춰."
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "……보안관님?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "인질이 다치면 안 돼."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "저기…… 사일런스 씨, 이쪽으로 와 봐."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "무슨 상황이라도 있어?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "망원경으로 봐. 사…… 저 개척자 뒤에 있는 두 사람, 당신 동료 아니야?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "대장, 토, 통신기에 불이 들어왔어!"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……가져와."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "역시 너였구나."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "그건 내가 할 소리 같은데."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "지금은…… 보안관인가? 축하한다는 말도 못 했네."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "네가 이 관할구에 이렇게 오래 있을 줄이야…… 개척지는 번거로운 일이 많은데."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "나도…… 네가 이렇게까지 타락할 줄은 몰랐어."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "예전에 들었던 수업은 기억나? 법에 관한 수업들 말이야."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "내가 경찰관이 된 그날…… 네가 나한테 한 말은 기억하고?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "“정말 잘 됐다. 우리 또 파트너가 됐네. 어렸을 때 놀았던 것처럼 함께 컬럼비아의 질서를 지키며 모든 죄를 법으로 심판하자……”"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "하…… 참 아이러니하지? 지금 가장 법으로 처리해야 할 범죄자가 바로 너 자신이라니."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "메리……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "네 대원들이 손에 들고 있는 건 뭐야? 사제 무기?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "그런 쪽팔리는 장난감은 내려놔."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "넌 너 자신을 그런 한심한 꼴로 망쳐놨지만, 아직 선택할 수 있어. 마지막 선택지야……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "네 옆에 있는 무고한 여자 둘을 풀어줘."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……아니, 아직은 안 돼."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "바보야, 넌 지금 벼랑 끝으로 가고 있다고."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "컬럼비아에서는 죄를 지어도 개척대에 들어가면 감옥에 가지 않아도 되지만……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "개척지에서 법을 어기면, 그 인간이 어떻게 되는지 몰라서 그래?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "대답해 봐, 사니 변호사!"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "그렇게 부르지 마. 부탁이야, 메리……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "날 후회하게 하지 마."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "아니다, 난 이미 후회되기 시작했어…… 네가 우리 집에 침입한 날, 즉시 경찰서로 잡아가지 않고 너를 용서한 게 후회돼."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "그건 다 지난 일이잖아. 그때 난……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……미안해, 계속 미안하게 생각하고 있었어."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "하지만 지금 이러는 데는 이유가 있어. 제발 내 이야기를 들어봐 줘……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "……대장!"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "무슨 일이야?"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "그 의사, 의사가……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……무어 씨가?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "프틸롭시스",
          "speakerId": "avg_128_plosis_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "프틸롭시스",
          "speakerId": "avg_128_plosis_1",
          "text": "설정…… 오류 발생…… 전원 계획 모드…… 수정……"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "큰일이다, 조이스가……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "우르비카 박사, 어떻게 된 거야?"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "……병에 의한 발작이라고 생각하면 돼."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "뭐?! 과, 광석병?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "서둘러 조치해! 내가 받쳐줄게, 약은 가지고 있어? 나…… 난 주사 놓을 줄 모르는데……"
        },
        {
          "type": "dialogue",
          "speakerName": "프틸롭시스",
          "speakerId": "avg_128_plosis_1",
          "text": "윽……"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "너무 힘들어 보여!"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "나…… 나한테 라인 랩에서 지급한 긴급 의료 팔찌가 있어. 이게 광석병 증세에 도움이 된다고 하던데."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "지금 바로 채워 줄게……"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "본인의 긴급 의료장치를 조이스한테 양보한다고?"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "그걸 주고 만약 자신이 갑자기 발병한다면, 너의 생존율은 크게 떨어질 건데."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "의사 선생님은 늘 우리를 잘 챙겨줬어."
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_npc_534_1",
          "text": "선생님에게 무슨 일이 생기는 건 정말 싫다고……"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "나랑 조이스를 납치한 건 너희들인데."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "미안해…… 우리는 그저 이기적인 평범한 사람일 뿐이야."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "하지만 은혜를 원수로 갚는 일 따위는 하고 싶지 않아."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "……통신은 계속되고 있어?"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "메리 씨, 내가 개척자들과 통화할 수 있을까?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "발작을 일으킨 리베리는 내 동료이자 친구야."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "더 중요한 건 내가 그 친구의 주치의라는 거고."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "개척자들한테 친구 상태를 물어보고 싶어. 그 사람들의 반응으로 보아 친구한테 매정한 건 아닌 것 같고."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……마음대로."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "하지만 시간이 많지는 않아."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "위에서 지시가 내려왔어. 개척자들이 계속 비협조적이라면 10분 후에 실험 기지의 모든 통신을 끊고…… 개척자 거주지의 전기도 차단할 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "speakerId": "avg_1027_greyy2_1",
          "text": "저, 전기를 차단한다고요?"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "speakerId": "avg_1027_greyy2_1",
          "text": "황무지는 일교차가 매우 큰데…… 밤이 되면 다들 추위를 견디지 못할 거예요!"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "speakerId": "avg_1027_greyy2_1",
          "text": "게다가 개척자 중에는 광석병 말기 환자도 많은데……"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "speakerId": "avg_1027_greyy2_1",
          "text": "그 사람들은 의료 설비로 생명을 유지해야 한다고요!"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……나도 알아."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "그러니까 이건 경고야."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "그들에게 라인 랩과 경찰의 결의를 보여줄 필요가 있어."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "모든 투쟁과 요구는 반드시 합법이 전제가 되어야 하지…… 범죄의 길에 발을 들여놓으면 아무도 그들의 말을 들어주지 않으니까."
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "speakerId": "avg_1027_greyy2_1",
          "text": "하지만…… 당신은 그 개척대 대장과 친구 아니신가요?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……친구?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "저 녀석이 타락하기 시작한 순간부터 우리 사이는 이미 끝났어."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "프틸롭시스",
          "speakerId": "avg_128_plosis_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "의사는 어때?"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "실시간 혈액 결정 밀도는 떨어졌지만, 안구 운동 지수는 아직도 비정상이야."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "안구 운동 지수?"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": null,
          "text": "조이스의 광석병 병소는 뇌에 있으니까."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": null,
          "text": "모든 증세의 변화는 신경계에 영향을 줘서 조이스가 깊은 수면 상태에 빠지게 하고, 심하면 간질을 유발할 수도 있어."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "어? 누가 말하는 거지?"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "……통신기가 아직 연결되어 있어."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "안녕, 대장 씨."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "난 조이스 무어의 주치의, 사일런스라고 해."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……사일런스."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "우선 감사 인사부터 할게."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "너와 다른 개척자의 도움 덕분에 조이스 상태가 빨리 안정될 수 있었어."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "납치범한테 감사라니……"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "그에 대한 보답으로 너희들을 진심으로 돕고 싶어. 믿어 줘."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "앞으로 5분 뒤면 통신과 너희들이 있는 거주지의 전기가 동시에 끊어질 거야……"
        },
        {
          "type": "dialogue",
          "speakerName": "개척대 대원",
          "speakerId": "avg_108_silent_1",
          "text": "대장, 가, 갑자기 불이 꺼졌어!"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "아무래도 앞당겼나 본데."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "상관없어. 뭐, 그래도 알려줘서 고마워."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "메리 씨한테 들었는데 라인 랩 고위층과 얘기하고 싶다면서?"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "이유를 물어봐도 될까?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "놈들이 이 기지에서 진행하고 있는 실험을 그만뒀으면 좋겠어."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "……실험을 그만둬?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "너도 무어처럼 착한 의사인 건 아는데, 이런 대규모 프로젝트를 멈추는 건 무리잖아."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "이 실험이 정말 위험한 거라고 라인 랩 이사장에게 전해줄 수 없을까?"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "사니 씨, 증거는 있어?"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "있다고 해도 나처럼…… 갈 곳 없는 개척자의 말을 믿어줄 건가?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "보안관님, 준비됐습니다. 언제든지 기지 통신을 끊을 수 있어요."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……사일런스 씨가 이야기를 마칠 때까지 기다려."
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "하지만 주임께서 즉시 통신을……"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "도대체 누가 보안관인데? 나야, 너희 주임이야?"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "그 퍼디낸드라는 사람에게 전해. 사람을 구하는 건 내 몫이니까 괜히 참견하지 말라고!"
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "주임님께서 서장님과 얘기를 마치셨답니다. 이건 그분들이 함께 결정하신 사항입니다."
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "주임…… 퍼디낸드?"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "설마 에너지과가 방위과도 관리하는 줄은 몰랐네."
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "그게……"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "퍼디낸드가 구조과까지도 자기 말을 들어야 한다고 생각하는 거라면 난 당장 라인 랩을 그만둬도 상관없어."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "프틸롭시스",
          "speakerId": "avg_128_plosis_1",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "조이스…… 조이스!"
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "잠…… 들었나?"
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "의식을 완전히 잃었어."
        },
        {
          "type": "dialogue",
          "speakerName": "엘레나",
          "speakerId": "avg_135_halo_1",
          "text": "즉시 치료하지 않으면…… 얼마 못 가서 뇌사 상태에 빠질 거야."
        },
        {
          "type": "dialogue",
          "speakerName": "사니",
          "speakerId": "avg_npc_535_1",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "사니 씨, 지금 바로 기지로 들어갈게."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "네 걱정은 알아. 그러니까 안심해, 무기는 안 가져갈 테니."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메리",
          "speakerId": "avg_npc_527_1",
          "text": "사일런스 씨, 지금 뭐 하는지 알고는 있어?!"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "응, 확실히 알고 있지."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "사니 씨, 경찰이나…… 방위과 사람은 누구도 못 따라오게 할게."
        },
        {
          "type": "dialogue",
          "speakerName": "라인 랩 방위과 직원",
          "speakerId": "avg_npc_528_1",
          "text": "사일런스 연구원, 당신의 행동을 주임께…… 파르비스 주임에게 보고할 겁니다."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "난 로도스 아일랜드 오퍼레이터로서 359호 기지에 들어가는 거야……"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "speakerId": "avg_1027_greyy2_1",
          "text": "저도요……"
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "……전기 엔지니어 동료도 나와 동행할 거고."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "이제부터 우리는 기지에 있는 광석병 환자에게 무상으로 의료 서비스를 제공한다."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "내 친구뿐만 아니라 당신들을 위해서도."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "라인 랩이 어떤 결정을 내리든 내 알 바가 아니야."
        },
        {
          "type": "dialogue",
          "speakerName": "사일런스",
          "speakerId": "avg_108_silent_1",
          "text": "내가 아는 건 감염자를 치료하는 게 로도스 아일랜드의 일관된 행동 규범이라는 것뿐."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
