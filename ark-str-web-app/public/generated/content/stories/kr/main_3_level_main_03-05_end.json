  "sourceHash": "828fdc08708408c2c439a36e61c55440ecf13b67e20456c2a7bdd032ae68dcbf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "후퇴하세요! 진형을 재정비합니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "적을 쫓지 마세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이대로는 우리 부대도 적들에 의해 둘로 갈라지고 맙니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그 상태에서 적의 증원이 온다면, 끔찍한 상황이 벌어지겠죠…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이번에 온 적은… 저희를 쓰러뜨리려고 온 것이 아닙니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "오퍼레이터 전원, 자신의 안전을 먼저 생각해주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "스나이퍼도 후퇴하는 적을 공격하는 걸 멈추세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "호시구마 씨를 엄호하는 게 먼저입니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "성가신 녀석들이군!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "꽤 하네, 설마 이렇게까지 버틸 줄은 몰랐는데~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "근데 앞으로 몇 번이나 더 버틸까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그건 네 녀석의 목숨이 얼마나 질긴지에 달렸지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "…첸! 지금이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "저 여자를 포위해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어머, 근위국의 지원군인가 보네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "무기를 버려라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "첸 팀장님, 또 만났네요~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "친한 척해도 소용없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "네가 용문에 저지른 짓을 두 배로 되돌려 주마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어머나~ 무서워라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그렇지만 이번엔 당신을 만나러 온 게 아니랍니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아미야, 이거 받아~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 말인가요? 이건… 휴대전화…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그래, 너랑 이야기하고 싶다는 사람이 있어서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "좋아, 이걸로 내 임무는 끝~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아, 맞아. 이건 아미야 말고 너희 모두에게 주는 선물이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "또 봐~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…근거리용 폭탄…?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아니, 섬광탄이에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 여자를 도망치게 내버려 둘 수는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "…늦었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이미 도망쳤다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "도망치는 거 하나는 정말 빠르군. 순식간에 빠져나가 버렸어. 근위국이 진형을 갖추기도 전에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아미야, 그 여자가 건네준 물건에는 주의해라. 만약 폭탄이라면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…이건, 아무리 봐도 평범한 휴대전화 같네요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "하지만… 혹시…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "여보세요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "당신은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아미야…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "미샤 씨! 어디 계시나요! 저…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아미야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이 목소리",
      "text": "……우선…… 중상자를!! ……수혈이 필요해! 서둘러!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "청년 목소리",
      "text": "…젠장, 어째서… 다 같은 감염자인데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "청년 목소리",
      "text": "로도스 아일랜드… 녀석들은 대체 왜 이런 짓을 하는 거지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자 목소리",
      "text": "…우린 처음부터 놈들에게 버림받았던 거야! 우리가 살아날 방법은 없어… 다 끝났다고…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자아이 목소리",
      "text": "죽으면 안 돼! 죽지 마! 같이, 같이 집으로 돌아가자고 했잖아…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이 목소리",
      "text": "…흑… 오빠… 안 돼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "들리니? 이 목소리들이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "리유니온의 감염자들… 인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "나, 기억났어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아니, 잊어버린 게 아니야. 그저… 떠올리고 싶지 않았을 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그래, 리유니온이 우리 집을 부수고, 아버지도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "하지만… 그건 우리가 자초한 일이었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그때 난 눈앞에서 남동생이 끌려가는 모습을 지켜봤어… 그 애는 울면서 내 이름을 불렀지. 하지만 난 고개를 돌리고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…내 방으로 숨었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "내가 그 아이를 다시 만났을 때… 그 아이는 이미 많은 것을 포기한 상태였지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그렇지만 그 아이는 변함없이 날 사랑해줬어. 그런데 나는 그게 두려워서 또 도망쳤고…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그래도 이젠 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "지금 저 사람들은… 그때 그들을 고통스럽게 했던 사람들에게 감염자들이 받았던 고통을 느끼게 해 주려는 것뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그리고 나도 이젠, 감염자가 되었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…그래, 드디어… 단죄의 시간이 온 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "미샤 씨, 무모한 짓은 그만두세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "지금까지 감염자들이 어떤 고통을 겪었더라도, 이제부터 당신이 변한다면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "소용없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "내가 뭘 바꿀 수 있다는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "나도, 그때 그저 바라보기만 했던 사람 중 하나인데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "감염자가 되고 나서… 확실히 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "비감염자가 감염자에 해왔던 짓을, 감염자도 비감염자에게 똑같이 돌려줘야 한다는 걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그게 바로 비감염자들이 받아야 할 벌이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그럴 수가…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "내 고통은, 결국 나 자신이 심었던 잔혹한 씨앗이 열매를 맺은 것일 뿐…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "물론 내가 마땅히 받아야 할 벌이기도 하고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "하지만 대체 왜…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그 아이는 아무런 죄도 없었는데!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그냥 갑자기 감염자라는 걸 알게 됐을 뿐인데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "이제 막 나한테 숙제를 가르쳐달라 하기 시작하던 그 어린아이를!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "만약 내가, 내가 그때, 그 아이를 지켜줬다면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "미샤 씨! 진정하세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "죄 없는 시민을 해친 건 당신이 아니에요! 당신의 잘못이 아니라고요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "처음부터 죄 있던 사람이 세상에 어디 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "잘못은…… 그래, 잘못이라면… 감염자가 되어버렸다는 게 잘못이겠지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "서로 상대방에게 복수하려고 싸우는 거라면, 이 비극은 대체 어디서부터 시작된 걸까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "만약 우르수스가 감염자를 가축 이하로 취급하지 않았더라면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "우르수스를 증오하는 사람들은 아무도 없었을 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "왜 감염자들은 늘 이런 고통 속에서 살아야 하는 건데!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "미샤 씨…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "스컬슈레더 씨는 이미 죽었어요. 저희에게 돌아오시면, 저희가 꼭…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "…아미야, 이미 답은 나왔어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "나도 감염자야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그러니, 감염자들의 편에 서겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "제발……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그래, 아미야. 너도 감염자잖아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "너도 분명 이해할 수 있겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 저도… 로도스 아일랜드에 있는 모두가 당신의 고통을 이해하고 있어요… 저는 알아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그렇지만 미샤 씨, 미샤 씨가 감염자가 되었다고 해도 변하는 건 아무것도 없어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "기다려 주세요, 바로 그쪽으로 갈게요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "오지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…미샤 씨! 무슨…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아미야, 네 말이 맞아… 난 그냥 내가 한심할 뿐이야. 그냥… 내가 너무 약한 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "이미 정했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아주 작은 첫걸음이라고 해도… 난 조금이라도 앞으로 나아가고 싶어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "미안해, 아미야. 미안해…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "리유니온은 감염자라고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "그들도 모두 감염자란 말이야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "안녕……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "미샤 씨? 미샤 씨?! 미샤 씨!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
