{
  "server": "kr",
  "storyId": "main_13_level_main_13-19_beg",
  "groupId": "main_13",
  "stageId": "main_13-19",
  "title": "진홍의 군주",
  "storyCode": "13-21",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_13-19_beg.txt",
  "sourceHash": "1d34eb0af1dcf5f6c230c990ed015eb05043c291444fce658e09b5b48fc007e4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "저건…… 도대체……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "뱀파이어 생귀나르가 전에 살카즈에게 남긴 축복은 아직 거두어지지 않았다. 하지만 방금 저건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "설마 박사 쪽에서 말한 게 바로……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……외드레르, W, 멍때리지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "지금이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "W, 묻어 둔 폭약들 있지? 터트려, 당장!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……말 안 해도 알거든!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "잡스러운 생각은 그만 해, 외드레르! 저게 뭐든, 우리는 지금 당장 상대할 수 있는 적만 상대하는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……알고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "W의 폭탄이 수비병의 방어선을 찢어놨으니 돌파한다. 너무 오래 붙잡혀 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "아미야와 로고스는 이미 한 발 앞서서 가고 있으니, 우리 대신 가장 성가신 그놈을 처리해 줄 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "나머지는…… 저들이 열어준 길을 따라, 저 다리를 통해 베헤모스의 해골로 올라간다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "망할, 이 자식들이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "놈들이 계속 지나가도록 두지 마라! 지휘관 울술라 님이 계단을 회수하고 있다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "반역자들을 여기서 죽여라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "저 망할 자식들의 시체는 나흐체러르 킹의 막사로 보내져, 우리가 맞이할 승리의 제물로 만들어질 것이다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "어라?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "뼈 밑에 지뢰를 심는 거, 나쁘지 않은 경험인걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "외드레르, 이네스, 준비해…… 충격파가 올 거야!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "W, 수류탄 세 개, 대각선 아래로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그거 괜찮겠는걸.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……이런 폭탄놀음에 어울려 주는 건 이게 마지막이야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "이쪽으로, 이 해골의 중추는 이쪽에 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "우리의 목표는 울술라야. 울술라를 찾아서, 지금 우리가 탄 이 놈의 통제권을 얻어내야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "진짜 이 뼈다귀를 '빼앗을' 수 있다고 생각하는 거야? 누가 들으면 무슨 카라반 약탈하러 가는 것만큼 간단한 줄 알겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "가능하다. 그렇지 않다면 아미야와 로고스의 전투엔 아무런 의미가 없어질 테니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그러니까 가서 문을 열고, 운전수를 집어 던진 다음 열쇠를 뽑고선 “좋아, 이제 이 차는 우리 꺼” 같은 짓을 한다는 소리지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……이게 일으킨 환상을 보고, 이 뼈대 사이를 걸으면서도 아무런 생각이 안 드나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "충분히 유명한 일화일 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 알아야 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "잊고 있었군, 넌 역사에 전혀 관심이 없었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "수백 년 전, 살카즈들은 어느 카즈델을 하마터면 멸망시킬 뻔했던 베헤모스를 죽였다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그 베헤모스가 죽은 뒤, 결국 어떻게 되었는지에 대해서 여러 이야기가 있는데 그중 하나는 바로……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "베헤모스의 의식은 사라지지 않았고, 대신 분해되어 여러 물품들 속에 봉인되었다는 것이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "이제 보니, 그 이야기가 정말로 진실에 닿아 있었을지도 모르겠군. 의식을 잃은 빈 껍데기는…… 이 전쟁이 일어나기 전, 누군가에 의해 조심스럽게 수집되었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "이를 개조하기 위해서 적잖은 품을 들여야 했을 거다. 그리고 확실히 이 전쟁 속에서 군사위원회에 의해 큰 활약을 했지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "'여러 물품들'이라. 울술라에겐 회중시계를 가지고 다니는 습관 같은 건 없었어. 흉터의 상점에서도 절대 시간 약속을 안 지키는 여자였고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "하지만, 만약 울술라의 회중시계에 정말로 이 베헤모스의 의식이 숨겨져 있다면…… 높은 확률로 심각하게 부서져 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "우리가 딛고 있는 이 해골은 분명 아직 죽지 않았지만, 그저 가장 기초적인 조건 반사만 하고 있어. 울술라도 아마 기껏해 봐야 그런 조건 반사의 방향만 유도하고 있을 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "그것들만 주의하면……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "엄폐해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "그렇지, 사람을 박살낼 수 있는 신경 다발과 어디서든 튀어나오는 날카로운 뼈의 창만 조심하면 별 거 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "이 녀석은 진작에 다 해체돼서 이 백골만 남았거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "글쎄, 아직 너희들이 남았잖아, 울술라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "이 살아 있는지 죽어 있는지조차 모르는 베헤모스보다는 너희가 더 위험한 존재야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "일은 드디어 다 끝났어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "너희가 방해만 안 했다면.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이 여자가 여기의 지휘관이야? 자신의 부하라는 흰 뼈다귀한테 참 매정한걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "화살 봐봐, 뼈에 박혔잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 뽑는 거 도와줄까? 꽤 간편한 방법이 있는데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "쿨럭쿨럭…… 이 미친 자식!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "내 눈앞에서 감히 내 부하를 죽이려고 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "외드레르, 날 너무 무시하는 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "쳇.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "예전보다 솜씨가 무뎌졌네, 울술라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "흉터의 상점에서 지내던 나날이 꽤나 괜찮았나 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "……너희는 확실히 생존의 전문가야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "카즈델에 있을 때, 늙다리들이랑 늘 내기를 하곤 했어. 너희들이 참가한 임무에서 누가 끝까지 살아남아 보수를 타먹을지 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "외드레르, 이네스, 그리고 거기에 미치광이 W까지 더하면 항상 돈을 딸 수 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그럼 우리 몫으로 나눠줘야 할 게 잔뜩이란 소리네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "'지금의 W'는 확실히 혀가 날카롭네. 이네스한테 좋은 거 좀 배우지 그랬어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "하지만 이번엔, 너희들이 틀렸어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "왕정의 주인 둘이 여기서 전력으로 싸우고 있어, 거기다 '마왕'까지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "항상 전쟁에서 도망칠 수 있는 너희들일지라도, 여기선 살아남을 수 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "그렇다면 너는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "테레시스가 런디니움에 안배해 둔 마지막 수단, 진작에 들은 바가 있지 않나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "심지어…… 그것들이 가져올 결과가 상식을 벗어나는 종류라면? 너는 여전히 그러한 대가 위에 재건한 카즈델이, 살카즈에게 도움이 될 거라고 보나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "……쓸데없는 소리는 집어치워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "병사들, 아직 시간이 남았을 때 이곳에서 놈들을 처리해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "소령님, 보십시오.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "이쪽의 뼈에……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "뱀파이어 생귀나르 님이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "이미 준비되셨나 보군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……이렇게 많은 피라니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "울술라, 이 피는 어디서 온 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그걸 말이라고 해? 살인에 중독된 그 뱀파이어 생귀나르가 여기서 학살이라도 했나보지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "아니, 저들의 손목에……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "“피의 왕정의 주인이시여, 제 피를 당신께 바치옵나이다.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스파인 수비병",
      "text": "“당신의 사냥이 영원토록 순조롭기를 바라나이다.”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "“그리고 저희는 저희의 피로서 질주하는 수레를 지어 당신께 바치겠나이다.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "울술라! 멈춰! 너 미쳤어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "베헤모스가…… 움직이려고 한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "지금 우리의 위치면 역사의 난류에 휩쓸리게 될 거다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "저 여자가 지금 우리를 길동무로 삼을 작정이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "난 베헤모스를 조종하고 있지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "선혈이 베헤모스의 근육을, 인대를, 골격을 대체했지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "베헤모스를 조종하기엔 충분해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "나와 마지막까지 함께해 준 훌륭한 동료들이여, 살카즈의 영혼들 사이에서 다시 만나자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "내가 말했지, 이 해골에서 도망치려고 해도 살아서는 돌아갈 수 없다고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "서둘러! 일단 선실 안에 숨어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "환상이 떠오르기 시작했다. 어디로 향할지는 아무도 몰라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……파도를 일으켰다! 조심해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "쳇, 저 뱀파이어가 대체 우리를 어디로 데려갈 생각이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "외드레르?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "난 여기 있다. 울술라도.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "출혈이 심한 탓에, 살아남을 수 있을지는 봐야 알겠지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "선실 밖에 내버려 두지 그랬어, 외드레르. 부하들이랑 같이 죽을 수 있게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "지금까지 그렇게 많은 '친구'들을 죽여왔으면서, 갑자기 착한 척을 하고 싶었다던가 그런 건 아니겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "너에게는 아직 이용 가치가 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "말했지, 이 해골은 이미 내 통제에서 벗어났다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "넌 군사위원회에 충성한다고도 했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "만약 군사위원회가 카즈델이 '국가'로서 의존할 대상이라고 생각한다면…… 어째서 그자는 아직도 스스로를 섭정왕이라 칭하는 것이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "어째서 테레시아가 필요한 거지? 어째서 이 전쟁을 이기면 카즈델에게 미래가 있을 것이라고 여기는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "테레시스는 도대체 무슨 생각을 하는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "됐다. 이런 건, 베헤모스를 손에 넣은 다음에 얘기하도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "너희들…… 뭘 하려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "우리의 목표는 바뀌지 않았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "고향으로 돌아가는 것.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "……하. '고향으로 돌아간다'라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "그것은 원래 이 해골의 마지막 임무였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "……뭐라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "이름도 있는 해골이야, 코드네임 '라이프 스파인'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "비록 거의 쓰이지는 않지만, 맨프레드 장군이 그 이름을 지을 때…… 내게 같은 말을 했었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "같은 말을 했다고? 맨프레드가……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "우리는 적이니 대답은 더 이상 하지 않겠어, 그저 내 죽음만을 기다릴 뿐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "게다가, 훗. 네가 오늘까지 살아 있다는 것 자체가 답이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "정말 맨프레드 장군이 장님이라고 생각해? 너희의 잔재주 하나도 눈치 못챌 정도로?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "text": "뭐, 그것도 너희가 뱀파이어 생귀나르 님에게서 살아서 도망친 뒤에야 '고향으로 돌아간다' 따위의 말을 입에 담을 자격이 생기겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "맞는 말이군.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "그럼……\n잠시 네 회중시계 좀 빌리지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "확실히…… 생각보다 더 시끄럽군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "대지를 떠도는 베헤모스여, 당신은 아직 죽지 않았다. 스스로가 존재하는 방식을 바꾸었을 뿐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "text": "당신은 아직 이 안에 있는 것이겠지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "멈추시지요, 베헤모스.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "당신은 카즈델, 저희의 도시를 앞에 두고 있습니다. 그곳의 사람들은 당신의 방문을 원치 않습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "다른 곳으로 가시지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "그리하지 않는다면, 살카즈가 당신을 도륙할 것입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "이는 저희의 마지막 경고입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베헤모스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "어쩔 수 없군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "형님께선 저희에게 저것의 전진을 금하고, 마왕의 의지에 복종하도록 명령했지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "젊은 뱀파이어?",
      "text": "선혈의 왕정이여, 너를 내게 바치거라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "환각과도 같았던 과거와 기억에 비하면, 분명 당신은 제게…… 보다 가치 있는 풍경을 보여 주었군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "두 분, 이런 진귀한 풍경이 앞에 펼쳐졌으니, 손에 들린 그 나약하고 가소로운 아츠를 우선 흩어버리는 게 어떨지요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "자, 주변을 둘러보세요. 시간을 들여 감상해도 괜찮습니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "이는…… 제가 그대들을 위해 선정한 무덤이니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "방금까지만 해도 낮이었는데, 여긴……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어두운 밤이에요, 그리고 끝없는 바다까지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "……별이 바뀌었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "이런 곳은, 그 어떤 서적이나 전설에서도 듣지 못했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "그렇다면, 여기는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "충분히 아득하고도 요원한 곳이지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "그렇네요, 과연 저희가 지금 카즈델과 얼마나 떨어져 있을지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "모든 이들에게 테라라고 불리는 이 땅은, 과연 너무 넓은 걸까요, 아니면 너무 좁은 걸까요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "아미야, 조심해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "저 녀석의 피가…… 승화하고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "방금 그 아츠를 사용해서 자신의 혈맥을 깨운 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "마치 남의 일처럼 말씀하시네요, 밴시.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "그대도 알 텐데요. 저는 순수한 자라면 항상 동등하게 대한다는 걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "어쩌면, 무수히 많은 세월 동안 순수함을 추구해 온 선혈의 왕정에 비하면, 당신은 오리지늄에 너무 깊이 영향을 받았을지도 모르겠네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "하지만 상관없습니다, 살카즈 중에서 당신은 분명 맑고 깨끗한 편이며…… 또한 강한 편에 속하니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "자, 사양하지 말고 저의 축복을, 거부할 수 없는 선물을 받으시죠. 제가 불러온 힘에 의존해야만 결국 저와 맞설 수 있을 테니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "그 종의 비명이 지금도 과연 달빛을 어둡게 만들 수 있을지, 부디 제게 들려주시죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "“내가 적어내리는 것은 곧 나의 명일지니.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "“흑야는 나를 위해 죽음을 가릴지어다.”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "……또 주문인가요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "또 그 천박한 주문이라니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "당신은 비범한 재능을 가졌습니다. 그저 입술을 달싹이고 골필로 적는 것만으로도 범인들의 가련한 오리지늄 '아츠'를 멸시하기에 충분할 정도로요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "허나, 어째서 전승을 이토록 거부하는 것인가요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "제게 당신을 보여주시지요. 왕정의 주인, 밴시여!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "나…… 뱀파이어 생귀나르 두카렐에게, 모든 선혈의 지배자에게 당신을 보이란 말입니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "멈추세요, 뱀파이어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "로고스 씨, 버텨 주세요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "오, '마왕'. 당신도 여기에 있다는 걸 깜빡하고 말았네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "카우투스, '마왕'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "보세요, 당신은 제 은혜를 단 한 톨도 얻지 못했네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "카우투스의 피, 지루하고 평범하지요. 제가 심혈을 기울여 낱낱히 파헤쳐 봤지만 단 한 줌의 재능과 힘도 찾을 수 없더군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "심지어 그 피가 더럽혀졌거나 난잡하다고도 말하는 것조차 망설여집니다. 그런 단어는 결국, 다시 순수해질 수 있다는 기대를 담고 있는 표현이니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "하지만 당신은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "훗.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "물론 혼돈을 지닌 핏줄은 저 또한 인정합니다, 하지만 그들은 전부 의심할 여지 없이 '강대'했으며 또한 '아름'다웠지요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "허나 당신에겐 무엇이 있죠? 가소로운 동기? 천박한 믿음?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……당신에게 대답할 의무는 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그저, 당신을 쓰러뜨리기만 하면 되니까요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "이게 바로 '마왕'인가요? 그저 타인의 기교를 훔쳐냈을 뿐, 난잡하고 무질서하군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "저 밴시가 반항심으로 만들어 낸 장난감보다도 못해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "……그 남매에겐 더더욱 못 미치고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "도발에 넘어가지 마라. 지금 이 순간에도 힘이 증폭되고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "text": "속전속결로 가지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "다시 맑은 하늘 아래로 돌아가도록 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "……과거.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "저는 소위 '마왕'이라는 자를 하나 살해한 적이 있지요, 딱히 어렵지는 않았답니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "그리고 지금, 당신의 최후도 똑같을 예정이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "당신이 칠흑의 칼날로 저를 의심하겠다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "text": "저는 당신에게 죽음을 선사하는 것으로 대답하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
