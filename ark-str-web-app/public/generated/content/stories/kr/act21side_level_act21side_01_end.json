    {
      "type": "dialogue",
      "speakerName": "오만한 관리",
      "speakerId": "avg_npc_222",
      "isRemote": false,
      "text": "당신은……"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "avg_npc_689_1",
      "isRemote": false,
      "text": "루비오입니다. 지난주에 파티에서 만났었죠."
