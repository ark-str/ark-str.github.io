    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "속물적인 관리",
      "speakerId": "avg_npc_223",
      "isRemote": false,
      "text": "베아토 씨, 이쪽입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "오만한 관리",
      "speakerId": "avg_npc_222",
      "isRemote": false,
      "text": "어, 그래. 그럼, 먼저 실례하겠습니다."
