      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "만트라",
          "speakerId": "avg_4204_mantra_1",
          "text": "내가 아미야와 함께 가겠어."
        },
        {
          "type": "dialogue",
          "speakerName": "만트라",
          "speakerId": "avg_4204_mantra_1",
          "text": "박사, 순조롭길 바라지."
