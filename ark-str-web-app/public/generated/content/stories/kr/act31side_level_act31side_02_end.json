    {
      "type": "dialogue",
      "speakerName": "촌장",
      "speakerId": "avg_npc_1240_1",
      "isRemote": false,
      "text": "……저 강 건너의……"
    },
    {
      "type": "dialogue",
      "speakerName": "만 시랑",
      "speakerId": "avg_npc_1241_1",
      "isRemote": false,
      "text": "알고 계시잖습니까. 그게 전부가 아니라는 걸."
