    {
      "type": "dialogue",
      "speakerName": "빅토리아 스파이",
      "speakerId": null,
      "isRemote": false,
      "text": "시작해라."
    },
    {
      "type": "dialogue",
      "speakerName": "'A조'",
      "speakerId": null,
      "isRemote": false,
      "text": "잠깐, 상황 변경!"
