    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엔시오데스",
      "speakerId": "avg_172_svrash_1",
      "isRemote": false,
      "text": "마터호른, 내일도 계속 테일러 씨를 안내해 줘."
    },
    {
      "type": "dialogue",
      "speakerName": "엔시오데스",
      "speakerId": "avg_172_svrash_1",
      "isRemote": false,
      "text": "정상적인 범위의 요구라면 다 들어주고."
