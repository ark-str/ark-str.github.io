    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "해럴드",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "이런, 죄송합니다. 아직도 여기 계셨군요."
