    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "데겐블레허",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": true,
      "text": "다른 사람한테 연락이 오는 게 싫을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "데겐블레허",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": true,
      "text": "엔시오데스, 네가 알아야 할 일이 있어."
