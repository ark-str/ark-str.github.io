{
  "server": "kr",
  "storyId": "story_susuro_set_1_story_1",
  "groupId": "story_susuro_set_1",
  "stageId": null,
  "title": "전문의",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/memory/story_susuro_1_1.txt",
  "sourceHash": "26b667310a39de7de5b1f88d6784c9e56823862eec069e2f0c72cd51991b9bbc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "몇 시예요?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "4시, 몇 번을 물어보는 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "급하니깐 그러죠! 안 급해요?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "진정해, 급하면 뭐 어쩌게? 본함에서 오는데 무사히 도착하기만 해도 감사하지."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "정말이지, 어떻게 3일 만에 본함에서 여기까지 올 수 있죠? 대단하네요, 본함은."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "본함에 가본 적 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "아니요. 한 번 가는데 비용도 만만치 않고, 게다가 여기 할 일도 많고."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "본함에 이동속도가 엄청나게 빠른 대형 공중 교통수단이 있다던데, 넌 본 적 없지?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "공중이요? 차가?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "절대 차는 아니지…… 실제로 뭐라 부르는지는 나도 몰라."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "아아, 혹시 그 윗선의 높은 캐스터 양반들이 타고 다니는 고급템 말인가요? 하늘을 막 떠다니는 그런 거?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "그런 것도 아니고!"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "아, 그만해. 나도 본 게 적어서 모른단 말이야. 나중에 직접 보던가."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "그렇게 한가하면 다시 차량 점검이나 해. 돌아갈 땐 서둘러야 하니까 일이 터지면 안 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "네네네…… 상사가 까라면 까야죠."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "그나저나 이번에 본함에서 오는 사람은 누구인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "이름 말해줘도 모르잖아 어차피, 본함 가본 적도 없으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "우리 쪽에서 긴급 요청을 보냈으니, 누가 왔든지 간에 분명히 의료부의 엘리트일 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "이번 일은 작은 일이 아닌데, 어떤 엘리트가 올까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "쓸데없는 걱정 하지 마."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "오, 저기 온다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "저 교통수단은…… 굉장한데요. 본함에는 저런 것까지 있구나. 식견이 넓어지네요."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "됐고, 손님 맞을 준비나 해."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "라이타니엔에 온 걸 환영해. 나는 여기 사무소 책임자인 페랄리구스야. 페를이라고 불러줘."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "안녕, 난 본함의 메딕 오퍼레이터 수수로야. 이쪽은 내 조수고."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "(고개를 끄덕인다)"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 B",
      "speakerId": "char_013_riop",
      "text": "인사 안 하고 뭐해?"
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "아, 아! 네."
    },
    {
      "type": "dialogue",
      "speakerName": "사무소 오퍼레이터 A",
      "speakerId": null,
      "text": "저는 현지 사무소의…… 운전기사…… 아니, 저는 사무소의 오퍼레이터로, 코드네임은 피스톤입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "상황이 좀 복잡해. 시간도 촉박하니 일단 차에 타."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "이번 돌발 사건의 자세한 자료는 전부 프린트해뒀으니, 차 안에서 보면 될 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "알았어, 고마워."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "장비를 좀 챙겨왔는데, 싣는 걸 도와줄 수 있을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "아…… 알겠습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "2시간 후"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "두 번째 서류 좀 보여줘 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "네."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "이 보고서를 확인하고 추가로 준비할 장비가 있는지도 체크해."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "알겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "(보스!)"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "뭔데, 왜 몰래 수군덕거리는데."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "(목소리 너무 커요! 조금 더 이쪽으로……)"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "엘리트라고 하지 않았나요? 어째서 저런 꼬마 아가씨가 리더인 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "너 이 자식, 말조심해. 또 그랬다간 네 보너스 삭감할 줄 알아."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "언제부터 그렇게 겉모습으로 사람을 판단하는 나쁜 버릇이 생겼지? 직원 매뉴얼은 허투루 봤니?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "모르면 입 다물어. 저 사람은 진짜로 본함 의료 부서의 엘리트라고."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "네네, 알았어요…… 미안해요, 미안."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "페를 씨."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "어?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "자료는 다 봤는데 몇 가지 질문이 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "자료에 따르면 이번에 의료 구호가 필요한 사람이 대부분 광석병 감염자가 아니라는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "아아, 맞아. 라이타니엔 공식 발표는 재앙으로 인한 도시 파괴와 사상자라고 했지만, 실제 상황은 그보다 훨씬 복잡해."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "그럼 재앙정보전달자의 실수인가?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "지금으로 봐서는…… 그렇지도 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "이번에 재앙을 대비한 철수 작전은 전혀 문제가 없었어. 적어도 그 과정에서는 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "유일한 오산이라면…… 재앙의 경로 상에 최소 열 군데의 니들플라이 대형 소굴이 있었다는 거지."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그 마을은 미리 철수하기 시작했지만, 재앙으로부터 도망친 수백 마리의 니들플라이가 이동 중인 대열에 돌진해 들어갔어……"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "니들플라이요? 혹시 그 1미터가 넘는 육식 벌레 말입니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "그것도 수백 마리나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "알겠어……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "그럼 사상자 수는 알아?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "라이타니엔은 아직 정확한 숫자를 공식 발표하지 않았어."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "벌써 이틀이나 지났는데도 아직 결론이 나지 않았거든……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "즉 현시점에서는 사상자 수를 집계할 수 없다는 거네."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "영지 위병들이 많은 부상자를 근처의 마을로 이송했지만, 우린 그걸 일일이 확인할 여유가 없었어."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "사무소에 비축된 의료 물자는 충분해? 니들플라이의 독소를 처리할 해독제 재고는? 수술 설비의 관리 상태는?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "현지 다른 의료 구급대의 동원 상황은? 자료에 없는 이런 정보들이 필요해."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "그건……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "의료 물자는 넉넉한 편이야."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "현지 권력자들이 즉각 구조 작업에 나섰고, 로도스 아일랜드 사무소도 의뢰를 받은 뒤 응급 구조 물자를 충분히 보급받았어."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "의료 설비의 상태도 문제없지만, 그것들이 스스로 움직이는 게 아니라서 우리 일손이 턱없이 부족해."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "마을 의사들도 훈련은 잘되어 있으나, 긴급사태를 대처하는 경험이 부족해. 이 정도의 재난은 대부분 사람이 처음 겪거든."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "사무소가 위치한 마을에는 사람이 많지 않아. 마을 전체를 통틀어도 소규모 진료소 3개밖에 없으니, 수술이 가능한 의사는 더욱 적어."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "많은 부상자는 수술대에 오를 때까지 버티지 못해."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "사무소에도 지금 대량의 난민을 수용하고 있어 상황이 좋지는 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "게다가, 이런 혼란스러운 상황에선 우리가 감염자를 즉각 판별할 수도 없고."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "보내온 환자 중에는 감염자도 있어…… 감염자가 사망한 이후의 상황은…… 말 안 해도 알겠지?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "……응, 알아."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "아직 한참 더 가야 하니, 좀 쉬고 있어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "도착했어요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "벌써 사람들이 많이 있네요."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "부상자는 모두 사무소 근처로 옮겨져, 다른 직원들이 처리하고 있을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "피스톤, 넌 여기서 기다려. 이따가 보급 차량이 올 거니깐, 네가 맞이하도록 해."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "여기서 마냥 기다려요? 괜찮을까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "넌 이런 임무가 처음이잖아? 현장 상황은 네가 생각한 것보다 훨씬 가혹해…… 그러니 여기서 의료 물자 받아서, 얌전히 분배나 해."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "무슨 말씀이세요. 저 꼬마 아가씨도 가는데, 나 같은 사내가 두려울 게 뭐가 있겠어요?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "……새파랗게 어린 주제에."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그래, 알았어. 나중에 후회나 하지 마."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "형체를 알아볼 수 없는 환자",
      "speakerId": null,
      "text": "물…… 물 좀……"
    },
    {
      "type": "dialogue",
      "speakerName": "어린아이",
      "speakerId": null,
      "text": "아빠! 아빠!!"
    },
    {
      "type": "dialogue",
      "speakerName": "피투성이의 환자",
      "speakerId": null,
      "text": "쿨럭쿨럭…… 쿨럭……"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "여기 한 명 와줘요! 이 감염자가 위급해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "일반 환자",
      "speakerId": null,
      "text": "감염자! 가, 가까이 오지 마!"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "당신은 왜 여기 있습니까? 빨리 치료구역으로 돌아가세요."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "위병! 위병! 어디 갔어요?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……세상에…… 이게……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "상상했던 것보다 더 가혹하네."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그저께 왔을 때만 해도 저쪽 큰 마당은 이곳 상회의 화물 터미널이었는데, 지금은 일반 환자의 치료구역으로 사용되고 있네."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "의사의 일손도 턱없이 부족해. 의료실에서 우선으로 응급 처치를 받을 수 있는 건 중상자뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "바닥에 누워있는 이 사람들은…… 어떻게 된 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "아마 모두 감염자일 거야. 마을이 작다 보니 감염자 수용 구역이 없어. 감염자와 일반인을 같이 둘 수는 없으니까……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "그렇다고 저 사람들을 광장에 내버려 두는 거야? 페를 씨, 우리 사무소 창고에 남은 공간 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "지금 바로 물건을 다 빼 볼게. 아마 큰 문제 없을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "그리고, 중상 감염자를 수용할 독립된 공간이 필요해. 격리된 장소면 가장 좋겠지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그럼 직원 숙소를 비우는 수밖에 없어. 시간이 좀 필요할 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "부탁할게."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "1팀은 창고에서 감염자 상태 확인."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "2팀, 3팀은 나와 함께 장비를 수술실로 옮겨줘!"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "환자 분류와 배정은 당신에게 맡길게."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "네, 알겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "저, 저도 도울게요."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "아, 그럼 이 사람들을 방으로 옮기는 걸 도와주세요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "오리지늄 아츠를 이용해 상처를 치료하기 전에, 반드시 독소가 깨끗하게 제거되었는지부터 확인해줘."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "만약 상처가 그리 심하지 않으면 최대한 오리지늄 아츠를 사용하지 않도록 하고. 현재로서는 의사의 체력이 가장 귀한 자원이야. 효율적으로 분배해야 더 많은 목숨을 구할 수 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "알겠습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "먼저 이쪽이요! 중증 환자가 있습니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "상황은?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "후우……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "가족을 지키려다 니들플라이에게 팔이 뜯겼나 봐요. 보내왔을 때 이미 의식을 잃은 상태고요."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "감염자이긴 하지만, 병세는 안정적입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "……떨어진 팔은? 아직 있나?"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "(고개를 젓는다)"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "상처가 이미 세균에 감염됐어. 왼손도 눈에 보일 정도로 곪아 있어서 좀 더 절제해야 해."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "……그렇다면 두 손 모두……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "여긴 내가 맡을 테니 당신은 가서 2팀 도와줘."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "부탁드립니다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "멍하니 있지 말고 감염자 응급처치를 준비해."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "환자의 체표면 결정이 인후부에 있어. 혈액검사도 준비하고."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "손목에 있는 비늘을 조심하고, 사브라 전용 메스 준비해줘."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "방안의 불빛이 너무 어두워. 피스톤 씨, 발전기 상태를 확인해줄 수 있을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "네, 알겠습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "3시간 후\n사무소 의료실 안, 중환자의 수술은 여전히 이어지고 있다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "부상자",
      "speakerId": null,
      "text": "선생님…… 저 살 수 없는 거죠?…… 선생님, 알려 주세요……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "구강 내 출혈이 많아. 석션 보틀 좀 갈아 줘."
    },
    {
      "type": "dialogue",
      "speakerName": "부상자",
      "speakerId": null,
      "text": "선생님…… 부, 부탁입니다. 이 반지를…… 제 아내에게 전해주세요. 부탁드립니다……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "넌 살아남을 거야. 그러니까 힘내."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "거즈가 떨어졌어. 더 가져와!"
    },
    {
      "type": "dialogue",
      "speakerName": "부상자",
      "speakerId": null,
      "text": "으윽…… 거, 거짓말하지 마세요. 저는 다 알아요……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "말하지 마! 넌 살아남을 수 있어. 약속할게!"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "여기 꽉 눌러 줘. 봉합한다."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "과산화수소수도 다 썼습니다. 누가 창고에 가서 한 박스 가져다주세요!"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "피스톤 씨!"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "네, 네, 바로 다녀올게요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "출혈은 멎었어. 나머지는 맡긴다. 나는 다른 환자를 확인할게."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "알겠습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": null,
      "text": "팀장님, 여기요! 방금 이송된 환자가 위급합니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "바로 갈게."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "위독한 환자",
      "speakerId": null,
      "text": "쿨럭…… 으악……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "흉복부 복합 상처에 복부 개방성 외상이야."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "밀어 넣고 우선 처리해. 식도와 기도를 절개한다."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……세…… 세상에……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……이게……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "멈추지 마! 아직 다른 환자들도 있어!"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "장기 파손 여부 확인! 복막 출혈이 없는지도 확인하고! 빨리!"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……우웁…… 저는 좀……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "죄송해요…… 우욱…… 저는……"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "괜찮아. 수고했어. 먼저 나가 쉬고 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "가…… 감사합니다……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……너무 무서워……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "우웩……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……본함 사람들은 늘 이런 상황에 대응하나."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "…… 웁…… 또…… 온다…… 우웩……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": null,
      "text": "너 괜찮아?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……괘, 괜찮아요. 아직 이런 광경이 익숙지 않아서……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "자, 수건. 얼굴 좀 닦아."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "휴……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……우욱…… 부끄럽습니다. 제가 현장에서 가장 부실한 존재라니."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "신경 쓰지 마, 넌 아주 잘했어."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "이게 잘한 거예요?"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "넌 자진해서 도왔고 반나절이나 버텼잖아. 게다가 넌 메딕 오퍼레이터도 아닌데. 난 네가 반 시간도 못 버틸 줄 알았는데 뭐."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "그 꼬마 아가씬…… 아니, 그 메딕 오퍼레이터는 정말 대단한 것 같습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "훗, 내가 말했지. 저 사람들은 본함의 엘리트라고."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "저 수수로라는 메딕 오퍼레이터는 몇 년 전 팔레르모 사건의 경험자야. 만만하게 봐선 안 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "팔레르모 사건? 아…… 그 당시 시라쿠사를 떠들썩하게 했던 사건이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "오리지늄 광산이 폭발하는 바람에 민간인 급성 감염자가 많이 생겼고, 의료진과 의료 설비, 약품 부족으로 급성 감염자가 대량으로 사망했던 거로 기억하는데…… 도시 절반이 거의 붕괴 직전이었죠."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그건 정말 인간 지옥이었어. 대량의 감염자가 급성 발작을 일으켜 사처에 감염자 유해들이 널브러져 있고, 활성 분진들이 온 사방에 퍼져있다고 상상해 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "팔레르모 사건을 직접 겪었던 사람들은 모두 심각한 트라우마가 남았대."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그러니까, 저 메딕 오퍼레이터한테 오늘 같은 광경은 그저 귀여운 수준이야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "안 되겠다, 다시 도와주러 가야겠어요."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "됐으니까 그냥 쉬어."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "네가 안에서 또 들어가서 토라도 해봐, 오히려 더 방해될 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……그것도 그렇네요."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "정 돕고 싶으면 대피소에 가서 연락할 사항이 없는지 물어봐. 내친김에 다른 사무소의 보급차가 왔는지도 확인해보고."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "네, 바로 갈게요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": null,
      "text": "……하, 자식."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "후우…… 힘드네요……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "아, 선생님, 상황은 어때요?"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "당신들 덕분에 대부분 환자들이 안정을 찾았습니다. 나머진 아미르 쪽에서 어떻게 하느냐에 달렸죠."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "당신들의 숙소까지 환자용으로 할당해 준 것 같더군요. 저는 로도스 아일랜드가 의료 기업이 아닌 줄 알았는데, 저…… 정말 죄송합니다."
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "그리고 진심으로 감사드립니다. 지금은…… 으음, 이 이상의 단어가 떠오르지 않네요. 당신들의 지원이 없었다면 사상자 수량과 2차 피해는 상상도 할 수 없었을 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "아닙니다…… 전 그저 잡일을 맡고 있을 뿐…… 어……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "메딕 오퍼레이터분들은요? 쉬고 계시나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "현지 의사",
      "speakerId": null,
      "text": "저도 어디 갔는지 몰라요. 당신들이 더 잘 알 거라 생각했는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……알겠습니다. 선생님도 얼른 쉬세요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "보스, 본부에서 온 메딕……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "쉿, 너 조용히 해!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "할 말 있으면 밖에서 얘기해."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "저 사람들…… 아니, 쉬게 두죠."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "대피소 상황은 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "문제없어요. 아미르 쪽 사람들이 와서 경증 환자의 1차 이송을 시작했어요."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그럼 됐어."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "할 말 있으면 그냥 해, 우물쭈물하지 말고."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "아니…… 그냥……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그만두고 싶어졌어?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "아니에요. 단지 로도스 아일랜드의 업무에 대해 조금 더 이해하게 된 것 같아서…… 대략이요, 아주 약간."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "하하하……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "의욕이 생겼다는 건 좋은 거지. 기왕 의욕이 생긴 거 지금 가서 의료 물자의 소모 상황을 점검해 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "기록은 2부 작성해. 하나는 사무소에 남겨 두고, 다른 하나는 내일 아침 현지 정부에 제출하고."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……알겠습니다. 지금 바로 확인할게요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "4일 후"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "짐 다 쌌어?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "응, 다 했어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "왔어요. 저 왔어요. 하마터면 늦을 뻔했네요!"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "너 뭐 하고 있었어!?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "아, 수수로 씨가 뭐 좀 부탁해서, 제가 다 사왔지요."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "이렇게 많이?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "크, 크흠…… 이것들은 켈시 선생님께 드릴 책이고, 이건 가비알 씨에게 줄 공예품이야."
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "speakerId": "char_016_medic",
      "text": "이건 뭔가요? 간식인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "그건 박사님께 드릴…… 작은 선물."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "박사님? 그러니까…… 그 박사님?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "아무튼, 켈시 선생님과 박사님께 안부 전해 줘."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "알았어."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "조심히 들어가."
    },
    {
      "type": "dialogue",
      "speakerName": "수수로",
      "speakerId": null,
      "text": "고마워, 나중에 또 봐."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "다 갔네요."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "됐어, 가서 일하자. 아직 써야 할 보고서가 많이 남았거든."
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "……으음……"
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "왜 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "피스톤",
      "speakerId": null,
      "text": "저도 언제 한 번 업무차 로도스 아일랜드 본함에 가볼 수 없을까요…… 전부 대단한 사람들이 모여있는 것 같아요."
    },
    {
      "type": "dialogue",
      "speakerName": "페랄리구스",
      "speakerId": "char_013_riop",
      "text": "그럼. 일단 하던 일이나 끝내고 생각해보자."
    },
    {
      "type": "sceneBreak"
    }
  ],
