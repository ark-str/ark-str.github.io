        {
          "type": "dialogue",
          "speakerName": "테레시스",
          "text": "물러나라, 그리고 안전한 곳에서 기다려라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "테레시스",
          "text": "잊지 말고 '암나남'을 카즈델로 가져가도록.",
