  "groupId": "1stact",
  "stageId": "a001_02",
  "title": "눈치",
  "storyCode": "GT-2",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/a001/level_a001_02_beg.txt",
  "sourceHash": "ad3fe647e25c8b7ba5998c4c72c7725be65378d27e77e53c11bf4a7fe18093cb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "저 여자를 잡아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "잡으라니, 어떻게! 모두 당해버린 거 안 보여?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "네가 해! 평소에 잘난 척하던 건 어떻게 된 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "나, 나한테는 무리야! 저 녀석이 바로 그 소문으로만 듣던 '액성'이라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(에기르어) 나의 앞에 서는 자는 모두 죽는다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(에기르어) 나에게 휘두른 무기는 모두 부서진다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(에기르어) 죽고 싶으면 앞으로 나와라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "'대위'",
      "text": "뭐라고 중얼대는 거야……?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "아앗? 대위님? 대위님이 사라졌어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "대위님이 강까지 날아갔어……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "단 한 방으로 사람을 저렇게 멀리……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "아아, 너희는 못 알아듣는구나…… 뭐, 됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그 여자는 어디에 있지? 말하는 게 신상에 좋을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "여자? 누구를 말하는 거야? 나, 나는 아무것도 몰라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "크악!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "두, 두고 보자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "이봐! 도망치기 전에 대위님을 물에서 건져야지!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "저, 저 사람은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "아는 사이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "내 동료일지도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "하지만 이 임무를 받은 건 나 하나일 텐데? 겨우겨우 메테오라이트 언니한테 받은 임무인데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "으으으…… 아니면 뭔가 다른 임무 때문에 온 걸까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "어… 바운티 헌터들은 모두 도망친 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그럼 서둘러야지. 당장 마을을 나가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "다른 오퍼레이터도 이 마을에 있으면 임무가 조금은 편해질지 모른다고 긍정적으로 생각하는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "클로어, 계단이 어두우니까 나를 꽉 잡아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "응. 그보다 아까 그 여자한테 연락 안 해봐도 되겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "응, 할 수 있을 것 같으면 해보……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "끄악……………………!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "으아악………………!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "내, 내 코! 왜 문이 멋대로 열리는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "으앗? 왜 이런 곳에 사람이 누워……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "그라니! 무슨 일……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "다들 조용히 해! 쉿!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……쉿…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "칫, 너희 마을 사람들은 아무것도 모르나 보군. 저 액성이 안 보이는 거냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "바운티 헌터라면 누구라도 저 여자와는 만나고 싶지 않을 거다! 아직 저 녀석이 마을 하나를 날려버리는 걸 본 적이 없나보군 그래!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "과장이 심하잖아! 혼자서 마을 하나를 날려버렸다니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "조용히 해. 들키잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "으으음, 그래도 난 저 여자를……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "조용히 하라고 했잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "아, 알았어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "어째 로도스 아일랜드에서 들었던 것보다 소문이 더 심하게 퍼진 것 같은데……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "그, 그 괴물은 이제 갔나?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "가… 간 것 같다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "드디어 갔군. 후우, 죽는 줄 알았네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그, 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "이 정도 '업무'는 우리 한 부대로도 어떻게든 될 줄 알았는데, 저런 녀석까지 나타났으니 제대로 준비하지 않으면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "……잠깐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "헉! 창술사 꼬마! 이런 데서 만날 줄이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "촌장까지 있잖아! 정말로 우리한테 데려와주다니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "그라니, 혹시 일부러……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "아니야, 아니야. 이 사람들이 너무 자연스럽게 말을 걸어오니까 나도 모르게 그만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "우물쭈물 떠들지 말고 빨리 촌장을 넘겨! 이 검이 널 갈기갈기 찢어버리기 전에!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그 부러진 검으로?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바운티 헌터",
      "text": "……이, 이 꼬마! 언제 창을 꺼냈지!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "신호를 보내! 주변 녀석들을 집합 시켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "흉폭한 바운티 헌터",
      "text": "논을 망쳐놓은 벌레들도 모아라. 이 녀석들한테도 벌레들의 무서움을 보여주자고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
