{
  "server": "kr",
  "storyId": "story_lava_set_2_story_1",
  "groupId": "story_lava_set_2",
  "stageId": null,
  "title": "간호",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/memory/story_lava_2_1.txt",
  "sourceHash": "2343bea890e51183c9e71380b3526793b369fd8e5431a04e66d2c2e7f0bc47b8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "띠띠띠띠——\n띠띠띠띠——\n띠띠띠띠——\n툭"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아…… 시끄러워 죽겠네……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "히비스, 빨리 일어나."
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "왜 답이 없지."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "늦잠 자는 거 아니지?"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "어젯밤에 나한테 메시지 보내서 진료 가야 하니까 일찍 깨워달라고 했잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "난 일어났는데, 언니가 아직 자고 있네. 하암……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "에잇, 자라 자. 나 먼저 씻는다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "응?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "언니 왜 아직도 자?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "일어났어?"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "나도 방금 외근 다녀왔어. 이번 임무는 쉽지도 않고 너무 까다로워서, 나 말고 대응할 수 있는 사람이 몇 명 안 됐거든."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아미야가 며칠 휴가를 줘서 나도 온종일 잘 수 있었는데."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "언니 깨우는 거 아니었으면 나도 한두 시간은 더 잤을 거야. 하암……"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아직도 안 깬 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "안 일어나면 때린다!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "어젯밤에 언니는 의료부의 정예 중 하나니까 절대로 지각할 수 없다고 했잖아. 잡아당겨서라도 깨워달라더니."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그런 말이 처음도 아니지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "진짜 언니를 이불 밖으로 잡아당기는 건 처음이네."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "흥, 나 없으면 어떻게 할래?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "이래도 안 일어나? 진짜 이불 치운다. 춥다고 뭐라 하지 마."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "히비……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "히비스, 왜 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "손은 왜 이렇게 뜨겁지?!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "히비스? 언니? 장난치지 마, 멀쩡한 거 아니었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "어떻게 갑자기……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "언니, 언니, 말 좀 해봐!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "나 일어났어…… 라바……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "흔들지 마……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아, 미, 미안."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "괜찮아?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "조금 춥고…… 기운이 없네……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "열이 났나 봐……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "열? 언니도 열이 나?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아, 맞다!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "잠깐 기다려. 당장 가서 의사를 불러올게!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "무슨 큰일도 아니고…… 라바, 그럴 필요 없어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아휴…… 너도 참……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "10분 후"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_212_ansel",
      "text": "히비스, 의사 불렀어!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_212_ansel",
      "text": "안셀, 빨리 봐줘. 언니는 괜찮아?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "잠깐, 서두르지 마세요. 너무 잡아당기지 좀……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "나 참…… 갑자기 날 끌고 와 무슨 일인가 했더니, 언니 때문이었군요."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "난…… 괜찮……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "환자는 괜찮다는 말을 할 자격이 없는 법이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "음……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "숙소에 체온계 있죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "어, 있어!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "구급약 상자에……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "바로 가져올게!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "괜찮아요."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그냥…… 열이 나는 거예요……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "음."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "체온이 좀 높네요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "기운도 없고요?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "네……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "구급상자, 여기에 둔 걸로 기억하는데!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "요 며칠 음식이나 휴식은 문제없었죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "건……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "건강식."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "됐어요. 안 물어본 거로 하죠."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "히비스커스 씨랑 폴리닉 씨는 이쪽으론 전혀 걱정할 필요가 없는 사람들이니."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "요 며칠 너무 무리했나 보네요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "찾았다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "이따가…… 검사할 때…… 신세 좀 질게요……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그럼 라바가…… 안심할 수 있을 거예요……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "알았어요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "여기, 체온계!"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "구급상자를 통째로 가져와주세요. 그래야 히비스커스한테 기초검사를 다 할 수 있을 테니."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "히비스커스 씨의 구급상자에는 이런 설비가 다 있을 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "어!"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "충분한 데이터가 있으면 히비스커스 씨의 발열이 몸의 방어 시스템에서 나온 것인지, 아니면 다른 증세에서 나타난 건지 판단할 수 있겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "일단 체온 검사부터…… 자, 입 벌려봐요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "아……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "어, 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "별거 아니네요. 신체의 자율조정 과정이 좀 격렬할 뿐이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "피로가 주요 원인입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "한 이틀 푹 쉬면 빨리 회복할 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "음식은 싱겁게 드시고, 소금, 설탕은 조금만. 영양 밸런스를 맞춰서."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "언니에게 건강식을 주라는 얘기지?"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "식당에도 비슷한 음식이 있는데, 직접 만든 게 아닐 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "다른 건 히비스커스 씨가 잘 알 테니 더 말하진 않을게요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "의료부에는 제가 히비스커스 대신 병가를 내줄게요, 팽 씨한테도 말해주고요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "둘 다 외근이나 다른 임무는 없죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "난 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "없어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "그럼 문제없겠네요."
    },
    {
      "type": "dialogue",
      "speakerName": "안셀",
      "speakerId": "char_212_ansel",
      "text": "궁금한 점 없으면 먼저 갈게요. 히비스커스 씨의 간호는 라바 씨에게 맡기죠."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "앗……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "내가 이틀 동안 간호해야 해?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "간호 수업은 들은 적이 없는데."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "라바…… 훈련 가야 하면…… 갔다 와……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "언니는…… 의사는…… 그렇게 약하지 않아……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "혼자서도…… 있을 수 있어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "콜록, 콜록콜록……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "말하지 마! 목은 안 아파? 물 좀 줄까?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아니야……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그러니까, 음, 아니, 내가 언니를 돌보기 싫다고 말한 게 아니잖아!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그러니까, 내가 경험이 없어서……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "뭔가 잘못하면 언니가 불편하잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그런 거지."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "라바……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "알았어……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그럼 그렇게 하자. 일단 아침부터 먹자. 다 먹으면 내가 설거지할게."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "입맛이 없어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아니야……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "음……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그럼 세숫대야 좀 갖다줄 테니까 씻을래?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "(끄덕)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "잠깐만."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "(라바의 옷을 잡아당긴다)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아, 무슨 일이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "(고맙다는 입모양을 한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "고맙긴 뭘. 언니는 아프고, 난 휴가 중이니까 괜찮은 거야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "앗, 세숫대야를 어디에 뒀더라?\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "하…… 드디어 끝났네……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "간호하기 진짜 귀찮네. 하나도 안 쿨해."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "남 앞에서 이 일을 하라고 하면 난 거절했을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "다 먹었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "(끄덕)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "그럼 눈 뜨지 마."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "눈 감고 푹 쉬어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "난 세숫대야 좀 닦고 설거지를 할게. 그다음은…… 모르겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "일단 이렇게 하자. 무슨 일이 있으면 이 시계의 알람을 울려, 그러면 내가 소리를 듣고 올게."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "말 좀 들어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(히비스커스의 얼굴을 토닥여 준다)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "음…… 브러쉬, 세제."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(내가 방금 히비스 얼굴을 토닥인 건가?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "엄마 아빠는 늘 너희를 그리워한단다.\n편지 자주 보내렴.\n말 좀 들어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "흠……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(아빠, 엄마는 이렇게 우릴 좋아했었는데.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(지난주에 보낸 편지는 받았나 모르겠네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(음…… 히비스도 나한테 이렇게 해줬나?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_1011_purgatory",
      "text": "건강식으로 먹어야 해."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_1011_purgatory",
      "text": "말 좀 들어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(윽……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(언니가 저러는 건 다 나한테 뭔가를 시키려고 그러는 거야.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(아까 그 소고기 죽으로 배가 찼나 모르겠네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(과일이라도 깎아줄까?)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(아니면 고기를 구울까?)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(정말, 언니 침대 앞에 화로를 가져다 두고 고기 구워 먹고 싶다.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(그럼 옆에서 약이 올라 죽겠지.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(과일이나 깎자……)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "과일 좀 깎았어. 먹을래?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_1011_purgatory",
      "text": "쿠울… 쿠울……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "잘 자네."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "잠잘 때는 그렇게 꼴 보기 싫지 않네."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "(히비스커스의 얼굴을 꼬집는다)"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_1011_purgatory",
      "text": "쿠울……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "아직 너무 뜨거워."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "언니가 좀 나았으면 좋겠다. 그래야 나도 마음 편하게 장난칠 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "하암…… 정신없이 일했더니 나도 좀 피곤하네……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "언니 침대 옆에서 좀 자야지……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_1011_purgatory",
      "text": "쿠울 쿠울……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "띠띠띠띠——\n띠띠띠띠——\n띠띠띠띠——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "응?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "띠띠띠띠——\n툭"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "시끄러워서 깼어? 미안……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "이건 죽 알람이야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "난……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "지금 먹을까? 아니면 이따가?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "지금 먹자."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "내가……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "일어나지 마. 어제 지쳐 쓰러졌는데, 오늘 바로 날아다닐 리 없잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "누. 워. 있. 어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "으윽……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(히비스가 언제 이렇게 힘이 세졌지?)"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "하나만 물어볼게. 피스 씨가 너 데리고 특훈 하다 이렇게 된 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "피스 선생님의 문제가 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "원래 이번에는 고강도 훈련 일정이었어. 처음 시작할 때는 힘들었지만, 뭐든 처음이 어렵잖아. 나중에는 익숙해지니까 괜찮아."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그렇다고 훈련 끝나고 이렇게 녹초가 되면 안 되지……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "난 그럴만한 가치가 있다고 생각해. 이렇게 훈련하다 보면 내가 점점 강해지는 느낌이 들어. 오리지늄 아츠의 정확도도 그렇고 다른 분야도 그래."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "게다가……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "게다가?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "이번 특훈 전에 내가 깨달은 바가 있거든. 훈련 강도도 높고 과정도 힘들 테니까 마음의 준비를 해야 했어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "내가 교관님한테 “괜찮아. 우리 언니가 메딕 오퍼레이터야. 초주검이 돼도 숨만 붙어 있으면 언니가 살릴 수 있어.” 라고 말했어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "대충 이런 뜻이야. 이해해 주면 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "라바."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "이번에는 넘어가지만, 다음에 특훈 끝나고 또 이런 상태면, 그땐 진짜 정식으로 인사부에 이의 제기할 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "그럴 정도는 아니잖아……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "이 훈련으로 네가 얼마나 성장할지는 모르겠지만, 네 몸이 상하지는 않을까 걱정돼서 그래."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "적어도……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "미안해……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "히비스커스? 언니?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "다, 다 큰 어른이 왜 울고 그래……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "내가 너 찾았을 때 얼마나 걱정했는지 알아?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "괜찮잖아……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "약간 지치고 찰과상만 조금 있을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아니야. 이번에는……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "네가 어떻게 로도스 아일랜드에 왔는지 기억나?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "그건……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "길에서 상단의 상인들을 도와 강도를 처치할 때, 감염자라는 걸 들켰어……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "상인들에게도 버림받은 후엔…… 그때 누가 내 머리를 내려쳤고, 난 기절했지."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "깨어나 보니 로도스 아일랜드에 있더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "상처도 다 치료됐어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "외근하는 오퍼레이터가 날 데리고 왔다면서? 작은 상처여서 다행이야, 주위에 그렇게 폐를 끼치지도 않았고."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "중상이야……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "헤어진 후 평소처럼 어색하게 널 볼 수 있을 줄 알았어. 그런데……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "네가 수술대에 누워있었어. 라바, 몸이 불덩이였어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "난 아무 도움도 안 됐어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "내가 유일하게 할 수 있는 건, 수술이 끝난 후 널 간호하는 것뿐이었어. 지금처럼 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그때 넌 침대에서 내 이름을 계속 불렀어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "뭐? 잠깐, 난 처음 듣는 얘긴데……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "그, 그럼 왜 말 안 했어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "네가 또 삐딱하게 말 안 들을까 봐. 어렵게 널 찾았는데 만약 또 가버리면 어떡해?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그래서 네가 의식을 회복하고 입사하기 전까지 난 나설 수 없었어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아니야. 말도 안 되는 소리를……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "진짜야!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "우리가 빅토리아 떠날 때, 라바 네가 삐져서 헤어진 거 아니었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "그, 그건……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "어쨌든 그런 일이 다시 일어나면 안 돼. 알았지?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(작게) 알았어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그래. 착하지."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아, 맞다! 무슨 꿈 꿨어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "괜찮으면 편안하게 꿈 얘기 좀 해줘. 정신을 회복하는 데 도움이 될 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "응?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "응. 듣고 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "내가…… 내가 꿈에서 본 건……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "꿈에서 뭘 봤는데?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "꿈에서 히비스를 봤어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "내가 왜?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "히비스가……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "말해봐. 듣고 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "(라바의 얼굴을 토닥여 준다)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "……응?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "빨리 말해. 도대체 꿈에서 뭘 본 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(안 돼. 너무 부끄럽단 말이야! 말 못 해!)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아니야!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아무것도 아니야!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "빨리!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "안 돼!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아무 꿈도 안 꿨어!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "라바, 어떻게 깨어나자마자 또 싸우냐."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "우리 자주 싸우잖아. 왜 얼굴이 빨개지고 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "또 열이 나나?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아니야!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "얌전히 누워있어. 체온 좀 재보자."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "체온은 왜?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "체온계 가져오지 마. 열 안 나!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "환자는 괜찮다는 말을 할 자격이 없는 법이야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "언니는 얼굴 빨개지는 거랑 열나는 것도 구분 못 해?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "왜 언니를 보고 얼굴이 빨개지는데?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "언니가 꿈에서 말도 못 할 정도로 아팠어. 말하려니까 진짜 창피하단 말이야!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "대충…… 그런 꿈이었어……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "헤헤, 듣고 보니 너무 기쁜걸."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "히비스…… 언니가 평소에……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "난 그렇게 쉽게 쓰러지지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "응. 하지만 의외의 사고는 피할 수 없지. 그러니까 앞으로 진짜 라바의 간호가 필요해지는 날이 올지도 몰라."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "당연히 라바는 언니가 위급할 때 도와줄 거라 믿어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "평소에는 말도 안 듣고 고집불통에, 생각도 많고 행동도 빠르지만 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "빙빙 돌려서 나한테 잔소리하는 거 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "하……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "그만해."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "먹을 거 있어? 배가 좀 고프네."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "어, 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "잘 됐다. 웬일로 라바랑 마음이 통했지."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "잠깐 기다려. 내가 가져올게."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(그때 언니도 있었구나.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(익숙한 소리를 들었던 것 같아.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(요한 선생님이 아니었으면 히비스가 날 못 봤을 거야……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(선생님은 라이타니엔에서 잘 지내고 있는지 모르겠네. 선생님처럼 재능 있는 음악가는 이미 명성이 자자하겠지.)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(편지……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(엄마, 아빠는 언제쯤 답장을 할까……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(다들…… 힘들게 사는구나……)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(내가 더 강해질 수 있다면……)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "자, 방금 만든 죽이야. 뜨거울 때 먹어."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(킁킁)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아무 냄새도 안 나는 것 같은데, 소고기 죽 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "꿈에서 소고기 죽을 봤나 보네. 이건 최근에 개발한 건강죽이야. 맛있고 건강에도 좋다고!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "(건강?!)"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "잠깐, 설마 언니가 만든 그 건강 가루를 죽에 넣은 거야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "맞아. 이렇게 하면 영양 성분이 몸에 더 빨리 흡수되거든."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "하나만 물어볼게…… 직접 맛은 봤어?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "물론이지~"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "언니는 삼시 세끼를 다 먹는걸. 영양 밸런스가 특히 좋아. 그러니까 언니가 아니라 네가 아픈 거라고."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "먹어봐. 건강이 제일 중요해."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "싫어. 한 입도 못 먹겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "내가 어렵게 개량한 건데… 한 입만 먹어보자 한 입마안~"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "믿을 수 없어! 저번에도 괜찮아졌다면서 결과는 영……"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "야!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "으윽!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "어?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "냄새가 약간 괜찮은 것 같은데?"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그렇지~?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "음……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "?!?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "웩, 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "아니야, 아니야. 맛이 왜 이래?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "웩, 네가 말한 게 더 맛없게 만드는 거였어??"
    },
    {
      "type": "dialogue",
      "speakerName": "히비스커스",
      "speakerId": "char_120_hibisc",
      "text": "그래. 그래야 한입에 죽을 다 먹을 수 있지 않을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "히비스커스, 두고 보자!"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "우웩……"
    },
    {
      "type": "dialogue",
      "speakerName": "라바",
      "speakerId": "char_121_lava",
      "text": "기억해. 내가…… 우웩…… 언젠간 끝장을 볼 거야!"
    },
    {
      "type": "sceneBreak"
    }
  ],
