    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 가드 오퍼레이터?",
      "speakerId": "avg_npc_059",
      "isRemote": false,
      "text": "켈시 선생님…… 날 모욕하지 마십시오!"
