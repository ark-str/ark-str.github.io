    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "speakerId": "avg_npc_450_1",
      "isRemote": false,
      "text": "만약 저 녀석이 보고서에서 봤던 그 시테러라면…… 심해 교회는 우리가 생각한 것보다 훨씬 가까운 곳에 있다는 말인데."
    },
    {
      "type": "dialogue",
      "speakerName": "구경 중인 마을 사람",
      "speakerId": null,
      "isRemote": false,
      "text": "아마이아 씨! 빨리 이게 뭔지 봐봐요……"
