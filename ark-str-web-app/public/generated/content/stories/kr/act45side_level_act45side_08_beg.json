      "speakerName": "토가와 사키코",
      "speakerId": "avg_4182_oblvns_1",
      "isRemote": false,
      "text": "지금이야말로, 저는 곡을 쓰고 싶어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "토가와 사키코",
      "speakerId": "avg_4182_oblvns_1",
