      "speakerName": "토가와 사키코",
      "speakerId": "avg_4182_oblvns_1",
      "isRemote": false,
      "text": "이곳은 저희의 꿈. 그렇다면, 꿈의 주인은 바로 저희 자신입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "토가와 사키코",
      "speakerId": "avg_4182_oblvns_1",
