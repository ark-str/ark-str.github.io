{
  "server": "kr",
  "storyId": "act9d0_level_act9d0_st01",
  "groupId": "act9d0",
  "stageId": "act9d0_st01",
  "title": "살기 위해",
  "storyCode": "DM-ST-1",
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act9d0/level_act9d0_st01.txt",
  "sourceHash": "ea86c58ed7e6a0b22628ca11b57e54d1d1f8820bc80bfde8532b8c1f6c40513b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "계속 여기 있을 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "치료 안 받으면 정말 감염될 텐데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "내가 왜 마족 따위를 믿어야 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "마족, 마족이라……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "주변에 죄다 살카즈 밖에 없어서 완전히 잊고 있었네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "윽, 뒤에서 쫓아오지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이 정도면 꽤 멀지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "능청 떨지 말고, 죽이려면 당장 죽여!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루, 루블레프, 자극하지 마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……됐어. 갈 길이나 가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "신경 쓰지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "미, 미안해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "차라리 감염되는 한이 있어도, 절대 마족 도움은 안 받을 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "응……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "흐음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이 주변에 버려진 병원이 하나 있어. 체르노보그 병원이라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어디인지 알고 싶어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "듣지 마. 분명히 속이려는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "따돌려야겠다…… 더 빨리 가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "저쪽 골목 보이지? 저쪽으로 뛰어들어가. 빨리!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……뛰어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "꽤 빠르네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "어, 어떻게 이렇게 빨리 따라온 거야…… 윽!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프…… 너 다리가! 피, 피가 검은색으로……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "쳇, 방금 널 구했잖아. 따돌릴 수가 없다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "미안해, 미안해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "됐어! 조용히 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "들키면 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "앞에 있는 거리에서 왼쪽으로 틀면, 파괴된 광장이 보일 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "광장의 서쪽에 있는 제일 큰 하얀 건물이 병원이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "버려진 병원.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……우리, 아무래도 들킨 것 같아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "네가 내 말을 안 들어서 그래…… 됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "야, 마족!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……대체 왜 우리한테 그걸 알려주는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "흥미가 생겨서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너희 둘, 무슨 사이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……먹을 걸 찾으러 나왔다 만난 것뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프가 저를 구해줘서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아…… 그래서 쟤가 하라는 대로 하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "뭐, 맘대로 해. 이제는 네가 네 생명의 은인을 도울 차례니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "뭘 시키려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "별거 아냐. 멀지 않은 곳에 병원이 있다고 했잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "물론 리유니온도 바보는 아니라서, 그 의료 물자들을 그냥 내버려 둘 리가 없거든…… 그러니까, 루블레프라는 친구를 구하고 싶으면…… 가서 좀 훔쳐 와.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "저기에는 감염자 폭도들로 가득해. 너희 가족, 친척, 친구를 죽인 폭도들 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그리고 광석병 초기 증상을 억제할 수 있는 약도 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "가서 훔치던가 뺏든가 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하지만 네 옆에 있는 사람에게 항상 도움을 받을 수 있을 거라는 생각은 하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "가지 마! 저 말 들으면 안 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "하, 하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "안 가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "쟤는 네 이름을 알지. 루블레프, 그런데 너는 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "그게 무슨 상관이야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "가지 마! 네가 할 수 있는 일이 아니야! 거긴 전부……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "그…… 그래도 해보고 싶어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프 형뿐만 아니라, 많은 사람들이 재앙 때문에 다쳤어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "다들 아픈데…… 나는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "내 말은 왜 안 듣는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "나는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "네 말을 들을 의무는 없으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "사람들을 구하고 싶은 마음은 아주 훌륭해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 말한 병원 기억해둬. 의료 물자는 지하 창고에 모여 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "주차장 통풍구를 통해서 들어갈 수도 있고, 배수구를 통해서 들어갈 수도 있겠지. 화학 폐기물이 많지만 않다면 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어쩌면 거기서 죽을 수도 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "봐, 너 다리 떨고 있잖아. 갈 생각 하지 마! 절대 저 마족 녀석 말을 들으면 안 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "도망가라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "나는……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "으아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "무, 무슨 일이지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "용문에서 뭔가 일어난 모양이네…… 여기에도 틈이 생겼어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "체르노보그에선 보기 힘든 병원인데, 당연히 공격할 생각을 하지 않겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너희는…… 마족인 내가 왜 이 병원에 대해서 잘 알고 있다고 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "너는…… 으……윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "저, 저는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "고통스러운 것 같네. 계속 이렇게 뒀다간 구할 수 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "지금 결정을 내리지 않는다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너희는 여기서 죽겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "너, 윽, 뭘 하려는 거야! 오지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "갈래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아니면 말래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아…… 지금 가봤자 늦었을지도 모르겠다. 벌써 폭동이 일어났으니까, 어쩌지? 훔치는 게 더 어려워지겠는걸?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "가, 갈게요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……응, 안 죽게 잘해봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "대체 왜 저 말을 듣는 거야? 널 구한 건 나잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "그, 그래도 해보고 싶어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "네가 할 수 있을 리 없잖아! 지금처럼 약국이랑 먹을 걸 찾아보자. 그게 나아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "미… 미안해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "아…… 기다려!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이름도 몰라서 멈추게 할 수도 없네. 불쌍해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "너…… 쟤를 속였구나! 이 악마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "속여?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "거짓말은 하지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "물론, 나를 믿느냐는 너에게 달렸지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "쟤를 믿느냐도 너에게 달렸지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……내가, 내가 찾으러 가야, 윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "내, 내가 없으면 아무것도 못 하니까……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 아이가 도망갈까 봐 걱정하고 있구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "지금 너는…… 왜 나를 이 마족과 단둘이 남겨놨을까 하고 생각하고 있겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "아냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "이 *우르수스 욕* 괴물 녀석……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "닥쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……여기서 기다리고 있어. 한 발짝도 움직이지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아니면 여기서 널 죽여버릴 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 누구라고 생각하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "나는 살인자야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이 도시를 파괴하고, 네 부모와 친구들을 해친 살인자지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……아, 하하, 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "너한테 칼이 있다는 걸 잊고 있었네? 그 칼에 달린 건 살카즈의 악세사리야. 그리고 피도 묻어있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그럼 거기 묻은 피는, 누구 피일까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "흑…… 으흑, 몰, 몰라…… 네가 걔를……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "울어. 어린 애는 울어도 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하지만 너희의 목숨은…… 어떻게 하느냐에 달렸지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "걔는 못 할 거라고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "내가 걜 폐허에서 꺼내주지 않았다면, 걔는 벌써……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……걘 내가 없으면 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이 세상에는…… 타인 없이 살 수 있는 사람은 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "절대로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "또 조용해졌네, 이 버려진 도시……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 학살 이후로 저항하는 사람들이 줄어들었어. 괜찮네. 이러면 힘을 쓰지 않아도 되고, 죽는 사람도 줄겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그런데 병원 쪽도 조용해진 모양인걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "그…… 그 애는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "어쩌면…… 가지 않았을지도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "이미…… 윽, 시간이 이렇게 지났는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "도망갔네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하지만 네가 그 녀석을 구했으니, 걔도 널 위해서 노력하고 있지 않을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……나는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아니면, 너는 걔를 구할 수 있는데, 걔는 할 수 없다는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "걘…… 걔는 아무것도 할 줄 아는 게 없어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "음식을 찾을 때도 그랬어! 가게에 다른 사람이 있는 것도 알아차리지 못했다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "전부 걔 때문이야! 걔 때문에 내 다리가……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어디 가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "혼자서…… 돌아갈래……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 말했지. 여기서 벗어나면 널 죽이겠다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "하지만 걘 이미 도망쳤다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "원망하는 눈빛이구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "아, 아냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "걔가…… 걔가 갔더라도…… 시간이 이렇게 지났으니까…… 분명히……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……닥쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "돌아오기 전까지는 아무것도 모르는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그 아이가 돌아올 건지 아닌지, 그런 생각을 하는 건 네 자유야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하지만 걔가 못 한다거나, 의심하거나, 미워한다면 그건 네 문제지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "왜 걔가 실패했거나, 도망갔을 거라고 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "네가 걔를 구해줬기 때문에? 네가 걔보다 강하니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "흐흑……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "흐으윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아직 눈물은 나오는구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "걱정 마. 곧 아파서 울지도 못하게 될 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아직 나이도 어리고 살카즈도 아니니, 버틸 수 없다면 나한테 말해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "내가 해방시켜 줄게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "으윽…… 흑…… 흐흑……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "의식이 흐려지는 모양이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "됐어…… 아무래도 정말 끝인 모양이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "안돼…… 나는 아직……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "걜…… 걜 기다려야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "다시 믿는 거야? 죽는 건 무서운 모양이구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "어린 애들은 눈치가 참 빠르다니까? 그런 거로 나한테 점수를 따려고 하다니, 재미없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……흐윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "하지만 시간이 부족한 건 사실이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "마지막 10분이 되겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "걱정 마. 그때가 되면, 나도 어린 애를 고통 속에서 죽게 내버려 두지는 않을 테니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……이제는 울 기운도 없구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "무슨 생각 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "날 원망하고 있어? 아니면 걔를 원망하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "아니면, 괜히 사람을 구해서 자기 자신이 다쳤다고, 후회라도 하고 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……아냐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "말할 기운은 남았네. 다시 봤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "잘 들어, 루블레프.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "사람의 행동을 결정하는 건 뭐라고 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "출신? 신분? 아니면 과거? 누군가를 꽁꽁 묶었던 족쇄?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "전부 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "바로 살면서 받아왔던 영향이야. 시시각각 변하는 자신의 신념과 생각이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그리고, 자신의 그 신념을 얼마나 믿고 있는지도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "넌 걔를 구했어. 하지만 너는 내심 걔를 믿지 않고, 무시했지. 왜냐면 넌 네가 그 아이의 구세주라고 생각했거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "걔도 참 단순해. 네가 자신을 구했으니, 자기도 너를 구해야 한다고 생각하다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "이런 걸 보면, 그 아인 너보다 강한 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "검은 잘 가지고 있어. 살카즈의 검이니까. 그 검의 주인을 대신해서 내가 주는 선물이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그걸 사용하는 법을 익히거나, 팔아서 돈을 챙기거나, 네 맘대로 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그럼, 이만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "무…… 무슨 소리야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루, 루블레프! 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "이거 봐! 이거 봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "구급상자를 통째로 가져왔어! 약도 있고 붕대도 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "시끄……러, 아직 안 죽었어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "다, 다행이다. 상처를 치료해 줄게……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "이 붕대, 어떻게 쓰는 거지…… 이건 억제제인가? 이, 일단 열어야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "너희 부모님… 의사라고 하지 않았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "응…… 가르쳐준 적은 없지만, 아얏……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……너 다쳤어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "괜찮아. 별거 아냐…… 그냥 누가 쇠몽둥이로 때려서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "멍청이……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "……헤헷……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "그…… 살카즈는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "아…… 내가 왔을 때는 없었어…… 계속 같이 있었던 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "루블레프 형?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……윽, 저기, 네 이름은 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "응? 아…… 안드레이.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "풀네임은……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "안드레이 표도르비치 오스트롭스키…… 헤헤.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "웃긴 뭘 웃어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "형이 드디어 물어봤잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "……미안.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "그, 그런 게 아니야…… 사과하지 않아도 돼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "됐다. 이제 좀 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "강한 아이",
      "text": "응……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "좋아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "부축해줄게. 일단 돌아가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "약한 아이",
      "text": "어른들이 구급상자를 보면 좋아할 거야!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "두 아이의 웃는 모습을 보았다.\n불안이 사라지고 나면, 저 아이들은 이 도시에서…… 이 땅에서 살아갈 수 있을 것이다.\n살아라. 살아야 고통도 느낄 수 있으니까.\n불길에 뛰어드는 불나방처럼, 구덩이를 파는 벌레처럼.\n그렇다면 대가를 치르더라도, 항상 무언가를 찾을 수 있을 거야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "그렇지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……탈룰라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
