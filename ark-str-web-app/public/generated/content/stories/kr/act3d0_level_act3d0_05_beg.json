  "title": "돈 스탑 미 나우",
  "storyCode": "OF-5",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/activities/act3d0/level_act3d0_05_beg.txt",
