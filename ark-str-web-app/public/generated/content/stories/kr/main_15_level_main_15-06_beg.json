          "blocks": []
        }
      ]
    },
    {
      "type": "background",
      "backgroundId": "60_g2_rhodeslivingroom_bc"
    },
    {
      "type": "dialogue",
      "speakerName": "마음속에서 울리는 목소리",
      "speakerId": null,
      "isRemote": false,
      "text": "(미지의 언어) 여행자, 나는 그저 또 한 번의 파멸을 지켜볼 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "마음속에서 울리는 목소리",
      "speakerId": null,
      "isRemote": false,
      "text": "(미지의 언어) 힐다, 그게 네 이름이지?"
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "절 부르셨나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "당신의 언어를 이해할 수 없어요. 그리고 어떻게 제 이름을……"
    },
    {
      "type": "narration",
      "text": "카우투스는 함선의 창문을 통해 우주 속 그 모습이 함선에 천천히 가까워지다가 갑자기 사라지는 것을 보았다."
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "굴광자, 저 사람은 누구죠?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "굴광자",
      "speakerId": "avg_npc_1725_1",
      "isRemote": false,
      "text": "(격렬한 노랫소리) ♪~~♪~~♪~~"
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "……왜 그러세요?!"
    },
    {
      "type": "dialogue",
      "speakerName": "굴광자",
      "speakerId": "avg_npc_1725_1",
      "isRemote": false,
      "text": "저 여자를 좋아하는 사람은 거의 없다!"
    },
    {
      "type": "dialogue",
      "speakerName": "굴광자",
      "speakerId": "avg_npc_1725_1",
      "isRemote": false,
      "text": "미안하다, 여행자. 저 여자와 같은 공간에 있다는 걸 도저히 참을 수 없다."
    },
    {
      "type": "dialogue",
      "speakerName": "굴광자",
      "speakerId": "avg_npc_1725_1",
      "isRemote": false,
      "text": "다른 친구들이 보면, 분명 나를 경멸할 거다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "혼란스러운 카우투스가 정신을 차렸을 때, 선실 안에는 아무도 없었다. 환영받지 못하는 사람이 올 거라고 예상이라도 한 듯, 모두가 이미 떠나버렸다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "그리고, 카우투스는 목격했다."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "놀랄 필요는 없어. 난 원격 공명을 통해 소통하는 기술을 배운 적이 있거든."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "적어도 그 기묘한 종족을 파멸시키기 전에, 그들의 진화된 독특한 언어 양식은 내가 남겨두었거든."
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "……파, 파멸이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "새로운 손님, 그쪽도 파멸이라는 행위를 혐오해?"
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "저는…… 무슨 일이 일어났는지 몰라요."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "복잡하진 않아. 우리 종족은 행성을 집어삼키는 방식으로 생존해 왔어. 다른 이들이 혐오하는 건, 결국 우리가 생존을 위해 지녀온 본능이야."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "하지만 이제 우리의 과거는 사람들의 입에 오르내리는 무서운 괴담이 되었을 뿐이지."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "우리 종족은 거의 멸종했거든. 어쩌면 내가 마지막 한 명일지도 몰라."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "후훗, 우린 파멸을 업으로 살아왔지만, 진정한 파멸이 닥쳤을 때, 우리는 정작 아무것도 할 수 없었어……"
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "그 후 나는 겨우 살아남았고, 몇몇 천재의 도움 덕분에 생존에 필요한 에너지를 섭취하는 방법을 바꿨어……"
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "새로운 삶에 녹아들기 위해 노력하는 것처럼…… 들리네요."
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "그래서 아까 우주에 죽은 행성을 바라봤던 건, 이전의 파멸을 생각하고 계셨던 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "추억?"
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "하하, 그런 게 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "신비로운 존재",
      "speakerId": "avg_npc_1720_1",
      "isRemote": false,
      "text": "여기 있는 모든 사람들은 파멸이 다가오는 걸 담담하게, 그리고 긍정적으로 받아들이고 있을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "힐다",
      "speakerId": "avg_npc_1719_1",
      "isRemote": false,
      "text": "……?!"
