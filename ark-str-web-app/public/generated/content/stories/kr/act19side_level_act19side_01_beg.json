    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "speakerId": "avg_npc_530_1",
      "isRemote": false,
      "text": "퍼디낸드 씨, 지금 총괄님이 어디 계시는지 아세요?"
