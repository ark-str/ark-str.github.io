    {
      "type": "dialogue",
      "speakerName": "개척대 대원",
      "speakerId": "avg_npc_534_1",
      "isRemote": false,
      "text": "혹시…… 대기업은 부하 직원의 목숨에 전혀 신경 안 쓰는 거 아닐까?"
