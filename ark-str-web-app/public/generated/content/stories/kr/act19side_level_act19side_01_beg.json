    {
      "type": "dialogue",
      "speakerName": "라인 랩 연구원",
      "speakerId": "avg_npc_530_1",
      "isRemote": false,
      "text": "주임님, 드디어 오셨군요! 지금 시간 괜찮으실까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "avg_npc_522_1",
      "isRemote": false,
      "text": "너는…… 벤, 구조과의 벤이었지."
