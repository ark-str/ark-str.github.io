      "type": "dialogue",
      "speakerName": "사일런스",
      "speakerId": "avg_108_silent_1",
      "isRemote": false,
      "text": "난 의사야."
    },
    {
      "type": "dialogue",
      "speakerName": "메리",
      "speakerId": "avg_npc_527_1",
      "isRemote": false,
      "text": "그럼 저 사람은?"
