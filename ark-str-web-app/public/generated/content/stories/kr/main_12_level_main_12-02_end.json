        {
          "type": "dialogue",
          "speakerName": "아스카론",
          "speakerId": null,
          "text": "잔뜩 쌓인 폭발물 옆에서 대화하는 게 익숙하지 않아서 말이지."
        },
        {
          "type": "dialogue",
          "speakerName": "'회색 모자'",
          "speakerId": null,
          "text": "그저 만일에 대비한 거야."
