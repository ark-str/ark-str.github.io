{
  "server": "kr",
  "storyId": "act34side_level_act34side_05_end",
  "groupId": "act34side",
  "stageId": "act34side_05",
  "title": "불치의 운명",
  "storyCode": "BP-5",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act34side/level_act34side_05_end.txt",
  "sourceHash": "629743935374650bb1feaa6fec8b92599086d674e8e42479ab76ab8ad1e063e6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "해양 순찰대군. 날 심문하러 왔나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "심문이라…… 하, 이 단어가 나한테 쓰일 줄은 꿈에도 몰랐군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "연구소로 침입할 때 염두에 뒀어야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "그럼 그전에는? 너와 나 사이에 도대체 무슨 차이가 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "이곳에서 왜 넌 '심문하고' 난 '심문을 받는' 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "가끔은 우리 방식이 너무 부드럽다는 생각이 들어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "이베리아 사절에 따르면, 그들은 심문 단계에서부터 형벌을 적용한다고 하더군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "헛소리 다 했으면, 이제 네 신분을 밝혀라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "난 트랙용 산호 배양 담당자였다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "범행 동기는 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "길가의 트랙용 산호를 자세히 관찰한 적 있나, 해양 순찰대?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "우린 모든 거리의 트랙용 산호가 각기 다른 형태와 색깔을 띠고, 심지어 다른 기능을 갖길 바랐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "투지장 동쪽의 그 산호 말이야. 물류 케이블이 빈 몸통을 관통하고 케이블의 미세한 빛 아래 산호충들이 반짝반짝 빛을 반사해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "마치 작디작은 성운 같았지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "허브항 외곽에도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "조금 전에 난 여러 그루의 트랙용 산호를 자세히 관찰했다. 너희들의 예전 시험 농지에서 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "무고한 데이터 분석가가 거기서 죽었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "그녀의 이상, 집착 그리고 그녀가 아꼈던 조류들은…… 네가 묘사한 트랙용 산호만큼이나 아름다웠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "하지만 너희가 그녀를 죽였다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "질문 제대로 했군. 그럼 너와 그녀는 도대체 무슨 차이가 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "왜 넌 살아있고, 그녀는 왜 죽어야만 했지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "눈치챘기 때문이지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "뭘 눈치챘지? 왜 말을 멈추는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "아니면 내가 이 질문을 카시아에게 해야 하나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "너……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "심해 교회가 항로 계획에 무슨 짓을 했지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "너희가 집중 공격한 대상은 비콘이냐, 아니면 무기냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "말해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "아, 심해 교회, 심해 신도라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "아직도 이런 호칭에 익숙하지 않아. 너무 낯설어. 해양 순찰대가 사람을 손쉽게 잡아들이려고 지은 이름 아닌가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "소위 말하는 교회와 신자, 그 신성함은 도대체 어디에 있는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "난 허황된 어떤 존재를 숭배하지도 않아. 그저 카시아의 주장에 동의할 뿐이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "에기르에 만연해진 절망 속에서 카시아는 이 나라의 취약성을 꿰뚫었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "사람은 사물의 가치를 매우 중요하게 여기면서도 그 가치가 얼마나 취약하고 변하기 쉬운지 인정하지 않지. 그들은 기존의 가치에 충실한 신자가 되어버렸어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "하지만 지금 그 가치가 무너지고 있어. 에기르가 완전한 절망으로 빠지기 전에 누군가는 경종을 울려야 해……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "*에기르 감탄사*! 날 떠본 거군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "부상당한 '연구원'",
      "text": "더는 한마디도 하지 않겠어. 못 참겠다면 그냥 내 뇌파를 분석해. 힘든 일도 아니잖아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "질문을 하는 건 인간으로서 네게 주는 마지막 존중이다, 쓰레기 자식!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "넌 스스로 무고하다고 주장할 수 있고 네 행동이 음모가 아니라고 생각할 수도 있겠지. 하지만 넌 하나도 남김없이 정보를 토해내게 될 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세쿤다",
      "text": "자, 말해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "제2대 대장.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "스카디, 이제 우리 출발해야 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "긴급 상황이란 거 알아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "전선의 전력이 간신히 시본과 팽팽한 균형을 유지하고 있어요. 전멸된 두 함대의 악영향이 이제야 온전히 드러났죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "방금 들어온 소식으로는 제8군단, 제10군단이 여러 번 대형을 바꿔봤지만 모두 실패로 끝났고 고전 중이라는군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "만약 비콘을 소굴 내 지정 위치에 설치하지 못하고 교착 상태가 계속된다면…… 항로 계획은 실패하는 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이해했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "군단의 함대는 곧 피해를 무릅쓰고 시본에 대한 전면 공격을 감행하며 주의를 끌 거예요. 우리는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "우리는 전장의 빈틈을 노려 소굴 깊숙이 침투해 비콘을 투척하는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "맞아요. 스카디, 상태는 어때요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "적어도 방금은 아주 잘 잤어. 그 전투 이후로 처음으로 꿈꾸지 않고 잤지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "지금 도시 내 정세가 점점 더 요동치고 있어요…… 박사님이 어디로 갔는지 아나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(고개를 젓는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "제2대 대장, 박사 얘기를 꺼낸 이유는 알아. 질서를 유지하고 박사를 보호하게 하려고 날 보내려는 거잖아…… 결국 내가 계속 도시에 남아있길 바라는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "솔직히 말해서, 고민 중이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "바다의 쓰레기들을 소탕하는 건 어비설 헌터스의 책임이지만, 난 여러분의 안전에도 책임이 있죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "스카디, 바다로 돌아간 후 이샤믈라가 깨어날 조짐이 보였나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "만약 그게 있다면, 무척 조용하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "만약 그게 말을 한다면, 내가 그 입을 다물게 할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "제2대 대장, 사실은 할 말이 있어서 왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "예전에 우린 이렇게 조심스럽게 일하지 않았었어. 우린 이런 상황에 대처하는 방법이 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "심해 신도들의 신이자 그 쓰레기들이 말하는 '이샤믈라'가 정말 내 몸 안에 있다면, 내가 통제 불능상태가 되었을 때 그 자리에서 날 소멸시키면 돼. 아주 간단하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내 심장은 여기 있어. 당신이라면 실수하지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "스카디……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "아직 안 끝났어, 제2대 대장.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "당신이나 상어가 나보다 먼저 그 쓰레기들의 영향을 받는다면 나도 가만히 있지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "스카디, 큰 전투를 앞두고 이 말보다 더 위안이 되는 건 없다는 말을 하려던 참이었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "가시죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "로렌티나 씨.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "아기 새, 그 어색한 호칭은 빼요. 우리 사이가 이렇게 서먹했었나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "……로렌티나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "에기르의 도시에 온 지 이렇게 오래됐는데 우리가 이제 만나다니. 정말 슬프네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "난 늘 우리의 용감한 전사에게 심해 속에서의 진정한 활약을 보여주고 싶었어요. 하필 이번에 우리가 가야 할 소굴이 너무 멀고 깊어서 당신을 데려갈 수 없게 됐네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "아니, 그렇지 않더라도 난 지금 밀리아리움에 남아있어야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "어머?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "여기 있는 동안, 도시에서 몇 가지 일들이 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "처음으로 심해 잠수 장비를 착용하고 바다로 들어가자마자 해류에 휩쓸리며 이리저리 표류했지…… 인정해, 난 도움이 되기는커녕 짐만 될 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "그렇게 비하할 필요는 없어요. 처음은 늘 어려운 법이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "어쨌든, 소굴보다는 도시에서 내가 할 수 있는 일이 더 많아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "너희가 임무를 완수하고 에기르의 무기 시스템이 이 해역을 정화하기 시작하면, 난 빨리 카르멘 님 곁으로 돌아가 해상의 변화에 대응해야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "아, 그러니까 우리는 또 한동안 떨어져 있어야 한다는 거군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "원래 너희에게 작별 선물을 주려고 했는데, 밀리아리움에 오기 전엔 이런 상황이 생길 거라곤 생각 못해서 아무것도 준비하지 못했어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "걱정 마세요. 우린 다시 만날 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "이번엔 반쯤 죽어가는 당신을 바다에서 구할 필요는 없었지만, 이번 전투가 끝난 후에 다시 만난다면, 또 다른 잊지 못할 방식의 재회가 될 것 같네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "크흠! ……스카디 일행이 왔네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이린",
      "text": "로렌티나, 조심해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스펙터",
      "text": "이야기 끝났어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "물론이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "출발하죠, 헌터들.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울피아누스",
      "text": "박사.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "원하던 증거를 확보한 것 같네.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "그래, 네 도움이 컸다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그럼, 결과는?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "찾은 걸 공유할 생각은 없어?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "내가 전에 말한 것처럼, 도시 내의 비콘과 시본 소굴에 투하된 비콘 사이에 비정상적인 정보 교환이 있었다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "지금 보니 대부분의 작업이 C-22 연구소, 즉 우리가 방금 잠입한 곳에서 이뤄졌더군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "난 비콘 시스템과 제4급 무기의 원리를 완벽히 이해하진 못하지만, 이 정보 교환 내용만으로도 어렴풋이 추측할 수 있지……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "비콘과 무기의 연동 관계가 변경됐다는 걸 말이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "내 생각대로, 항로 계획이 고위층에서 누설된 거다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "“내 생각대로”인가……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "너는 처음부터 항로 계획에 이런 의혹을 품고 있었어?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "그래.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "항로 계획이 탄생하기 전부터, 난 이미 에기르를 의심하고 있었지.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그 의심은 어디서 비롯된 거지?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "……그 결정적인 전투에서.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "원래는 네가 '퍼스트본'에게 치명타를 날렸어야 했지.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "하지만 결정적인 순간에 팀과 연락이 끊겨버렸어.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "게다가 '퍼스트본'을 죽이는 중책은 스카디에게 남겼지.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "……넌 이미 알고 있었군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "스카디는 내 예상보다 더 널 신뢰하는 것 같군.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "스카디의 설명으로 당시 상황을 쉽게 추측할 수 있었어.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "사실 스카디도 무슨 일이 있었는지 정확히는 몰라.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "내 실수는 한순간의 방심 때문이었다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "이샤믈라의 핵심 기관에 가장 근접해 있는 동굴 혹은 그 비어있는 공간에서, 존재해서는 안 되는 뭔가를 발견했지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "거친 살점 층, 탁한 점액…… 난 처음에 그저 신체의 어떤 결절인 줄 알았다. 주변의 눈금과 무늬를 보기 전까지는……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "그건 녹슨 수맥 탐지기였다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "……에기르의 것이지. 수백 년 전 모델로, 지금은 박물관에서나 볼 수 있다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "수백 년 전?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "그 수맥 탐지기의 변형 상태로 봤을 때, 적어도 200년은 이샤믈라의 몸 안에 있었을 거다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "하지만 당시 내가 들은 설명으로는, 우리 이전에 에기르에서 '퍼스트본'의 본체와 접촉한 사람은 없었다고 했지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "즉, 시본이라는 생물이 에기르의 시야에 들어오기 전에 이미 에기르인이 '퍼스트본'과 접촉했고, 에기르는 이를 전혀 몰랐다는 거다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "에기르의 잔잔한 수면 아래의 암류는 모두가 상상하는 것보다 훨씬 더 거세다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "네가 증거를 확보하는 동안, 나도 이상한 점을 발견했어.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "헌터들이 깨어나자마자 바로 떠났어, 아주 급하게.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "전선의 교착 국면을 해결하게 위해 헌터들을 동원했겠지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "어떤 임무를 받았는지 충분히 상상할 수 있다. 전선을 우회해 소굴로 직접 침투해 비콘을 투하하는 거지.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "작전 보조에서 전술의 핵심이 되길 강요하다니, 변화가 너무 빨라.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "게다가 그 고문은 헌터들보다 훨씬 더 초조해 보였어.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "헌터들이 깨어나자마자 제일 먼저 연구소를 떠났지.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "블란두스.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "그렇다면 우리도 서둘러야겠군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "만약 비콘과 무기의 연동 관계가 누군가에 의해 조작됐다면, 내가 가야 할 곳은 하나뿐이다. 항로 계획의 핵심 장소, 비콘 발사대지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "울피아누스",
          "text": "그리고 넌……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "난 헌터들에게 명령을 내린 사람을 만나러 갈게.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "클레멘티아…… 집정관.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
