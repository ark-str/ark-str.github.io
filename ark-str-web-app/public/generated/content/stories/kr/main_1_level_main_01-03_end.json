      "text": "第八关（后）"
    },
    {
      "type": "background",
      "backgroundId": "bg_cher_1"
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "speakerId": "char_148_nearl",
      "isRemote": false,
      "text": "돌격!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "아니?!"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "…누, 누구냐?!"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "speakerId": "char_130_doberm",
      "isRemote": false,
      "text": "어디를 보고 있나! 받아라!"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "으악!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "speakerId": "char_013_riop",
      "isRemote": false,
      "text": "후우…"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "speakerId": "char_013_riop",
      "isRemote": false,
      "text": "후방에서 리유니온 녀석들이… 공격을 가하기 위해 집결하고 있습니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "speakerId": "char_148_nearl",
      "isRemote": false,
      "text": "우리를 쫓아오지는 못할 거다! 멈추지 마라!"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "speakerId": "char_130_doberm",
      "isRemote": false,
      "text": "조금만 더 가면 리유니온이 점령한 구역에서 벗어날 수 있다! 계속해서 전진하라!"
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "speakerId": "char_148_nearl",
      "isRemote": false,
      "text": "이런 폭도들로……"
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "speakerId": "char_148_nearl",
      "isRemote": false,
      "text": "우리의 앞길을 막을 수 있을 것 같으냐!"
    },
    {
      "type": "sceneBreak"
    }
  ],
