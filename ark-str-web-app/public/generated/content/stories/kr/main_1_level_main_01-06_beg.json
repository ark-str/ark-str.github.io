  "stageId": "main_01-06",
  "title": "재앙",
  "storyCode": "1-6",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_01-06_beg.txt",
