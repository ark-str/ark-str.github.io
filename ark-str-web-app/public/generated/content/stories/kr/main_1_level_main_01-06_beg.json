  "storyId": "main_1_level_main_01-06_beg",
  "groupId": "main_1",
  "stageId": "main_01-06",
  "title": "재앙",
  "storyCode": "1-6",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_01-06_beg.txt",
  "sourceHash": "535cb491675e0b9b6986b19a44708d4799e44048aca93f6303fcfa2c68ddb4d5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第九关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "역시, 녀석들은 파우스트가 추적하고 있는지 모르나 보네. 파우스트가 보낸 전령이 이것저것 알려주더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "로도스 아일랜드는 이제 중심 구역 외곽 쪽에 갇힌 상황이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "벌레 같은 놈들, 재앙의 혼란을 틈타 도망치려는 계획이었겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "녀석들이 체르노보그의 상황을 알게 된 이상, 우리 계획에 방해가 될지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메피스토",
      "text": "이쯤에서 끝내버리는 것도 나쁘지 않겠지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "체르노보그의 쓰레기들! 너희들이, 너희들이! 우리 감염자들을 이렇게 만들었다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "비켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "이 녀석들, 무서운 줄 모르고 계속 달려드는데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "리유니온은 대체 왜 이렇게 흥분해 있는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "왜 이 타이밍에, 하필 이곳에 리유니온이 이렇게나 많이 있는 거냐?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "앞뒤가 맞지 않아! 리유니온한텐 이곳을 지킬 이유가 없어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "오퍼레이터들에게 알린다! 각자 위치에서 물러나지 마라! 리유니온을 격퇴하고 퇴로를 확보해라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "저게 그 유명한 '로도스 아일랜드'인가? 훗… 용감한 녀석들이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "…앗?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "…낙석? 갑자기 뭐지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "멈추지 마! 방어선을 확보하라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "아니…… 건물에서 나온 파편이겠지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "무슨 소릴 하는 거냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "왔다! 드디어 왔다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "하하… 우리 감염자들의 구세주가 오셨다! 비감염자 놈들, 이젠 끝이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아, 아아… 큭!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아, 아아…큭!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "저 녀석들이 왜 쓰러진 거지…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "누군가의… 공격을 받은 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아니면 설마…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "도베르만 씨! 하늘이…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "하늘이 핏빛으로 물들고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "\"솟구치는 구름이 화염 속에서 소용돌이치면…\"",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "허둥대지 마라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "자기방어를 최우선으로 해라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "…아직, 살아남을 방법은 있을 거야!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "\"…공포가 그들의 목소리를 앗아가고, 대지는 정적에 휩싸이니.\"",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "\"거대한 오리지늄이 하늘에서…\"",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "\"…쏟아져 내리리라. 죽음이 각인된 그림자 위로.\"",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "탈룰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "어떻게 하는 게 좋을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "…놈들은 재앙 속에서도 살아남을지 모른다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "살아남은 녀석들은 네가 처리해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크라운슬레이어",
      "text": "알겠다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "리유니온 녀석들, 재앙을 이용해서 복수하려는 건 알겠지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "설마 체르노보그를 재앙으로 철저히 파괴해버릴 줄이야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "복수라기보단, 선전포고라고 표현하는 게 맞겠군…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "감염자의 시대가 왔다… 는 뜻인가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "아… 아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "하늘이… 무너지고 있어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "위험해!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "저건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "정신 차리세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "…앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이분을 안전지대로 데려가 주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "알겠습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "각자 위치에서 안전지대를 찾아라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "각 팀! 재앙에… 대비해주세요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
