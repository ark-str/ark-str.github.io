{
  "server": "kr",
  "storyId": "main_3_level_main_03-05_beg",
  "groupId": "main_3",
  "stageId": "main_03-05",
  "title": "통화",
  "storyCode": "3-5",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_03-05_beg.txt",
  "sourceHash": "ca74359eb20390159574768cd80ba84db6cf374ad470e4f18721f5bd277ff1e1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "{@nickname} 박사님…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "전… 저는…… 아니에요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "안개가 걷혔다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "근위국에서 통신이 들어왔다. 저쪽에서 더 많은 리유니온의 흔적이 확인되었다고 하는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "지금은 적 한 명을 쫓고 있다고 한다. 여성이고, 하얀 머리를 하고 있는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아미야, 첸이 재촉했었다. 네게…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너… 안색이 안 좋은데.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "내게 맡겨라.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "그럼…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "뒷일은 맡겨두지, {@nickname}박사.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "가능하면 5분 후에는 출발하고자 한다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "…{@nickname} 박사님…",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "무서운 건가?",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "네…? 전…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "박사님… 전 아무것도 두렵지…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "…아뇨, 두려웠어요.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "또다시 무언가를 잃게 되는 게 둘 되는 게 두려웠어요… 그래서…",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "…설마, 그 힘을 좋아하지 않는 건가?",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "자… 잘 모르겠어요…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "뭐라고 해야 할까요…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "사람을 다치게 하는 것 때문이 아니라… 실은…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "보여 드리고 싶지 않았어요. 박사님께서 이렇게 가까이 계실 때 제가…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "…남의 생명을 빼앗는 모습을.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "아미야, 후회할 필요는 없어.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "후회는 하지 않아요.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "아니, 그렇다기보다…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "박사님을 위해 힘을 쓰는 거라면, 어떤 사연이 있는 상대방의 목숨을 앗아가게 되더라도 후회하지 않아요.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "하지만 당연히… 찾아보면 더 좋은 방법이 있었을지도 모르죠.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "그런 방법을 찾지 못했기에, 그 사람의 목숨을 빼앗을 수밖에 없었어요.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "그 부분이… 굉장히 속상해요.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "저는…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "{@nickname} 박사님께 이런 모습 보여 드리고 싶지 않았거든요.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "평소엔 이 세계에 있는 감염자들을 고통에서 구하겠다고 말해 놓고…",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "중요할 때는 항상 이게 최선이라고 저 자신을 설득해서, 결과적으론 감염자들의 생명을 앗아가는 선택을 하고 있죠.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "아미야",
              "text": "저는…정말 나약해요.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "아미야는 적어도 나를 지켜줬잖아.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "…그게 제 일이니까요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "알았어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "처음부터 운명으로 정해진 일 같은 건, 없다고 생각해요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "하지만 무슨 일이 있더라도… 아무리 시간이 흘러도…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "전 박사님을 지킬 거예요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "약속해요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "위험해!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "너희는 먼저 가라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "난… 스컬슈레더를 도우러 간다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "무슨 소리야?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "그건 자살이나 마찬가지라고… 갈 거라면 다 함께 간다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "알았어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "그 녀석을 이런 황야에 버려둘 순 없지…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "가자!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "뭐지…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "리유니온이… 돌아오는 건가?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "대체 어떻게 할 생각이지…?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "호시구마 씨! 어서 후퇴하세요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "근위국, 꾸물거리지 마라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "적의 공격에 대비하라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "지원이 필요해! 이쪽이다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "저 여자…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "안 돼. 저 여자의 방패를 상대하는 건 무리야!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "서둘러! 우회하라! 녀석들이 태세를 정비하기 전에…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "우선 스컬슈레더를, 스컬슈레더를…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "리유니온 멤버",
          "text": "스컬슈레더를 구출하는 거다!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "로도스 아일랜드! 놈들의 움직임이 바뀐 것 같다, 조심해라!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "안 돼!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "호시구마 씨! 오른쪽!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "…뭐…?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "후훗, 방패로 막은 거야? 재미있네…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "폭발? 리유니온의 기습인가?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "당연히 기습 같은 게 아니지~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "그냥 네가 얌전히 여기 있어 줬으면 해서. 뒤로 움직이면 큰일 난다?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "쳇, 어디서 나타난 녀석이지!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "또 폭발인가!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "아미야! 여긴 지금 적의 원거리 포격을 받아 꼼짝할 수 없는 상황이다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "호시구마",
          "text": "나머지 적들이 그쪽을 향해 빠르게 이동 중이야!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "흐음, 이 방패, 정말 단단하구나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "왠지 사서 고생하는 느낌도 드네…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "뭐, 어때. 이럴 때 리유니온을 돕는 셈 치지 뭐.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "날 즐겁게 해달라고. 실망시키지 마~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "체르노보그에서 만났던 W라는 사람이에요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "설마, 첸 팀장님이 저 사람에게 당한 걸까요…?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "적의 기습에 주의하세요! 서둘러 호시구마 씨를 지원해야 합니다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "아직 많은 적들이 주위에 매복하고 있을 거예요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "적들의 흔적을 찾지 못하면, 전세를 유리하게 이끌 수 없습니다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "박사님! 각 팀을 지휘하여 적의 공격에 대응해 주세요!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
