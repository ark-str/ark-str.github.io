  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/a001/level_a001_04_end.txt",
  "sourceHash": "6de5de59a78892e52f395b4954d9c382e71bd364d7b5cd697d8f6fd39cc7432d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "큭……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "저 녀석은 다리를 다쳤다! 먼저 해치워!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "그라니! 이대로라면 여기서 체력을 모두 소모하게 된다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그렇게 말해도!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "클로어를 데리고 먼저 가! 빨리!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "다친 나와 함께면 신속하게 움직일 수 없어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "나중에 어떻게든 나도 합류하겠다! 그러니까 빨리 가!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "알았어, 그럼 약속해. 당신 몫은 남겨둘 테니까 꼭 무사히 와야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "……훗.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "가라!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "꼬마들이 도망친다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "빅 밥",
      "text": "너희의 상대는 나다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……싸우는 소리는 그친 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "하지만 클로어, 좀 힘들어도 쉬고 있을 시간은 없어. 서둘러야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "난 괜찮아…… 하지만 밥 씨가 어떻게 됐을지 걱정이 돼서……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "아마, 아저씨한텐 시간이 좀 필요할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "시간이 필요하다니……? 그게 무슨……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "클로어! 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "미안, 나무뿌리에 발이 걸려서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "자, 내 손 잡아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "……고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "걸을 수 있겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "……괜찮아, 긁힌 상처니까. 그라니 말대로 빨리 가지 않으면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "숲을 빠져나가면 모티카산 기슭이야. 거기에서 산 중턱에 있는 2번째 동굴로 들어가야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "입구는 그 동굴뿐이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "응. 안은 갈림길투성이에다가, 숨겨진 길을 지나야 하지만 난 가는 법을 알아. 보물은 동굴의 가장 깊은 곳에 잠들어 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "응. 그거라면……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "꺄악! 무, 무서운 소리가…… 멀리서 뭔가가 폭발한 거야……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "잘 들어보면 고함과 비명이 섞여 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "싸우는 소리야. 아직 끝나지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……클로어, 무서워?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "……굉장히 무서워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "하지만, 마을의 조용한 생활을 되찾고 우리 고향의 평화를 지키기 위해서라면…… 나도 할 일을 해야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "그, 그래……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "……클로어는 강하구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "클로어",
      "text": "응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그라니",
      "text": "후후, 아무것도 아니야. 자, 가자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
