{
  "server": "kr",
  "storyId": "main_3_level_main_03-04_beg",
  "groupId": "main_3",
  "stageId": "main_03-04",
  "title": "균열",
  "storyCode": "3-4",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_03-04_beg.txt",
  "sourceHash": "72af2ae3e004e7d8fea8cef47a7898d88389ec2f75a306c5c582d95cd538ef07",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아미야, 어때?! 우리 펭귄 로지스틱스도 나쁘지 않지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 굉장해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "우, 우와아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "나보다 어린 애한테 이렇게 칭찬받으니까, 왠지 좀 쑥스러운걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "아미야는 우리 의뢰인이다. 예의를 지켜.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아차, 미안 미안!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "괜찮아요. 오히려 제가 감사드려야 할 입장인걸요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "이걸로 로도스 아일랜드와 합류할 수 있게 됐군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "이제부터 어떻게 할 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "우선은 근위국의 판단을 기다려야겠네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그런가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그럼, 그들에게 이쪽으로 오라고 연락해보자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 지형……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "리유니온이 의도적으로 우리를 이곳으로 유인했을 가능성이 있다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "황사, 황야, 암석. 야외 작전에 필요한 요소는 다 갖춰져 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "유일하게 부족한 건, 적이 안 보인다는 것 정도?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마, 넌 남아서 로도스 아일랜드를 계속 지원해라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "음? 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "난 근위국 병력을 데리고 이동하겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이런 대치 상황이 계속되면 리유니온의 이동 경로가 우리의 힘이 미치는 범위를 벗어날지도 모르니 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "알겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너도 조심하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "…우와, 엄청난 바람이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "흐음, 시야 확보가 안 되네. 아무것도 안 보여……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "더 이상 전진할 순 없겠는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "리유니온이 우리가 포위망에 들어오는 걸 기다렸다가 기습을 할 수도 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "그런 상황만큼은 반드시 피해야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "이렇게 하자, 아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "난 리스캄이랑 같이 우회할게. 적을 정찰하면서 고지를 점거할 수 있는지 알아봐야겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "내가 연락할 때까지 로도스 아일랜드는 이곳의 수비를 좀 더 견고히 해줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "내 쪽에서 전투가 격렬해졌다고 섣불리 뛰어들면 안 돼, 아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "알고 있습니다. 여기서 상황을 보고 있을게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "박사, 당신도 아미야를 잘 지켜봐 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "그럼, 나중에 연락하지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "폐허는 텅텅 비었고, 고지를 방어하려는 기색도 느껴지질 않네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "웃음이 나오는걸. 리유니온에는 지휘관이 없나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프란카 씨, 무슨 문제라도 있나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "지금 여긴 수성에는 유리하고 공성에는 불리한 지형이잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "나라면 당연히 이 주변에 복병을 배치했을 텐데, 리유니온 녀석들은 대체……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "죽어라, 동포들을 버린 배신자 놈들아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "쳇, 이러면 내 체면이 말이 아닌데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…프란카 씨!! 측면에서 적이 나타났어요!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "리유니온이 건물 밑에서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "큭…! 검이 너무 빨라…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어째서…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "후훗.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "폐허 밑에 숨어 있으면 기습이 성공할 줄 알았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "우리를 너무 얕잡아 본 거 아냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "…블랙… 스틸…!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온",
      "text": "퇴각! 퇴각하라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "여기 리유니온이 잔~뜩 숨어 있을 것 같아서, 돌다리도 두드려 보고 건널 생각으로 온 건데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "무능한 겁쟁이들만 기다리고 있었나 보네, 실망인걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "쓸데없는 말을 하고 있을 때가 아니야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "적을 쉽게 놓아줄 순 없다. 쫓아야지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "아미야, 네 생각은 어떤가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "전 위험 요소는 피하는 게 좋다고 생각해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "먼저 펭귄 로지스틱스의 두 분에게 부탁해서, 위험 요소가 없는지 확인한 후에 움직이는 게 어떨까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "엑시아 씨, 고지를 선점해 주실 수 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "알았어! 지금 바로?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 가능하면 적의 제압도 부탁드려요. 리유니온이 반격할 여지를 조금이라도 줄여 놓고 싶거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "리유니온이 거리를 벌리고 진형을 갖추기 시작했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "게다가… 무언가를 데려온 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "조심하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 리유니온 폭도는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "평범한 전투원이 아니에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "리유니온이 어떻게 저런…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "설마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "저건… 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "틀림없어, 저 리유니온 전투원은… 어쩌면 살카……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "설마……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(리스캄 씨. 근위국과의 합동 작전 중이니, 지금은… 이런 민감한 이야기는 안 하는 게 좋겠어요!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "(그래, 알겠다.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "(나중에 다시 얘기하죠!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "…이런.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "모두, 준비해주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이번엔… 무척 힘든 싸움이 될지도 몰라요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
