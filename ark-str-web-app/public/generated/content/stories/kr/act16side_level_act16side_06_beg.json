    {
      "type": "dialogue",
      "speakerName": "오렌",
      "speakerToken": "avg_npc_355_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "대성당? 아니 아니. 체첼리아, 너를 대성당에 보내지는 않을 거야."
