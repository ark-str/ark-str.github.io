    {
      "type": "dialogue",
      "speakerName": "체첼리아",
      "speakerToken": "avg_npc_352_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "우선 비켜줬으면 좋겠어. 나는 저기 있는 시계탑에 가야 해."
