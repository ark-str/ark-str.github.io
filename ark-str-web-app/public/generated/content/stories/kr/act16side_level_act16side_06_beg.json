    {
      "type": "dialogue",
      "speakerName": "체첼리아",
      "speakerToken": "avg_npc_352_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "……내가 대성당에 가면 무슨 문제라도 있어?"
