    {
      "type": "dialogue",
      "speakerName": "오렌",
      "speakerToken": "avg_npc_355_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "넌 살카즈여야 했지만, 결국 산크타가 됐으니까."
