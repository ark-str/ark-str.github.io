    {
      "type": "dialogue",
      "speakerName": "오렌",
      "speakerToken": "avg_npc_355_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "글쎄, 뭐라고 장담하기 어렵네, 체첼리아."
