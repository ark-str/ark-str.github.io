    {
      "type": "dialogue",
      "speakerName": "체첼리아",
      "speakerToken": "avg_npc_352_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "에젤 오빠, 시계탑 위에서 기다릴게."
