    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_23_G03"
    },
    {
      "type": "dialogue",
      "speakerName": "대변인 맥키",
      "speakerId": "avg_npc_212_1",
      "isRemote": false,
      "text": "……말키위츠."
