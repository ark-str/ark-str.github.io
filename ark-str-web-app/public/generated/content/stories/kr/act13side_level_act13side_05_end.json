    {
      "type": "dialogue",
      "speakerName": "그라벨",
      "speakerId": "avg_237_gravel_1",
      "isRemote": false,
      "text": "이런 상황이 아니라면, 후훗…… 박사랑 함께 거리를 구경해도 좋았을 텐데."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "나보다도 아미야와 다른 사람들이 더 큰 압력을 받고 있어.",
          "value": "1",
          "blocks": []
