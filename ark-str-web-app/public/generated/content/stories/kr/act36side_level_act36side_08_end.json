      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "라이오스",
          "text": "응? 아, 미안! 방금 있던 저 새 수인…… 리베리 사람한테 묻고 싶었는데…… 어라? 어디 갔지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "라이오스",
          "text": "다들 왜 그렇게 멀리 떨어져 있어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "응……?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "질색하는 사람 D",
          "text": "아미야! 저 사람!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "질색하는 사람 E",
          "text": "저 사람, 환자가 아니라 아까 갑판에서 발견한…… '손님'인데……!",
