    },
    {
      "type": "choice",
      "options": [
        {
          "label": "우리는 광산에서 '국가'로 인한 오염을 발견했었어.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "크세니야",
          "text": "……근위병이 왔었지만, 지금은 떠났어요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "하지만 너는 정신을 잃기 전에 '오카'가 근위병을 죽일 수 있다고 말했어……",
          "value": "1",
          "blocks": []
        },
        {
