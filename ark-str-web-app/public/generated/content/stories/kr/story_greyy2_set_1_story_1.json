{
  "server": "kr",
  "storyId": "story_greyy2_set_1_story_1",
  "groupId": "story_greyy2_set_1",
  "stageId": null,
  "title": "광명을 쓰다",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_greyy2_1_1.txt",
  "sourceHash": "aafdd12e98635f976f95df0cafef0aa18055b99869ca9edc1d59c56883207536",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "그레이?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "엔지니어링부에 새로운 외근 임무가 들어왔어. 확인하는 대로 엔지니어링부에 와줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "알겠습니다. 바로 갈게요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "한마디로 요약하자면, 저번에 업데이트된 방재 전력 시스템과 그에 대응하는 조명 기구들의 생산이 전부 완료됐어. 규모가 좀 큰 사무소는 직접 설치할 오퍼레이터들이 있으니, 전달자에게 배송만 부탁하면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "문제는 외진 곳의 소형 사무소인데, 거기는 오퍼레이터도 부족하고 직접 설치할 능력도 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "그래서 이번에는 엔지니어링부 오퍼레이터가 직접 가서 설치하기로 했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "평소처럼 가고 싶은 곳이 있으면 먼저 알려줘. 그렇다고 개인 사정 때문에 작업 기간이 늘어나는 일은 없을 거야. 임무가 끝나고 주변을 돌아보는 건 자유지만, 기한은 넘기지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "리스트를 봐도 될까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "자, 여기.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "……전 이곳에 가고 싶어요. 볼리바르 뒷산의 사무소로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "알았어, 체크해둘게. 이건 조명 기구와 테스트 장비야. 시스템 설치와 업데이트 방법은 엔지니어링부 단말에서 확인할 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "맞다, 그레이. 너 볼리바르 출신이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "네, 맞아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엔지니어링부 오퍼레이터",
      "text": "출발은 내일 아침 7시야. 모처럼 고향에 돌아가는 건데, 안전에 조심하고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "고마워요. 우선 돌아가서 짐부터 쌀게요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "짐은 예전에 고객 방문 서비스를 할 때처럼 정리해 뒀으니까, 더 이상 뭘 가져갈 필요는 없겠지……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "오늘 새 물건이 들어왔다던데, 가자, 가보자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카제마루",
      "text": "임무 교대도 아직 끝나지 않았는데요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "이스티나 언니가 최근에 시험에 합격했대. 그래서 굼이 선물을 보내주고 싶어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "다들 언니가 고른 선물이 최고라고 했단 말이야. 부탁할게~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "나는 그 가게에 가본 적도 없는데. 어디지……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "이쪽인가…… 직진? 그리고 왼쪽이랬나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "정말 여기에 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가게 오퍼레이터",
      "text": "엇, 그레이? 오랜만이네. 저번에 본 게 엔지니어링부랑 함께 실습 나갔을 때였는데. 어때, 요즘 바빠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "실습도 곧 끝나가요. 최근에는 논문 답변을 준비하고 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가게 오퍼레이터",
      "text": "아, 고생이 많겠네. 내가 졸업 논문을 쓰다가 머리카락이 잔뜩 빠졌잖아. 귀 쪽에도 털이 거의 다 빠져서 한참을 길렀거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가게 오퍼레이터",
      "text": "그래서 쓴 게 이 발모제인데, 어때, 한 병 사서 써볼래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "그, 그건…… 사양할게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가게 오퍼레이터",
      "text": "아하하, 그럼 이 영양 만점의 월넛 밀크는 어때? 요즘 인기 상품인데. 이건 안 살 수가 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "그것도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가게 오퍼레이터",
      "text": "헤헤, 곤란해하는 것 같으니까 이건 그냥 선물로 줄게. 논문 답변이란 게 쉽지 않아. 이거 먹고 힘내야 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "고맙습니다, 릴리 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가게 오퍼레이터",
      "text": "그럼, 오늘은 뭐 사려고 여기 온 거야? 맡겨만 줘, 절대 실망할 일이 없을 거니까.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "후우…… 원석충 유리 장식, 메탈 크랩 화분, 그리고 가정용 양조기까지. 제대로 산 게 맞나……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이",
      "text": "짐은…… 다시 싸야겠네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그레이, 안녕.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "그레이, 그게 다 뭐야?",
          "value": "2",
          "blocks": []
        },
        {
          "label": "그레이, 이사라도 가?",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "박사님, 안녕하세요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "내일 새로운 방재 전력 시스템을 설치하러 볼리바르의 사무소에 가야 하거든요. 이건 그 사무소의 아저씨들과 아줌마들을 위한 선물이에요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "논문은 잘 쓰고 있어?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "논문 답변 준비는 잘 돼가?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "논문은 다 썼어요, 박사님.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "다만…… 아직 마지막 감사 부분이 고민돼요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "이 논문을 잘 마무리 짓고 싶거든요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "이번 외근 임무를 마치면 논문의 최종 버전을 제출할게요. 박사님께서 제 논문 답변 담당이시니, 잘 부탁드립니다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그래, 열심히 해.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "나 엄격해.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그래도, 현지 오퍼레이터들이 널 보면 아주 기뻐할걸.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "그 짐은 내려놓고 얘기할까?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "박사님, 감사합니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "그렇지만 먼저 실례하겠습니다. 내일 일찍 출발해야 해서 짐과 장비들을 정리해야 하거든요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "무사히 돌아올 테니 걱정하지 마세요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "조심해서 다녀와.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "감사합니다, 박사님!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "몇 주 후"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "정말…… 마음에 드나요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "유리 장식은 이쪽에 둬. 화분도 엄청 귀엽네. 그리고 이건, 양조기?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그레이 군, 이건 대체 어떻게 산 거야? 왜 샀는데? 몇 살이나 됐다고 벌써 이런데 물들었어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "그게 아니라……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "맙소사…… 선물까지 사 오다니…… 우리 그레이가 다 컸구나……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "여기는 하나도 변한 게 없어, 하하하! 사람들이 많이 오고 가도, 우리 셋은 항상 여기 있지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그나저나 그레이 군, 정말 괜찮아? 좀 쉬는 게 좋을 것 같은데? 도착한 지 얼마 됐다고 벌써 일을 시작하고 그래.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "본함에서 빨리 복귀하라고 재촉했어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "너를 막 본함에 보냈을 땐 그 '박사'라는 사람이 새로운 리더가 됐다던데. 최근 몇 년 사이에 여러 가지 일을 해냈더라. 우리도 소문 들었어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그런데 너는 거기 치료하러 간 거 아니야? 어째서 이런 외근 임무까지 하는 거야? 설마 그 박사라는 사람이 너희를 착취하거나 그런 건 아니지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "넌 아직 환자잖아. 고생하면서 여기까지 왔는데, 물 한 모금 안 마시고 바로 일이라니!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "저번에 편지에서 그레이가 말했잖아, 페르난도. 이건 그레이가 원해서 하는 일이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "페르난도 아저씨, 박사님은 그런 사람이 아니에요. 본함도 아주 좋아요. 여긴 제가 자원해서 온 거예요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "저는 계속 엔지니어링부에서 실습하고 있고, 최근에는 논문 답변을 준비하고 있거든요. 그리고 저도 키가 컸고 몸도 제법 튼튼해졌어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "지금은 단지 회로를 점검해서 미리 만들어둔 모델과 매칭하고 있을 뿐이에요. 그럼 내일 작업할 때 훨씬 편해지니까요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "진짜?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "성질도 급하긴. 그레이가 너한테 거짓말할 리가 없잖아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "페르난도 아저씨, 출발하기 전에 박사님께서 다들 저를 보면 매우 기뻐할 거라고 하셨어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그 박사라는 사람은 그런 것도 알아?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그래, 뭐…… 나쁜 사람은 아닌 모양이네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "그레이, 일단 사다리에서 내려와. 너를 위해 특별히 만든 볼리바르 요리를 먹어 봐. 아직 한창 클 나이니까 많이 먹어야 해.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "이야, 벌써 키가 나랑 비슷하네. 처음 너를 안고 왔을 땐 요만했는데……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "그, 그건……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "왜, 쑥스러워?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "하하하, 이 얘기는 나중에 하고. 아까도 셋이서 얘기했는데, 우리가 너한테 하고 싶은 말이 있어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "전에 보낸 편지에서도 너는 엔지니어링부에서 공부하고 전기 엔지니어가 됐다고 했잖아. 그레이 군, 이건 아주 좋은 일이야. 대단한 뜻이라고 생각해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "다만, 의사로서 나는……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "리타, 역시 내가 얘기할게.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "그레이, 너는 편지에서 장비 제조라든가, 논문을 쓴다든가, 답변을 준비한다든가, 그리고 더 깊은 분야를 전공하고 싶다고 했잖아. 심지어는 '현대 과학기술의 끝자락에 도달'하고 싶다고 했는데.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "네가 결정한 일이라면 우리는 물론 방해하지 않을 거야. 다만, 이런 말은 하고 싶지 않지만, 너는 어디까지나 아픈 몸이니까……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "리타 아줌마, 걱정하지 마세요. 본함의 약은 효과가 아주 좋으니까요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "게다가 본함에는 저 같은…… 심지어 저보다 더 심각한 환자들이 많아요. 하지만 다 저보다 훨씬 씩씩한 사람들이거든요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "제가 이 병을 대수롭지 않게 여기는 건 아니지만, 다들 매일 열심히 하는 모습을 보면 저도 덩달아 많이 나아진 느낌이에요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "그래, 스스로 알고 있다면 그걸로 됐어. 무슨 일이든 항상 깊이 생각하고 신중하게 움직여야 해. 그레이, 이건 내가 유일하게 네게 당부하고 싶은 말이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……다들 할 말 끝났어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그레이, 일어나서 한 바퀴 돌아 볼래?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……나쁘지 않네. 이 나이대 페로가 이 정도 체격이면 나쁘지 않지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "네가 감염자라는 건 알고 있지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "크흠…… 페르난도, 쓸데없는 소리 하지 마.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "아이 앞에서 그런 말은 의미가 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "페르난도 아저씨, 알고 있어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "하지만 이건 제가 하고 싶은 일이에요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그레이, 이해해. 아이들은 어릴 때 다 꿈을 가지기 마련이지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그런데 내가 걱정되는 건 너 자신이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "내일 본함에 신청서를 넣을게. 앞으로 너를 여기에 머물게 하라고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "네?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "어제도 네 예전 검진 결과를 다시 봤는데, 0.3u/L, 이건 조금만 방심해도 병세가 다시 악화할 수 있는 수치야. 우리는 최신 결과를 볼 권한이 없지만, 지금 수치는 얼마야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "코딩에, 장비 제조에, 금속 가공 실습까지…… 로도스 아일랜드의 목표가 변하지 않는다는 건 믿겠지만, 네가 당장 해야 할 일을 정말 알고 있는지 걱정돼서 안심할 수가 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "페르난도!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그레이도 다 컸어. 그렇게 말할 필요는 없잖아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "게다가 걱정은 걱정이고. 네가 원하는 걸 애한테 강요하지 마……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "크흠…… 자자, 밥 먹자! 밥!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "식으면 맛없어. 자, 그레이, 이거 먹어 봐.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "…… 페드로 아저씨, 고마워요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "있다가 설거지는 제가 할게요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……안 돼!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "꼼짝도 하지 마. 내가 할 테니까!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "네……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "그레이는 코끝에 맺힌 땀방울을 닦아내고 단말기에 업데이트 후의 데이터를 입력했다.\n전력 장치에서 뿜어져 나오는 빛이 그의 눈앞에서 잠깐 반짝이다가 점차 안정되었다.\n사무소의 몇몇 방은 순간 어둠에 휩싸였지만, 이내 시스템의 도움으로 조명기구가 더 강하게 빛나기 시작했다.\n그레이는 손에 든 단말기를 확인하고 있었고, 그의 호흡은 매우 안정적이었다."
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "그레이, 급해? 아니면 나도 도와줄까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "음, 대규모 업데이트라 해야 할 일이 많기는 하지만 혼자서도 충분해요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그레이, 내가 어렸을 때, 병에 걸리면 부모님은 나를 집에 가두고 아무것도 못 하게 했어. 그저 한시라도 빨리 병이 낫기만을 바랐지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그때는 나도 부모님을 이해할 수 없었거든. 다른 친구들은 병에 걸려도 부모님과 함께 일자리를 찾으러 나갔는데, 나만 집에서 외롭게 있어야만 했으니까. 마치 내 자유를 빼앗은 것 같았어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "하지만 십여 년이 지나니까 부모님의 마음을 알겠더라. 우리 집은 가난한 편이 아니어서 내가 목숨을 깎으면서까지 일할 필요는 없었어. 그저 집에서 확실하게 병을 치료하길 바랐던 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "전구를 가는 것 정도의 일도 너 같은 환자가 먼 길을 달려와서 해야 한다면…… 과연 네가 본함에서 정말 하고 싶은 일을 찾을 수나 있을지 걱정되는구나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "페르난도, 함부로 말하지 마.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "만약 초심을 잃은 거라면, 가서 며칠 머리나 좀 식히고 와. 네가 왜 로도스 아일랜드에 들어오고 싶었는지 잘 생각해 보고 다시 얘기해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "네 그 말은 그레이뿐만 아니라 본함까지 모욕하는 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "화났어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "나도 화나.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "능력이 없는 나 자신에 화나. 나 지금 말도 안 통하고 고집도 센 그런 가장처럼 보이겠지? 이게 다 네게 더 좋은 미래를 줄 능력이 없어서 그래.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "페르난도, 이건 그레이의 선택이야. 본함은 그런 선택을 존중해서 여러 가지 가능성을 제공한 것뿐이고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "우리는 남의 인생을 대신할 수 없어. 게다가 본함이야말로 더 넓은 무대고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "하지만 나에게는 죽으러 가는 것밖에 보이지 않아! 당시 내 친구들은 다 공장에서 일하다가 광석병에 걸려 죽었어. 건강하게 살아남아 여기서 오퍼레이터나 하고 있는 건 나뿐이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "걔네들이 이동도시에서 버, 버려졌을 때 내가 어떤 기분이었는지 알아?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "하지만 그레이는 아직 선택할 수 있는 길이 많잖아!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "감염자라고 해도 다른 길을 간다면 평화롭고 건강하게 일생을 보낼 수 있어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "난 감염자가 아니야. 너도 아니고 리타도 아니지. 전쟁만 일어나지 않는 한 우리는 아주 오래 살 수 있어. 하지만 그레이는 우리보다 먼저 갈 수도 있다고! 내 어릴 적 친구들처럼!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "나도 각오라는 게 있어, 거창하진 않지만. 나는 그저 볼리바르에서 나고 자랐을 뿐이야. 나는 그저 감염자가 된 내 친구들을 몇 명이라도 더 살리고 싶어서 여기서 일하는 평범한 사람이라고.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "나는 사람을 구하고 싶지, 병에 걸린 사람이 일하는 걸 그냥 쳐다보고만 싶은 게 아니라고.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "페르난도!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "페르난도의 과거는 우리 모두 알고 있지만, 이 녀석은 항상 욱하는 성질이라니까. 침착하게 말해도 될 일에 꼭 언쟁을 벌여야 속이 시원하나 봐……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "내 말이. 저번에도 나랑 두 시간이나 싸웠잖아. 그런데 주말에는 둘이서 뒷산에 낚시하러 갔더라?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그거랑 이건 얘기가 달라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "이건 그레이에 관한 거야. 우리들의 이상이기도 하고. 그런 사소한 말다툼 따위는 아니야……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "무슨 일이야?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그레이 군?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "흑, 흐흑……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "……흑……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그레이 군? 울어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "울지 마, 우리는 싸운 게 아니야. 그냥……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 B",
          "text": "그레이, 아직도 사다리 위에 있어? 얼른 내려와!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "……(코를 푼다)……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "……페르난도? 왜 너야? 그레이는?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "저는 여기 있어요, 리타 아줌마! 잠깐 전력 시스템에 오류가 있었을 뿐이에요. 제가 다 고쳤으니까 이제 괜찮아요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "페르난도 아저씨……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "흑…… 이럴 줄 알았으면 네가 우리를 도왔다고…… 너에게 돌아와서 우리를 도와달라는 부탁은 안 했을 거야……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……그 옷을 봐. 본함에서 오느라 얼마나 고생했겠니. 그런데 우리한테 불평 한마디 하지 않으니…… 흑, 너 같은 녀석이 어디 있어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……나는 매일 생각하고 있었어. 네가 힘들게 여기까지 온 것은, 그때 내가 이 녀석들에게 여기를 밝힐 수 있는 건 너밖에 없다고 말했기 때문이 아닐까……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "내 탓이야, 다 내 탓이야…… 이렇게 급하게 일하는 것도, 설마 금방 돌아가려고 그러는 건 아니겠지?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "그럼 너를 다시 볼 수 있는 건 또 몇 년 뒤일까?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "페르난도 아저씨, 그렇지 않아요……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "정말 힘들지 않아요. 제가 뭐라고 하지 않은 것도 하나도 힘들지 않기 때문이에요. 뭔가를 숨기려는 게 아니라요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "제발 울지 말고 잠깐만 기다려주세요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "페르난도 아저씨, 이거 봐요. 이게 제가 엔지니어링부에서 다른 오퍼레이터들과 함께 연구해낸 방재 전력 시스템이에요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "이 집의 불빛을 더 밝아지게 할 수 있어요. 광원도 안정적이라서 바람이 불고 비가 와도 전혀 어두워지지 않죠.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "원래는 발전기가 있어야 간신히 이 산의 텐트 하나 밝힐 정도였지만, 지금은 이 집을, 심지어 산 전체도 밝힐 수 있어요. 그리고 미래에는 영원히 빛나게 할 수도 있거든요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "이게 제 기술이고, 제가 지금 하고 있는 일이에요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "아저씨 말도 틀린 게 아니에요. 어쩌면 이 일이 제 건강을 해칠지도 몰라요. 저에게 남은 시간도 그리 많지 않아요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "하지만 그 대가로 제가 이뤄낸 걸 보세요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "슬럼가의 등불 몇 개나 오두막 몇 채가 아니에요. 저는 더 많은 곳을 밝힐 능력이 있어요. 저는 십 년 후, 심지어 몇십 년 후를 위해서 일하는 거예요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "저에게 그럴 능력이 있는데, 그 능력을 이용하지 않을 이유가 없잖아요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "만약 그때…… 저희 집이 불빛이 밝았다면…… 저도 지금처럼 되지는 않았겠죠.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "제가 할 수 있으니까, 저는 사람들이 그때의 저처럼 같은 일을 당하는 걸 원치 않아요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "그리고 아저씨의 친구들처럼 될 사람도 없을 거예요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "(역시 페르난도 아저씨가 아줌마랑 다투고 있나 보네……)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "(가서 말려도 별 소용없을 건데. 페르난도 아저씨의 생각도 변하지 않을 거고.)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "(내 능력을 먼저 보여드리고 타일러야 모두를 멈출 수 있을 것 같네.)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "(코드야…… 미안해. 조금 있다가 고쳐줄 테니, 우선 잘못된 값을 입력할게……)",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그레이 군, 네 말은 잘 알아. 나는 페르난도처럼 욱하는 성격이 아니니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "하지만 의사로서…… 당시 네가 우리에게 도움이 됐다고 거짓말했던 사람으로서…… 물어보고 싶은 게 있어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "너라면 그게 거짓말이었다는 건 이미 눈치챘겠지. 나도 '선의의 거짓말'이라는 걸로 포장할 생각이 없어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그건 어른으로서 별생각 없이 내뱉은 말이었어. 게다가 다른 두 사람까지 거짓말을 하게 만들었지. 그리고 이 일이 어느 정도는 네 선택에 영향을 준 것도 사실이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그래서 물어보고 싶은데, 만약 그 일이 다시 일어난다면…… 우리가 널 속였다는 걸 알면서도…… 너는 우리를 위해 오리지늄 아츠를 사용하고, 우리에게 사실 필요 없었던 빛을 밝혀 줄 거냐?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "네.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그게 정말 도움이 될지 모르더라도?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "네, 비출 거예요. 앞으로도. 저는 어둠이 싫어요. 어둠이 더는 누구에게도 공포의 대상이 되지 않았으면 좋겠어요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "그게 정말 도움이 될지 모른다고 해도요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "……하아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "메딕 오퍼레이터",
          "text": "그레이 군, 이건 네 이상이고 네 인생이야. 우리도 너를 계속 응원할 거다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "사무소 오퍼레이터 A",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "박사님, 안녕하세요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "안녕.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "논문이랑 장비를 모두 완성했어요, 박사님.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "그레이",
          "text": "답변도 준비되어 있습니다.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
