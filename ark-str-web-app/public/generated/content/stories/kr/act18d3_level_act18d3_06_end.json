{
  "server": "kr",
  "storyId": "act18d3_level_act18d3_06_end",
  "groupId": "act18d3",
  "stageId": "act18d3_06",
  "title": "식욕 부진",
  "storyCode": "SV-6",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act18d3/level_act18d3_06_end.txt",
  "sourceHash": "3b8e1db86ae2ee3174e6b00425311a43f2fafa4a8b3e0b0d9275fa0ed0664e15",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "콜록콜록……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……대상이 사람이면 힘과 각도를 제어하기 어려워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "괘, 괜찮아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(자신의 냄새를 맡는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "피도 멈췄는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "저것들은 왜 저렇게 흥분한 거지? 이곳에 시테러가 원래 이렇게 많았나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "어제 그 괴물인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "비슷해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "지금까지 본 적이 없는 것들이네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "며칠 동안은 이곳에 오지 마. 빨리 돌아가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……내 치마 좀 잡아당기지 마. 넌 그 정도로 어린아이도 아니잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전…… 제가 원하는 게 무엇인지 생각해 봤어요. 전 당신의 노래를 듣고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "흠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "왜냐하면…… 전 노래가 무엇인지 모르거든요. 당신이 꿈속에서 흥얼거리는 걸 들었어요. 그런데 전 알아들을 수 없었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "좋아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 대답하신 거예요? 그럼 약속한 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그렇다고 쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(미간을 찌푸린다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내 하프가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "어? 맞다. 가수님, 하프는 어딨어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……돌아가서 찾아야겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네, 제가 같이 찾아 드릴게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "그건, 저와 함께 돌아가고 싶단 것 맞죠? 야, 얏호!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그렇게…… 기쁜 일인가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "안녕, 벽먼지, 좋은 아침!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "맞다, 철판은 어디 갔어? 너희들 전엔 계속 붙어 다녔잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네가 보고 있는 방향은…… 바다…… 야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "설마 어제 빨간색 조개껍데기를 뽑은 게, 철판이었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "나무틀, 내 병이 더 심해진 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "나, 가슴이 많이 부풀어 올랐어. 터질 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "난 음식도 먹고 싶지가 않아. 그러니 나한테 말 걸지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "……하아.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 어서오세요! 저희 집에!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "노인 주민",
      "text": "흐윽…… 하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "네 할머니는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "페트라 할머니께선 아직 주무시고 계셔요. 어제 함께 이곳에 돌아와서부터 줄곧 주무시고 계세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "할머니께서도 체력을 많이 소모하셨으니, 분명 많이 피곤하셨을 거예요. 전 할머니께서 갑자기 나오셔서 재판관님께 그렇게 말씀하실 줄은 몰랐어요. 평소와 너무 다른 모습이었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "네 말이 맞아. 할머닌…… 정말 대단해. 할머닌 재판관을 물리쳤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "노인 주민",
      "text": "아…… 하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "재판관을…… 물리치셨다고요?! 가수님이 그렇게 말씀하시는 걸 재판관님이 들었다간 또 화를 내실 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "마음대로 하라지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "만약 그 여자가 다시 싸우려고 한다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "재판관이 다시 찾아와 가수님을 귀찮게 하진 않겠죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……누굴 귀찮게 굴든 마찬가지야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(가방을 만지작거린다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "참, 우리 하프 찾으러 가요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "잠깐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "네 머리에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "으악! 초록색 끈적끈적한 것들이 엄청 많은데…… 이게 뭐죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "해초야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "방금 넘어졌을 때 붙은 걸까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그런 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이것들은…… 쓸모가 있나요? 해조류랑 비슷하게 생겼네요. 바람에 말리면 침대에 깔 수 있을까요? 허리가 불편하신 페트라 할머니께 딱일 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……줘봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "조개껍데기로 이 해초를 갈아. 점액을 씻어내지는 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "단지에 해초를 넣고, 전부 잠길 만큼 바닷물을 부어. 그리고 잘 봉인해서 반년 동안 두는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "단지 속의 녹색이 옅어지면 발효가 다 됐단 뜻이니까, 그때 마시면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "……가수님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "왜? 못 알아들었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "지…… 지금까지 제게 단숨에 이렇게 많은 말을 했던 적은 없었던 것 같아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "응.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "조개껍데기도 버리지 말고 깨끗이 씻어 말려서, 술 마시는 용기로 쓰면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "술이요? 그게 뭐죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "저기에 적혀 있어. 이곳은 원래 술집이었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이 글자는 술이란 뜻이었군요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "사람들은 술을 마시면 기분이 좋아지고, 고민을 잊을 수 있다고 말했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "정말이에요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……사실 다 소용없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "하지만 맛은 나쁘지 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님은 이전에 이걸 자주 마셨나요? 당신의 고향…… 에기르에서요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "좀 달라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……가끔 비슷한 걸 마시기도 해, 춤추기 전에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "그땐 엄청 즐거웠겠어요. 아, 알겠어요! 술이 즐거움을 줄 수 있는 게 아니라, 즐거울 때 우리는 술을 마시는 거네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "바깥에 사는 사람들은, 모두 술을 마실 줄 아나요? 모두들 즐거운가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "꼭 그렇진 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "알겠어요. 그럼 그들은 분명 저만큼 즐겁지 않을 거예요. 가수님, 술 만드는 법을 알려주셔서 고마워요. 전 지금 당장 당신과 함께 마시고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그렇게 하는 게 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이렇게 빻으면 잘게 다지기 어려워. 각도를 바꿔 가장 뾰족한 부분을 해초의 결에 맞춰.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "리듬에 따라 호흡을 가다듬어 봐…… 네 손, 네 몸을, 네 피부에 닿는 바닷바람과 하나가 되게 해봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이렇게 해야…… 한 번에 다질 수 있어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "날 그렇게 뚫어지게 쳐다보는 건, 날 치겠다는 거야? 너 하나쯤은 금방 끝낼 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "아…… 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "이거, 돌려줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이건?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "내 하프잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판이 주운 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "어젯밤에 네가 이 물건을 밖에 떨어뜨리는 걸 보았대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "와, 정말 다행이에요! 가수님, 우리 하프 찾으러 가지 않아도 되겠어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "철판이, 이걸 몰래 우리가 사는 집으로 가져와서는 당신에게…… 돌려주라고 했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "그렇게만 말하고는 가버렸어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "어? 어……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(하프 줄을 튕긴다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이 선율은…… 어, 가수님이 밤에 잠들었을 때 흥얼거린 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "이게 자주 내 머릿속에 떠올라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "이건 당신과 당신의 동료가, 이전부터 알던 노래인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "고향에 있을 때 이런 노래를 많이 들었어. 우린 노랫소리로…… 서로 대화했으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "그곳을 떠난 뒤로는 다른 노랫소리는 다 사라졌어. 나 외에, 남은 건 이것뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "어쩐지, 이 노래가 슬프게 들려요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(하프 줄을 튕긴다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 우리 약속이요! 하프를 되찾았으니, 우리한테 노랠 불러줄 수 있죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "우리 모두 기다리고 있어요. 그렇죠, 페트라 할머니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "노인 주민",
      "text": "오…… 으응……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "할머니는 오늘 말을 못 하세요. 그렇지 않았다면 할머니도 틀림없이 따라 부르고 싶어 했을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "노인 주민",
      "text": "아…… 아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 페트라 할머니가 듣고 싶어 하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "좋아.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "헌터 한 명이 해변을 걷고 있네♪\n고향은 뒤에 있고, 길은 앞에 있네♪\n부모와 자녀 모두 그와 헤어지고♪\n연인마저 바다에 묻혔다네♪"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주교",
      "text": "표정이 좀 바뀌셨군요. 뭔가 느낀 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "글래디아",
      "text": "아무것도 아니에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주교",
      "text": "전혀 이상하지 않습니다. 당신의 신경은 여전히 둔한 상태니까요. 눈앞의 물을 보십시오. 수위의 변화, 물결의 빈도, 빛의 역동, 이 모든 것이 메시지입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주교",
      "text": "곧 만조입니다. 저희도 올라가야 할 때이고요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "헌터 한 명이 해변을 걷고 있네♪\n고향은 뒤에 있고, 탄식만 남았네♪\n그의 길은 끝이 보이지 않네♪\n그의 길은 안개가 자욱하네♪"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "노래를 하고 있네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "설마 이 황폐해진 술집에서, 그것도 사람들 앞에서 노래를 하다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "사람들은…… 그걸 또 듣고 있고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "고개 숙인 사람은 여전히 고개를 숙이고 있고, 말할 줄 모르는 사람은 여전히 혀가 굳어 있어. 노랫소리는 분명 저들의 경직된 몸속에 스며들 수 없을 텐데, 저들의 눈빛은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "재판관",
      "text": "과연, 저들이 알아들었을까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "페트라 할머니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "무슨 일이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "할머니께서…… 잠드셨어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "할머니께서 이렇게 평온하게 주무시는 건 거의 본 적이 없어요. 예전에 할머닌 눈만 감았다 하면 크게 소리를 지르며 허공에 대고 헛발질을 하셨는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "전 가수님이 부르는 노래를 듣고 할머니께서 춤추고 싶어 할 줄 알았어요. 할머니는 항상 춤추고 싶다고 하셨으니깐요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "벽먼지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "나 죽을 것 같아. 내 눈에…… 바닷물이 들어갔어. 너무 짜. 하나도 안 맛있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "와, 너 지금…… 너 운 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "울어? 우는 게 뭔데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……네 몸 깊은 곳에서 흘러나오는 감정이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 B",
      "text": "그…… 래? 난 아직 잘 모르겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "가수님, 전 가수님 노래가 좋아요. 가수님은 말수가 적지만, 당신의 노래에는 많은 말이 담겨 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아니타",
      "text": "다시 한번 불러주실래요? 전 당신의 이야기를 더 많이 듣고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스카디",
      "text": "(하프 줄을 튕긴다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 C",
      "text": "먹을 것……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 D",
      "text": "먹을 것이 도착했어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 C",
      "text": "해변으로 가자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남자 주민 D",
      "text": "선교사님!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
