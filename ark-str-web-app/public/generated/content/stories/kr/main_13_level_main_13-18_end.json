{
  "server": "kr",
  "storyId": "main_13_level_main_13-18_end",
  "groupId": "main_13",
  "stageId": "main_13-18",
  "title": "들끓는 피바다",
  "storyCode": "13-20",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/main/level_main_13-18_end.txt",
  "sourceHash": "06cec63d5fc97d5413b9d7ba09c71fa59369f324036280eff942598728d610a2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……테레시스."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "뱀파이어."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "만약 제 기억이 틀리지 않았다면, 당신의 거짓된 '군사위원회'에서 저도 어떤 직책이 있었던 것 같은데 말이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그런데 관련 전황 보고를 마지막으로 받아본 지가 언제였던지 기억도 잘 나지 않는군요."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "그건 당신이 군사위원회의 회의에 거의 참가하지 않았기 때문이다."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "당신에겐 여전히 상응하는 지휘권이 있을 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "“지휘권”이라."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "제 아이들은 지휘할 필요가 없답니다. 그들은 날 때부터 저의 것이었고, 그들이 섬기는 왕정에 속해 있으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "그럼, 그들을 좀 더 잘 관리할 필요가 있겠군."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "전쟁은 이제 막바지에 이르렀고, 당신의 부하는 더욱 중요한 일을 맡아야 하건만 그들의 방종함은 참으로 골치가 아프더군."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "서부 전선에서 너무 시간을 많이 끌었다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "의식에 필요한 일이었다고 해 두지요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그만한 피와 눈물이 없었다면, 그토록 많은 주술 소재들을 비축하기란 불가능했을 테니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "당신과 테레시아가 제게 그랬었죠. 그 상처투성이인, 오래된 문을 찾아냈다고요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "살카즈가 겪어 온 고난의 근원, 운명의 시발점이 정말 그 문 뒤에 있나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "의식의 준비는 이미 마쳤다."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "하지만 이에 필요한 거점 중 하나인, 브렌트우드라고 불리는 마을이 지금 우리의 적들에게 공격 당하고 있다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "지금 제게 그 사소한 문제를 해결하라고 말하는 건가요, 테레시스?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "흠, 덕분에 떠오르는 게 하나 있군요. 군사위원회의 명망 높은 '섭정왕'이시여……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "군사위원회에서 그 '중요한' 마을을 기억하고 있었다면, 어째서 그럴듯한 대비를 하지 않은 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "수의로 몸을 감싼 캐스터, 뼈와 살로 이뤄진 꼭두각시, 혹은 어떤 주술로 강화되어 피육을 휘두르는 덩치같은 것들로 말이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……제가 당신과 당신 동생의 행위를 용인한 이유는, 그대들에게 강대하고 눈부신 영혼이 있었기 때문이랍니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "연약한 살카즈들은 그대를 섭정왕이라 부르고, 당신의 곁으로 모여든 고해신부들은 테레시아까지 데려왔어요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "섭정왕, 죽음에서 돌아온 '마왕'. 당신들은 참으로 재미있는 남매죠."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "하지만. 이는 당신들의 행동과 힘 때문이었지…… '지위' 때문은 아니에요."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "'힘'이라."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "흥."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "가장 웅대한 저주를 내리기 위해, 저는 이미 이 전장에 축복을 깔아두었답니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "가장 오래된 왕정 중 하나로서, 저는 자비를 베풀어 살카즈의 핏줄 속에 잠재되어 있던 힘을 불러냈지요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그럼, 테레시스, 당신은 과연 이를 느꼈나요? 제가 베푼 은혜에 기뻐하고 있나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그 불순한 피에서, 어느 정도나 되는 힘이 흘러나올 수 있을까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "결말이 가까워지니, 당신의 기분도 들뜨고 있나 보군."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "약점을 잘 숨기는 게 좋을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "아니면, 내가 굳이 이를 상기시켜 주길 바라나?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "훗."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "당신을 위해 의식의 마지막을 완성해 드리지요, 오만한 섭정왕이시여."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "하지만 이는 당신 남매의 왜소한 포부를 위해서가 아니랍니다. 당신들은 항상 그 카즈델이란 허명을 지닌 이동도시를 바라보고 있더군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "이는 그저 기나긴 고통의 길 중간에 있는 또 하나의 쉼터일 뿐이지요."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "테레시아는 준비되었다."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "더 샤드 또한 빅토리아가 상상조차 못할 힘을 발휘해 낼 예정이고."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "그 해골은 외부 캠프의 허브에서 기다리고 있으니, 거기를 통해 브렌트우드로 갈 수 있을 거다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……흥분되는군요, 그렇지 않나요? 테레시스, 당신은 항상 그토록 무미건조한 얼굴을 하고 있군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "저는 이미 보았답니다. 지평선 너머로부터 솟아오르는 검은 빛이, 마치 흑요석으로 된 벽처럼 진정한 성을 쌓아가는 것을."
    },
    {
      "type": "dialogue",
      "speakerName": "테레시스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……훗. 당신은 저를 조급하다고 비웃지만, 당신이야말로 침묵으로 속마음을 가리고 있는 게 아닌가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "늦지 않게 돌아와, 그 성대한 장면을 목도할 수 있다면 좋겠군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "만약 당신이 정말로 이 대지를 다시 빚어낼 힘, 살카즈가 처음으로 접촉했던 그…… '오리지늄'을 찾아낼 수 있다면 말이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그럼 저는 기꺼이 당신을 위해, 카즈델의 이름을 제가 닿는 모든 땅에 뿌려 드리지요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "뱀파이어 생귀나르시여, 베헤모스의 표류가 곧 종료되고, 저희는 브렌트우드 부근의 기착지에 도착할 예정입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "마을은 이미 빅토리아인들에게 함락되었고, 군주님의 피조물들은 지금 그들에게 소탕당하고 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……피조물?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그 미개한 버러지들은 그저 선혈의 왕정을 섬기는 아이들이 결정에 주문을 그리려 할 때, 무심코 흘린 몇 방울의 피에 불과하답니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "빅토리아인들이 자신의 '승리'를 마음껏 축하하도록 두지요."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "제가 오해했습니다. 죄송합니다, 군주시여."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "울술라라고 했었나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "……그렇습니다, 군주시여."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "당신의 혈액 속에는 알코올이 너무 많이 섞여 있군요. 그 탐욕과 향락은 용서하겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "하지만 당신의 망설임은, 정말이지 실망스럽군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "저라면 그 망설임을 씻겨내 줄 수 있습니다, '소령'."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "……호의에 감사드립니다, 뱀파이어 생귀나르시여. 저 스스로…… 처리할 수 있습니다. 바로잡을 수 있도록…… 노력하겠습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "울술라…… 울술라."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "시간 도둑 울술라. 누구나 다 아는 이야기지요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "하, '울술라'가 이 해골의 고삐를 잡는다니, 재밌네요."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "우연일 뿐입니다, 군주시여. 제가 스스로의 이름을 지을 땐, 정말로 영웅처럼 이렇게 될 줄은……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "영웅?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "울술라는 겁쟁이였답니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "심지어 이 베헤모스의 두 눈을 직시할 수조차도 없었고, 그저 베헤모스가 일으킨 난류 속에 숨어 환상에 빠진 사람 몇몇을 간신히 깨우는 것밖에 할 수 없었죠."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그래서 저는 그에게 그런 임무를 주었답니다. 물론, 그렇기에 그는 “수많은 사람들을 구해냈죠”."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "드디어 저를 알아본 건가요?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "곧 도착합니다, 뱀파이어 생귀나르시여."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "다소간의 환각이 있을 수 있으니……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "따로 알려 줄 필요는 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "이 자와는, 당신보다 훨씬 오래 교제해왔으니까요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "(고대의 살카즈어) 그대들은 피땀을 흘려 이 회백색의 카즈델을 지어 올린 덕분에, 살카즈는 다시 한번 고향을 얻었지요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "(고대의 살카즈어) 그러나 그대들은 고향의 협소함 때문에 분노한 적이 있지 않나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "(고대의 살카즈어) 이종족의 침략으로 인해 티카즈는 고향을 잃었지요. 그리하여 그대들은 물러나기 시작했습니다, 그대들의 고향이라 부를 수 있던 것들을 점점 축소시키고 왜곡하면서요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "(고대의 살카즈어) 평원으로 내몰릴 때까지, 지정된 땅에서만 살아야 할 때까지, 그 이름으로만 자신들의 도시를, 마을을 부르기에 이르기까지."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "(고대의 살카즈어) 그것이 바로 살카즈가 나약해지기 시작한 시발점입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "(고대의 살카즈어) 그리고 지금, 저는 그 종착점 앞에서 과거를 돌아보았습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "환상이 끝났습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "이 해골은 이미 둥지로 돌아왔군요."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "……뱀파이어 생귀나르시여. 한 가지, 말씀드려야할 책임이 있습니다. 브렌트우드의 핵심 마법진을 장악한 부대가 아직도 근처에 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "놈들 또한 해골이 이동할 때 남긴 흔적에 대해 아는 바가 있으니, 저희의 귀환은 이미 발각됐으리라 생각됩니다."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "군주님의 힘을 의심하는 것은 아니지만, 그 적들 중에는 어쩌면……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "상관 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "우리의 적이 의식의 노드를 파괴했단 말인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "이 해골이 전장에 투하한 마법진들은, 애초부터 그저 진홍빛 왕정이 뻗은 촉수의 말단이었을 뿐입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "됐습니다, 이미 끝에 다다랐으니……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그럼, 제가 친히 이 고대 의식의 중심이 되도록 하지요……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "'추방자'여, 관을 쓴 사냥꾼이자, 우리의 첫 마왕이시여."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "만약 일만 년 전 당신의 영혼이 아직도 살카즈의 영혼에 깃들어 있다면……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "만약 당신께서 여전히 저희를 지켜보고 계신다면, 여전히 무너진 고향의 후손들을 지켜보고 계신다면……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "만약 그 번번히 왜곡되고 덧칠되어 온, 요원한 전설이 허구가 아니라면……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그렇다면."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "부디 그 요람 속의 고난을 다시 강림시켜 주소서."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "부디 저희로 하여금…… 티카즈의 잃어버린 운명을 되찾을 수 있게 하소서."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "……예상대로, 빅토리아인들이 현재 이곳을 공격하고 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "가능한 한 의식을 완성할 시간을 벌어보도록 하겠습니다, 뱀파이어 생귀나르시여."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "빅토리아인? 훗."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "테레시스, 제게 참으로 예상치 못한 기쁨을 남겨 두셨군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "아니, 아니에요. 울술라라 불리는 레이디여. 우리가 마주해야 할 것은 '빅토리아인' 같은 게 아닙니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그들은 지금 이 순간을 목도하기에 걸맞는 우리의 손님이지요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "또 다른 순수한 피를 가진 자, 아직 성숙하지 못한 종."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그리고, 찬탈당한 '마왕'."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "……그것이 누구든, 군사위원회의 계획은 필히 실행되어야 합니다."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "베헤모스와 저 사이의 연결을 강화하여, 저들이 이곳에 오지 못하도록 최대한 막도록 하겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "울술라",
      "speakerId": null,
      "text": "뱀파이어 생귀나르시여, 부디……"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그대에겐 아직 제게 제안을 할 자격이 없어요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "아, 정말로 보고 싶군요…… 그들이 이번에는 과연 제게 어떤 진부한 헛소리들을 내뱉고, 또 어떠한 절망의 순간을 보여줄지."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그럼, '소령'. 당신은 여기에 남도록 하세요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그대의 그 딱히 중요하지 않은 일은 이미 끝났습니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "text": "'파멸'."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "당신은 아직도 그 가여운 문장과 거짓된 주문을 붙잡고 있군요, 밴시."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "왜 진정으로 당신에게 속한, 진정으로 당신의 피에 쌓인 권력을 직시하지 않는 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그대가 노래할 수 있는 엘레지는 지금쯤 더욱 감미로워졌어야 하는 거 아닌가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "하지만 당신은 침묵했죠, 당신은 '한 번도 입을 열지 않았어요'."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "뱀파이어."
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "지금 도대체 무엇과 이어지려 하는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "이건 절대 살카즈의 문헌에 기록된 의식이 아니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "지금 깨어나고 있는 저건, 도대체…… 뭐죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "저건…… 제게 보이는 건, 한 알의…… '씨앗'이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "당신들은…… 만 년 전의 주술로 씨앗을 깨워내, 전장에 그려진 마법진으로 영양을 공급하고 더 샤드의 폭풍으로 이를 부릴 생각이겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "……절대 용납할 수 없어요!"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "런디니움이 완전히 파괴될 거라고요! 오리지늄밖에 남지 않은 폐허가 될 거란 말이에요!"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "아니, 거기서 끝이 아니에요…… 이 정도 규모, 이 정도의 힘이라면…… 거기에서 그치지 않고……"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "살카즈의 복수가 온 테라를 심연으로 끌어내릴 거예요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "……'복수'라."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "카우투스, 당신은 여전히 스스로를 살카즈의 마왕이라 주장하지만, 그 관점은 정말이지 편견으로 가득 찼군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "이백 년 전, 테라 각국은 연합하여 카즈델을 한 차례 멸망시켰죠."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그리고 지금, 그대는 저희가 빅토리아의 수도를 고통과 파멸에 바치려는 것이 그저 이백 년 전의 복수에 불과하다고 생각하는 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "하아…… 또 다시 저를 실망하게 만드는군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "검은 왕관은 여전히 그대의 머리 위에 머물러 있지요, 이는 분명 '마왕'이 저지른 또 하나의 터무니없는 짓입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "적 하나를 살해하는 것과 국가 하나를 도륙하는 것, 도시 하나를 파멸시키는 것과 문화 하나를 지워버리는 것엔 아무런 차이가 없답니다. 살카즈에게, 이러한 것들은 저항이라고 불리기엔 아직 한참 멀었죠."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "저희가 이 런디니움이란 이종족의 수도에 온 것은, 애초부터 이런 '반격'을 위해서가 아닙니다."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "'씨앗'이라고요? 나쁘지 않은 표현이로군요."
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "그 씨앗이 어떠한 광경을 불러올지 지켜보도록 하세요."
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "편협한 건 바로 너다, 뱀파이어."
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "무슨 말로 치장하든, 너희들이 저지른 일의 본질을 바꿀 수는 없다."
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "내가 '한 번도 입을 열지 않았다'고?"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "걱정 마라, 뱀파이어. 이제 들을 수 있을 테니."
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "“결박하라, 무거운 형틀이 네 육체에 떨어질 것이다.”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "아미야!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "어째서, 이렇게 간단히……"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "……아니, 뭔가 잘못됐어요!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "……저 자의 피가!"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": null,
      "text": "의식의 마지막 단계를 완성하려고 하고 있어요!"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "……! 런디니움에 남겨진 주문이 방금 그 순간 흔적도 없이 붕괴했다."
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "런디니움에 무슨 일이 일어난 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": null,
      "text": "아미야, 어서 전투를 끝내라. 무언가가 느껴……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": null,
      "text": "너무 서두르지 마시지요, 손님 여러분들."
