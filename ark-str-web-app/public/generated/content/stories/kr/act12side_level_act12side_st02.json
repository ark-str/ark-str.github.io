  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "(사라졌어?!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "(나를 발견하지 못했겠지.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "(평소에도 반정찰 태세를 유지하게 훈련받나?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "(아니면 이 일대에 발견되면 안 될 곳이라도 있다는 건가?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "(……관두자, 일단 첸 훼이지에부터 찾아야지.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "우선 2라운드 진출 팀을 발표하겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "이번 그랑프리의 1라운드에서 총 15개 팀이 진출했는데요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "용쟁쥐투 팀, 역시 최고의 인기를 끌고 있는 팀이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "그리고 그레이 페더 팀, 팩맨 팀, 허니 홀리데이 팀, 비지니스 제휴 문의 5453-46235 팀……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "매니저",
      "text": "수고했어요. D.D.D. 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "매니저",
      "text": "익숙하지 않은 일을 시켜서 정말 미안해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "괜찮아. 높으신 분 체면도 봐 드려야지…… 이런 건 이미 익숙해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "처음에는 확실히 적응이 안 됐는데, 하다 보니 DJ 할 때랑 느낌이 비슷하더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "DJ는 음악으로 분위기를 띄우지만 여기는 말발로 띄워야 하는 게 다를 뿐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "매니저",
      "text": "그렇게 생각한다니 다행이에요. 하지만 정말 하고 싶지 않으면 내가 최선을 다해 거절해 볼게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "솔직히 말해서 판을 깔아줬으니 하긴 하는 거지만, 가끔은 과거의 나라면 절대 하지 않았을 말을 할 때가 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "너무 위험해.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "그건 그렇고, 저 용쟁쥐투라는 팀 봤어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "그 두 여자 진짜 대단하더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "매니저",
      "text": "아, 확실히 그래요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "그 두 사람을 보고 있으면 나도 모르게 빨려드는 느낌이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "그 여자들을 위해 곡을 쓰고 싶을 정도라니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "text": "특등석에서 그 둘의 경기를 볼 수만 있다면, 좀 더 견딜 수 있을 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "매니저",
      "text": "하하, 그럼 정말 좋죠.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아가씨, 정말 궁금해서 그러는데…… 경기가 끝났는데 넌 오히려 더 신이 났네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "며칠 동안 들떠서 여기저기 다니는 걸 보면 단순히 구경만은 아닌 것 같고, 대체 뭐가 그렇게 재밌는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "구경하는 것도 맞고, 다른 목적이 있기도 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "다른 목적?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이 도시에 대해 알고 싶어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 도시를? 그건 왜?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이 도시의 담장 밖은 볼리바르, 세 정부가 할거하는 나라야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "라이타니엔이 지지하는 싱가스 왕조, 컬럼비아가 지지하는 연립정부, 두 정부에 저항하기 위해 일어선 '진정한 볼리바르인'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "우리가 여기 있는 동안에도 세 정부 사이의 크고 작은 마찰은 끊임없이 발생하고 있을지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "그렇지만 이 도시는, 우리가 오면서 봐왔던 다른 볼리바르 도시들과는 완전히 달라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이 도시는 '번화' 그 이상이야. 난 이렇게까지 사치스럽고 유흥에 미친 도시는 본 적 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이런 나라에 어떻게 이런 도시가 생겼을까? 넌 궁금하지도 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "확실히 궁금하긴 하지만, 여긴 용문도 아니고 깊이 파고드는 것도 귀찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "너는 말이야, 뭐든 다 알면서 용문이나 첸과 관계없으면 꼭 무심한 척하더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "습관 돼서 그래. 그런데 아가씨, 네가 그렇게 말하는 건 분명 뭔가 이상하다는 거겠지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "만약 이 도시가 어둡고 암울했다면 전혀 이상하지 않았을 거야. 하지만 가증스러울 정도로 활력이 넘쳐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "도시마다 심장이 있다고 치면 용문의 심장은 생기로 가득 차 있거든. 신선하고 건강한 피가 끊임없이 공급되면서 심장이 건강하게 뛸 수 있도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "하지만 이 도솔레스의 심장은 너무 이상해. 혼탁한 검은 피가 계속해서 공급되고 있는데 심장이 약해지기는커녕 오히려 건강한 용문보다도 더 강하게 뛰고 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "용문보다 더 생명력이 넘치는 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "더군다나 용문은 외부 세력의 견제를 적게 받지만, 이 도시는 정세가 복잡한 볼리바르 안에 있다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "난 이게 너무 이상해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아, 그 비유 너무 적절하다. 이해가 쏙쏙 되는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그러니까 이런 모습으로 변하면 안 되는데도 이렇게 변해버린 이유가 궁금하다는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이 도시는 범죄를 용인하고 도박을 부추기지. 이곳 생활은 환락과 방탕 그 자체야. 하루아침에 부자가 되거나 파산하는 일이 비일비재해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이건 사람들에게 이 도시는 관광업과 유흥산업이 유일한 수입원이라는 가짜 이미지를 심어주거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "그런데 평범한 유흥산업만으로는 이 도시를 절대 운영할 수 없어. 그러니까 어쩔 수 없이 유흥산업을 넘어 범죄까지 용인하게 되고, 그 결과 다양한 사람들이 몰려든 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "결국 이 도시는 허상에 불과하고, 붕괴 직전의 번영으로 쌓아 올렸단 얘기지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "말은 되는 것 같은데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "진실은 과연 그럴까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "음…… 아가씨, 내 생각엔 너무 오버하는 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "뭐라고?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그렇게 생각하는 것도 무리가 아니야. 너 같은 부잣집 아가씨한테는 이 도시의 운영 방식이 낯선 데다가 야만적으로 보일 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하지만 내가 보기엔 매우 친근해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "너도 알겠지만, 극동도 볼리바르랑 별 차이 없어. 밖에서는 미친 듯이 싸우지만, 안에 있는 높은 분들은 아무렇지 않은 척하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 도시는 내가 아는 그 도시들과 본질적으론 별 차이 없어 보여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아, 하지만 듣고 보니, 유흥산업과 관광업만으로 이 도시를 운영한다는 것은 불가능할 거 같긴 하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "극동에도 그런 도시는 없을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그러니까 빨리 말해줘, 아가씨. 대체 뭘 발견했는지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "말하기 싫어졌어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아 참…… 그러지 말고…… 아가씨, 내가 잘못했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "저기요, 홀리데이 스무디 하나, 이 아가씨 앞에 놔주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "종업원",
      "text": "알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "자, 아가씨, 화 풀어, 화 풀어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "흥. 너 우리가 이 도시에 들어올 때 기억해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "네 카드를 보여줬잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "그건 미리 준비했기 때문이야. 용문이 이 도시와 무역협정을 맺었으니까, 내 카드를 이용해 바로 들어올 수 있었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "정말이지, 그러니까 나 말고, 다른 사람 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하긴, 확실히 몇몇 초라해 보이는 사람이 들어가려니까, 경비가 검문한 뒤에야 들여보내 줬던 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "게다가 경비는 친절하게도 그 사람들한테 길까지 가르쳐 줬지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "그리고 도심 밖에 있는 수많은 공장들, 그런 것도 봤지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "봤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "바로 그거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아, 이해했다. 볼리바르 같은 곳은 정세가 하루하루 다르다 보니 무역에 의지해 생필품을 조달받는 건 무척 위험하다는 거네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 도시는 스스로 자기 생명줄을 잡고 있어야 하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그 가난한 사람들이 바로 공장에서 일하는 사람들이었고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "맞아, 며칠 전 밤에 바에서 잠깐 알아봤는데, 여기 공장은 월급을 엄청 많이 준대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "그래서 다른 도시 사람들이 산 넘고 물 건너, 전쟁터까지 피해 가며 여기로 와서 일하려는 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "도솔레스에서 자리를 잡으면 바깥보다는 돈이 좀 있는 셈이 된다 이거구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "맞아. 물론 연립정부나 싱가스 왕조 밑에서 전쟁해서 버는 돈보다는 훨씬 못 미치지만, 적어도 여긴 안전하잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "하하, 어두운 골목에서 맞아 죽거나 전장에서 죽는 것 중 어느 쪽이 더 안전하다고 말하긴 어렵겠지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "내 말 끊지 마. 그리고 지난 기사를 찾아봤는데 도솔레스는 볼리바르에서 유흥산업 외에도 술, 커피, 설탕으로도 아주 유명하더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "연립정부든 싱가스든, 진정한 볼리바르인이든 온 볼리바르의 거물들이 모두 도솔레스에서 이것들을 사들여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "볼리바르는 말할 것도 없고. 우리 집만 해도 볼리바르산 테킬라와 커피가 널렸어. 생산지는 기억이 잘 나지 않지만, 여기 공장의 라벨은 확실히 본 적 있거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그리고 경비들은 장비도 좋은데다 기력도 흘러넘치는 것 같더라고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "즉, 유흥산업과 관광업 외에 그 누구도 무시할 수 없는 사치품 산업을 꽉 쥐고 있었던 건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "무슨 말인지 알겠어. 이 도시는 겉으로는 혼란스러워 보여도 사실은 기반이 튼튼하고, 용문처럼 질서정연한 도시로 변모할 잠재력이 충분하다는 거네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "재밌네, 나도 흥미가 생기기 시작했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "아깐 나보고 오버한다더니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "스와이어 아가씨의 높은 안목과 넓은 식견을 어찌 나 같은 말단 따위가 비교할 수 있겠습니까? 부디 넓은 아량으로 그냥 넘어가 주시옵소서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "흥, 하여튼 입만 살아가지고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그런데 아가씨, 내 경험상 네가 원하는 답은 의외로 간단할 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "어떤 일이 있더라도 자신의 통제를 벗어나는 혼란 요소를 허용할 지배자는 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 도시가 지금의 모습을 유지하는 이상, 우리가 생각하는 혼란은 이곳의 지배자 입장에서는 문제조차 되지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그러니까, 이 도시에는 분명히 강하면서도 광적인 집권자가 있을 거란 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "내 생각도 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "이 도시의 시장은 칸델라 산체스야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "용문과 도솔레스 무역 거래에 우리 집도 참여했지만, 그전까진 그 시장과 이 도시에 대해 제대로 몰랐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "그러니까 자기 도시를 이런 모습으로 만든 사람이 도대체 어떤 사람인지 정말 궁금하다는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그럼 직접 찾아가서 네 신분을 밝히면 되잖아. 그쪽도 잘 대접해 주겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "안 돼. 거짓말은 할 수 있겠지만 결국은 드러날 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "가자, 구경할 곳이 많아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스와이어",
      "text": "오늘은 교외 지역에 있는 공장을 보러 가야 해. 일어나자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "종업원",
      "text": "손님, 주문하신 스무디 나왔습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아가씨 잠깐, 스무디 나왔어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아아, 가끔 보면 첸이랑 똑같다니까. 성급하기는.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "내가 들고 가면서 마시지 뭐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "아가씨, 같이 가!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "(초록색 머리에 뿔…… 설마 호시구마?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "뭘 보고 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아냐, 아는 사람을 본 것 같아서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "용문 사람? 어디?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "사람이 너무 많아서 금방 놓쳤어. 아니야, 여기 있을 리가 없지. 내가 잘못 봤을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그보다 너, 여기서 만나자고 약속해놓고 왜 이제 와?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "길을 좀 헤맸어. 먼저 들어가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "여긴 저번에 네가 소란 피우던 그 바 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "지금은 내 아지트야, 들어가자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "카지노 사장",
      "text": "누님, 어쩐 일로 오셨습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "자리 좀 비켜줘. 얘랑 얘기 좀 하게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카지노 부하",
      "text": "넵!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "위스키 한 잔.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "난 탄산수면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "카지노 사장",
      "text": "알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그래서, 용건이 뭔데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "술 마시자고 날 찾아온 건 아닐 테고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "경기 중에 한 팀을 쫓다가 그 팀이 주민 구역에 폭탄을 대량으로 설치하는 걸 봤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그 사람들 말하는 걸 들어봤을 때, 적어도 서너 팀이 같은 일을 하고 있는 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "너 방금……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "아, 에르네스토를 의심하고 있구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "넌 의심 안 해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "하긴, 상대가 움직이는 규모가 커. 한 번의 밀수로 칸델라 시장님의 귀에까지 들어갔을 리 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "분명 중간에서 정보를 조작한 놈이 있을 거야. 에르네스토일 가능성이 커. 에르네스토가 아니라도 누군가 했겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "나 혼자서는 일일이 확인할 수 없었지만, 적어도 폭탄 1개는 지금 내 가방 안에 있거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "한 번 만져 볼래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……됐어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "어느 팀이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그레이 페더.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그 팀이라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "나도 의외야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……즉, 걔네들이 조직적으로, 계획적으로 움직인단 말이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "폭탄까지 사용하는 걸 보면 이미 평범한 계획은 아닌 것 같고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "어떡할 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "일단 칸델라 시장님에게 알려야겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "정말 그렇게 할 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "무슨 뜻이지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "모르는 척하지 마, 첸 훼이지에. 이 화려한 도시가 어떻게 돌아가는지 알고 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "칸델라는 이 도시의 시장임에도, 모든 것을 방임하고 있는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "이런 도시, 이런 사람을 정말 도울 가치가 있다고 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……그렇다고 폭탄을 설치한 놈들을 그냥 두자는 거라면, 차라리 나랑 한 판 더 싸우자. 이번은 대련이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그 반대야, 첸 훼이지에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "난 이 도시가 어떤 모습인지, 어떤 모습으로 변할지에는 관심이 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "난 웨이 장관님을 대신해 왔으니 내 관심은 오직 웨이 장관님의 이미지야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "애초에 난 칸델라 시장님의 임무를 완수하는 것 외에 다른 옵션은 없었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "오히려 나는 네가 더 걱정이야. 너의 그 넘치는 정의감 때문에 나랑 대립하게 될까 봐.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "첸은 갑자기 고개를 들어 린 위시아를 똑바로 바라보았다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "무슨 뜻이야?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "린 위시아도 전혀 양보하는 기색이 없이 똑같이 쳐다보았다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "내 말은 네가 만난 적도 없는 사람들에게 감정이 있는 척 꾸미지 말란 말이야, 첸 훼이지에.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "넌 이 도시와 관련된 모든 것에 참견할 자격도 없고, 나를 탓할 자격은 더더욱 없어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그건 변명의 이유가 못 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "나도 변명하려는 게 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "언젠가는 너를 법으로 처리할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "훗.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "무슨 명목으로? 전 용문근위국 특별감찰팀 팀장, 첸 훼이지에 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "하늘의 도리로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그래도 정의보다는 듣기 좋네. 정말 그런 날이 온다면 목을 씻고 기다릴게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "다른 볼일 또 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "없어. 네가 뭘 하든 난 상관하지 않을 거야. 나도 내 방식대로 처리할 거고. 그냥 이런 일이 있었다는 걸 알려준 것뿐이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이 일은 아는 사람이 적을수록 좋아. 하지만 적어도 칸델라 시장님에게는 알려야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "알린다 해도 칸델라 시장님이 할 수 있는 게 딱히 없을걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "상대방의 목적도 명확하지 않고. 조사하든 체포를 하든 오히려 상대방을 놀라게 할 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그리고, 휴대폰 쓰지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "내가 그것도 모를까 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "훗, 하긴, 도청 제일 잘하는 건 경찰들이니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "진짜 나랑 싸우고 싶나 보네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그럴 생각은 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "그럼 칸델라 시장님한테 가봐. 나는 해야 할 일이 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그러지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "text": "……너랑 손을 잡는 날이 오다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "그건 내 대사야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "실력도 없으면서 잘난 척 해봐야 무슨 의미가 있겠어…… 훗.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "오늘은 영업 안 합니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "낚싯대 사러 왔어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "어, 들어와.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "오빠, 매일 암호 바꾸는 거 안 하면 안 돼? 이젠 외우기도 힘들어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "안 돼.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "라파엘라, 경계를 늦춰선 안 돼. 이번에 평범한 무기 밀수로 위장하려고 내가 얼마나 고생했는지 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "칸델라 시장이 뭔가 냄새를 맡기라도 했다면, 우리는 진작에 끝장났다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "이왕 하는 거 철저하게 해야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "치, 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "널 혼내는 게 아니야. 네가 어리숙하긴 해도 해야 할 일은 잘하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "내가 화나는 건 뭐가 중요한지 모르는 멍청이들 때문이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "이 도시는 유흥에 치중된 게 맞아. 하지만 유흥만으로 어떻게 볼리바르에서 기반을 단단히 다지겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "내가 어리숙하다고 뭐라 할 땐 언제고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "설마 아니라는 거야? 내 사랑하는 동생아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "흥.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "그런데 방금 누가 나를 미행하는 느낌이 들었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "정말?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "확실하진 않지만 그런 느낌이 들었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "경기 팀 쪽에도 평소에 조심하라고 말 해둘게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "……아니다. 걔들은 임무 외에는 여기 사는 사람들과 별 차이 없어. 오히려 뭔가를 알아내긴 힘들 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그래서 임무 진척은 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "주민 구역에 폭탄을 모두 설치했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "들키진 않았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "중간에 오빠네 팀 보라색 머리 그 사람을 만났는데, 오빠가 말한 대로 정면충돌은 피했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "……그 여자 반응은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "딱히 우리를 따라다니지는 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "나를 찾아오지 않은 걸 보니 확실히 눈치 못 챈 것 같네……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "아니야, 장담 못 해. 그 여자는 첸 씨보다 나를 더 안 믿어. 오히려 눈치챘는데 일부러 숨기는 걸 수도 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그렇지만 눈치챘더라도 섣불리 움직이진 않을 테고……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그 둘은 분명 같이 움직이지 않을 텐데. 하아, 한 번에 두 사람을 감시할 순 없으니…… 번거롭게 됐네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "어, 난데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "병사",
      "text": "무슨 일이십니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "칸델라 시장이 경기 구역에 대해 수색을 지시한다면, 그 즉시 나랑 아버지한테도 알려줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "병사",
      "text": "알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "후, 일단은 이 정도로 하자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "진출 상황은 모두 봤어. 40개 팀 중 우리 쪽 12개 팀에서 9개 팀이 진출했어. 예상했던 거랑 비슷하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "응. 그 파란 머리가 끼어들지만 않았어도 한두 팀은 더 처리할 수 있었을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "눈에 띄는 순금으로 다른 팀을 유인해 처리하고 우리 팀의 진출률을 높이는 건 원래부터 효과적인 방법은 아니었어. 이 정도면 훌륭해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "1라운드에서 성공했으면 2라운드는 다른 팀을 방해만 하면 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "2라운드는 시장 부하들이 지름길마다 매복해 있으니 폭탄을 설치하는 게 쉽지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "2라운드가 끝나고 배에 오르는 팀에는 우리 쪽 사람이 많을수록 유리해. 그게 이번 2라운드의 목적이야, 기억나지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "진짜, 바보 취급 하지 말라고!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "만일을 대비해서 그래. 만일을.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "참, 계획이 변동됐어. 마침 왔으니 알려 줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "왜? 그 두 외지인이 그렇게 대단해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "응. 걔네 둘, 좀 지나치다 싶을 정도로 대단해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "그럼 처리할 거야? 그 두 사람.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "아니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "첫째, 치러야 할 대가가 너무 높아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "둘째…… 그 사람들, 좋은 사람들이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "좋은 사람?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "응. 좋은 사람.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "더 일찍 그 여자들을 만났더라면, 우리를 도와달라고 설득하고 싶었을 정도로.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "도와줄까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "몰라, 어쨌든 이제는 불가능해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그 사람들이 배에 올라 아버지한테 접근하는 게 더 위험할 수도 있어. 최대한 다른 일로 방해할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "결과적으로 나는 배에 오르지 못할 수도 있지만, 그땐 육지에서 협력해 줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "내 도움이 필요해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "필요하면 부를게. 그래서 미리 말하는 거고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "알았어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "가벼운 얘기로 넘어갈까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그러고 보니 라파엘라, 너도 이 도시에서 꽤 오래 살았는데, '도솔레스'라는 이름의 유래에 대해서는 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "응? 들어본 적 없는데…… '투 선 시티'라고도 하니까 혹시 2개의 태양을 의미하는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "맞아, 그럼 그게 어느 태양을 의미할까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "음…… 하늘 위의 태양?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그건 너무 뻔하잖아. 고개만 들면 볼 수 있는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "두 번째는…… 물속의 태양?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "대단한데, 난 못 맞힐 줄 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "이 도시의 바다는 하늘의 태양을 품고 있지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "아빠가 알려준 적 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "그럼 이 도시 이름을 '트레솔레스', '쓰리 선 시티'로 바꿀 뻔한 것도 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "응? 세 개의 태양이 떠오르는 도시?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "웅, 그럼 세 번째 태양은 뭘까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "세 번째는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "설마 시장 자신을 가리키는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "하하하, 그런 말도 있긴 하지. 칸델라 시장은 이 도시의 태양 같은 존재니까. 이 도시가 존재할 수 있는 이유는 전적으로 칸델라 시장이 있기 때문이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "하지만 틀렸어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "엥? 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "시장은 오만한 사람이긴 하지만 그래도 자신을 태양에 비교하지는 않아. 왜냐하면 그것보다 자신이 더 위라고 생각하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "어떻게 자신을 다른 두 태양과 같이 거론하겠어? 3개의 태양 모두 자기 거라 말할걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "그럼 세 번째 태양은 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "답은 간단해. 네 아버지의 배에 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "나한테는 양아빠야. 오빠의 아빠라고 해야 맞는 거지…… 아, 설마 그 귀여운 황금 조각상?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "하하, 맞아. 그게 바로 이 도시의 세 번째 태양이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "다른 사람들이 겨우 칸델라 시장을 설득해서 말렸대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "좀 시시한데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "이 도시에 신나는 게 뭐가 있겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "하지만 오빠는 이곳 생활을 즐기고 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "내가 즐기고 있는 것 같아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "최근 몇 년간 시장 일을 도우면서 무척 즐거워 보였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "정말 그런 거라면 아버지를 왜 돕겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "몰라. 난 오빠가 안 도울 거라고 생각했거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "하아…… 어쩜 네 직감은 틀린 적이 없니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라파엘라",
      "text": "치, 아까는 어리숙하다더니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "하하하.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에르네스토",
      "text": "이제 경기 준비하러 가자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
