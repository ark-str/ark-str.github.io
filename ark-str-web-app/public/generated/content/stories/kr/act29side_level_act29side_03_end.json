    {
      "type": "dialogue",
      "speakerName": "게르하르트",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "그래서 저는 고탑 캐스터의 신분을 버리고 학자가 되기로 한 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "난폭한 노인",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
