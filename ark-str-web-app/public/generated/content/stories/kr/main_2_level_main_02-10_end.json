  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "큭…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "하아, 하아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더, 괜찮나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "크윽, 이놈들 확실히… 강하군!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더, W가 있던 쪽은 정리됐다는 통신이 들어왔다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "목표를 탈취하는 데 성공했다고 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…W가 성공했다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그래, 저쪽 기습은 순조로웠던 모양이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그럼 우리도 이제 퇴각하면 되는 건가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "탈룰라에게 신호를 보내라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "알았다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…퇴각한다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "흥, 로도스 아일랜드의 겁쟁이 녀석들…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "다음에 만났을 때가 너희 마지막이 될 거다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…리유니온이 퇴각하고 있는데요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "정말 신속하네. 마치 원래부터 정해져 있던 계획인 것처럼 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그렇게 큰소리치더니, 도망칠 때는 거의 육상 선수 수준이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "뭔가… 이상해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "이상하다니…",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "리유니온의 목적은 로도스 아일랜드가 아닐지도 모른다.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "생각해 보면, 리유니온은 그저 우리의 발을 묶어두기 위해 여기 있었는지도 몰라요…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "그렇다면…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "큰일이에요, 근위국이 위험할지도 몰라요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "…당장 첸 팀장님을 지원하러 가야겠어요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "프란카 씨, 주변 정찰팀을 소집해주세요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "리스캄 씨는 첸 팀장님께 연락을 부탁드려요!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "특별감찰팀 주력 부대는 어떻게 됐나! 왜 아직도 지원이 안 오는 거지!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "용문근위국 대원",
          "text": "리유니온 때문에 발이 묶였다는 통신이 들어왔습니다…!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "그럴 리 없어! 리유니온 같은 오합지졸 부대가 그런 전략을 수행할 수 있을 리가…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "용문근위국 대원",
          "text": "…게다가, 적은 단 한 명이라 합니다…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "설마……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
