          ]
        },
        {
          "label": "딱 잘라 말하기는 어렵다.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "쉐라",
              "speakerId": null,
              "text": "난 네가 낙후된 환경을 바꿔야만 한다고 얘기할 줄 알았어."
