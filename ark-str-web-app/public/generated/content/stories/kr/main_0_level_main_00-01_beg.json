{
  "server": "kr",
  "storyId": "main_0_level_main_00-01_beg",
  "groupId": "main_0",
  "stageId": "main_00-01",
  "title": "붕괴",
  "storyCode": "0-1",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_00-01_beg.txt",
  "sourceHash": "2992f39bcaeb36761d417cddb5f96f01dd091ae5417bd8cb3d1e1c2429b4b975",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "제길…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "대체 뭐가 어떻게 돌아가는 거지?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "건물 내부까지 샅샅이 뒤져라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성",
      "text": "그 아이를 놔 줘… 안 돼! 당신들은 대체…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "저항할 셈이냐? 이미 늦었다! 이 빌어먹을 체르노보그인 놈들아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "남성",
      "text": "빨리 도망쳐! 난 신경 쓰지 말고… 아이는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "엄마… 엄마…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병",
      "text": "시민은 신경 쓰지 말고 방어선을 사수해라! 가면 쓴 폭도들은 대체 얼마나 더 있는 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "놈들을 내버려 두지 마라! 계속해서 공격해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우르수스 헌병",
      "text": "지원군은 언제 오는 거지?! 이러다가는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "공격, 공격하라!!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이게 어떻게 된 거죠…?! 어, 어째서 리유니온이 여기를…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "몇 년 동안 얌전하더니 이제야 본색을 드러낸 건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "가, 감염자가…… 우르수스 시민을……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "대, 대체 왜지?! 감염자들도 잘 알 텐데! 우르수스 정부의 심기를 건드리면 일이 커질 거라는 걸…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아니, 놈들의 공격이 이 정도로 매서운 걸 보면… 이건 계획된 게 분명하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "박사를 구출한 구역도 기밀성이 높아 찾기 어려웠을 텐데… 거기까지 적이 침입한 걸 보면 더욱 확실해지지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "리유니온으로 인한 피해는 체르노보그 전역으로 퍼져있을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "제길… 이게 대체……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "쉿!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 A",
      "text": "도망친 체르노보그인은 없나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "찾고 있습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 A",
      "text": "한 놈도 놓치지 마라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 A",
      "text": "피도 눈물도 없는 체르노보그 놈들…… 내 아버지가 받았던 고통을 이제 네놈들도 맛보게 해주마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "(콜록…)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 A",
      "text": "무슨 소리지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "저쪽이다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "(윽!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "(리, 리유니온이…)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "(조용히!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "(으으…!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "여성",
      "text": "…흐윽…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 A",
      "text": "여기다! 찾았다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성",
      "text": "…아아아아!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성",
      "text": "아아… 아, 안 돼…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "이런 곳에 숨어있었나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "나와라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성",
      "text": "아, 아아…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "그런 곳에 숨어있으면 안 들킬 줄 알았나…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여성",
      "text": "죄, 죄송합니다! 죄송합니다!! 부, 부디 제 아들만은!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…리유니온을 공격해야 해요, 지금 당장.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "아미야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "도베르만 씨, 저도 위험하다는 건 알아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "하지만 리유니온이 퇴각할 때까지 기다리기엔… 시간이 너무 많이 지체됩니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "게다가 이 상황이 언제까지 이어질지도 알 수 없고요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그렇다면 지금 당장 적을 치는 것이 최선이에요. 그렇죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "알겠다, 네 지시에 따르지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "모든 오퍼레이터는 들어라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "리유니온은 아직 우리가 있다는 걸 눈치채지 못했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "신속하게 움직여서 단숨에 몰아붙이도록!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "{@nickname} 박사, 네가 팀을 편성해라. 네 능력을 증명해 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "지금 상황이라면, 여력을 남길 생각은 하지 않는 게 좋겠지.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "맡겨만 줘!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "간단하다. 금방 끝내지.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "훗.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "도베르만",
          "text": "아미야, 네게 맡기마.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "알겠습니다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "…\"피할 수 있는 싸움이라면, 침묵을 지키고……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "피할 수 없는 싸움이라면, 끝까지 싸워라!\"",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "로도스 아일랜드의 신조는… 단 한번도 변한 적이 없습니다!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
