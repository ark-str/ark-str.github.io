  "sourceHash": "db883e71af821ce916835f4307aea0fa5f0a944a36ff696ba97835131941d7c1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "어떻게 된 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "리유니온의 일개 소대를 처리했을 뿐인데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "형세가 완전히 역전된 것처럼 보이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그렇지만 일개 소대라고 해도, 그 덩치 큰 녀석한텐 꽤 애먹었잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "말도 안 돼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그렇게 많은 감염자가 흔적도 없이 사라질 수가 있나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "조금 전의 그 거대한 적은 그저 미끼에 불과했다는 말인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "적이 이렇게 짧은 시간에 이 구역에서 이탈했다는 말인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아니, 첸 팀장님이 적의 퇴로를 막고 계셨을 텐데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "도무지 모르겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그리고 여기… 좀 이상해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "잡초, 폐허, 모래언덕…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "어디를 봐도 매복하기 딱 좋은 장소인데,",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "아무것도 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "발자국도, 옷이 잡초에 스치는 소리도, 폭발물의 냄새도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "전혀 감이 안 와!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "펭귄 로지스틱스, 어떻게 좀 해봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "하나부터 열까지 다 이상하다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "잠깐 조용!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "무슨 소리지…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "…응?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "땅… 밑에서?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "아미야! 발밑을 봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "박사! 엎드려!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 녀석들… 정말 수단 방법을 가리지 않는군!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "뭐냐… 너 이 자식… 어떻게 내 공격을 막아낸 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 방패 '반야'는, 너 따위에게 뚫릴 물건이 아니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "글쎄… 뚫을 필요는 없을 것 같은데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "온도가 급상승하고 있어!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "손에 든 무기와 함께 자폭할 생각인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "박사! 어서 도망쳐! 그 거리에선…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 녀석……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "끝장내주마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아… 안 돼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "막아야 해…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "박사님을 다치게 할 수는 없어…!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "컥, 커헉…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…훌륭하군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너… 이 힘은 뭐지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "강하구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…커헉… 아프잖아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "이만한 힘을 갖고 있으면서…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…넌… 동포들의 고통을… 보고서도 모른 척했단 말이지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "용서… 못 해…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너희 같은 놈들은… 절대 용서 못 해…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "큭…!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "미샤",
      "text": "아…… 안 돼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
