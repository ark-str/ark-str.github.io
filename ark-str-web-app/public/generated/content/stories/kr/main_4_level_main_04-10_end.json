    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "반드시… 구해줄게!!"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "그러니까 기다리라고…"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "금방 갈 테니까!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "일어나!"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "으응…?"
