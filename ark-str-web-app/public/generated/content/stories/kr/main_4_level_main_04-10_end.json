      "speakerName": "메테오라이트",
      "speakerToken": "char_219_meteo_1#5",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "아무리 강해도… 너희는 아직 애들이라고!"
