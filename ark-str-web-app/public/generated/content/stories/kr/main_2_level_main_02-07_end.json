  "stageId": "main_02-07",
  "title": "위생관리",
  "storyCode": "2-7",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_02-07_end.txt",
