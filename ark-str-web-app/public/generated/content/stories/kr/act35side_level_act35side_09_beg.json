    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": "avg_npc_1479_1",
      "isRemote": false,
      "text": "답은 이미 말했다. 페페, 이제부터는 그대 자신의 힘으로 해야 한다."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": "avg_npc_1479_1",
