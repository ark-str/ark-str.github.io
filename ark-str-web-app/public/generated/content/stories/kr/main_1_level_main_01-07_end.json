  "sourceHash": "d632f4fc14d431285f8b687cdb016b99d9b6cbc6e9e12778f7a8044578026ba4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "하아… 하아… 하아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "해냈다…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "리유니온을 물리친 데다가…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "재앙도 확실히 약해지고 있다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "아직 상황이 좋아졌다고 속단하기엔 이르다… 다들 긴장을 늦추지 마라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "재앙이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "원래 있던 길은 무너진 폐허에 묻혀버렸어요. 건물들도 무너져서 길을 가로막고 있고요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "오리지늄이 생겨나기 시작한 건가…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "여기까지 왔는데, 이렇게 또 가로막혀버리다니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "만약 우리가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "…만약…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이스",
      "text": "왔군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "뭐가 말입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "리유니온? 설마 우리를 추적했던 건가?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메딕 오퍼레이터",
      "text": "리유니온이… 저렇게나 많다니…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "추적해 온 게… 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "녀석들은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "…기어 나온 거다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "광장, 길가, 건물… 폐허가 된 곳곳에서.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "이 정도나 남아있었을 줄이야, 후우……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "어쩐지 다 죽어가는 녀석들 빼곤, 재앙을 전혀 두려워하지 않더라니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "이 재앙으로… 크게 어림잡아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "저 녀석들의 절반 이상이 소멸했다고 해도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "나머지 인원만으로 우리를 처리하기엔 충분한 머릿수다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "멈추지 마라! 예정대로 퇴로를 따라 진격한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "사방이 트인 장소에서 멈추는 건 자살 행위다! 대형을 갖추는 건 광장 출구에 도착해서 해도 늦지 않아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "니어 씨…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "싸우는 것 외에 다른 선택지가 없어. 돌파구를 열고, 적의 혼란을 틈타 탈출하는 게 유일한 길이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "할 수 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "우리에겐 다른 길이 없어. 가능성은 희박하겠지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "녀석들의 수가 우리의 수십 배에 달하더라도, 놈들이 단순한 폭도에 불과하다면 로도스 아일랜드에도 기회는 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "허둥대지 마라! 전투를 준비해라! 방어 진형!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "…쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "이 정도의 머릿수라면… 정말로 체르노보그를 점령할 수 있을지도 모르겠군…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "너무 많다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "많아도…너무 많아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "리유니온은 대체… 어디서 이렇게 많은 감염자를 모은 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "이 포위망을 보면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "리유니온은 우리를 순순히 보내주진 않을 모양인 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "대, 대규모의 리유니온 병력이… 광장을 포위하고 있습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "적이 움직임을 멈췄습니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "적 한 명이 이쪽으로 옵니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "왜 혼자 이쪽으로 오는 거지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가드 오퍼레이터",
      "text": "사절을 보내는 건가…? 아니, 그럴 리가…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 사람은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "자료에 따르면…저 사람은 리유니온의…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "저 녀석에게서 불길한 냄새가 나는군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "…니어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "뭔지는 정확히 모르겠지만……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "저건… 강철과 유황 냄새다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "무언가 타오르는 냄새야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "혹시 그게 화염이라면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "로도스 아일랜드 전 대원… 경계 태세를 최대 레벨로 끌어올려 주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……저 사람이 바로……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "text": "리유니온의 폭군……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…탈룰라예요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "탈룰라",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "니어",
      "text": "온 땅을 태워버릴…… 화염이란 건가.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
