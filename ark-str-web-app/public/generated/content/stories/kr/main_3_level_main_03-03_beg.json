  "sourceHash": "0c9d8598e9352c65db086a9557df124f7e2c34d246896df37b026e86233b2eb6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "죽어라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "적은 둘 뿐이다! 가라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "뭘 주저하는 거냐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "벌써 동료가 스무 명도 넘게 당했어…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "저 둘은 평범한 녀석들이 아니야…!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "오른쪽 조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "엄호를 부탁한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그 녀석을 붙잡아! 내가 마무리한다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "쳇, 지금 이 녀석들까지 상대할 여유는 없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "다음에 한 잔 사는 거다?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "알았으니까 서둘러.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "오케이~!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "거기 오빠들~?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이 탄환은 선물이야, 잘 받아~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "탄환? 탄환이라니…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "윽… 으악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "대신 처리해 뒀어~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "고맙군.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "이, 이것들이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "저, 저 녀석의 칼은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "아, 미안.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "…평소에는 이도류거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "으, 으아악!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이제 전부 정리된 것 같네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "우리의 콤비네이션, 역시 끝내준다니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "놓치지 마라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "적의 증원이 대량으로 몰려온다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "이쪽에서 벌인 소동을 보고 달려온 것 같군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "아아아!!! 제길!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "어째서… 너희들, 대체 무슨 짓을 한 거냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "흐음, 개인적인 원한은 없는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "계약은 계약이라서 말야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "계약을 성실하게 이행하는 건 물류회사의 기본이지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "왼쪽.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "엉?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어, 어라?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "고, 고마워.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "그럼 내 오른쪽에 있는 적은 네게 맡기지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "뛰자. 슬슬 이동해야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "엑시아 씨, 곧 그쪽에 도착합니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "우리가 적의 주의를 끌게. 너희는 알아서 움직여!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그럼 두 분 모두 조심하세요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프란카 씨, 목표지점에는 도착하셨나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "여긴 오케이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "text": "리스캄과 디펜더 팀도 목표 지점에 도착했다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "모든 오퍼레이터 여러분, 잘 들으세요. 적의 스나이퍼가 지형을 이용하여 숨어있을 가능성이 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "각자 위치에서 경계하면서, 스나이퍼부터 공격해 주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그럼… 여러분, 기습을 준비해주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…임무 목표가 있을 수도 있으니, 주변 피해를 최소화하는 것도 잊지 마시고요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
