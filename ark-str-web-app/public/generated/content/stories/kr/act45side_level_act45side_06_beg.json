    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아이리스",
      "speakerId": "avg_338_iris_1",
      "isRemote": false,
      "text": "차가 갑자기 멈췄어요! 무슨 일이죠?!"
