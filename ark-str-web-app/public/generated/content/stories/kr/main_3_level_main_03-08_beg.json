  "groupId": "main_3",
  "stageId": "main_03-08",
  "title": "황혼",
  "storyCode": "3-8",
  "avgTag": "작전 전",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_03-08_beg.txt",
  "sourceHash": "61b4c282b6fed91cfd2311d696e0d15ffe770ece5cdb7c577b0153c8eeced165",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "큭! 적이 또 반격해온다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "지금 저 녀석들만 처리하면 우리가 이긴다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "지금은… 싸울 수밖에 없겠어.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "이 녀석들… 만만치 않은데!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "윽…! 저 방패, 젠장…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "맞아, 저 녀석은… 저 녀석은 근위국의…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "지금이라도 무기를 버리고 투항하면 기회를 주도록 하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "그러나 죽음을 재촉하고 싶은 녀석이 있다면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "네 말을 어떻게 믿으라는 거냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "속지 마라! 우르수스에서도… 투항한 감염자들은 있었어. 하지만 투항한 후에 한 명씩 차례대로… 결국에는 모두 처형당했지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그리고 나는 산처럼 쌓인 시체 속을 기어 나와서 간신히 살아남았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "너희가 우리를 없애기 위해… 해왔던 행동이 얼마나 비열했는지는 더 말할 필요도 없겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "너희는 우리 감염자들을 모조리 죽일 셈이잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "그렇다면 우리도 끝까지 싸울 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "덩치 큰 언니, 지금 무슨 말을 해도 저 녀석들은 듣지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "지금 저 녀석들은 용문의 착한 사람과, 우르수스의 나쁜 사람도 구분하지 못할 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "그곳에선… 아니, 어디든 똑같겠구나…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "비감염자와 감염자는 서로 위협하고 증오할 뿐이야. 그거 말곤 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "보아하니… 교섭은 결렬된 것 같군. 눈앞에 길이 열려 있는데도.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "길이라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "…우리가 뭘 할 수 있는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "너희는 뭘 할 수 있고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "저런 놈들과 이야기할 필요 없어! 스컬슈레더! 한꺼번에 처치해버리자!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "폭발인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "놈들이 사방에서 우리를 포위할 생각인가 봅니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이대로 있다간 측면이 버티지 못해… 반격한다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더! 내가 엄호하지! 이놈들만 잡으면 이 싸움도 끝이라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리유니온 멤버",
      "text": "스컬슈레더!!!!!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "반드시… 모두 함께…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "반드시…!!!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스컬슈레더",
      "text": "――――――――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "이제 시간이 얼마 남지 않았다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "호시구마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "준비는 되어 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "침착하게 행동해. 적에게 약점을 드러내지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "호시구마",
      "text": "적에게 기회를 줄 생각은 없다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "용문근위국 대원",
      "text": "놈들의 돌격에 주의하십시오!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "text": "아미야! 적에게 너무 다가가면 안 돼…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저, 저건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "박사님, 박사님… 전 어떻게 하면 좋을까요…",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "네가 해야 할 일을 하는 거다, 아미야.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "하지만 저는……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "죄송해요. 박사님…… 저……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "스컬슈레더",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "스컬슈레더",
          "text": "아……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "스컬슈레더",
          "text": "아미야…?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "어째서……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "당신이……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "이런 짓을……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "스컬슈레더",
          "text": "아미야… 이렇게 될 운명이었던 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "아미야! 뭘 하는 거야! 어서……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "전……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "쳇……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "첸 팀장님? 전……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "됐어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "역시……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "모든 것을 끝내야겠군.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……첸 팀장님……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "한 가지 충고해 두지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "지금부터는 모든 감염자를 똑같다고 생각해라. 저들은 모두 적이야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "운명이란 불공평한 법이다.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "원망하고 싶으면, 날 원망해라.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "첸",
          "text": "근위국, 공격하라!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
