    },
    {
      "type": "dialogue",
      "speakerName": "환영 석궁병",
      "text": "……저, 저게 뭐야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "환영 석궁병",
      "text": "그러니까 저건……",
