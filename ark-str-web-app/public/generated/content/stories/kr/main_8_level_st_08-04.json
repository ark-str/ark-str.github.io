    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "text": "힘이 필요하다면, 무언가를 파괴해야 한다면, 내가 하면 되잖아!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "로즈몬티스 씨!",
