    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "text": "무슨 일이야? 빨리 응답해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "text": "……어서 응답해! 라바카! 블루이쉬실버!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "text": "아, 안 돼!!",
