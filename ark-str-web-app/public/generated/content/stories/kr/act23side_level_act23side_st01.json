{
  "server": "kr",
  "storyId": "act23side_level_act23side_st01",
  "groupId": "act23side",
  "stageId": "act23side_st01",
  "title": "꿈속의 소년 시절",
  "storyCode": "WB-ST-1",
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/activities/act23side/level_act23side_st01.txt",
  "sourceHash": "a8bf1c6aa46898c340bbd1918f1bd6270808f430d37e8da9715cb753b48b55ac",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "주인장, 드라마가 왜 이래? 왜 17화에서 20화로 바로 건너뛴 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "디스크가 고장 난 바람에 몇 화는 재생이 안 됩니다. 대충 보십쇼."
    },
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "아, 지금 중요한 대목인데. 전 화에서는 척청추랑 심비백이 끝장을 볼 기세로 싸우더니, 둘이 왜 또 갑자기 같이 싸우는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "중간 그 세 편에서는 척청추가 심비백이 자기 사부를 죽인 원수라는 걸 알고는 그와 싸우러 가려 했지."
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "하지만 막상 옥문에 도착했더니 심비백은 이미 군에 입대했고, 심지어 계급도 낮지 않다는 걸 알게 됐어."
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "하지만 지금은 외적이 침범해 온 터라 척청추는 밤잠을 이룰 수 없었어. 나라의 적이 자신의 원한보다 크다는 걸 깨달은 척청추는 종사님 휘하에 들어가 함께 적에 대항하게 되었지."
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "스토리는 단순하지만, 19화의 그 절벽논검은 정말 명장면이었어!"
    },
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "세상에, 몇 번이나 봤길래 그렇게 자세히 기억하는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "이 옥문에서는 꼬맹이 아무나 붙잡고 물어봐도 《옥문풍운》의 스토리를 줄줄 외울 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "그런데 이 손님께서 빼먹은 부분이 있습니다. 척청추는 군에서 심비백을 만난 뒤, 바로 원한을 내려놓지는 못했죠."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "그때 마침 그 종사님이 나서서 심비백 대신 척청추의 복수를 받겠다고 말했습니다. 그렇게 그 절벽논검이 성사된 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "그 당시, 먹구름이 짙게 깔리고 바람이 세차게 부는 게 마치 천지 만물이 그 비무의 산증인이 되는 듯했습니다. 눈 깜짝할 새에 두 사람이 검을 뽑아……"
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "(약간 서툰 염국어로) 헛소리, 헛소리야! 완전, 헛소리야!"
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "그 드라마, 액션은 좋지만, 디테일은 완전 꽝이야."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "하석안, 또 왔구나. 염국 말도 제대로 못 하면서 드라마 내용이 뭔지 이해는 했어?"
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "물론, 했지! 《옥문풍운》은 50년 전 실제 사건이야. 수많은, 강호 협객들이 원한을 내려놓고, 그 종사님과 함께 외적에 대항했어."
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "나 그것도 알아, 드라마의 여러 씬은 이 객장에서 찍었어!"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "'객잔'이야, 객잔."
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "이 외국 분은 염국의 역사에 대해 잘 아시네요."
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "당연하지. 그 종사님이 나 무공 가르칠 때 직접 알려줬어, 사르곤에서."
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "종사님은 검 하나 있어. 그 검이 너무 특별해서, 절대 뽑으면 안 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "또 시작이네. 네가 정말 종사님의 제자라면 어제 연무대에서 그 필라인 아가씨한테는 왜 진 건데?"
    },
    {
      "type": "dialogue",
      "speakerName": "사르곤 옷차림의 여행객",
      "speakerId": null,
      "text": "필라인 아가씨가 뭐, 그 사람 무공이 대단해. 네가 뭔데 사람 무시해?"
    },
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "사르곤 형씨, 염국 말로는 그게 그 아가씨를 무시한다는 뜻이 아닌데……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "함께 있던 사람들",
      "speakerId": null,
      "text": "하하하하하……"
    },
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "그나저나, 드라마가 실제 사건을 각색한 거라면, 옥문엔 정말 강호인과 군대가 연합해서 외적에 대항했던 역사가 있다는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "용문 여행객",
      "speakerId": null,
      "text": "“자고로 협객은 나라를 위하고 백성을 위한다.” 강호를 자유롭게 누비면서도 나라를 지키고자 하는 포부를 갖다니, 역시 옥문이네. 생각만 해도 멋져."
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "TV에 나오는 건 결국 이야기이니 어느 정도는 미화했겠지. 하지만 역사가 어떨지, 겪어본 사람이 아니고는 누가 확실하게 말할 수 있겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "게다가 이제는 전장에서 창칼을 들고 싸우는 시대가 아니니까. 정말 나라를 위하고 싶다면 오리지늄 아츠를 잘 배워서 천사가 되는 편이 낫지."
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "옥문 같은 이런 변방의 요새 도시에 이렇게 많은 일반인들이 여기 살면서 도시의 운영을 유지하지 않고, 다른 도시의 보급에만 의존한다면 얼마나 많은 자원을 소모해야 하는지 알아?"
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "당시 도시를 세울 때, 식솔들을 데리고 이 멀고 추운 땅까지 이주해 온 사람들, 그리고 지금까지도 여기 남아있는 사람들 중에, '나라와 백성을 위한다'라는 말에 걸맞지 않은 사람이 어디 있겠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "술 마시던 단골",
      "speakerId": null,
      "text": "그러고 보니, 드라마 속 유일한 실재 인물인 그 종사님마저 지금은 떠나려고 했지."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "text": "잠시 실례."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우람한 남자",
      "speakerId": null,
      "text": "약을 가져왔다."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "고생하셨습니다. 거기 두시면 이따 점원에게 옮기라고 할게요."
    },
    {
      "type": "dialogue",
      "speakerName": "우람한 남자",
      "speakerId": null,
      "text": "의사 선생님이 조제한 타박상, 화상 약이 다 들어있다. 이번 달에는 보급이 부족해 약선을 만들 재료는 남지 않았어."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "약값입니다. 번거롭게 해드려 정말 죄송하군요. 이건 최근 객잔에 들어온 물자들인데, 의원에 가지고 가십시오."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "아, 물건이 좀 많군요. 잠깐 기다리세요. 점원에게 같이 들어다 드리라 하겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "우람한 남자",
      "speakerId": null,
      "text": "됐어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "짐이 한 수레 가득인데 그냥 이렇게 메고 가는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "의원은 어디서 저런 직원을 구했는지, 힘이 장난이 아니군……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "어, 내려오셨습니까."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "며칠 묵으면서 보니, 일 층 홀은 비어 있을 때가 없더군요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "얼마 전 옥문이 용문과 도킹하면서 보급 물자를 받고 있는 와중에 하필이면 재앙이 일어날 줄 누가 알았겠습니까. 두 도시가 급하게 분리하는 수밖에 없었죠."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "너무 갑작스레 일어난 터라, 많은 상인과 관광객이 옥문에 남게 되었어요. 덕분에 최근 객잔들은 전부 만실이지만."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "그래도 접대할 사람이 많으니 마음 졸일 일도 많습니다. 다들 기분파인지라 자칫하면 말썽이 일어날 수도 있으니……"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "장사가 잘된다는 건, 동종업자들이 부러워할 행복한 고민거리가 아닙니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "뭐, 제 구멍가게도 용문에서 장사가 이렇게 잘 된다면 골치가 아프기는 하겠네요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "오늘은 우선 차를 한 주전자 드릴까요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "네. 알아봐달라고 부탁드렸던 건……?"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "자, 보십시오. 반년 치 옥문 연무대 방의 순위 변동 현황입니다. 찾으시는 그 '무림 고수'가 여기 없다면 저도 따로 방법이 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "옥문이 지금까지도 연무대 비무 같은 전통을 지키고 있을 줄은 몰랐습니다…… 확실히 무도인들의 덕망이 높은가 보군요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "평숭후께서 워낙 군을 엄격하게 다스리긴 합니다만, 지금은 사람들이 전선에서 외적을 상대할 필요가 없으니, 이렇게 연무대를 남겨두어 무도인들이 몸을 풀게 하는 거죠."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "어쨌든, 급하지 않으시다면 며칠 더 머물러 보시죠. 오가는 손님들이 많으니 찾으시는 사람을 만날지도 모릅니다."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "참, 성 남쪽의 도검방에 가서 알아보는 것도 좋겠군요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "그곳의 주인은 베테랑 강호인입니다. 옥문에서 날고 긴다는 무도인들이나 표국 호송원들이 그곳에서 잘 모이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "감사합니다…… 역시 낯선 곳에서는 일 처리가 힘드네요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "괜한 참견이긴 합니다만, 무엇 때문에 그렇게 열심히 찾으십니까? 은혜, 아니면 복수? 설마 빚이라도 졌나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "굳이 따지자면 그 사람이 저에게 엄청나게 큰 빚을 졌죠……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "이번에는 얼마나 걸려?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "모르겠소."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "돌아는 올 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "일을 마치면 바로 돌아올 거요."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "3일 후면 와이후의 생일인 거 알지? 저승에서 제수씨가 알게 되면 뭐라고 하겠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "나는 좋은 아비도 좋은 남편도 아니오."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "이번 생에 한 가지 일만 해낼 수 있다면, 난 그것만으로도 충분하오."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "빚 독촉입니까? 그건 어려울 수도 있겠군요. 염국 땅은 무척 넓습니다. 이 옥문만 해도 인구가 10만이 넘죠. 정말 마음먹고 숨는다면 어떻게 찾을 수가 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "서두르실 것 없습니다. 차는 준비됐으니 차나 마시면서 옥문 특색 요리인 버든비스트 조림을 드셔보는 건 어떠신지요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "하하, 그럼 잠깐 쉬면서 우리 집 아가씨의 경기가 끝나기를 기다려야겠네요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "자, 얼마 전에 막 들여온 용문 춘차입니다. 이렇게 신선한 찻잎은 저희도 몇 년에 한 번 겨우 마실 수 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "감사합니다. 제게 이렇게 귀한 걸 내주시다니, 아무래도 아깝네요."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "무슨 그런 말씀을."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그런데 맛이…… 이 시기의 용문 춘차라면 이런 떫은맛이 날 리가 없는데……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "……네가 왜 여기 있지?"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "여기서 만나자고 한 적은 없는데."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "어…… 저기 실례지만?"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "아니…… 네가 아니야……"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "두 분 아는 사이십니까? 마침 자리도 없는데, 합석하시는 건 어떠십니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "모르는 사이야. 나는 잠깐 있다가 갈 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "네, 괜찮습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 주인",
      "speakerId": null,
      "text": "알겠습니다. 편하신 대로 하시고, 필요하신 게 있으시면 말씀하십시오."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "절 누군가와 착각하신 거 아닙니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "비슷하게 생겼을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "오랫동안 만나지 않은 옛 친구분인가 보군요……"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "그런 셈이야…… 차나 계속 마시도록 해."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "아가씨께 한잔 대접하겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "내가 누군지도 모르면서 차를 대접한다고?"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "잘못 만난 건 사실이지만, 이런 만남도 일종의 인연이니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "하루빨리 옛 친구분을 찾으시길 바라는 뜻도 있고요."
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "빨리 만나도 재미없어. 때가 되면 자연스럽게 찾게 되겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "일리가 있는 말이군요. 오랫동안 못 만난 사람일수록 답은 그 사람이 아니라 그 사람을 찾는 시간 속에 있기도 하니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "원래 아무한테나 그렇게 말이 많아?"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그럴 리가요……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "벌써 가시게요?"
    },
    {
      "type": "dialogue",
      "speakerName": "냉담한 여인",
      "speakerId": null,
      "text": "잠깐만 있다가 간다고 했잖아."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "별일이군……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "공자님, 모처럼 돌아오셨는데 먼저 장군님을 뵈러 가지 않으시는 겁니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "아버지는 군의 일 때문에 바쁘실 테니, 방해하지 않는 게……"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "괜한 참견일지도 모르지만, 상촉의 일은 숙정원에서 이미 결론이 났고, 공자님은 정정당당하시니 장군님께 부끄러워하지 않으셔도 됩니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "전 그저……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "집에 돌아가도 별달리 할 일이 없으니 우선 도시의 상황을 보려고요. 태부께서 이번에 저를 옥문에 보내신 건 뭔가 변고를 예견하셨기 때문일지도 모릅니다. 사전에 살펴봐야겠어요."
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "공무 때문이시라면 저 또한 기꺼이 함께하겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "태합 아저씨도 옥문은 오랜만이시니 감회가 새로우시겠어요."
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "방금 오면서 보니 사람들의 생활이 제가 떠날 때와는 많이 달라졌더군요."
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "북쪽 국경은 전쟁이 끊이질 않는데, 옥문 백성들이 편하게 살 수 있는 걸 보면 장군님의 군 통솔력과 정무 처리 능력이 정말 감탄스럽습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "저 연무대는 여전히 사람들로 북적거리네요."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "방금 태합 아저씨의 이름이 연무대 방의 5위에 올라 있는 걸 봤어요."
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "허명일 뿐입니다. 하루빨리 뛰어난 청년이 나타나 저를 순위에서 밀어내는 것이야말로 기쁜 일이죠."
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "지금 겨루고 있는 저 두 아가씨는……"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "왜 저를 뚫어져라 보고 계십니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "공자님의 무공이 연무대의 저 두 아가씨에 비하면 어떨지 생각하는 중입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "크흠……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "태부께서는 지촉인의 직책이 밝은 불로 베헤모스의 그림자를 몰아내고, 사직에 문제가 없는지 살피는 거라 하셨습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "가장 중요한 건 사명을 마음 깊이 새기고 일을 영리하게 처리하는 것입니다. 무공은 그다음이죠……"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "공자님 말씀이 맞습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "……그런데, 태합 아저씨가 보시기에 연무대의 저 두 아가씨와 비교하면 제 무공은 어떤가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "태합",
      "speakerId": null,
      "text": "솔직히 말씀드리면, 공자님은 경공은 뛰어나시지만, 정면으로 싸우게 되면 승률은 3할 정도일 겁니다……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "연무대의 두 사람은 벌써 열 합이나 겨뤘다.\n미처 숨을 돌리기도 전 또다시 습격.\n필라인 소녀는 몸을 일으켜 달려들었다. 섬세한 주먹질은 연달아 폭발음을 내면서 상대의 무기 든 손을 확실하게 제압하고 있었다.\n다음 합에서 두 사람의 발이 맞닿았다. 그러자 상대인 이민족 차림의 소녀는 힘을 빌려 뒤로 물러났다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "그만!"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "당신은 이미 연무대를 벗어났어요."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "연무대는 공간이 좁아요. 당신이 쓰는 원거리 무기에 불리하니, 제대로 힘을 발휘할 수가 없죠……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "하지만 규칙은 규칙이죠. 당신의 패배입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "당신 무공은 정말 훌륭하네요. 전부 처음 보는 초식이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "(약간 서툰 염국어로) 지금 진 거면, 경기를 계속, 할 수 없는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "무예를 익히는 사람이 승부에 너무 연연해서는 안 되긴 하지만, 지금 저도 꼭 이겨야만 하는 이유가 있어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "너도 검을, 얻고 싶어?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "검? 무슨 말이죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "사람들 말로는, 연무대 방 1위는, 특별한 검, 얻을 수 있다고 했어."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "아니…… 전 누군가가 제 이름을 볼 수 있도록 더 높은 순위를 얻으려는 것뿐이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "너, 31위야. 그 말은 네 앞에, 너보다 더 강한 사람이, 30명이 있다는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "……엄밀히 따지면 그렇죠."
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "네 무공, 확실히 나보다 뛰어나."
    },
    {
      "type": "dialogue",
      "speakerName": "이민족 차림의 소녀",
      "speakerId": null,
      "text": "(아무래도 이 방법으로는……)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "앗, 벌써 가버린 건가요……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "이번에 이겼으니 연무대 방의 첫 페이지에 이름이 나오겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "그래도, 그 사람이 봐주려나……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "총 열다섯 합, 천부장은 오른쪽 손목, 왼쪽 옆구리, 복부, 목 네 곳을 공격당했고, 치우바이는 공격당한 곳이 없으니 치우바이 승입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "천부장",
      "speakerId": null,
      "text": "하하, 졌네 졌어. 이게 전장이었으면 난 이미 치우 소저의 검에 세 번은 죽었겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "비무는 무예를 겨루는 거고, 전장은 심성을 겨루는 거죠. 정말 생사가 걸린 전장이었다면 죽는 건 저였을지도 모릅니다."
    },
    {
      "type": "dialogue",
      "speakerName": "천부장",
      "speakerId": null,
      "text": "치우 소저는 항상 종사님 곁에 있다 보니 무공과 식견이 일취월장한 것 같군. 진심으로 감탄했어."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……영광입니다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "종사님이 무공기록부에 달아 준 주석 좀 보여주세요."
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "최근 기록은 다 여기 있습니다. 선생님은 바쁘신데도 사저의 경기에는 무척 관심을 두고 계셨고, 사저의 검술을 크게 칭찬하셨습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "사저, 고민거리라도 있으신가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "그 사람이 말했던 '검의 뜻이 불순하다'라는 게 무슨 의미인지 생각하고 있었어요."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "그리고, 이런 검술로 언제쯤 그 사람을 꺾을 수 있을지도 생각해 봤죠."
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "선생님이 구술하신 《무공전》에는 그런 내용이 없었습니다. 아마 그 말은 사저께만 하신 것 같습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "그리고 '종사님을 꺾는다', 이 세상에 이런 생각을 하는 사람도 많지 않을 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신도 제가 분수를 모른다고 생각하나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "전 본분대로 선생님의 곁에서 세상의 무공을 사실대로 기록하고 품평할 뿐입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……오늘 연무장에 사람이 많이 온 것 같은데, 왜 그 사람만 안 왔나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "좌 장군의 손님들이 오신 모양인데, 선생님도 성루에서 옛 친구분을 만난다고 했던 것 같습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "그렇다면 먼저 갈게요."
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "살펴 가세요, 사저."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신은 저보다도 종사님을 더 오래 따랐는데, 왜 자꾸 저를 사저라 부르는 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "선생님께서, 기록하는 자는 더더욱 남의 장점을 발견하는 안목이 있어야 한다고 하셨습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "녹무관",
      "speakerId": null,
      "text": "무공과 경력을 따지자면 사저가 모두 저보다 위이시고, 제가 배워야 할 것이 많습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……됐어요. 마음대로 하세요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "위엄 있어 보이는 남자",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "narration",
      "text": "평상복 차림의 장군은 활시위에 화살을 얹었고, 굵은 조각 활을 당기자 그 모양이 마치 만월과도 같았다.\n활을 든 손이 살짝 떨리면서 화살도 살짝 흔들렸고, 한 번 흔들릴 때마다 장군의 이마가 조금씩 찌푸려졌다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "철제 화살은 과녁을 반쯤 뚫어버렸지만, 중심을 약간 빗나갔다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "장군님, 궁술이 뛰어나십니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "빈말은 됐소. 내 몸은 내가 잘 알고 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "재작년까지만 해도 창검을 어느 정도 휘두를 수 있었지만, 올해는 활조차도 제대로 당길 수 없으니 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "아무리 전장에 나갈 필요가 없다지만, 환자에게 옥문 장수를 맡으라고 하는 건 아무래도 무리인 것 같소…… 내겐 시간이 얼마 남지 않았으니."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "장군님 몸에 난 상처들은 그야말로 옥문을 수십 번이나 지켜낸 증거입니다. 그 공적은 조정의 그 누구도 잊을 수 없지요."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "이 몸은 아깝지 않으나, 아직 이루지 못한 몇몇 일들이……"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "저도 이번에 태부님의 명을 받고 장군님을 도우러 온 것입니다. 옥문의 귀국 관련 사무를 저도 함께 맡겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "태부 어르신이 '도우라'고 했단 말이오?"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "장군님, 태부님의 뜻을 잘 아시잖습니까……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "양대인에게 부탁했던 상촉 건도 내가 고맙다는 인사를 못 했구려. 게다가 좌락 이 녀석이 아직은 어려서 일 처리가 어설픈 탓에 양대인에게 폐만 끼치게 됐잖소."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "장군님, 아닙니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "부모의 마음을 양대인은 아직 이해하기 어려울 것이오."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "자식의 성과는 눈여겨보지만, 사소한 실수라도 할까 봐 걱정부터 앞선단 말이오. 게다가 좌락이 지금 짊어진 사명은 더더욱 실수를 용납할 수 없으니."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "좌공자는 젊은 준재인 데다 영리하기까지 합니다. 젊은이라 가끔 무모한 것도 당연한 일이지요. 장군님, 너무 걱정 안 하셔도 됩니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "그럼 양대인이 보기에는 내 방식이 무모한 것 같소?"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "……저는 장군님을 믿습니다. 분명 달리 생각하는 바가 있으시겠지요."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "양대인이 상촉의 수령으로서 정무에 힘쓰고 백성을 사랑한다는 건 나도 옥문에서 익히 들었소. 하지만 양대인은 전장에서 싸워본 적이 있소?"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "몇 년 전, 상촉에 수적 떼가 출몰할 때 싸운 적이 있습니다…… 물론 장군께서 겪으신 전장과는 비교할 수 없을 정도입니다만."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "그렇다면 양대인도 잘 알겠구려. 장수가 전장에서 결정 내린다는 것은, 관리가 백성을 위해 정무를 결정하는 것과 확연히 다르다는 것을."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "전장에서는 상황이 순식간에 변하고, 수많은 병사의 목숨이 한 사람의 결정에 달려 있소."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "이럴 때 필요한 게 과연 결단을 내릴 수 있는 용기라고 생각하오, 아니면 이해득실을 따지는 계략이라고 생각하오?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "이번 쉐이 건은 이미 활시위에 화살이 얹혀 있는 거나 마찬가지요. 쏠 수밖에 없소."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "가르침을 받았습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "마침 양대인은 '옥문 참지'를 맡게 됐으니, 전장에 온 거나 마찬가지고, 우리 또한 동료임은 틀림없소. 앞으로 이 좌선료의 방식을 부디 이해해줬으면 좋겠구려."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "최선을 다하겠습니다. 그리고 장군을 믿겠습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "하지만 지금 염국이 직면한 베헤모스 문제는 백성을 위한 정무도 아니고, 전장의 살육도 아닙니다."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "저는 장군님의 결단을 믿습니다. 그러니 장군께서도 저의 판단을 믿어주십시오."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "음……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "또 한 번의 사격, 이번에는 과녁 정중앙에 맞았다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "양대인도 해보겠소?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "양대인은 글재주만 뛰어난 것이 아니라 검술과 궁술에도 일가견이 있는, 문무를 겸비한 인재라 들었소."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "다만, 이 옥문의 활은 꽤 무거운 편인데, 양대인이 당기실 수 있을지 모르겠구려."
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "순방영 수비군",
      "speakerId": null,
      "text": "장군님, 용문의 웨이 총독께서 도착해 의사당에서 기다리고 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "그래, 알겠다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "린 선생의 영애가 며칠 일찍 도착했으니, 대충 계산해 보면 웨이 총독도 도착할 때가 되었군."
    },
    {
      "type": "dialogue",
      "speakerName": "순방영 수비군",
      "speakerId": null,
      "text": "그리고, 태부께서도 도착하셨습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "태부와 웨이 총독이 같이 온 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "양현",
      "speakerId": null,
      "text": "웨이 총독은 공적인 일로 오신 게 아닌 것 같습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "공이든 사이든 오늘만큼은 두 귀빈을 동시에 접대해야 할지도 모르겠소."
    },
    {
      "type": "dialogue",
      "speakerName": "좌선료",
      "speakerId": null,
      "text": "아무래도 나를 일깨워 주려는 게 양대인 만이 아닌 것 같군."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "오라버니."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "어젯밤에 꿈을 꿨다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "꿈속에서 한밤중에 바람이 세차게 불어 창문을 열어보니 성 밖의 사막이 숲이 되어 있더군. 사시나무에는 새싹이 돋아났고, 심지어는 꽃이 핀 것도 있었어."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "나뭇가지가 무척 길게 자라 그물처럼 엮이더니, 옥문 전체를 칭칭 휘감아서 움직일 수가 없었지."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "사람은 작별을 고하지 않고, 꽃은 가지를 남기기가 어렵거늘."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "오라버니는 아직 옥문을 떠나기 아쉬운가 보네?"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "저번에 네가 옥문을 떠나면서 뭐라 했었지? 기억이 안 나는구나."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "밤이 고요하고 성안의 음주가무 소리가 걷히니, 지나가던 나그네는 이곳이 변방 끝자락인 걸 믿지 아니하더라."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "새로운 시구 같은데. 못 본 새에 우리 동생의 심경에 또 변화가 생겼구나."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "백 년이 긴 시간은 아니지만, 이곳을 꿈꿔서 다시 돌아온 것뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "하지만 내게는 그 '백 년'은 3만 개의 밤과 낮 이상이었다. 모든 순간이 긴급 보고였고, 척후병의 출정이자, 전달자의 귀환이었지."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "네가 떠난 후 성을 지키던 병사들이 몇 번이나 교체되었고, 이 성벽도 몇 번이나 고쳐졌는지 모른다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "성벽이 아직 무너지지 않은 게 다행이지."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "상촉에서 니엔이랑 시는 만났니?"
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "만나긴 했는데, 전이랑 똑같아. 지금은 정착해서 놀 만한 곳을 찾았더라."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "그럼 둘째도 만났겠구나."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "우리 남매 중에 오라버니를 걱정시키지 않는 사람이 없다니까."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "시는 섬세하고 생각이 많은 데다, 누군가에게 속마음을 터놓으려고 하지를 않아. 늘 자신만의 세상에 웅크리고 있으니 문제가 생길 법도 하지."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "니엔은 자유롭고 소탈해 보이지만, 가장 외로움을 많이 타지. 뭔가 정신을 집중할 새로운 일이 없으면, 자신을 계속 괴롭힐 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "넌, 오히려 걱정되지 않는구나. 유일하게 걱정되는 건, 네가 술을 너무 즐기다 술값을 내는 걸 잊어서 점주를 곤란하게 만드는 것뿐이니까."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "그래도 네가 큰언니이고, 딱히 공무도 없으니 동생들을 잘 보살펴 줘야 한다."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "꼭 내가 언니 노릇 못 한다고 나무라는 것 같은데?"
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "이 세상에 우리 같은 가족이 몇이나 되겠어? 내가 보고 배울 사람도 없으니…… 결국 스스로 깨닫는 수밖에 없지."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "게다가 이 철없는 동생들이 이래저래 속내를 터놓지 않고 걱정을 사서 하는 걸 어쩌겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "걔네들 탓할 것도 아니다. 네가 걔네 입장이었으면 너도 이렇게 소탈하지 못했을 테지."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "소탈하다고 해서 말인데, 아무래도 난 오라버니처럼은 안 될 것 같아. '나'를 완전히 버리고, 새로운 '나'를 찾다니."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "'숴'라는 이름과 남아 있던 영혼은 모두 그 검에 봉인해 뒀어. 지금의 나는 그저 무술을 좀 하는 평범한 인간일 뿐."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "'무술 좀 한다'는 인간치고 너무나 많은 무도인들의 앞길을 막은 게 아닐까?"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "하루 수련하면 하루의 무공을 쌓는데, 수백 년이라는 시간이 지났으면 이 '무술 좀 한다'라는 말조차 오만일 지도 모르지."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "모래 방아는 쉬지도 않고 수천만 톤에 달하는 황사를 삼켰다 토해내며 옥문의 전진을 위해 장애물을 제거하고 있었다.\n방대한 이동도시는 새로운 종착지를 향해 빠르게 달려가고 있다."
    },
    {
      "type": "dialogue",
      "speakerName": "링",
      "speakerId": null,
      "text": "옥문을 떠나면 오라버니는 어떻게 할 생각이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "남쪽으로 가서 경치나 구경하고, 중원의 소주도 마셔보고. 아니면 니엔과 시가 머물러 있는 곳에라도 가볼 생각이란다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "강호가 이렇게 큰데, 내가 갈 곳이 없겠느냐만."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "……전에 함께 술 마시며 웃고 떠들던 사람들은 지금은 한 사람도 찾을 수 없겠지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "멀리서 사막의 뜨거운 열기가 솟구쳐 올랐고, 세상은 흐릿하고 거칠어져 보였다.\n긴 바람이 불어왔지만, 성루에 도달했을 땐 이미 힘이 수그러들어 날려온 고운 모래가 뺨에 부딪히는 촉감이 부드러울 정도였다.\n삼천 리 길을 달려온 황사였지만, 세월을 씻어내는 건 눈 깜짝할 사이로다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "옥문 수비군 A",
      "speakerId": null,
      "text": "……장비의 식별 코드를 보니 오늘 오전에 귀환해야 하는 재앙정보전달자 소대가 맞습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "옥문 수비군 A",
      "speakerId": null,
      "text": "현장에 강렬한 오리지늄 폭탄의 흔적이 있습니다. 시체는 아마도 분진이 됐을지도……"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "……잔류 오리지늄을 조심해."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "여긴 도시에서 겨우 두 시간밖에 안 되는데, 대체 누가 감히 이렇게 가까운 곳에서 관청의 재앙정보전달자를 습격했을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "옥문 수비군 A",
      "speakerId": null,
      "text": "보급 중에 값이 될 만한 물건은 다 가져갔습니다. 아무래도 도적 떼가 한 짓 같습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "……아니면 누군가 일부러 도적 떼 소행처럼 보이게 한 걸지도?"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "계속 수색해. 재앙 관측 데이터를 찾지 못하면 진짜 골치 아파지는데……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "옥문 수비군 B",
      "speakerId": null,
      "text": "찾았습니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "옥문 수비군 B",
      "speakerId": null,
      "text": "좀 떨어진 곳에 있는 부서진 갑옷 밑에서 찾았습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "옥문 수비군 B",
      "speakerId": null,
      "text": "형제들이 필사적으로 지켜낸 겁니다……"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "시간이 없어. 주변을 경계하고 데이터를 가지고 즉시 복귀한다."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
