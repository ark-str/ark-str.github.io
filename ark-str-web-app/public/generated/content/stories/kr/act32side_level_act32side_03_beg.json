      "type": "dialogue",
      "speakerName": "스피커 소리",
      "speakerId": "avg_4125_rdoc_1",
      "isRemote": false,
      "text": "언젠가 다시 당신의 손을 마주 잡고 싶어요, 다음 모퉁이에서♪"
