      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "굼, 조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "제가 녀석들을 붙잡아 둘게요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "지마, 지금이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "그래!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "식은 죽 먹기네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "헐떡이면서 큰소리치기는.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "지마 언니!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "다쳤네! 바, 방금 굼 대신 막아서 그런 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "다 굼 잘못이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "시끄러우니까 울지 좀 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "그래, 그래. 딱 봐도 지마 잘못이지 굼 네 잘못이 아니야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "하지만……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "그보다 지금은 해결해야 할 다른 일이 남아 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "이봐, 어때. 지금은 너 혼자만 남았네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "마을에 있었던 일이랑 너희들이 납치해간 두 아이는 어디에 있는지 빨리 말해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "말하지 않으면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "말하지 않으면 이빨이랑 머리카락을 다 뽑아버릴 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "(……그럴 필요까진 없잖아.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "흥, 빌어먹을 꼬맹이들이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "말조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "겨우 몇 명 이겨서 뭘 어쩌겠다는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "너희들의 목적은 그 애들이냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "그래!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "빨리 솔직하게 말해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "하, 순진하군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "아쉽게도 그 애들의 행방을 아는 건 나뿐이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "내가 말하지 않는다면 아이들을 찾을 수 없다는 거지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "숨겨봤자 좋을 게 없을 텐데요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "내 생각엔 조건에 대해 이야기해봐야 할 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "일단 우리를 놓아줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "그러면 두 아이는 마을로 돌려보내지. 다른 것에 대해선 참견하지 마라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "그게 다야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "미안하지만…… 거절한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "얻어맞은 주제에 무슨 조건을 걸겠다는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "그러니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "(이 사람도 조용해졌네요……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "(진짜 죽어도 말 안 하려는 건 아니겠지?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "(좀 까다롭네요. 진짜 고문을 할 수도 없구요……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "몇 대 더 후려치면 끝날 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "앗, 지마 언니, 목소리가 너무 커!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "감히 날 얕보다니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "……빌어먹을 곰 새끼들이!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "지마 언니!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "뭐야……?! 으아아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "이 비열한 자식……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "비열하다고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "수단과 방법을 가려선 안 되지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "죽어라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "소냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "제길, 이 애송이 녀석이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "커억……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "절대……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "소냐 언니를 해치게 하지 않아……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "한 대 더……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "기다려, 굼! 난 괜찮아! 흥분하지 마!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "애들이 어딨는지도 물어봐야 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "나, 난……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "음침한 바운티 헌터",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "굼…… 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "끔찍하네. 죽은 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "아니, 아직 살아있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "친애하는 로잘린드 씨, 미안하지만 이 사람을 저쪽으로 옮기는 것 좀 도와주지 않을래? 지혈도 하고 '깨어나게' 해야 하거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "문제 될 거야 없지만…… 왜 갑자기 날 그렇게 부르는 거야? 무섭잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "됐으니까, 이리로 와.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "지마 언니, 상처에서…… 피가 나. 내, 내가 붕대를 감아줄게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……미안해……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "미안해, 지마 언니, 이스티나 언니. 굼이…… 또 사고를 쳤어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "바보 같은 소리 하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "네가 무슨 사고를 쳤다고 그래? 넌 나를 구해줬잖아. 고맙다고 해도 모자랄 판인걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "하지만은 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "굼, 넌 두려워하면서도 우리를 지켜줬어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "그래, 맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "게다가…… 굼, 난 네가 얼마나 강한지 알아. 네가 정말 온 힘을 다해 머리를 때렸다면 녀석은 이미 죽었을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "그, 그럼 그 사람은……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "살아있어. 안심해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "한 번 더 때려서 깨어나게 해줄래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "살아있구나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "굼, 굼이 제어해낸 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "제어했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "마지막으로 공격할 때, 손을 휘둘렀지만 힘은 뺐어. 내가 똑똑히 봤어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "굼.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "이리 와요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "그리고 지마도 이리 와요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "우리는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "뭐 하려는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "시끄러워 죽겠네! 밀지 좀 마!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "주위가 온통 엉망진창이 되었지만, 우르수스 학생자치단의 아이들은 사이좋게 모였다.\n이스티나는 굼의 왼손을, 그리고 지마는 오른손을 잡았다. 아이들은 손을 잡고 머리를 맞댔다. 서로의 머리카락 때문에 뺨이 가려웠지만 결코 떨어지지 않았다.\n굼은 동료들과 머리를 맞대고 예전에 장난칠 때 그랬던 것처럼 이마를 다른 사람의 이마에 가볍게 부딪혔다.\n그리고 동료도 굼의 이마에 다정하게 박치기를 해주었다."
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "굼, 전에 제가 했던 말 아직 기억하고 있죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "당신은 이미 충분히 잘하고 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "우리가 같이 있어 줄 테니까, 무서워하지 말아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레토",
      "text": "맞아, 맞아. 굼은 아주 잘했어! 마지막 공격은 정말 훌륭하게 막아냈어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로사",
      "text": "하하, 이미 자기 성질도 못 참는 누구보다 더 강할지도 모르겠는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "뭐? 누구 말하는 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "풉.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "지마 언니, 뛰지 마! 다쳤잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "굼이, 굼이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "굼이 정말…… 해낸 거야? 정말로 저, 전력을 다하지 않은 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "지마",
      "text": "응. 네가 해낸 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "좀 있으면 녀석을 깨울 수 있어요. 그럼 아이들의 행방에 대해서 불어볼 수 있을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "안심해요. 제가 말하게 만들게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이스티나",
      "text": "굼, 당신은 우리를 지켰을 뿐만 아니라, 아이들도 구해냈어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "굼이…… 제어했어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……굼이 해냈어……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "이것도 가져가고, 이것도…… 음, 빵은 좀 많이 가져가야겠다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "후, 드디어 짐을 다 쌌네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "아빠, 엄마, 라다가 곧 찾아 갈게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "켈시 선생님이 아주 어려울 거라고 했지만 그래도 시도는 해보고 싶어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "참, 라다는 이제 사람을 때릴 때마다 망설이지 않게 됐어…… 세 번째 공격 때도 힘을 약간은 제어할 수 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "다시는 언니들을…… 그리고 아빠랑 엄마도 걱정시키지 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "아직도 악몽을 꾸곤 하지만 언니들 덕분에 지금은 그렇게 무섭진 않아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "아빠, 엄마, 라다는 여기서 아주 즐겁게 지내고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "아, 언니들한테도 인사를 해야겠네. 혼자서 멀리 떠나는 건 이번이 처음이긴 하지만 꼭 돌아올게. 언니들, 꼭 라다를 기다려 줘 ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……후.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "됐다. 여기까지만 녹화해야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "굼",
      "text": "……그럼 출발!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
