    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "avg_npc_046",
      "operatorId": null,
      "portraitKey": null,
      "text": "용병 W라고 해. 외드레르 대장을 찾다가 길을 잃어서……"
