    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "avg_npc_046",
      "operatorId": null,
      "portraitKey": null,
      "text": "로도스 아일랜드?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "avg_npc_056",
      "operatorId": null,
      "portraitKey": null,
      "text": "아……"
