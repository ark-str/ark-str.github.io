    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "avg_npc_046",
      "operatorId": null,
      "portraitKey": null,
      "text": "나?"
    },
    {
      "type": "dialogue",
      "speakerName": "테레시아",
      "speakerToken": "avg_npc_056",
      "operatorId": null,
      "portraitKey": null,
      "text": "나는 테레시아, 여기는 로도스 아일랜드. 그럼 너는?"
