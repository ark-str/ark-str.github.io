    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에렌델",
      "speakerId": "avg_npc_928_1",
      "isRemote": false,
      "text": "(작은 목소리로) 저 형은 페데리코 형보다 더 무서워."
