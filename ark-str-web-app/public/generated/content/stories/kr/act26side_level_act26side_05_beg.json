    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에스타라",
      "speakerId": "avg_npc_929_1",
      "isRemote": false,
      "text": "아, 안 닿아!"
    },
    {
      "type": "dialogue",
      "speakerName": "에스타라",
      "speakerId": "avg_npc_929_1",
      "isRemote": false,
      "text": "조, 조금만 더 숙여 봐……!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "speakerId": "avg_1032_excu2_1",
      "isRemote": false,
      "text": "무슨 일이죠……?"
