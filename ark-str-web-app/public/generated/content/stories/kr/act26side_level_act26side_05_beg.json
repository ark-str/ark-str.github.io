    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에스타라",
      "speakerId": "avg_npc_929_1",
      "isRemote": false,
      "text": "헤헤……"
    },
    {
      "type": "dialogue",
      "speakerName": "에스타라",
      "speakerId": "avg_npc_929_1",
      "isRemote": false,
      "text": "아, 안녕……!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "speakerId": "avg_1032_excu2_1",
      "isRemote": false,
