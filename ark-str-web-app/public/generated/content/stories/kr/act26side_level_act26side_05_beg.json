      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "39_g6_villagestreet"
    },
    {
      "type": "dialogue",
      "speakerName": "페데리코",
      "speakerId": "avg_1032_excu2_1",
      "isRemote": false,
      "text": "음?"
