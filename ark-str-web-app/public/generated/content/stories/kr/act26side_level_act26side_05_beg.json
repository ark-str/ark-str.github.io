    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라이문트",
      "speakerId": "avg_npc_931_1",
      "isRemote": false,
      "text": "너희들……!"
    },
    {
      "type": "dialogue",
      "speakerName": "제럴드",
      "speakerId": "avg_npc_926_1",
      "isRemote": false,
      "text": "됐어, 라이문트."
