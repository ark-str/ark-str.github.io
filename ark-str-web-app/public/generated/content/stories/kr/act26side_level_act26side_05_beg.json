    {
      "type": "dialogue",
      "speakerName": "에렌델",
      "speakerId": "avg_npc_928_1",
      "isRemote": false,
      "text": "타라! 페데리코 형은 바빠. 떼쓰면 안 돼!"
    },
    {
      "type": "dialogue",
      "speakerName": "에스타라",
      "speakerId": "avg_npc_929_1",
      "isRemote": false,
      "text": "응…… 응! 그럼 우린 이 무섭게 생긴 오빠랑 같이……"
