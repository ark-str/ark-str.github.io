{
  "server": "kr",
  "storyId": "act23side_level_act23side_st02",
  "groupId": "act23side",
  "stageId": "act23side_st02",
  "title": "내가 믿는 것",
  "storyCode": "WB-ST-2",
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/activities/act23side/level_act23side_st02.txt",
  "sourceHash": "ef640c27062430e788d0eb846cb0c8c325fb6faab84a009e98f99c5a31a4d265",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "경과는 이렇습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "검은 와이 무치에게 있고, 그 사람 실력이라면 좌락도 어찌할 수 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "그 약속을 위해 삼 년이나 기다렸다니…… 참 재미있는 사람이군."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "태합의 상태는 어떤가?"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "아직 못 깨어났습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "태합에게 중상을 입히고 그저께 웨이 옌우를 암살하려고 했던 건 동일 인물입니다. 혼란을 틈타 도망쳤는데 상대할 수 있는 자가 아니라서 쫓아가지 못했죠."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "좌락이 도검방을 봉쇄하는 바람에 많은 무도인들이…… 붙잡혔습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "재앙을 눈앞에 두고 수비군과 강호인 사이가 또 완전히 틀어졌으니, 옥문은 더 혼란에 빠질 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "좌락의 충동을 탓할 수는 없지."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……이번 일은 당신이 직접 나서지 않으면 해결할 수 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "좌 장군은 내게 수비군 군영에 있으라고 했는데, 내가 노골적으로 장군한테 맞서면 안 되지."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "요 며칠간 있었던 일만 얘기하는 게 아니라는 거 아시잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "떠나기 전에 당신을 존경하는 이 도시 사람들에게 뭔가를 해야 하지 않겠나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "아니면, 설명하기 힘든 일은 피하면 그만이라고 생각하는 겁니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "다들 너를 내 학생으로 알고 있지만, 가끔은 나도 네 목적을 잊고 녹무관이나 좌락과 같은 아이로 생각한다니까."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "저는 한 번도 당신을 '스승'이라고 부른 적이 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "확실히 내가 스승은 아니지."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "넌 깨달음이 뛰어나고 검술도 대부분 혼자 연마했으니, 원래부터 내가 가르칠 수 있는 건 한정적이었지."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신이 모두에게 제 신분을 감추고 저를 옥문에 남게 했으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "아이 혼자 황야를 떠도는 걸 그냥 둘 수는 없으니까……"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "제가 당신을 죽일까 봐 걱정한 적은 한 번도 없나요? 아니면 전 영원히 당신을 이길 수 없다고 확신하는 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "복수라 해서, 꼭 무공으로 날 이겨야 하는 건 아니니까."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "밥에 독을 타거나 성벽에서 밀었으면 난 수백 번도 더 죽었을 테지."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "다만 네가 날 죽이고 나서도 집념을 버리지 못할까 봐 걱정될 뿐이다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "……만약 5년 동안 당신 곁에 있지 않았다면, 그 말을 들은 순간 당신을 세상에서 가장 위선적인 사람이라고 욕했을 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "5년이라, 벌써 그렇게 오래된 건가."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신한테는 긴 시간이 아니겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "그건 또 왜지?"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "십여 년이 지나도 외모는 조금도 변하지 않았고, 언제나 세상사를 통달한 듯 어쩔 수 없다는 표정을 짓고 있으니까요. 제가 아무리 둔해도 당신이 평범한 사람이 아니라는 것쯤은 압니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "이 땅에 수명이 매우 긴 종족이 있다는 것도 알아요. 예전에는 그저 전설인 줄 알았는데, 설마 내 곁에 그런 사람이 있었다니."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "이미 알고 있었구나."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "그저 별로 신경 쓰지 않은 것뿐입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "저의 목표는 복수일 뿐, 당신이 얼마나 오래 살든 저랑은 상관없으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "게다가 늘 당신이 평범하지 않다고 생각하는 건 스스로 핑계를 찾는 거나 다름없잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신 말처럼 높은 곳에 오르려면 한 걸음씩 올라가면 됩니다. 다른 건 생각해 봤자 마음만 어지러워지죠."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "하지만 원망과 이기고 지는 것만 생각하다 보면 원하는 바를 이루어도 내려놓지 못할 수 있다."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "검에 너무 많은 잡념이 담기면 둔해지는 법이지."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "평범한 사람은 그 집념에 의지해 사는 겁니다…… 당신도 잘 알잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "처음 만났을 때는 이렇게 무섭게 몰아붙이지 않았는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "5년 동안 당신에게 많은 가르침을 받았으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "난 무예를 익히는 마음가짐만 가르쳤다."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신 말대로 가르치는 건 한정적이지만, 가르친 것보다 더 많이 배우는 것 또한 각자에게 달렸죠."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "그건 그렇고, 먼저 당신을 생각하는 사람들을 만나러 가야 하지 않을까요."
    },
    {
      "type": "dialogue",
      "speakerName": "치우바이",
      "speakerId": null,
      "text": "당신은 너무나도 많은 사람들의 집념이니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "총웨",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "그 덩치 큰 사람이 사라졌네……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "거기 서십시오."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "또 너구나……"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "아가씨는 도적놈들과 한패가 아닌데 왜 검을 훔쳤습니까? 의원 사람과는 또 무슨 관계입니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "난 그놈들은 몰라. 그 사람이 누구인지도 모르고."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "본인이 얼마나 큰 문제에 휘말렸는지 모르는 것 같군요."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "당신은 이동도시에서 살아 본 적도 없고 옥문에 대해서도 하나도 모릅니다. 누군가 당신에게 검의 위치를 알려주고 훔치도록 이용한 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "하지만 그게 어떤 문제를 일으킬지 당신은 몰랐겠죠."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "제게 알려주면 일을 만회할 수 있을지도 모릅니다."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "말했잖아. 누구 지시를 받은 게 아니라, 은혜를 갚으려는 거라고."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "본인의 목숨을 잃더라도요?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "……아무튼 그만 따라와."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "진실이 무엇이든 전 무관한 사람이 위험에 빠지는 걸 두고 볼 수는 없습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "전 당신을 구하려는 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "아무리 듣기 좋은 말을 해도 소용없어. 넌 좋은 사람이 아니니까."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "전 명을 받고 조사하는 중입니다. 당신이 먼저 검을 훔쳤으니 말 못 할 사정이 있더라도 사실을 왜곡하면 안 되죠."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "네가 공방의 장인들을 모두 군영으로 잡아갔어. 그것만 봐도 믿을만한 사람은 아니지."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "그자들은 산해중이 도망치도록 저를 방해했습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "그 사람들은 그곳을 지키려던 거였어!"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "혐의를 벗기 전까지 모든 사람을 면밀히 조사해야 합니다. 재앙은 눈앞에 있고 도적이 반란을 일으켰으니 전 옥문을 책임져야 하고요."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "우리 부족에서는 열여섯 살이 되고 신체가 건강한 아나사에게만 부족 사람이 전용 무기를 만들어줘."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "무기를 받은 아나사는 노인과 아이 그리고 아픈 동족을 영원히 지켜줘야 하지."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "무관한 사람을 위험에 빠뜨릴 수 없다지만, 성을 지킨답시고 평범한 사람에게 무기를 겨눠도 되는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "전 맡은 직책이 있습니다……"
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "사부님 말이 맞아. 너희는 허울 좋은 이유만 대면서 정작 자기 잘못은 모르고 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "기껏 속도를 늦췄는데도 아무도 쫓아오지 않길래 와봤더니……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "검은 아직 내 손에 있는데도 둘은 신나게 대화 중이군?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "선생님, 제가 두 분을 오해한 것 같습니다. 원주인에게 돌려드릴 테니, 검을 넘겨주시지요."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "너희들의 말싸움을 듣고 얼추 이해했다."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "이 검은 원래 종사의 검인데 저 아가씨가 몰래 훔쳐 왔나 보군."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "종사의 무공은 완벽에 가까우니 특정 무기에 의지하지는 않을 터. 설마 검이 아까워서 네게 가져오라고 시킨 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "말씀드릴 수 없는 속사정이 있습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "종사를 번거롭게 하면 퇴임하는 날이 또 미뤄질 게 뻔하지…… 하지만 난 저 아가씨를 돕겠다고 약속했다."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "흠…… 어렵군, 어려워."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "아, 그렇지."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "원칙 같은 건 난 모르겠고, 명쾌하게 해결할 방법이 하나 있다."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "너희들도 실력이 제법 있는 것 같으니, 둘이 싸워서 결판을 내라. 무기는 쓸 수 없고 주먹으로만 싸운다면 승자에게 이 검을 넘기도록 하지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "황당하군요. 이렇게 큰일이 장난처럼 보입니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "저는 절대 하지 않을……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "……나는 시간이 없어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "매화꽃처럼 위치를 바꾸며 손과 발의 호흡을 맞춘다. 주먹이 오면 멈추고 주먹을 거두면 공격한다.\n촌내에 발경하되 힘을 올바르게 잡는다. 마음이 밖에 있으면 정신을 집중할 수 없다……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "어라?"
    },
    {
      "type": "narration",
      "text": "어슴푸레 하늘이 밝아오자 객잔의 점원들이 청소를 시작하며 오늘 주방에 필요한 식자재를 준비한다.\n리는 잠에서 막 깨어났다. 뒷마당에서 아침을 깨우는 파울비스트의 울음소리와 주먹을 가르는 바람이 전해진다."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "역시 부녀지간이군. 인연이란 게 참……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "훌륭하네. 아주 멋져."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "리 선생님……"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그 권법은 오랜만에 보는걸. 난 또 네가 갑자기 무슨 심법이라도 깨달아서 초식이 없이도 이기는 경지에 도달한 줄 알았지."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "또 농담하시네요."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "무공은 그렇게 심오한 게 아니에요. 실력을 키우려면 매일 꾸준히 수련하는 수밖에 없죠."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "지당하신 말씀."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "처음 네게 사무소 심부름을 시켰을 때, 버르장머리 없는 패거리를 건드렸던 게 기억나는구나."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "내가 깨닫고 달려갔을 때, 넌 녀석들을 다 쓰러뜨리고 혼자 서 있었지. 마치 아무 일도 없었던 것처럼."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그때 넌 겨우 열여섯 살이었어……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "전 말을 떼기 전에 이미 무공을 배우기 시작했어요."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그렇게 오래된 일도 기억하는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "그 사람…… 한테 들은 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "적어도 이쪽으로는 널 아주 잘 가르친 것 같구나."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "그런 말이 있잖아요. “스승은 입문을 도와주고, 수행은 각자에게 달렸다.”라고."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "뭐, 사실 '입문'도 중요하긴 하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그건 아마 그 녀석이 아버지로서 해줄 수 있는 유일한 일이 아니었을까 싶네."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "아, 그 녀석을 위해 변명하는 건 아니야. 그 녀석이 좋은 아버지는 아니지만, 그렇다고 네가 원하는 삶을 방해할 수는 없지."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "그 무공은 그 녀석이 네게 주는 선물이라고 생각해. 마음에 들지 않으면, 그냥 원치 않던 과외를 강제로 받은 거라 생각하고 버려도 되니까."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "무예의 정점을 추구하는 건 그 녀석의 길이지만, 그게 꼭 너의 길일 필요는 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "저는 이 무공이 싫지 않아요. 그리고 저도 제 인생이 있어요."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "전 용문 과학기술 대학교 기계 공학과의 우수한 졸업생이에요. 리 탐정사무소의 직원이자 로도스 아일랜드의 외근 오퍼레이터죠."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "하지만, 동청목 구의 정의 사도 No.1은 아니지."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "필요하다면 저도 그렇게 될 수 있어요!"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "이제 깨달았으니 다음에 만날 때 그 녀석에게 말해주면 되겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "리 선생님은 역시……"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "오랫동안 쓰지 않았던 권법을 갑자기 쓰는 건 당연히 그 이유가 있겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "아무튼, 그동안 그 녀석의 무책임한 행동이 원망스러웠다면 찾아가서 싸워도 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "speakerId": null,
      "text": "져도 상관없어. 그 녀석이 네 나이 때 꼭 너보다 실력이 좋았다는 보장도 없으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "와이후",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "(절레절레) 하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "그만."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "승부는 났어. 아가씨의 승리야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "자."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "일단 보내줄 테니 은혜를 갚고 나면 돌아와서 치료비를 갚도록."
    },
    {
      "type": "dialogue",
      "speakerName": "지에윈",
      "speakerId": null,
      "text": "……알았어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "애송이, 네 칼도 돌려주지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "상대가 다친 걸 알고 반격하지 않았으니, 수치스러운 패배는 아니로군."
    },
    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "그런 눈빛으로 볼 거 없다."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "저 아가씨는 돌아오겠다고 약속했으니 난 믿는다. 약속을 지키지 않으면 내가 사람을 잘못 본 것이지."
    },
    {
      "type": "dialogue",
      "speakerName": "와이틴푸이",
      "speakerId": null,
      "text": "그땐 내가 다시 잡아 오지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "이제 가도 돼."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "……왜 그렇게 쳐다봐?"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "다친 것 같지는 않네."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "예상 밖이라서? 아니면 실망했나?"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "네게 무슨 일이 생기는 건 원치 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "불필요한 오해 때문에 성가신 일에 휘말리게 해서 미안해."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "내가 다 설명했으니까 이제 괜찮아."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "잠깐."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "아까 여기 있던 병사가 그러던데, 이 완장…… 네가 준 거 말이야, 엊그제 성 밖에서 가져온 증거물이라던데."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "뭔가 설명해야 하는 거 아니야?"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "이미 알았는데 더 설명할 게 있나?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "두요야의 주먹은 허공에서 멈췄고, 린 위시아도 피하진 않았다."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "우리가 만난 지 얼마 안 되니까 나를 믿지 않는 건 이해해."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "너 대신 도검방을 조사할 사람이 필요했다면 나도 동의했을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "하지만 내 친구를 이용해서 날 속이는 건 아니었어."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "미……"
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "그만."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "넌 사과할 자격도 없어. 나도 널 용서하지 않을 거고."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "이게 용문 사람들이 일을 처리하는 방식인가?"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "이건 내가 일을 처리하는 방식이야."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "내가 그냥 이용만 당할 수만은 없잖아. 그래서 네가 알아낸 게 뭔데?"
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "네가 아는 걸 나한테 다 알려줘."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "원래는 의심이었지만, 지금은 확신이 들었어."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "성 밖에서 전달자 소대가 습격당했을 때부터 우리에게 일어난 모든 일이 다 수상했지."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "너희가 도검방에서 산해중을 만난 것도 우연이 아니야. 이건 맹 씨 도공이 놈들과 결탁했다는 가장 직접적인 증거지."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "정말 아저씨가……?"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "이런 일을 꾸밀 만한 능력도 명분도 있는 한 사람을 꼽자면, 그 사람밖에 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "이해가 안 가. 아저씨가 왜 이런 일을……"
    },
    {
      "type": "dialogue",
      "speakerName": "두요야",
      "speakerId": null,
      "text": "내 친구의 행방에 대해 대체 얼마나 알고 있는 거야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "잘 모르지만 이미 사람을 보내 조사 중이야."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "최악의 결과, 전달자 소대뿐만 아니라 옥문 전체가 엄청난 위험에 휘말릴 수도 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "린 위시아",
      "speakerId": null,
      "text": "그 사람의 목적이 이게 아니길 바라야지. 아니면, 다른 뭔가가 있다든가……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "맹철의",
      "speakerId": "avg_npc_789_1",
      "text": "하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "맹철의",
      "speakerId": "avg_npc_789_1",
      "text": "결국 늙으면 쓸모가 없어지는군. 마지막 일도 깔끔하게 처리하지 못했으니……"
    },
