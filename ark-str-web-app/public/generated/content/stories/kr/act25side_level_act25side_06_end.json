    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "speakerId": "avg_249_mlyss_1",
      "isRemote": false,
      "text": "사실은 나, 속인 사람이 또 있어, 하하. 나 진짜 못됐지?"
