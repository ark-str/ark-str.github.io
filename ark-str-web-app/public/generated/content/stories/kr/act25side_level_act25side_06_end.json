    {
      "type": "dialogue",
      "speakerName": "로즈몬티스",
      "speakerId": "avg_391_rosmon_1",
      "isRemote": false,
      "text": "응, 그 사람을 찾아갈게. 어떻게 해야 할지 알겠어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "29_g4_corridor"
    },
    {
      "type": "dialogue",
      "speakerName": "뮤엘시스",
      "speakerId": "avg_249_mlyss_1",
      "isRemote": false,
      "text": "……조용해졌네."
