  "sourceHash": "172e7d13339519dbbb8303ac2c2934c9ed5f9a4f260444f24366b829d4b7a948",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "食铁兽"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "용문의 한 고급 아파트"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "삐~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "음성 메시지가 1건 있습니다. 재생할까요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(재생 버튼을 누른다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "완셩셩, 어디에 간 거니? 한참 수소문했는데 널 봤다는 사람이 아무도 없더구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "진짜 나도 속은 거란다. 싱 그 자식이 돈을 홀랑 가지고 튈 줄 누가 알았겠니. 이 렁 아저씨도 이 영화에 투자했거든. 그래서 마음이 아프구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "완셩셩, 이 렁 아저씨가 너한테 한마디 안 할 수가 없구나. 아무리 시나리오가 마음에 들어도 그렇지, 어떻게 돈을 그 프로젝트에 다 집어넣었니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "아이고, 지금 이 꼴을 보렴. 영화도 못 찍고 돈도 물거품이 되고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "하아, 너도 힘들 테니까 여기까지만 하마. 이 렁 아저씨가 근위국에 아는 사람이 있다. 분명 이번 사건에 대해 철저히 수사해 줄 테니, 돈은 반드시 찾을 수 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "자동 응답기",
      "text": "그러니 너무 낙담해 있지 말고, 나중에 괜찮아지면 연락 주렴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(종료 버튼을 누른다)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아이고, 머리야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "끝장이군. 돈을 모두 날렸어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그 제작자도 분명 이 능구렁이가 소개해 준 건데, 일이 생기니 나 몰라라 하네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "으아아…… 정말 짜증 나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "이제 어떡하지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그냥 집으로 돌아가 아빠 탕후루 가게나 물려받을까…… 하아, 그러면 또 엄마가 허락 안 하시겠구나. 엄마는 내가 가전 권법을 세상에 알리기를 원하시니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(머리를 쥐어뜯으며) 대체 어쩌지……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(냉장고 문을 연다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "맥주는…… 다 마셨고, 위스키는…… 조금밖에 안 남았고, 보드카는…… 다 마신 지 오래고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "뭐야, 아무것도 없잖아…… 아무래도 내려가서 사 와야겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(냉장고 문을 닫는다)",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "콰당탕……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "뭐야…… 스읍, 이건 어제 버린 깡통이잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(며칠 동안 집 밖에 안 나갔더니 집이 난장판이네…… 일단 술부터 사 오고 좀 치울까?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(이런 건 일단 나중에 생각하자……)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "오, 크래프트 맥주네…… 이건 한 박스 사야겠다. 럼주도 오랜만이니 한 병 추가! 어디 보자…… 맨 위 선반엔 고급 보드카도 있잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "안 닿아…… 뛰면 잡을 수 있으려나? 흡!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아, 안돼. 떨어지겠다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "앗차차, 짜잔, 이 정도는 식은 죽 먹기지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "대, 대박!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "어, 누구세요?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨 맞으시죠? 제가 진짜로 완셩셩 씨를 만나다니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "저, 저는 당신의 팬이에요! 완셩셩 씨가 출연하신 영화는 전부 다 봤어요. 《천애협녀》 3부작은 몇 번이나 다시 봤는지 몰라요. 뵈, 뵙게 돼서 정말 여, 영광……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "저, 저는 완셩셩 씨가 아니에요. 사람을 자, 잘못 보신 것 같아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "그럴 리가요? 방금 병 잡는 모습은 《백만 용문폐》에서 보여주신 모습이랑 완전히 똑같았는걸요! 7번이나 본 작품이니 틀림없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그, 그런가요? 하하, 꽤 오래된 영화인데…… 5, 6년은 되는……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "……어, 어쨌든 사람 잘못 보셨어요. 그럼 이만 결제해야 해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨, 제가 귀찮게 해드렸죠. 죄송해요. 이, 일부러 그런 건 아니에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "정말 죄송해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "앗, 그, 저, 그런 뜻으로 한 말이 아니라…… 하아, 사인 받고 싶어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "사인이요?! 정말입니까? 너무 고맙습니다. 잠시만요, 적당한 종이가 있는지 찾아볼게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(이 녀석, 주머니란 주머니는 다 뒤적이네……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "종이, 찾을 수 있겠어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "찾았습니다! 일단 지폐…… 입니다만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "아니면…… 그……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "하아, 완셩셩 씨, 그냥 이 지폐에 사인 부탁드려요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "음…… 그래, 알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(지폐가 너무 꼬질꼬질해!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "정말 감사합니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "무협 좋아하나 봐? 영화 말고, 혹시 소설도 봐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "네! 미스터 웡의 대하소설이랑, 치쓰 씨의 단편 소설, 그리고 《월간 무협》도 매호마다 빠짐없이 다 읽었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "치쓰 씨 글도 좋아한다고? 내 주변 사람들은 다들 전개가 너무 느려서 지루하다고 하던데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "그게 어떻게 전개가 느린 거예요. 치쓰 씨는 섬세한 묘사로 눈물샘을 자극하는 분이신걸요. 그분의 작품은 모두 보기 드문 걸작이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "맞는 말이야. 그 돌대가리들은 진짜 작품을 감상할 줄 모른다니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨도 치쓰 씨 소설을 좋아하세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "내가 제일 좋아하는 소설은 《합의권》이야! 집에 있는 그 책은 너무 많이 봐서 다 너덜너덜해졌어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "근데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그거 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그 소설은 원래 영화화할 예정이었어. 그런데 윈셩 역할을 맡기로 한 배우가 탈세 문제로 근위국에 잡혀들어갔고, 제작자는 돈을 들고 튀어버렸어. 그래서 결국 흐지부지되다가, 무산돼 버렸어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "하아, 너무 아쉽네요. 인연이 아니었나봐요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "세상일은 모르는 거라니까. 누가 이렇게 될 줄 알았겠어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "음…… 아니에요. 생각해보니 윈셩은 성실하고, 불의에 맞서 용감하게 싸우는, 몸이 갈가리 찢어져 죽을지언 권력과 타협하려 하지 않는 인물이잖아요. 그런 캐릭터를 어떻게 탈세나 하는 사람이 연기할 수 있겠어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "그러니 어떻게 보면 무산된 게 차라리 다행인 것 같아요, 하하.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "……그건 또 그렇네. 하하. 그렇게 생각하는 것도 나쁘지 않은 것 같아. 하하하.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "네 말이 맞아. 거기다 그 사람은 성질도 고약하고, 연기 실력도 별로고, 스타병도 심해! 윈셩이랑 전혀 안 어울려. 처음에 그 사람이 배역을 맡았단 말을 듣고 나 엄청 화냈거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "맞아요. 정말 다행이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아, 날이 어두워졌다. 난 얼른 가봐야겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "저, 저도요. 완셩셩 씨, 기회가 되면 또 봬요. 아, 다시 만날 기회가 거의 없겠네요. 사인 감사합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아, 잠시만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "레이디 장, 나란주의 사막은 길이 험하여 한번 가면 돌아올 수 없대요. 언제쯤 돌아올 수 있을까요? 또 언제쯤 다시 만날 수 있을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "운가의 꼬마야. 집이 있기에 돌아올 수 있는 것이고, 인연이 있다면 언제든 만나게 되는 것이란다. 세상일은 한 치 앞도 알 수 없으니, 그때까지 건강히 잘 지내렴.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "하하, 너 그 소설 진짜 좋아하는구나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "잘 가!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "다음날"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "으…… 머리야. 숙취 때문에 죽겠네. 어제 적당히 마셨어야 했는데. 윽…… 머리가 깨질 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "완셩셩 씨, 무슨 일이세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "리화, 혹시 따뜻한 탈지유 있으면 한 잔만 가져다 줄래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "완셩셩 씨, 저희 오늘은 휴업이라 문 닫고 집에 가려던 중이었어요. 도움이 못 돼서 죄송해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "휴업? 무슨 일 있어? 어제까지만 해도 멀쩡히 영업했었잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "어젯밤에 도둑이 들었거든요. 도둑이 도망갈 때 선반을 몇 개 넘어뜨려서 가게 내부가 엉망진창이 됐었어요. 지금은 다 정리했지만요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "저런, 도둑은 잡았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "휴…… 다행히 보자이 씨가 잡았어요. 도둑이 발악하는 바람에 좀 다쳤지만요. 이마가 좀 크게 찢어졌어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "뭐? 보자이는 지금 어딨어?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "완셩셩 씨, 진정해요. 보자이 씨는 병원에서 약 바르고 바로 집으로 갔어요. 괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그래. 보자이는 솜씨가 좋으니까, 그런 보자이를 만난 도둑이 오히려 운이 없었던 거지. 아, 그런데 혹시 최근에 누구 나에 대해 물어보고 다니는 사람 없었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "몇몇 수상한 기자들이 완셩셩 씨의 근황에 대해 물어보긴 했어요. 그래서 보자이 씨가 시킨 대로 대충 둘러대고 돌려보냈어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(머리를 긁적이며) 요 며칠 귀찮게 해서 미안해. 나중에 맛있는 밥 한번 살게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "아니에요. 그때 완셩셩 씨의 도움이 없었다면 저랑 보자이 씨도 용문에서 자리를 잡지 못했을 거예요. 이 정도는 당연한 거니 신경 쓰지 마세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "헤헤, 나도 늘 와서 공짜술 얻어먹는 걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "마시면 또 얼마나 마신다고요. 아, 맞다, 완셩셩 씨, 혹시 잃어버린 물건은 없나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "다 있는 것…… 같은데. 그런 갑자기 왜 묻는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "그 도둑이 어제 완셩셩 씨랑 한참이나 얘기했잖아요. 그래서…… 완셩셩 씨가 부주의한 틈을 타 뭔가 훔치지 않았을까 해서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "후후, 누가 감히 내 물건을 훔쳐 가겠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "잠깐만, 방금 누구라고?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "아, 완셩셩 씨가 어제 술 사러 왔을 때 먼저 말 걸었던 그 남자요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "뭐라고! 그 사람이?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "완셩셩 씨, 왜 그러세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "음…… 그 녀석 지금 어디 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "그, 근위국 구치소에 있을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "나 먼저 갈게……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "……나중에 봐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "점원",
      "text": "네? 완셩셩 씨!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "너……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "(고개를 숙이며) 저……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "젊은이, 이 아가씨가 대신 벌금을 내준다고 하니, 앞으로 성실하게 살아. 좀도둑질 같은 건 다시 하지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "네, 경관님. 이제 두 번 다시 하지 않겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "먼저 이 아가씨한테 고맙단 말을 해야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "……폐를 끼쳤습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "너, 도대체 왜 그런 짓을 한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "그건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "(배에서 꼬르륵 소리가 난다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "뭐, 됐어. 일단 나가서 밥부터 먹자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "경관님, 폐를 끼쳤습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "이 목소리…… 엄청 익숙하네. 어디서 들어봤던 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "으이구, 멍청아. 완셩셩 씨잖아. 너 어제도 완셩셩 씨가 출연하는 《근위국의 옛이야기》를 봤잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "어!? 그럼 저 선글라스 낀 아가씨가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "그래, 네가 제일 좋아하는 액션 스타 완셩셩 씨야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "내가 대체 뭘 놓친 거지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "쯧, 그나저나 저 대스타도 요즘은 좀 힘들 거야. 영화 투자에 실패해서 파산할지도 모른대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "아니, 어쩌다가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "너 뉴스도 안 봤어? 요새 난리잖아. 협력 업체에 재무 문제가 발생했는데, 그걸 완셩셩 씨한테 싹 다 떠넘기고 도망갔대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "저런, 완셩셩 씨 엄청 힘들겠네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "무랑 면을 추가한 어묵탕 곱빼기 두 그릇입니다. 맛있게 드세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "사장님 정말 솜씨가 좋아. 이건 진짜 만 번 먹어도 안 질릴 것 같다니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "하하, 이젠 대스타면서 뭐 하러 포장마차까지 오고 그래. 파파라치한테 사진이라도 찍히면 어쩌려고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그게 뭐 어때서, 찍히면 그냥 가게 홍보한다 치면 되는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "그러지 마. 나 광고료 줄 돈 없어. 아, 그쪽은 왜 드시지 않고, 보고만 있어요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그냥 먹어. 사양하지 말고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "감사합니다, 완셩셩 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "얘기들 나눠요. 카레 수프 조리 중이라 가봐야겠어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "이게 어묵탕이란 거군요. 용문에 와서 처음 먹어보는데, 정말 맛있네요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "난 여기 자주 오거든. 소문으로는 여기 사장님이 예전에 용문 어느 갱단의 보스였었는데, 지금은 은퇴하고 이 포장마차에서 어묵을 팔고 있는 거래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "푸웁…… 콜록콜록!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "(힐끗 본다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "헤헤, 뻥이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "콜록…… 크흠. 괘, 괜찮아요, 완셩셩 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "참, 그리고 너 아직 내 질문에 대답을 하지 않았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "저, 전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "가게에서 왜 그랬던 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "이틀 동안 굶어서…… 너무 배가 고파서 그만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "좋아, 배고파서 훔친 건 어쩔 수 없었다 쳐. 그럼, 사람을 왜 다치게 한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "사장님이 저를 붙잡았을 때, 제 손에 쥐고 있는 지폐를 봤거든요. 돈을 내지 않으면 물건을 가져갈 수 없다고 그래서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그럼 계산하기 싫어서 사장님을 다치게 한 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "……완셩셩 씨, 그 돈은 제 마지막 돈이었어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그렇다고 해서 사람을……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아, 그게 그 지폐였구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "네, 원래는 어제 그걸로 가게에 들어가서 먹을 걸 사려고 했어요. 근데 완셩셩 씨 사인을 받고 나니 그게 너무 아까워서 그만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그랬군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그럼…… 오늘 밤 어디 갈 곳은 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "아, 아뇨. 지난주에 집주인에게 쫓겨났어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "앞으로 어떡할 거야? 고향에 돌아갈 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "부모님은 일찍 돌아가셨고, 고향에 가도 아무도 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "여기에 친구는 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "용문에 온 지 두 달밖에 안 돼서 아는 사람도 없어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그런……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨, 전 아무 능력도 없어서…… 먹고살기가 쉽지 않아요. 하지만 당신을 만날 수 있어서 정말 기뻐요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "하아, 너무 비관적으로 생각하지 마. 언젠가는 괜찮아질 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "(눈물을 훔치며) 완셩셩 씨, 제가 나빴어요. 폐를 끼쳐서 정말 죄송해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그래서 앞으로…… 어떻게 할 생각이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "글쎄요. 입에 풀칠만 할 수 있다면, 어떻게든 살아갈 수 있겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "사장님, 펜 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "어, 있어. 서랍에 있으니까 가져가서 써.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "어디 보자. 찾았다. 종이도 한 장 찢어가도 돼?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "알아서 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "(펜을 들고 글씨를 쓴다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "이거 받아. 내가 아는 현장 매니저 연락처인데, 찾아가서 잡일이라도 시켜달라고 해. 월급은 그렇게 많지 않지만, 식사랑 숙소는 무료로 제공해줄 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "고마워요…… 완셩셩 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "사장님, 여기 어묵탕 2인분 추가! 하나는 포장, 하나는 먹고 갈게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "그래!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "앞으로 잘 지내. 지나간 날들은 모두 잊어버리고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "여기 어묵탕 하나 포장이오. 받으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "이거 가져가. 그냥 주는 게 아니니까 나중에 돈 벌면 갚아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "흑흑…… 완셩셩 씨, 정말 죄송해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "괜찮으니 얼른 촬영장에나 가봐. 너무 늦으면 다들 퇴근해버려서 매니저를 찾지도 못할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "네, 완셩셩 씨. 저 가볼게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "또 봐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "가난한 남자",
      "text": "완셩셩 씨, 저 꼭 열심히 일하는 성실한 사람이 될게요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "하하, 알겠어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "하아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "웬 한숨이야. 왜, 내 어묵탕이 별로야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "사장님, 나도 힘들어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "대체 무슨 일이야. 어제는 렁 아저씨가 찾아와서는 네가 일주일 동안이나 아저씨 전화를 안 받는다고 그러더라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "내가 전에 얘기했던 시나리오 기억해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "치쓰의 《합의권》?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "응, 그거 밑졌어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "얼마나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "전 재산.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "설마, 한 푼도 안 남은 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "저금이 조금 있긴 한데, 그건 자선 단체에 정기적으로 기부하는 돈이라 쓸 수 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "그럼 앞으로 어떻게 할건데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "운이 좋으면 도망친 사람을 잡아 돈을 돌려받을 수 있겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "못 잡으면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그때는 처음부터 다시 시작해야지. 내 특기인 쿵후 때문이라도 영화는 계속 들어올 테니, 굶진 않을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "그럼 네가 계획했던 것들은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "나한테 계획이 어딨어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "사람은 말이야, 정신이 맑지 못할수록 뒷일을 더 걱정하는 법이야. 오밤중에 내일을 생각한다거나, 아니면 술에 취해 미래를 얘기한다거나. 술에서 깨어 눈을 뜨고 나서야, 쓸데없는 생각이 적을수록 더 잘 살 수 있다는 걸 깨달을 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "언젠가는 기회가 생기겠지. 그럼 틀림없이 괜찮아질 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "난 강하니까 위로 안 해줘도 돼. 그냥 내일도 사장님의 어묵을 먹을 수만 있다면 어떻게든 살아갈 수 있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "너무 치켜세워주는 거 아냐……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "그리고 어떻게 삶을 기회만 기다리면서 살 수 있겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아무리 짧더라도 가끔씩 사소하게 즐거운 일이 있다면, 설령 아무것도 바뀌지 않더라도 난 며칠 더 힘차게 보낼 수 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "그럼 최근에는 무슨 즐거운 일이라도 있었어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "당연하지. 지금 막 사장님이 만든 어묵을 먹었잖아. 너무 맛있어서 혀까지 호강하고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "쯧, 그럼 그거 말고는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "음…… 글쎄. 아, 어떤 감독님이 연락이 왔더라고. 출연료도 많이 준다고 하길래 내일 오디션 보러 갈 예정이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "그래. 그럼 나도 어묵 한 접시 서비스할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "(어묵 한 접시를 테이블에 놓는다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "오, 이건 신메뉴야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "매운맛 어묵을 만들어보고 싶은데, 시장성이 있을지 모르겠네. 그러니 시식 좀 해줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "맛있어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "아야야, 근데 혓바닥이 탈 것 같아. 이건 나한테도 너무 매워!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "여기 얼음물 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "완셩셩",
      "text": "으아아, 안 마실래. 습~ 하~ 습~ 하~ 이건 분명 좋은 징조야…… 습~ 하~ 내 사업도 이렇게 활활 타올라서 성공할 거라는 거잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제이",
      "text": "정말 못 말려……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "2주 후"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "카, 좋은 아침. 커피 좀 마셔.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "고마워요, 야오 형. 오늘은 어때요, 바빠요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "여전히 일이 너무 많아! 근데 뭘 찾는데 그렇게 신문을 뒤적거려?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "뭐 재밌는 거 없나 싶어서요. 근데 야오 형, 요새 완셩셩 씨 얘기는 신문에서 아예 찾아볼 수가 없네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "못 들었어? 며칠 전에 완셩셩 씨가 촬영 도중 다쳐서 응급실에 실려갔잖아. 아직 상태가 어떤지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "단순 외상이라면 금방 퇴원할 텐데, 왜 이렇게 오랫동안 기사 한 줄 없는걸까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "스타잖아. 일이 터졌으니 조용히 처리하려는 거겠지. 어쩌면 벌써 집으로 돌아갔을지도 모르니까 너무 걱정하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "하지만 너무 걱정돼서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "뭐 이런 거 갖고 예민하게 굴어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 A",
      "text": "그게 아니라요. 오늘 아침 오는 길에 봤는데 완셩셩 씨의 광고가 전부 내려졌더라고요. 하나도 남김없이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "근위국 대원 B",
      "text": "그건, 확실히 이상한데……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
