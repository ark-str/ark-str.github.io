    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "speakerId": "char_337_utage",
      "isRemote": false,
      "text": "큰일 났네. 저 사람 이미 이성을 잃어버린 것 같은데."
