    {
      "type": "dialogue",
      "speakerName": "우타게",
      "speakerId": "char_337_utage",
      "isRemote": false,
      "text": "그래?!"
    },
    {
      "type": "dialogue",
      "speakerName": "마이카",
      "speakerId": "avg_478_kirara_1",
      "isRemote": false,
      "text": "차에서 자신은 보석 가게를 턴 게 아니라 누명을 쓴 거라고 말했어."
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "speakerId": "char_337_utage",
      "isRemote": false,
      "text": "정말 그런 말을 했어?"
