  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "아…! 조심해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아얏!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "미, 미안. 일부러 부딪친 게 아니야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "괜찮아, 예의 바른 아이구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "헤헤......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "그런데 누나, 여기서 뭐해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "비가 오는데 왜 그냥 맞고만 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아… 응… 그냥 산책 중이었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "뭔가 도와주었으면 하는 일이 있니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "아! 누나, 어떻게 알았어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "안 가르쳐 주지~! 누나의 비밀이거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "으음… 알았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "누나, 그러면…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "으음… 누나는 안 될지도 모르겠다. 키가 작아서…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그! 그런 말 하면 못써! 그래도 너보단 크잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "우왓!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "그, 그럼 해볼까… 음… 이 널빤지 들어줄 수 있어? 같이 들자!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "저 철골 아래 축음기가 있는데, 그걸 가져가고 싶거든!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "알았어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "하나… 둘… 셋… 이얍!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "좋았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "와, 누나 힘 진짜 세다! 고마워!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그런데… 이 축음기 망가진 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "괜찮아! 원래부터 망가져 있었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "언젠가 꼭 고칠 거야. 다른 사람들한테 들려주려고 레코드를 많이 모아 놨거든. 한 번도 들어보지는 못했지만…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "…그래도 나중엔 꼭 다른 사람들한테 들려줄 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…그렇게 어려운 말을 쉽게 하는구나…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…나는 누구를 위해… 무엇을 할 수 있을까…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "누나는 나 안 무서워?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…무섭다니?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "나 사실 감염자야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "후후… 나도 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "정말?! 아깝다, 이렇게 예쁜 누나가 감염자라니…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "감염자든 아니든 상관없어. 건강하더라도, 감염됐더라도…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네가 착한 아이라면, 그 사실만큼은 변하지 않을 테니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "으응~? 무슨 말인지 잘 모르겠는데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "(꼬르륵…)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…배고파?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "…응.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…자, 이거 먹어. 이게 전부긴 하지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "신난다! 고마워, 토끼 누나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "그런데 누나… 여기는 왜 온 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "나는…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어떤 사람이랑…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "어떤 사람이랑 약속했거든.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아이",
      "text": "누나, 안녕!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "응, 안녕!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저런 어린아이도 마지막엔, 마지막에는…",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "신분을 박탈당한 자. 감염자. 너희는 사람도 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "내가 뭘 할 수 있을까? 내가 더 할 수 있는 건…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "난 왜… 모두를 지켜줄 수 없는 걸까…",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "넌 아무것도 할 수 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아니야… 나는…",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "굶주림… 핍박… 죽음…\n감염자를 기다리는 최후란 결국 그런 것뿐이지."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그렇지 않아…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "로도스 아일랜드가 감염자의 힘이 되어준다면…",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "너는 일부 운 좋은 사람일 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아니야, 모두가 함께 같은 목표를 위해 끊임없이 노력하고 있는걸.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "이 대지는 이미 전부 마비되어 버렸어."
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "아직 그 정도는 아니야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "감염자는 절대 절망에 삼켜져선 안 돼…",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "너는.\n분노에 삼켜지리라.\n그것 밖에……"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "나…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "나는… 절대로…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "약속했으니까…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그 아이와 약속했으니까…!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "…어라?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저게 뭐지…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이",
      "text": "다른 언니가 가르쳐 줬어. 이 인형은 손으로 직접 만들어야 의미가 있대.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이",
      "text": "그러니까, 그러니까 이거 줄게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "또 다른 소녀의 목소리",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 목소리는…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저 뒷모습은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이",
      "text": "………………!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "여자아이",
      "text": "…………!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "또 다른 소녀의 목소리",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님, 여기서 뭐하고 계세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "전 분명…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "너와는 상관없는 일이다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "첸",
      "text": "용문에 관한 일은 내가 처리한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "처음 봤어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "첸 팀장님이 저런 눈빛을 한 건……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
