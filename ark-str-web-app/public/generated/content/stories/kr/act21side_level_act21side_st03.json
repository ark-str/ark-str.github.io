{
  "server": "kr",
  "storyId": "act21side_level_act21side_st03",
  "groupId": "act21side",
  "stageId": "act21side_st03",
  "title": "뼈를 깎는 고통",
  "storyCode": "IS-ST-3",
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act21side/level_act21side_st03.txt",
  "sourceHash": "0895bfb9225c5d4e6fbf07552f71aba0152041a9d55d334dc1953fcb73b51b81",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "와, 진짜 판사님이네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "당신이 루비오 장관의 따님이신가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "네…… 판사님이 와준다는 얘기, 난 아빠가 농담하는 줄 알았는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "저랑 제 친구들 모두가 판사님을 존경해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "우리 아빠 같은 사람들에 비하면, 판사님은 정부에서 유일하게 마음이 깨끗한 사람이잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……루비오 장관과 사이가 좋지 않은 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "……좋지도 나쁘지도 않아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "그래도 난 아빠를 좋아하는 편이에요. 아빠는 늘 시간이 많아서 저랑 많이 놀아주거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "하지만, 지금은 아빠처럼 자기 보신할 줄만 아는 사람은 정말 패기가 없는 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "예전에 아빠랑 함께 밑바닥에서 시작한 동료들은 지금 다 출세해 있거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "아빠만 그 연세에 아직도 별 볼 일 없는 자리에 앉아 있죠, 요만큼의 진취심도 없는 건 우리 아빠뿐일 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "루비오 씨의 예전 동료?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "네, 얼마 전에 죽은 건설부 장관 카라치 아저씨 말이에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "그 자리 자체가 위험하니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "알아요…… 하지만, 전 TV에서 매일 그 사람을 볼 수 있었어요. 패밀리의 사람들마저도 모두 그분에게 예의를 갖췄잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "정부 관리가 되려면 그 정도 되는 자리엔 올라야 의미가 있다고 생각되지 않으세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "그럴 수도 있겠네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "그래서, 이번에 아빠가 갑자기 건설부 장관에 부임하신다는 소리에 사실 엄청 놀랐어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "아빠가 어떻게 그렇게 갑자기 생각을 바꾼 건지…… 진작에 그랬다면, 엄마도 아빠랑 이혼하지 않았을 텐데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "이혼?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "네, 엄마도 아빠가 너무 의욕이 없으시다면서 싸우시더니 결국 몇 년 전에 이혼했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "그런데 사실 엄마 성격도 별로 안 좋은 편이라 최종적으로 전 아빠를 따라가기로 한 거고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "맞다, 판사님, 판사님은 아빠가 어떻게 건설부 장관 후임으로 선정되었는지 아시죠? 말해주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……죄송하지만 그건 저도 모릅니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "아, 네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "일단 편하게 앉으세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "저도 오늘은 아무 데도 안 가고 아빠의 연설을 들을 예정이거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "(루비오 장관의 방…… 생각보다 깔끔하네.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "이상하죠? 아빠는 칠칠치 않은 사람처럼 보이지만, 사실 매우 규칙적인 생활을 해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "참, 아빠는 일기 쓰는 습관도 있다니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "일기요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "네, 제 기억엔 바로 저기 뒀었는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "말이 일기지, 사실 아빠는 생각나는 걸 그냥 적는 것 같아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "최근 몇 년간 띄엄띄엄 쓴 걸 모두 합쳐봤자 겨우 이 정도네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "마음대로 봐도 괜찮아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "괜찮아요. 아빠가 여기에 두었다는 건 다른 사람이 봐도 개의치 않는다는 뜻일 거니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "저도 몇 번 봤는데 전부 재미없는 내용뿐이었어요. 뭔가 전형적인 중년 아저씨의 생활 기록부 같달까요, 따분하고 지루해요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "궁금하시면 얼마든지 보세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "벨로네 패밀리 멤버",
      "text": "루비오 씨, 이쪽이 연설 장소입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "다들 나가 봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "벨로네 패밀리 멤버",
      "text": "하지만…… 저흰 당신을 보호하라는 명령을 받았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "아무도 들어올 수 없을 텐데, 아닌가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "벨로네 패밀리 멤버",
      "text": "알겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "쯧쯧, 권력이란.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "소파로 문을 막고…… 내가 할 수 있는 건 이 정도뿐이겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "그다음은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "카라치, 조금만 더 기다려라, 금방 따라가마.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어떻게 됐어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……의사 말로는 공격받은 위치가 심장에서 몇 센티미터 빗나간 덕분에 즉사하지 않은 거래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "하지만, 여전히 상황이 좋진 않아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "텍사스 씨는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어제 돌아온 이후로 계속 넋이 나간 것처럼 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "저기 앉아서 꿈쩍도 안 하고, 밥 먹으라고 해도 반응이 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소라",
      "text": "……혼자 잠깐 두자. 나랑 크루아상은 병원에 있을 테니까 텍사스 씨를 부탁할게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그래, 너희도 병원에서 조심하고.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……하아, 심심한데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "맞다, 오늘 무슨 연설이 있다고 했던 것 같은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "들어봐야겠다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "친애하는 시민 여러분, 안녕하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "여러분 대부분은 저에 대해 잘 모르시겠지만, 전 그것을 전혀 이상하다고 생각하지 않습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "저는 지금까지 식품안전부 장관이라는 별로 중요하지 않은 직책을 맡고 있었으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "사실 대부분의 시민 여러분께서는 전임 카라치 장관과 라비니아 판사님을 제외하고는 우리 정부에 대해 거의 아는 바가 없으실 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "저는 판사님과 잘 아는 사이가 아닙니다만, 카라치 전 장관과는 다소 친분이 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "오늘의 연설은 여러분이 잘 아는 그의 얘기부터 시작해보겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "저와 카라치는 같은 시기에 시장감독국에 입사했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "카라치는 충만한 에너지와 씩씩함으로 실사 담당을, 저는 후방 지원차 서류 작업을 맡았었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "카라치는 그때 당시부터 거대 패밀리들조차 두려워하지 않을 만큼 겁이 없기로 유명했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "솔직히 카라치는 꽤 목숨이 끈질긴 편이었습니다. 몇 번이나 불만을 품은 거대 패밀리에 의해 제거당할 뻔했지만, 모두 피했거나, 버텨냈으니까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "아무튼, 당시 감독국 내에서는 모두 카라치를 싸움닭으로 여기며 아무도 도와주려 하지 않았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그렇게 카라치에게 보고하는 업무 역시 미움받고 있는 제게 맡겨졌습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "카라치에게 업무 보고를 하기 위해 저는 많은 공을 들여야 했어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "하지만, 그 일을 하면서 저는 성취감도 느꼈죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "비록 저는 카라치처럼 대담하게 일을 하진 못했으나, 카라치는 제가 하고자 하는 일을 대신 해주었고, 저도 카라치에게 공들인 업무 보고를 했습니다. 일종의 보답이랄까요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그러다 보니 어느새 저희는 꽤 깊은 사이가 됐습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "레온, 네가 지난 몇 년간 카라치와 함께 일하며, 카라치를 높이 평가했다는 건 나도 잘 알고 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "네가 아는 카라치는 어떤 사람이었지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "……활력이 넘치는 사람이었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "패밀리를 다루는 방법을 아주 잘 알고 있었어. 단순히 잘 알고 있다라 표현하기엔 부족하겠군. 교묘하게 패밀리에 혜택을 주면서 그들이 자신의 목적을 위해 움직이게 만들었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "원래대로라면 여러 패밀리에 의해 방해받았을 여러 일들도, 카라치의 손에선 언제나 잘 처리됐지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "너의 행동도 카라치의 영향을 많이 받은 것 같더구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "나는 그저, 그 방식이 내 생각과 비슷한 점이 있다고 생각했을 뿐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "지금은 서로 싸우고 죽여서 문제를 해결할 수 있는 시대가 아니야, 아버지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "패밀리도 시대를 따라가려면 시대에 맞게 변해야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "레온, 넌 역시 아무것도 모르는구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "뭘 모른다는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "너는 무의식적으로 너 자신을 라비니아 그리고 카라치와 같이 놓고 평가하는 경향이 있다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "하지만 잊지 말거라, 넌 그자들과 달라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "알고 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "만약 정말로 알고 있다면, 네가 여기 서 있지는 않았을 테지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "아쉽지만, 이젠 시간이 없구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "레온투초",
      "text": "아버지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "레온, 만약 네가 살아남는다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "베르나르도",
      "text": "됐다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "비록 많은 패밀리에게 있어 눈엣가시이긴 했지만, 카라치는 누구나 인정할 수밖에 없는 뛰어난 능력을 갖추고 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그렇기에 저보다 훨씬 빨리 승진해 갔죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "솔직히 저는 당시 카라치가 승진하면 바로 죽을 줄 알았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그전까지는 이익과 크게 관련이 없는 자리에 있었기에, 죽음을 초래할 만큼의 위협이 다가오지 않은 것이라 생각했던 거죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "하지만 만약 지위가 올라간 뒤에도 계속 자신만의 방식을 유지한다면, 틀림없이 감당하기 어려운 인물들까지 자극하고 마리라 생각했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "하지만 저는 틀렸습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "……아빠가 이렇게 말을 잘하는지 몰랐는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "판사님이 보기엔 어떠세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "판사님?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "라비니아는 루비오의 딸이 자신이 부르는 걸 전혀 알아채지 못했다.\n그녀는 모든 정신이 손에 든 일기장에 팔려있었다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "루비오, 당신은 대체……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "사실 우리 조직에서 카라치와 같은 초심을 가진 사람은 결코 적지 않았습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "다만 이러저러한 이유로 그들은 결국 패밀리에 굴복하고, 더 나아가 아첨하는 것을 선택했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "하지만 카라치는 달랐습니다. 그는 굴복하지 않았을 뿐만 아니라, 늘 그들에게 대항할 방법을 모색해 왔습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그 노력은 가치가 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "제가 당초 생각했던 것과는 달리 바로 죽기는커녕 점점 더 높은 곳으로 올라갔죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그리고 어느 한 파티에서 다시 재회했을 때, 카라치가 제게 했던 말이 아직도 기억에 생생합니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "“지금의 패밀리는 연약하다.”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "이 아저씨 간이 꽤 큰데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "음…… 텍사스, 밖에 무슨 일이 생긴 것 같은데, 좀 보고 올게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "엑시아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "텍사스",
      "text": "조반나를 용문으로 데려가는 거 어떻게 생각해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "좋지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "조반나는 재미있는 사람인 것 같아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "그런데…… 넌 그렇게 생각하지 않는 것 같네?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "텍사스는 시선을 창가의 테이블로 돌렸다. 그곳에는 목걸이가 하나 놓여 있었다.\n시칠리아 부인의 증표.\n조반나가 그녀에게 남긴 선물이었다.\n할아버지의 눈에 컬럼비아의 모든 패밀리는 예전 같지 않은 듯했다.\n그들은 이익을 위해서라면 더러운 일에도 거리낌 없이 손을 댔으며, 비도덕적인 살인마저 저질렀다.\n아버지의 눈에 시라쿠사의 패밀리들은 썩어있었다.\n눈앞에 손쉽게 얻을 수 있는 이익을 챙기려 하지 않고, 도의 따위를 위해 자신의 발전을 제한하는 모습이 어리석기 그지없다고 말하곤 했다.\n하지만 텍사스가 봤을 땐 할아버지와 아버지의 말씀이 모두 일리가 있으면서도, 둘 다 틀린 것 같았다.\n만약, 자신이 그저 조반나의 처지에 분노하는 것뿐이라면, 7년 전처럼 바로 떠나면 된다.\n다만, 이번에는 조반나를 데려갈 것이다.\n할아버지의 죽음을 알았을 때, 그 세차공을 못 본 척했을 때, 도움을 요청하라는 아버지의 명령을 무시했을 때, 텍사스가 생각했던 것은……\n이 모든 것에 끝이 없을 것 같다는 것이었다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "카라치는 제게 패밀리를 다루는 방법을 가르쳐 주었습니다. 그 방법은 웃길 정도로 간단했지만요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "카라치는 패밀리에게 거절할 수 없는 물품이나 이익을 주었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "물론 패밀리들이 그가 가진 루트를 빼앗지 못하는 건 아니었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "하지만, 그들에겐 훌륭한 관리자가 부족했습니다. 약탈할 줄만 알지, 진정한 관리가 무엇인지 몰랐거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "카라치는 자신의 그 뛰어난 능력으로 한 걸음씩 나아가더니, 결국 여러 거대 패밀리에게 환영받는 사람이 되었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그리고 거대 패밀리들이 건설부 장관 자리를 놓고 다툴 때, 모두가 만족할 만한 인물로 그가 꼽혔죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "여기까지 들은 지금, 이런 의문이 드는 분들도 계실 겁니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "결국 카라치도 줄타기를 잘하는 사람과 다를 바 없는 것이 아니냐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그러나 제가 말하고 싶은 것은 시라쿠사와 같이 악을 바탕으로 하는 나라에서 선인이 존재한다는 가정은 처음부터 성립되지 않는 것입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "좀 더 과격하게 말하면, 우린 모두 악입니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "……이거, 부임 연설에서 할 말은 아니지 않아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "으음, 역시 미리 거점을 옮겨놨어야 했나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하지만 어제 그런 일도 있었고, 뭐 어쩔 수 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 사람",
      "text": "쳇, 이 산크타 만만치 않네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "패밀리 사람",
      "text": "상대는 혼자야, 둘러싸!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "내 소중한 파트너가 쉬고 있는데, 너네 좀 조용히 할 수 없을까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "하아, 정말 민폐 덩어리들이네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "……아, 이럴 때 옆에 누군가 있었으면 “엑시아, 네가 할 말은 아니지!”라고 했겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "혼자서는 정말 재미없네.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라플란드",
      "text": "여기에 도움이 필요해 보이는 사람이 있는 것 같네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "전부터 든 생각이지만, 너 말이야, 그렇게…… 한가해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라플란드",
      "text": "나도 너랑 마찬가지로, 답을 기다리고 있을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "무슨 뜻이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "텍사스가 용문으로 돌아갈지 말지가 너에게 그렇게 중요해?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라플란드",
      "text": "굉장히.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라플란드",
      "text": "그리고 지금이라면, 난 텍사스가 돌아갔으면 좋겠어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "음…… 그럼 넌 우리 편이네?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라플란드",
      "text": "정답.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엑시아",
      "text": "좋아, 혼자보단 한 사람이라도 더 많은 게 낫지.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "죄송합니다. 제가 김새는 이야기를 한 것 같군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "하지만 오늘 제가 부임 연설을 하려고 여기 온 게 아니란 걸 여러분도 눈치채셨을 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "저는 제 속마음을 털어놓으려고 온 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그렇게 큰 포부를 품은 카라치가, 제게 신도시에 대한 전망을 한 번도 말한 적이 없다면 믿으시겠습니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그건 그가 그 자리에 죽을 각오로 올랐기 때문이겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "지난 몇 년간 그가 해온 일에 대해선 모두가 잘 알고 있으실 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "신도시의 건설이 완료될 때까진 살아있으리라고 믿었던 카라치가, 며칠 전 갑자기 죽었죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "전 이 분노를 도저히 삭일 수가 없었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그래서 저는 벨로네 패밀리에게 접근했고, 제 자신을 추천해서 결국 이 자리를 얻었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그 과정에서 저는 벨로네 패밀리와 살루초 패밀리가 꾸민 음모를 알게 되었죠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그들은 애초부터 도시의 정세를 어지럽혀 새로 건설하는 이동도시를 탈취하려 했습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라디오",
      "text": "그리고 그 혼란을 틈타 시칠리아 부인에게 대항할 생각이었습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "충실한 패밀리 멤버",
      "text": "보스, 이건……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "베르나르도의 움직임은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "충실한 패밀리 멤버",
      "text": "없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "……베르나르도, 이놈이 대체 무슨 생각이지?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "단브론.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "단브론!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "……어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "너 루비오 근처에 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "알베르토",
      "text": "가서 그 미친놈을 처리해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "……알았다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "하아…… 마음먹고 들어오려는 자는 어떻게든 막을 수 없는 건가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "정말 어리석군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "이런다고 무슨 의미가 있지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "그 옷차림은, 평소에는 노동자인 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "평소엔 '단브론 세차장'이라는 곳에서 일해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "음, 어디서 들어본 것 같네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "그러니까 당신의 이름이 단브론이라는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "맞아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "당신은 자신의 일에 대해 어떻게 생각하나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "별생각 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "시라쿠사는 점점 더 미적지근해지고 있으니까. 뭐 딱히 할 일도 없는데, 아무 일이나 찾아서 하는 느낌 정도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "유감이네요. 더 많은 걸 봤었어야 했는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "당신 같은 고고한 패밀리들은 영원히 우리를 지배할 수 있으리라고 생각하겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "당신들의 적은 언제나 다른 패밀리라 생각하며, 나머지는 거들떠보지도 않겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "그러나 시대는 발전하고 있어요. 이 세상에 변하지 않는 것은 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "네가 아무리 훌륭하게 말을 포장하려고 해도, 고작 그 몇 마디뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "고작 그 몇 마디 말로 패밀리를 무너뜨리고, 시칠리아 부인을 무너뜨릴 수 있다고 생각하나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "하지만 이 절호의 기회를 빌려 제 생각은 이미 세상 밖으로 전달됐습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "베르나르도와 시칠리아 부인, 둘 중 누가 이길지 저는 몰라요. 관심도 없고요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "제가 믿는 건…… 시대는 결국 당신들을 버릴 거란 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "시라쿠사가 새로운 시대를 맞이할 운명이라면, 그 주인공은 절대 패밀리가 아닐 것이라는 걸 확신합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "우린 힘이 없어요. 우린 확실히 약하죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "하지만 문명이란 원래부터 폭력을 극복하기 위해 존재하는 것이죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "우리가 원하는 것은 평등이고, 폭력을 기반으로 하지 않는 질서입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "폭력이야말로 우리의 본능이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "그런가요? 그렇다면 왜 모든 패밀리가 같은 방향으로 나아가고 있는 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "왜 그들은 폭력과 싸움이 아닌 돈과 권력을 추구하는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "설마 오늘 여기서 저를 죽이는 것 역시 단지 폭력의 표출에 불과한 겁니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "당신 뒤에 있는 사람이 권력을 잡는 걸 제가 방해하고 있기 때문이 아니라요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "보세요, 당신은 답을 알고 있습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "그리고, 만약 괜찮다면 제 마지막은 제가 스스로 맞이하게 해주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "이게 뭔지 아십니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세차공",
      "text": "총?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "맞아요, 몇 년 전에 어떤 경로를 통해 블랙스틸에서 구입한 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "총은 다루기 어려울뿐더러, 제게 이게 있다고 싸움 잘하는 패밀리 멤버를 무조건 처치할 수 있다는 보장도 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "기껏해야 나 같은 나약한 인간으로부터 자신을 보호하는 것이 고작이겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "지금 생각해보면, 저는 이미 몇 년 전부터 이걸로 누구를 겨냥할지 생각해둔 것 같습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "루비오는 천천히 자신의 관자놀이에 총구를 갖다 댔다."
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "참, 단브론 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오",
      "text": "언젠가 당신이 이 시라쿠사 땅에서 무기를 들 필요 없이, 세차공으로만 살아가길 바랍니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "판사님, 제가 지금 꿈을 꾸고 있는 건 아니죠? 아빠가…… 아빠가 어떻게 킬러를 상대로 저런 말을.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "루비오의 딸",
      "text": "안돼, 아빠…… 아빠가 위험해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "라비니아",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "라비니아는 눈물이 이미 눈가를 적시고 있다는 걸 느꼈다.\n하지만 눈물을 미처 닦지 못했다. 그녀는 앞으로 일어날 일에 대해 이미 예감하고 있었기 때문이다.\n라비니아는 루비오의 딸 곁으로 다가가 그녀의 귀를 살포시 막았다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "볼시니 시민들은 이날을 영원히 잊을 수 없을 것이다.\n이날의 이른 아침, 맑은 총성이 라디오를 통해 볼시니 전체에 울려 퍼졌다.\n볼시니의 전 식품안전부 장관 루비오는 건설부 장관직의 부임 연설 중 사망했다.\n그 후 발생한 수많은 혼란은 반나절 만에 수습되긴 했지만, 이는 시라쿠사의 미래를 바꾸는 단초가 되었다."
    },
    {
      "type": "sceneBreak"
    }
  ]
}
