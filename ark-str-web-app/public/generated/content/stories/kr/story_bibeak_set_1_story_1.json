{
  "server": "kr",
  "storyId": "story_bibeak_set_1_story_1",
  "groupId": "story_bibeak_set_1",
  "stageId": null,
  "title": "부화",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/memory/story_bibeak_1_1.txt",
  "sourceHash": "6b318b4a5c146babbcc35df56f61c46d57b277ed3c324ed44124a4188d3aad35",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니…… 저, 조금 긴장돼요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "누구에게나 첫 임무는 있어. 그렇게 걱정하지 않아도 돼. 내가 있잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "게다가 며칠간 훈련실에서만 있었잖아. 지금 네 검술은 누구에게도 밀리지 않아. 그렇지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "글룸핀서는…… 엄청 사납겠죠? 만약 마을 사람들도 녀석들을 쫓아내지 못한다면, 전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "글룸핀서가 사납다는 걸 부정하지는 않겠어. 하지만 장담하는데 글룸핀서를 듀나 교관의 검과 방패, 도베르만 교관의 채찍을 비교하면 아무것도 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "교관님들에게 허가받고 이번 외근 임무에 배치됐다는 건 네 능력이 충분 감당할 만하다는 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "이건 시작일 뿐이야. 너도 오랜 결심 끝에 신청하기로 한 거잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "휴…… 오키드 언니, 이 차에 타는 건 이런 느낌이었군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "방금 사무소의 오퍼레이터가 우리를 찾으러 왔을 때, 다음 기회를 노리자는 생각도 했거든요. 하지만 그래도 이 한 걸음을 내딛고 싶어서 손을 들었어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "도베르만 교관님이 절 보고 웃는 모습을 본 지가 너무 오래됐어요. 이번 임무는 꼭 잘 완수할 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "이 검…… 이 녀석과 함께 더 많은 사람을 지키고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "그래야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "저기, 오키드 언니. 첫 번째 임무에 나갔을 때 어땠는지 말해줄 수 있나요? 오키드 언니의 경험을 듣고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "음, 아주 오래전의 일이었어. 소대를 이끌고 갔던 것 같은데……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "그 임무가 끝난 뒤에 그냥 사직할까 고민도 했었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "다행히 시간이 지나면서 다들 말을 듣기 시작하더라고…… 아마도.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……선배님들은 그런 성격이었군요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "저기……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "로도스 아일랜드에서 온 사람이 너희들이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "네…… 맞아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크, 네가 사람들에게 우리 임무의 세부 사항을 설명해 줄래?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "안녕하세요. 저희는 로도스 아일랜드에서 이번 임무를 책임지게 된 소대입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "이번 임무는 우선 마을 외부에 방어시설을 배치할 거예요. 작업이 끝나면 제작과 배치 방법을 알려드릴게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "방어시설에는 상응하는 감응 경보 장치를 설치할 거예요. 그러면 앞으로 글룸핀서가 습격해와도 미리 준비할 수 있을 테니까요. 마을의 손실도 심각하지 않을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "글룸핀서가 오면 저희가 여러분을 도와 녀석들을 격퇴할게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "그래. 저기…… 궁금한 게 더 있어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "네? 말씀하세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "아가씨는 말도 느릿느릿하고 검도 가늘군. 로도스 아일랜드에서는 왜 너희 같은 사람을 보낸 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "정말 글룸핀서를 격퇴할 수 있으려나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "어떻게 그런 말을……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "할 수 있어요. 저를 믿어주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "아…… 너무 직설적으로 말했네. 신경 쓰지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "너희처럼 품위 있는 아가씨는 집에서 독서를 하거나 차나 마실 줄 알았거든. 그런데 이런 거친 일을 할 줄이야. 나중에 다치지 않게 조심해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "이곳에 우리를 도와주러 오다니, 정말 감동이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "자, 자. 우리 집에 차와 디저트를 준비해 뒀어…… 직접 만든 건데 입맛에 맞았으면 좋겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "감사합니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "차 맛이 좋네요, 감사합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "흠, 직접 기른 건데 전부 작년 거야. 올해는 글룸핀서가 차밭을 죄다 못 쓰게 만들어버려서 남은 것도 얼마 안 될 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "하루하루가 힘들어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "이곳을 떠나서 다른 걸 할 생각은 해본 적 없나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "어디로 갈 수 있겠어? 그리 쉬운 일이 아니라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "공장도 요즘은 어느 정도 지식이 있어야 해. 우리 같은 사람들은 이 땅을 지키며 평생 어떤 걸 할 수 있을지 지켜볼 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "죄송합니다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "신경쓰지 마. 다들 기품 있게 입어서 마치 귀공자나 아가씨 같네. 이곳에는 단련하러 온 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "우리도 생각은 하고 있어. 혹시 안정적인 수입이 있는 일이 있다면 꼭 알려줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "이곳의 상황을 보고 있으면 몇 년 못 버틸 것 같다는 생각이 들거든……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "우리 역시 회사 생활을 하는 것뿐이지 부유한 집안의 자녀 같은 건 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "하지만 만약 정말 곤란한 일이 있는 거라면 전부 끝나고 나서 자세히 얘기해줘. 어쩌면 어느 정도는 도와줄 수 있을지도 모르니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "아, 고마워. 정말 고마워.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "이봐! 이봐!! 망보던 사람이 글룸핀서가 오는 걸 봤대! 다들 어서 물건 챙겨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "서둘러, 어서!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "다시 말하지만, 녀석들에게 마을이 다시 파괴당하면 사람들이 더는 버티지 못할 거야. 꼭 녀석들을 막아줘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "정말 고마워!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "다들…… 최대한 높은 곳에 서 계세요! 아래는 저희가 책임질게요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "꼬마 아가씨, 너무 걱정하지 마. 녀석들과 여러 번 싸워 봐서 다들 어느 정도는 경험이 있으니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "이쪽은 우리가 지킬게! 물론 너희들만큼은 못하겠지만, 조금이라도 분담할 수만 있다면 도움은 되겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "그럼 부탁해! 여기에 있는 방어시설만 지키면 돼. 다만 실수로 위쪽의 아츠에 맞지 않게 조심하고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "아츠? 아츠도 쓸 줄 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "정말 대박이야. 강력한 캐스터는 혼자서 건물도 무너뜨릴 수 있다고 하던데, 너희가 있으니 이번에는 많이 쉬울 것 같네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "너무 낙관적으로 굴지 마. 난 그렇게 강하지 않다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "아츠를 쓸 줄 안다는 것만으로도 엄청난 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "조심해. 라이트, 패티. 방패의 오리지늄 회로를 발동시켜!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A&B",
      "text": "알았어!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "d"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "와! 정말 엄청난 것 같아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "정말 우리에게 이걸 남겨주는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "일부 시설을 남겨두는 게 매번 사람을 보내서 지원하는 것보다 시간도 힘도 훨씬 더 아낄 수 있어. 여러분이 사용법을 다 배우면 우리가 자주 올 필요도 없어질 테고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "좋은 일이잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "너희들 정말 좋은 사람이구나.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "…… 아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니, 조심해요. 녀석들이 몰려와요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "어디 다쳤어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "어깨를 긁혔어요. 괜찮아요…… 처리할 수 있어요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "바이비크는 찢어진 천으로 간단하게 상처를 싸매면서 작전복에 감싸져 있던 목을 드러냈다."
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "응……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "(저…… 목에 저거, 오리지늄 아니야?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "(뭐?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "(*욕설*!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "저기, 너, 너희들 혹시…… 감염자야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "정말이잖아! 네 몸에 있는 그거, 그 돌 맞지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "부…… 부탁인데 제발 좀 멀리 떨어져 줘!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "네?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "너희들, 전부 감염자지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "빌어먹을, 난 방금 전까지 같이 차도 마셨다고! 설마 나도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "글룸핀서, 글룸핀서…… 이 글룸핀서들은 왜 우리만 공격하는 거야? 감염자한테나 가라고!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "한 마을 사람이 집에서 가져온 냄새가 심하게 나는 음식을 소대가 있는 곳을 향해 던졌다.\n글룸핀서들은 냄새가 나는 쪽을 향해 기어갔다."
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "가서 저 녀석들을 물어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "벼…… 병에 걸릴 바에는 집에 있는 모든 음식을 글룸핀서에게 주겠어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "너희들은 어떻게 여기에 온 거야……?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "그거야 여러분이 요청해서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "우리는 감염자를 요청한 적이 없다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만 저희가 도와줬잖아요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "방금 전에는 집에 초대까지 했으면서……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "……그건 너희들이 감염자라는 걸 몰랐으니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "너희가 우리를 속인 거야! 몸에 있는 오리지늄을 꼭꼭 숨기면 대체 누가 알 수 있겠냐고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "뭐라고??!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "가!!! 여기서 떠나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "글룸핀서, 저 녀석들을 쫓아내!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "지금 갑자기 그런 소리를 한다고?! 광석병은 일상적인 접촉으론 옮지 않아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "난 감염자도 아니고 저들과 몇 년을 같이 일했는데도 괜찮다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "감염자가 아니라고? 그럼 더 미친 거지!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "빌은 영문도 모른 채 그 병에 걸렸고, 몸에 돌이 생긴 후엔 아무 곳에서도 안 받아줬어. 가장 열악하다는 광산조차 그를 원하지 않는 바람에 결국 아무 곳에도 가지 못하고 죽었다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "그가 죽은 뒤, 뒤에는…… 우리 마을은 감염자 때문에 망한 거란 말이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "그런데 이렇게 대놓고 우리 마을에 들어왔다고? 우리도 병에 걸려서 죽기를 바란 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "너희들은 우리를 도와주러 온 거야, 아니면 해치러 온 거야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "나가! 싹 다 나가라고! 너희들의 도움 따윈 필요 없으니까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "오키드 씨가 대장이니 명령을 내려줘요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "더 이상은 못 참겠어요! 왜 이렇게 일방적으로 욕을 먹어야 하는지도 모르겠고, 심지어 글룸핀서를 우리 쪽으로 유인하기까지 했다고요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크, 이 녀석만 잡고 가자. 저들이 이런 결정을 했으니, 우리도 여기에 더 머물 필요는 없겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "나는 높은 곳에서부터 내려갈 테니까 너는 방어시설 뒤로 돌아와서 차 옆에서 만나!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "저……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "저희가 왜 이렇게 쫓겨나듯이 떠나야 하는 거죠……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……우리는 아무것도 잘못한 게 없잖아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "우리는 분명 그냥……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "냄새가 심하게 나는 음식이 또 하나 날아와 바이비크의 발치에 떨어졌다. 주위에서 냄새를 맡은 글룸핀서가 방향을 바꿔 그녀를 향해 다가왔다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "어쩔 수 없이 오키드가 오리지늄 아츠를 사용해 바이비크 주위의 글룸핀서를 격퇴하자, 녀석들은 한동안 감히 다가오지 못했다."
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크, 나는 이런 일을 이미 몇 번이나 겪었어. 어쩌면 많은 사람이 로도스 아일랜드의 지원 설명은 제대로 읽어보지도 않은 채 도움만 받으려는 건지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "하지만 지금 같은 상황은 우리에게 매우 불리해. 계속 여기에 있다간 다른 분노를 사게 될지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "만약 누군가가 과격하게 움직인다면 상황은 더욱 나빠질 거야. 그러니 후퇴하는 것이 좋을 것 같아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "……임무 실패를 걱정하는 거야, 바이비크?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "모, 모르겠어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니, 이건 제 첫 번째 외근 임무예요. 이렇게 포기하기는 싫어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "게다가…… 우리는 잘못한 게 없잖아요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "이해할 수 없어요. 전 저들을 도와줬는데 왜 이렇게 쫓겨나야 하는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "저…… 전 예전에 글룸핀서만 보면 무서워서 부모님 뒤에 숨었었어요. 저에게 상처를 준 상대를 앞에 두고도 제가 뭘 어떻게 해야 할지도 몰라서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만 저…… 전……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "전 가고싶지 않아요! 이렇게…… 쫓겨나고 싶지 않단 말이에요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "글룸핀서는 더는 오키드의 오리지늄 아츠를 두려워하지 않았고, 탐색하듯 앞으로 발을 내디뎠다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "바이비크는 검을 휘둘렀다.\n그녀는 과연 무엇을 베어내고 싶었던 걸까…… 과거 그녀는 분노한 사람들 앞에서 등 뒤의 사람을 지켰으며, 훈련장에서 무수히 검을 휘두르기도 했다.\n하지만 오늘 이 검은 오로지 자신만을 위해 사용하는 것이었다."
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "당신들은 제가 감염자라는 이유만으로 이러시는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……제가 감염자라서 당신들의 거주지를 파괴하려는 글룸핀서보다 훨씬 두려워하고 이렇게 거리를 둬야만 하는 건가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "아까도 말했지만, 저희는…… 광석병을 옮기지 않아요!",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "마을 사람들은 누구도 대답하지 않았다.\n글룸핀서는 끝이 없이 나타나 마을 앞의 방어시설을 망가뜨렸다.\n바이비크는 어디도 가지 않고 그냥 그 자리에 서서 이를 악문 채 자신의 가는 검을 휘둘렀다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "(……정말 고집스러운 녀석이네.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "(이번 임무를 자신을 증명하는 것으로 여겼다는 거겠지…… 사실 이렇게까지 부조리를 당할 필욘 없었는데.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "(하지만 그렇게 생각한다면……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크, 정말 그렇게 하고 싶다면 나도 도울게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "……하지만 그렇게 필사적으로 하지는 마. 넌 이미 다쳤으니까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "젠장, 글룸핀서들이 몰려오려고 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "더 이상 뒤로 물러나지 마. 반드시 이곳에서 글룸핀서를 막아야만 해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "집에 석궁이 있거나 무기가 될 만한 게 있는 사람은 전부 숨지 말고 나와!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "문과 창문을 단단히 잠그고 자물쇠를 다시 한번 확인해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "점점 더 많은 글룸핀서가 마을을 향해 몰려오기 시작했다. 사람들의 예상을 훨씬 뛰어넘는 수였다.\n마을 사람들은 하나 둘 씩 집에서 나와 앞에 섰다.\n이미 철수한 몇몇 오퍼레이터들은 아무 말 없이 검만 휘두르는 바이비크를 바라보며 한숨을 쉰 뒤, 다시 발치에 버렸던 무기를 들었다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "……*욕설*, 이젠 모르겠다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "오키드 씨, 저와 패티는 다시 방어시설을 보강할게요. 이대로 가다간 전부 끝장나겠어요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "나, 난…… 오지 마……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "……내 다리!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "다쳤으면 뒤로 물러나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "가, 가까이 오지 마……! 알아서 일어날 테니까!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "쳇, 나도 부축할 생각 없거든.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "방어시설은 다시 세웠어요! 오키드 씨, 바이비크, 이쪽으로 피해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "알았어!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "말도 안 돼, 이놈들 끝이 없잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "……당신 뒤!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "고마워, 친구! 윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "쓸데없는 소리는 하지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "아무튼 고마워……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "멍하니 서 있지 말고 뭐라도 하라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "뭘 멍하니 보고만 있어? 입으로는 마을을 사랑한다면서 감염자들이 앞에서 싸우는 걸 구경만 할 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "다시 한번 말하는데, 평범한 접촉으로는 감염되지 않아! 정말 글룸핀서를 쫓아내고 싶다면 앞으로 나서라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "나, 난……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "*욕설*, 간다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "이걸 받아! 하, 하지만 그냥 거기에 있어…… 던져줄 테니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 B",
      "text": "질질 끌지 말고 정말 무서우면 안 줘도 돼. 강요 안 하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "그래, 무서워, 무섭다고! 하지만…… 나도 양심은 있다고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "너희들이 날 구해줬으니 최소한 내 양심에는 부끄럽지 않게 할 거야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "이건 우리가 직접 만든 냄새 주머니야. 글룸핀서가 싫어하는 냄새니 도움이 될 거야.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "자…… 받아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "라이트, 저쪽에 좀 더 신경을……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "겁에 질린 소리",
      "text": "아악……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "날카로운 비명에 모든 사람이 고개를 돌렸고, 거기엔 한 소녀가 바이비크가 있는 방향을 가리키며 공포에 질려 있었다.\n바이비크의 뒤에는 한 글룸핀서가 발톱을 들어 올리고 있었다. 바이비크는 검을 들어 올리려고 했지만, 피로가 쌓인 탓인지 실패하고 말았다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "발톱이 바이비크의 몸에 떨어져 내리는 순간, 화살 하나가 글룸핀서의 몸을 관통했다.\n화살을 쏜 주민은 손을 뻗어 자신의 놀란 딸을 보호했다. 그리고는 아무 말 없이 또 다른 글룸핀서를 향해 화살을 발사했다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크! 괜찮아?! 일단 뒤로 빠져서 휴식을……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니, 괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "뒤다, 뒤에서 또 몰려온다아아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "소리 좀 그만 질러! 그럴 시간에 와서 방어시설이나 지탱하라고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "가, 간다고! 그래…… 난 무섭지 않아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "힘이 남아있는 사람은 가서 저쪽 좀 도와줘!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 C",
      "text": "그리고 남는 수제 총포도 전부 가져와. 어느 정도는 쓸모가 있겠지!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "오후에 시작된 전투는 저녁까지 이어졌고, 마침내 우둔한 글룸핀서들은 앞쪽이 죽음의 길이라는 걸 알아차렸는지 점차 물러나기 시작했다.\n사람들은 저려오는 손을 내리고 멍하니 제자리에 선 채 조금 전 필사적으로 싸우던 그 상황 속에서 빠져나오지 못하고 있었다.\n땅에 박아넣은 검으로 몸을 지탱하던 바이비크는 몸을 돌려 멀리 세워져 있는 로도스 아일랜드의 차를 향해 걸어갔다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크! 자, 어서 차에 타. 내가 상처를 치료해줄게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "마을 사람들은 제자리에 가만히 서 있었다. 어떤 사람들은 한 걸음 다가가고 싶은 듯했지만, 결국 그 자리에 멈추고 말았다."
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터 A",
      "text": "……흥.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "아무래도 우리가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "저기, 그러니까, 너희들……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "미안해…… 그리고 고마워. 집에 아직 전에 준비해뒀던 밥이 있는데, 마침 밤도 늦었으니 가져다줄게. 가는 길에 먹어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "주민 B",
      "text": "……정말이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "됐어요. 여기까지 하죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니, 언니가 만든 디저트 먹고 싶어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "조금은 가져오셨죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "응, 가져왔어. 차에 있을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "이제 갈까?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주민 A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "자, 치료는 끝났어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "흑……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "흐흐흑……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "참느라 힘들었지? 울어, 실컷 울어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "넌 충분히 용감했어. 그렇지? 처음부터 울면서 차로 돌아온 게 아니라 모든 글룸핀서를 해치운 뒤에 스스로 돌아온 거잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "네 덕분에 마을 사람들이 생각을 바꾸고 점차 우리와 함께 싸우게 된 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "아니었으면 다른 사람들의 결정으로 바로 그곳을 떠날 수밖에 없었겠지. 아무것도 바꾸지 못하고, 돌아가는 길에는 욕이나 하면서 분을 풀고 있었을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "제 자신을 무수히 타일렀어요. 분노에 잠기면 안 된다고, 괴물이 되어서는 안 된다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만 다른 사람의 눈에…… 병에 걸리지 않은 보통 사람의 눈에는 제가 괴물 같았을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만…… 하지만, 사실 그 사람들도…… 틀린 건 아니에요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크, 너…… 그렇게 네 자신을 위로하지 않아도 괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "로도스 아일랜드의 지원 설명서에는 우리 팀원 중에 감염자도 있다고 적혀 있어. 저들이 보지 않은 거야. 최소한 훨씬 점잖은 방법을 쓸 수도 있었겠지. 우리가 받아들이지 못하는 것도 아니고 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……오키드 언니, 저도 진심으로 그렇게 생각해요. 그 사람들이 무서워하는 건 당연해요. 저도 무섭고 증오스러우니까요. 전 제 병이 무서워요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "집을 떠나 이곳에서 병을 억제하고 다양한 훈련에 참여하면서 새로운 기회도 얻었어요. 저는 제 두려움을 이길 수 있지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "다른 사람은 불가능할지도 모르죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만 이렇게 많은 것을 해왔는데, 첫 번째 외근 임무에서 멈추거나 물러서고 싶진 않았어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……제가 이기적인 걸까요? 만약 그 사람들이 정말 두려워했다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "바이비크, 누워서 좀 쉬어. 우선 너무 많이 생각하지 말고 뭐라도 좀 먹자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "저들은 광석병에 대해 모르기 때문에 두려워하는 거야. 하지만 일반적인 접촉으로는 감염되지 않는다고 설명했잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "나중에 다들 진정되고 나서는 받아들였어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "그럼 다음에도 로도스 아일랜드에 도움을 요청할까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "혹은 다음에 저들이 로도스 아일랜드에 지원을 요청했을 때…… 제가 기꺼이 임무를 맡을까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "그건 네가 선택할 일이야, 바이비크.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "사람마다 자신만의 선택이 있어. 나라면 많이 망설일 것 같아…… 그러다 거절하겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "……아직은 제가 어떻게 할지 모르겠어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "어쩌면 다음에는 저들이 저를 두려워하지 않을지도 몰라요. 또 어쩌면 여전히 배척할 수도 있겠죠. 아니면 다음이라는 게 아예 없거나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만 저는 그날이 오기를 기다릴 거예요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "오키드",
      "text": "(디저트를 건넨다)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "오키드 언니, 오늘 함께 해줘서 고마워요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "아니었으면 멍청한 짓을 했을지도 몰라요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "하지만 전……이번 외근 임무를 신청한 걸 후회하지 않아요. 제 생각과는 많이 달랐지만요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "바이비크",
      "text": "전 계속 버텨나갈 거예요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
