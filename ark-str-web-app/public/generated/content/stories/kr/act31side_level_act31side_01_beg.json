    {
      "type": "dialogue",
      "speakerName": "좌락",
      "speakerId": "avg_4121_zuole_1",
      "isRemote": false,
      "text": "…… 왜 그런 걸 여쭙는 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "화생",
      "speakerId": "avg_4119_wanqin_1",
      "isRemote": false,
      "text": "말투와 풍기는 기운이 많이 달라."
