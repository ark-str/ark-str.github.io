        {
          "type": "dialogue",
          "speakerName": "만드라고라",
          "speakerToken": "avg_npc_233_1#8",
          "operatorId": null,
          "portraitKey": null,
          "text": "안돼, 안돼. '스파이', 얼른 가자……"
