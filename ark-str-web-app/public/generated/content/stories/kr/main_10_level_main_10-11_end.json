        {
          "type": "dialogue",
          "speakerName": "맨프레드",
          "speakerToken": "avg_npc_404_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "너도 곧 그 친구를 만날 수 있을 테니, 만드라고라."
