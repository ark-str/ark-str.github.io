        {
          "type": "dialogue",
          "speakerName": "타라 밀정",
          "speakerToken": "avg_npc_421_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "만드라고라……"
        },
        {
          "type": "dialogue",
          "speakerName": "만드라고라",
          "speakerToken": "avg_npc_233_1#8",
          "operatorId": null,
          "portraitKey": null,
          "text": "왜? 내가 당분간 말하지 말라고 했잖아?"
