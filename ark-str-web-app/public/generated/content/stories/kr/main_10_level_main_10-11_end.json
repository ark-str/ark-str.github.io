        {
          "type": "dialogue",
          "speakerName": "만드라고라",
          "speakerToken": "avg_npc_233_1#8",
          "operatorId": null,
          "portraitKey": null,
          "text": "무슨 소리야……? 내가 지금까지 해 온 일이 전부……"
