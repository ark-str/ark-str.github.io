        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "만드라고라",
          "speakerToken": "avg_npc_233_1#7",
          "operatorId": null,
          "portraitKey": null,
          "text": "무슨……"
