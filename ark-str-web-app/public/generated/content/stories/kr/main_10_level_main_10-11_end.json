        {
          "type": "dialogue",
          "speakerName": "만드라고라",
          "speakerToken": "avg_npc_233_1#8",
          "operatorId": null,
          "portraitKey": null,
          "text": "괜찮아, '스파이'. 넌 무사할 거야. 화살에 맞은 것뿐이야. 이제 3m만 남았어. 내가 널 업고서라도……"
        },
        {
          "type": "dialogue",
          "speakerName": "타라 밀정",
          "speakerToken": "avg_npc_421_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "……빨리 가."
