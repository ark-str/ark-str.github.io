          "type": "dialogue",
          "speakerName": "미저리",
          "speakerToken": "avg_npc_235",
          "operatorId": null,
          "portraitKey": null,
          "text": "힐록 카운티의 만드라고라…… 이 공장을 빠져나갈 수 없을 거다."
        },
        {
          "type": "dialogue",
          "speakerName": "혼",
          "speakerToken": "avg_4039_horn_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "……"
