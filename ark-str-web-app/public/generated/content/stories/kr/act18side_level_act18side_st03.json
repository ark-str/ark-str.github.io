    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그 기분은 충분히 이해해.",
          "value": "1",
          "blocks": []
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "그래도 심사 결과는 기다려야 해.",
