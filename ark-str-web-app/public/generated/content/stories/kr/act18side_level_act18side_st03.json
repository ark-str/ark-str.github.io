          ]
        },
        {
          "label": "에벤홀츠 건에 비하면 별거 아니야.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "체르니",
              "speakerId": "avg_4047_pianst_1",
              "isRemote": false,
              "text": "……"
