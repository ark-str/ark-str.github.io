    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_corridor"
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "speakerId": "avg_4047_pianst_1",
      "isRemote": false,
      "text": "걱정해주셔서 감사합니다, 박사님. 덕분에 많이 좋아졌습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "speakerId": "avg_4047_pianst_1",
      "isRemote": false,
      "text": "더불어, 애프터글로를 보호해 주신 것도 다시 한번 감사드립니다."
