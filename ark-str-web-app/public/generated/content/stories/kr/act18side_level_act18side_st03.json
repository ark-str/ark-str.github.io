    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "라이타니엔에서는 그의 사망을 공식 발표했어.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "그는 건강해. 시간이 좀 더 필요할 뿐.",
          "value": "2",
          "blocks": []
        },
        {
          "label": "아이러니하게도 덕분에 라이타니엔과의 협력에 도움이 됐지.",
          "value": "3",
          "blocks": []
        }
      ]
    },
    {
      "type": "dialogue",
      "speakerName": "체르니",
      "speakerId": "avg_4047_pianst_1",
      "isRemote": false,
      "text": "……맞는 말씀입니다."
