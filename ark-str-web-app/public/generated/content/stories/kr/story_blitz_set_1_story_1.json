  "sourceHash": "35a0984194c9dbc53cc6dd4671d50ee0a4cf2bc16d6a3466b37ccc43b3095a4f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "사르곤\n푄 고온지대의 국경"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "안녕, 아저씨."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아저씨?"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "저리 가. 너랑 말할 힘도 없으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "나한테 물이랑 먹을 것 좀 팔 수 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "(가늘게 뜬 눈으로 Blitz를 훑어본다)"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "아, 용병 나리셨군."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "우리 마을에는 뜨거운 바람과 모래뿐이야. 여긴 왜 온 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "남쪽으로 가려고 준비 중이야."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "남쪽? 하, 더위라도 먹었나 보군."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "거기는 푄 고온지대라고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그래, 푄 고온지대에 가려는 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "(다시 한번 Blitz를 훑어본다)"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "정신은 멀쩡한 것 같고, 어디 다친 거 같지도 않은데. 뭐 하러 거기까지 가서 죽으려는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그냥 가보는 거야. 탐험이랄까."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "음, 다른 사람들이 미친놈인 줄 알고 널 쫓아낸 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그럴지도."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "그래서 나한텐 무슨 용무야?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "보급품을 좀 사려고."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "용병 나리, 여기 이 마을에서는 물 한 모금, 식량 한입마저도 목숨이나 마찬가지야."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "돈은 아무 쓸모가 없지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "다른 마을 사람들이 그러던데, 네가 다른 마을 사람들과의 거래를 책임지고 있다며? 맞지?"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "하, 누가 이런 곳에 와서 물건을 산다고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "(사르곤 비속어) '금화 세 닢'을 사고 싶은데."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "(어눌한 빅토리아어) 케이크가 필요해."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "(사르곤 비속어) 노란 모래 한 톨을 주지."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "흥……"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "들어가서 얘기하지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "로도스 아일랜드 안전가옥에 온 걸 환영해, 오퍼레이터."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "음, 그쪽에선 오퍼레이터라고 한댔지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "어떤 게 필요하지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "최대한 많은 물과 식량."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "정말 푄 고온지대로 가려는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "응."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "이곳에서 40년 넘게 살았지만, 지금까지 그곳에 관심을 가지는 녀석은 없었어."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "매년 적지 않은 사람들이 그곳에서 불어오는 뜨거운 바람에 목숨을 잃지."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "그리고 남은 사람들은…… 봤을 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "매일 밖에서 꼼짝하지 않고 열을 식혀야 해. 말 한마디 하기도 힘들지."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "내가 장사를 좀 할 줄 알았고, 바깥과 이렇게나마 접촉할 수 있었기에 망정이지, 아니었으면 나도 똑같이 살았을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그래도 한 번 가서 본다고 손해 보는 건 아니잖아. 그렇지?"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "너 같은 외부인이라면 관심이 있을 수도 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "잠깐만, 전에 로도스 아일랜드 사람들이 여기에 남겨 둔 물건이 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "우선 목부터 축이라고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "고마워."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "아, 찾았다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "처음에 이……"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "(강한 억양의 빅토리아어) '안전가옥'을 부탁한 사람이 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "푄 고온지대에 가려는 사람에게 주의사항을 남겼어."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "난 글자를 몰라서, 직접 봐 봐."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "고마워."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "(표준 빅토리아어) 고온지대를 탐험하는 것은 권장하지 않으며, 꼭 가야 하는 경우 반드시 생존에 필요한 물자를 충분히 확보해야 한다."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "뭐라고 쓰여있지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "충분한 물자를 가지고 가라는군."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "왜 이렇게 그 괴상한 곳에 가려고 고집을 부리는지 모르겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "쯧."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "이렇게 하지. 물과 물자는 나한테 있어. 규정인지 뭔지에 따르면, 원래 당신 오퍼레이터들을 위한 것이었으니까. 직접 챙겨가."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "방금 물은 마셨나?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "응."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "별 느낌 없어?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "머리는 아까보다 나아진 것 같기도 하네."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "그러겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "여기 주전자에 둘테니, 머리가 아프면 한 모금 마셔."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "다만 한 번에 많이 마시면 안 돼. 환각을 일으킬 수 있으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "고마워."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "다 해서 금화 한 닢이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "금화 한 닢? 알았어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "엑. 아니, 형씨, 이 정도로는……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "돌아올 때 버든비스트를 한 마리 부탁해야 할지도 몰라서 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "귀환할 때 필요한 보급도 더 사주고, 남은 걸로는 특산품 아무거나 좀 사다 줘."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "그래 그래, 외지인들은 다 돈을 헤프게 쓴다니까."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "오늘 여기서 하룻밤 묵고 갈 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "지금 출발하려고."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "알겠어. 더는 말리지 않을게."
    },
    {
      "type": "dialogue",
      "speakerName": "마을 사람",
      "speakerId": "avg_npc_164",
      "text": "맞다. 뭐라고 부르면 될까?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "Blitz."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "푄 고온지대, Blitz의 사르곤 여행의 마지막 종착지.\n뜨거운 열기와 미친듯한 바람, 그리고 모래알이 그를 맞이한다.\n끝없는 황사, 타오르는 폭풍, 이 모든 것은 테라인에게 대지 끝자락의 모습을 보여준다.\n하지만 Blitz의 눈에 이곳은 탐험의 시작점이다. 충분히 강인하고 거기에 운까지 따라준다면, 탐험가에게 진실을 보여줄지도 모르는 곳이다.\n아직 아무도 이 사막을 탐험하지 않았기 때문에, 이곳에는 약간의 가능성이 있다.\n만약 그 여정에 집으로 돌아갈 방법이 있다면?\nBlitz는 시도해 보기로 했다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그렇게 난 그렇게 푄 고온지대로 갔다가, 멀쩡하게 돌아온 거야!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "용기는 기특하군, 형제여."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "내가 분명 테라의 각지의 위험 지역에 표시를 해놨을 텐데."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "용케도 전부 다 돌아다녔군."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "흥……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "그래서, 푄 고온지대에서 뭐 좀 발견한 게 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "나도 좋은 소식을 말해주고 싶지만, 거긴 모래뿐이었어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "Tachanka, Frost. 북방 빙원 쪽에도 이상한 게 많다던데, 맞아?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "Frost 가 그 괴물들을 상대해 봤거든. 상당히 귀찮다던데."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "난 진짜 뭔가 형태가 있는 거랑 싸워보고 싶었다고. 적어도 생명이 살고 있다는 증거잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "하지만 푄 고온지대는……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "하늘, 미친듯한 바람, 모래."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그게 다야."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "여행하러 가기엔 좀 그렇지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "재미없어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "그리고 외롭기도 하다고, Blitz는 생각했다."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그러고 보니 사르곤에서 우리 옛 친구를 만났었다며?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "옛 친구?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아, 맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "음, 그 롱스프링 마을의 새로운 아미르 아가씨를 말하는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "요새 잘 지내는 거 같더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그 귀찮은 괴물들을 처리하고 나서, 새로운 컬럼비아 회사가 찾아왔었나 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "좋은 일 같지는 않은데."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "메이랜더?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "메이랜더."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "상대방이 후한 조건을 내걸었는데도, 전에 볼보트 코친스키가 일으킨 트러블 때문에, 피케일은 기본적인 무역 협력 외에 나머지 조항은 거절했나 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "재밌네."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "롱스프링 마을의 이전 주요 자금원은 오리지늄 광석이었어. 하지만 광산 심층은 이미 폐쇄됐고, 저층도 이미 우리가 폭파했으니 더 이상 광석을 생산하는 건 불가능해."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "팔 수 있는 다른 게 또 있나?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그건 우리 알렉산드르 님에게 감사해야지."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그게 나랑 무슨 상관이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "거기서 심심풀이로 러시아 인형을 많이 만들었잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그랬지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "시찰 갔던 컬럼비아인이 그 '사르곤' 공예품이 마음에 들었나 보더라고. 메이랜더에서 피케일에게 독점 판매권을 요구했다더군."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "어……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "참 황당하군."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그래서 현지 사람들도 모두 사르곤 '전통' 수공업자로 변신했다지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그러고 아미르 아가씨가 처음 번 돈으로, 컬럼비아인들에게 사막에서 잘 자랄 수 있는 씨앗을 사 와서, 마을을 완전히 바꿨대."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "참고로 선대 아미르 저택은 피케일이 정원으로 만들었다고 하네."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "우리가 보기엔 꽤 괜찮더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "흥……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……미아로우 선생의 묘는, 아직 있지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "……묘는 모래 바람에 침식돼서 무너지기 시작했더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "……묘비 좀 닦아주고, 꽃도 하나 두고 왔어. 거기 사람들에게 부탁해서 작은 방풍막도 하나 만들었고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "저세상에서는 잘 지내고 있겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그래, 잘했네."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "크흠."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "전반적으로 사르곤은 아주 흥미로운 곳이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "언어 발전의 상황도 그렇고, 지금까지 가 본 다른 나라들과는 많이 다르지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "같은 지역 사람이라도, 인종에 따라 억양이 다를 수 있거든."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "어떤 억양은 특정 종족에서만 나타나고, 다른 종족이 구현할 수 있는 가능성은 거의 없었어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "도마뱀이 되지 않는 한은 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "혹은 다른 이상한 생물로 말이지."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "정말 특이한 관점이네."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "이게 내 전문이니까."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "언어 얘기를 하니 생각났는데, 난 사르곤에서 아주 특별한 곳을 지나갔었어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아카후알라라는 곳이었지."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "아……카……훌……라?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아카후알라. 의료부에 있는 그 아다크리스 여자의 고향이지."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "가비알 말이군. 들어봤어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "난 사르곤에서 이런 천국 같은 곳을 찾을 수 있으리라고는 생각도 못 했다고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "다만 아쉽게도 거기 아다크리스는 '과도한 열정' 때문에, 말보단 주먹으로 교감하려 하더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "결국 마지막엔 방패를 너무 많이 사용해서 '펑'하고 고장 나버렸지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아카후알라를 떠나기 전에, 난 나무와 섬광탄으로 임시 방패를 만들어야 했어."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "재밌네."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "열대우림에는 독특한 사냥감들이 많았지. 티나도 분명 좋아할 만한 곳이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "슬슬 식사 시간이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "다들 오후 일정이 어떻게 되지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "난 인사부에 가서 새 유니폼을 받아야겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "사르곤의 모래 때문에 거의 너덜너덜해졌거든."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "이런 걸 입고 있으면, 은폐하기도 힘들다고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "떨어지는 모래를 따라오면 누구나 날 찾을 수 있을 테니까."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "그거 참 재앙이로군."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "좋아."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "그럼, 두 시간 후, 로도스 아일랜드 훈련장에서 집합한다. 다른 의견 없지?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "일동",
      "speakerId": null,
      "text": "없어."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "우린 소대 단위 훈련을 진행하지 않은지 너무 오래됐어."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "다들 대항 훈련의 요점을 잘 기억하고 있길 바랄게."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "해산, 두 시간 뒤에 보자."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "이따 보자고, 다들."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "자, 가자, 쾨츠."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "오늘도 많은 임무가 기다리고 있다고."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "로도스 아일랜드\n레인보우 팀 임시 숙소"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "새 유니폼, 새 장비, 거의 다 됐네."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "어디 보자……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Blitz는 숙소 거울에 비친 자신의 모습을 바라봤다.\n그동안 그는 혼자 사르곤을 여행하며 집으로 돌아갈 수 있는 실마리를 찾아다녔다.\n사르곤의 번영하거나 무너진 도시부터 아카후알라의 울창한 정글까지, 그 어느 곳도 그의 탐구를 향한 발걸음을 가로막을 수 없었다.\n오직 고온지대를 제외하고.\n그곳은 시간마저 황사에 지배당한 듯했다.\n하루, 이틀, 열흘.\n눈앞의 모습은 전혀 변한 적이 없었다.\n그저 그렇게 모래 위를 걸어갈 뿐이다.\n아무런 수확도 없었다.\n그는 두려워졌다."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "……"
    },
    {
      "type": "narration",
      "text": "언제 돌아가기로 결정했었는지도 알 수 없었다. 하지만 그 상황에선, 앞으로 가든 뒤로 돌아가든 마찬가지였다.\n푄 고온지대의 안전가옥으로 돌아가고 나서야, 비로소 살아 있다는 느낌이 몸으로 돌아왔다.\n곧이어 엄청난 파도처럼 피로가 밀려왔다.\n매번 그때의 생각을 할 때마다, 몸이 떨려 온다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "어때, 좀 괜찮아?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "응……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "이따 총알을 실컷 먹여줄게."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "응."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "먼저 가지."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "(Blitz의 어깨를 두드린다)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "익숙한 목소리가 그를 기억 속에서 끄집어냈다.\n자신의 손에 있는 개조 총기와 완전히 충전된 방패를 바라봤다."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "대항 훈련은 나랑 Ash가 Frost, Tachanka를 상대하는 거겠지."
    },
    {
      "type": "narration",
      "text": "협력, 대항, 전우와 함께 전술 목표를 달성.\n그는 갑자기 마음속에 의욕이 차올랐다."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "서프라이즈 타임이야."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "4시간 후\n로도스 아일랜드 본함 훈련장"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "후, 하……"
    },
    {
      "type": "narration",
      "text": "한때는, 푄 고온지대의 끝까지 가보자고 생각한 순간도 있었다. 실패하여 목숨을 잃는다 하더라도.\n그러던 어느 날, 안전가옥에서 어느 친구가 준 신비한 음료를 한 모금 더 마셨고, 맑은 정신과 환각의 틈새에서, 그는 문득 한 가지를 깨달았다.\n자신이 간절히 성과를 내기 위해, 혼자 방패를 들고 앞으로 돌격했을 때\n자신의 동료들과는 멀찍이 떨어져 있었다는 것을\n엘리아스 쾨츠, 오퍼레이터 Blitz\n직책은 팀원을 호위하는 것이다.\nFrost에게 전술 함정을 배치할 기회를 만들어 주는 것이고.\n적들을 Tachanka의 총 앞으로 유인하는 것이며.\nAsh에게 몇 가지 조언을 하는 것이다.\n혼자서 위험을 무릅쓰며 탐색을 하는 것이 아니다.\n그는 깨달았다.\n그렇기에 지금, 그가 돌아왔다."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "저번에 전술 함정을 밟았을 때 어땠는지 거의 잊을 뻔했어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "괴물용 전술 함정을 쓰지 않아 줘서 고마워, Frost"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "감사는 Ash에게 하라고, Ash의 파괴탄이 아니었으면 너는 진작에 아웃이었으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "2대 2 대항 훈련이다 보니까, 실전보다 간단했던 부분이 많아."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "알렉산드르의 방어 위치는 내가 이미 드론으로 여러 번 확인했으니까 과감하게 했던 거고."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "훈련용 탄환이 아니었으면 기회는 없었을 거야, Ash."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "알지."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "그래서 그 틈을 파고들었던 거고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "하……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그냥 우리 넷이 한 번에 사라졌었으면 좋았을 텐데. Ela랑 Iana 둘은 말려들지 않게 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "그랬으면 좋았겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "아쉽지만 우리는 더 이상 완전한 5인 특수 부대를 구성할 수 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아니면 이 세계에서 새로운 사람을 모집해 보는 것은 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "우리는 대테러 특수 부대지, 군사 청부업체의 용병이 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "평화를 지키는 게, 우리의 유일한 임무였다고."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아쉽네, 이곳의 평화는 지구보다 훨씬 취약하잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "그래서 우리가 지금 해야 할 일은, 생존 그리고 집으로 돌아갈 방법을 찾는 것이지."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "아무리 많은 신입들이 있다 해도, 우리와 함께 이 길을 끝까지 가진 않을 테니까."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "하지만 그렇게나 큰 차이가 있을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "우리들 나라 사이의 차이보다도 더 크겠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "하하."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "예전에는 옛날 상사 식스가 똥을 치워줬지만, 지금은 모든 걸 우리가 알아서 해야 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "아니면 이 세계의 일원이 되려 노력해 보는 건 어때, Ash."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "우리는 지금 익숙한 환경을 떠난 지 오래되었잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "이 엉망인 곳에도, 뭔가 칭찬할 만한 점이 있을 수도 있겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "물론 집으로 돌아가는 건 중요하지만, 그게 전부는 아니라는 거야, 코언."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "집으로 돌아가는 방법을 찾기 전에, 어떻게 살아가야 할지 생각해 볼 수도 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "어떻게 하면 총을 내려놓고, 이 대지에서 걸어갈 수 있을지 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "그게 네 생각이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "그냥 제안일 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "친구로서의 제안이지."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "고려해 볼게."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "누가 왔어."
    },
    {
      "type": "dialogue",
      "speakerName": "도베르만",
      "speakerId": "char_130_doberm",
      "text": "오랜만이군. 레인보우 팀 제군."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "어서 와."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "어서 와?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "잠깐 Ash, 이게 무슨 상황이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "듀나",
      "speakerId": "char_260_durnar",
      "text": "우리도 훈련하러 왔어!"
    },
    {
      "type": "dialogue",
      "speakerName": "펠른",
      "speakerId": "avg_npc_972_1",
      "text": "교육을 받으러 왔다고 할 수 있겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스",
      "speakerId": "char_013_riop",
      "text": "다들 안녕."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "새로운 상대들이 왔으니, 시작해 볼까."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "Ash , 너 설마……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "우린 오퍼레이터고, 레인보우 팀이야."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "다들 이 도전을 받아들일 수 있겠지?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "받아들이지."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "전술 함정 종류를 바꿔야겠는데."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "Blitz, 너는?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "답은 뻔했다."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "거절은 내 선택지에 없다고, Ash."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "준비 됐어."
    },
    {
      "type": "sceneBreak"
    }
  ],
