    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "엘리시움",
      "speakerId": "avg_npc_450_1",
      "isRemote": false,
      "text": "하하, 이 시테러들은 정말 예민하다니까."
