    {
      "type": "dialogue",
      "speakerName": "조르디",
      "speakerId": "avg_4042_lumen_1",
      "isRemote": false,
      "text": "……일부 기록 데이터가 있긴 한데 무슨 뜻인지는 모르겠어요. 끝도 없어요!"
