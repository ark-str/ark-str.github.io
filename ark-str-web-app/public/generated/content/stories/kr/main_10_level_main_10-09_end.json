        {
          "type": "dialogue",
          "speakerName": "아미야",
          "text": "박사님, W 씨가 하이디 씨에게 볼일이 있다고 말할 때, 눈빛이 뭔가 이상했어요.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
