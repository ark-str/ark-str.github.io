  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act15side/level_act15side_01_end.txt",
  "sourceHash": "e568ab0f5f7d8f52706efaa1a826f7eab6e610ab475d445f77ef6cc82aa3f5d1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "어? 왜 갑자기 멈추셨을까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "조금 전에 제가 너무 심하게 공격해서 아가씨를 다치게 했나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……흥, 어디서 잔망스러운 동작의 무공을 갖고 거들먹거려?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "그 대도둑도 도망쳤겠다 너랑 더 얽혀봤자 아무런 의미가 없어. 너 같은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……너 이름이 뭐야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "우요우라고 합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "하핫, 도둑이 스스로 본명을 밝히겠나? 강호에서나 부르는 칭호 따위겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "오호, 정말 똑똑하시네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "내가 계속 쫓겠다면 넌 비킬 생각이 없는 거지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "제가 괜히 아가씨한테 똑똑하다고 했겠습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……건방진 녀석!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "길거리 청년",
      "text": "뭘 멍하니 있어? 어서 덤벼!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "길거리 청년",
      "text": "아가씨! 저희가 왔습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "……잠깐!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "길거리 청년",
      "text": "히잇……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "크흠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "여기는 객잔인데 두 분께서 계속 이러시면 만신창이인 모습으로 괜스레 행인들에게 비웃음만 사게 되는 걸세.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "그래도 두 분께서 멋진 대결을 보여주신 덕에 우리도 식견을 넓혔으니…… 변상은 굳이 따지지 않겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "그러니 오늘은 소인의 체면을 봐서라도 그만하는 게 어떠신지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……흥.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "미안합니다, 사장님. 나중에 오해가 풀리면 사과드리러 찾아오겠습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……사장님 얼굴을 봐서 오늘은 널 봐준다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "그 사람이랑 무슨 사이인지는 모르겠지만, 얌전히 우리한테 넘기는 게 좋을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "그놈을 감싸주면 너희도 공범이 된다. 지금은 그냥 보내지만 상촉은 너희 같은 범법자를 용서하지 않아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "정말 범법자라면 경찰에 신고하면 될 것이지, 뭐 하러 직접 무력까지 쓰는 거죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "우요우 씨, 지당하신 말씀이구먼. 아무리 명분이 옳다고 한들, 다짜고짜 주먹부터 쓰는 건 아니지 않나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……당신!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "아가씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "얼른 부하들을 돌려보내게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "길거리 청년",
      "text": "아, 아가씨, 이렇게 놓아준다고요……? 저놈을 잡아서 그 용문인이 걸려들게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……조용히 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "어차피 그자는 도망쳤으니 쟤 하나 잡아 둔다고 의미 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……게다가 정말 붙잡아 둘 수나 있을까? 야, 너 혹시 아직 숨겨둔 수법이라도 있는 게 아냐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "설마요. 옛말에 화목하면 부가 온다 했잖습니까. 아가씨께서 한발 물러 주신다니 정말 잘 된 일이죠……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "우요우, 널 기억했어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "귀인은 사소한 일을 자주 잊는다던데, 저도 제발 잊어줬으면 좋겠습니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "(슬금슬금…… 됐어, 이 정도 거리면 뛰쳐나갈 수 있겠다……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "난 정 영감 체면을 봐서 이만 두는 거야. 이 문을 나서면 누가 널 지켜줄까? 차라리 얌전히 이 두 소저의 말에……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……따르면! 엥!? 어디 갔지!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "어, 어느새 도망간 거야!? 너희는 대체 뭐 했어!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "길거리 청년",
      "text": "……그게…… 아가씨께서 아까 녀석을 보내줄지 말지 확실하게 얘기를 안 하셔서……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……뭘 쳐다봐? 얼른 쫓아가!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "길거리 청년",
      "text": "아, 예!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 점원",
      "text": "……두 소저, 일을 너무 크게 벌이신 거 아닙니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……넌 비켜!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "객잔 점원",
      "text": "아니, 저, 저기…… 관두자, 내가 남의 집안일에 참견할 바는 아니지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "정 영감! 아까 왜 구경만 하더니 도리어 날 말렸어!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "……억지 부리기는.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "억지라니? 저 사람들이 응봉로로 갈 줄 알고 여기서 기다린 거 아니었어!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "도시에 있는 수십 개 객잔이 다 우리의 눈인데, 사리분별을 못하는 좀도둑 하나 잡는 건 일도 아니잖아……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "……사리분별 못하는 게 누군데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "너는 그 술잔이 뭔지도 모르고, 하물며 그 용문인이 어떤 사람인지는 더더욱 모르겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "게다가 아까 무공이 뛰어난 사람도 있었고. 만약 그들이 마음먹고 일을 크게 벌이면 분명 이기는 것도 그들이고, 도리에 맞는 것도 그들이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "두 소저",
      "text": "하지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "하지만 뭐? 이 의뢰가 얼마짜리인 줄 알아? 그 이름 모를 의뢰인이 어떤 인물인지는 또 알기나 하나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "정 사장",
      "text": "너 따위는 표국의 이름에 먹칠할 자격도 없다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "……아무도 안 쫓아오는 것 같군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "여러분, 죄송하게 됐습니다. 원래대로라면 제가 길을 안내했어야 하는데, 일이 이 지경까지 되어 버리다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "정말 상상도 못 했습니다. 상촉에 당도한 순간, 설마 이런 꼴을 당할 줄이야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "그런데 그 젊은이만 남겨 두고 와도 정말 괜찮을까요? 우리 때문에 괜히 곤경에 빠지는 게 아닌지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "거기 사장이랑 그 기고만장한 아가씨랑 아는 사이 같더군요. 뒤에 남은 분은 빠져나오기 쉽지 않을 거예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "엇…… 그걸 어떻게 알지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그 아가씨가 몇 번이나 사장님의 눈치를 살피고 있었거든요. 제가 본 게 틀림없을 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "제 눈이 틀린 거라면 장사를 접어야겠죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "우요우의 달리기를 믿을 수밖에 없겠네~ 그것 하나는 믿을만하니까~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "……정말 괜찮습니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "괜찮아~ 그 여자애도 시퍼런 대낮에 상식을 벗어난 짓은 못할 거야. 사람은 적지만 그래도 안이나 밖에 행인이 꽤 있었으니까~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……후우, 여기서 로도스 아일랜드 사람을 다 만나다니 정말 신기하네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "미스터 리는 상촉에 왜 온 거야? 사무소 의뢰 때문에?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그렇다고 할 수 있죠. 오랜 친구의 사적인 부탁입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "……그 상자인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "맞습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "그런데 참 이상하군요. 상촉에서 감히 양대인의 물건에 손을 대려는 자가 있다니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "이상할 것도 없죠. 무사히 상촉에 도착할 수 있다면 양대인께서 굳이 절 찾으셨겠나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "양대인?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "네, 제 동창입니다…… 상촉의 웨이 옌우라고 보면 됩니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "아하~ 웨이 씨인가~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "……말투를 들어보니 다들 용문의 웨이 님과 아는 사이인가요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "일반 백성이라면 몰라도, 용문에서 밥벌이하고 살려면 웨이 씨를 모를 리가 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "웨이 님을 아는 것과 웨이 님과 아는 사이인 건 다른 거죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그렇긴 한데, 저와 웨이 옌우의 악연은 굳이 꺼내고 싶지 않군요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "유감이군요. 저 같은 사람은 웨이 님 같은 인물과 가까워질 수 없으니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……대단한 사람이기는 한데 그렇게까지 대단한 건 아닙니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "그럼 그 양대인이란 사람은 대단한 인물이라는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "대단한 인물이라고 할 수 있나요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "대단하죠, 안 될 리가 없습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "잠깐, 용문의 웨이 님이 아니라는 건지, 양대인이 아니라는 건지, 어느 쪽입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "뭐, 그렇다고 치죠. 지금은 모두 대단한 인물이 되었지만, 쯧쯧. 예전에는 융통성 없는 고집쟁이었거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "……미스터 리는 아직도 여전하네~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "훗, 전 용문에서 먹고 사느라 바쁜데, 상촉의 고관대작과 무슨 관계가 있겠습니까? 연락 안 한 지도 오래됐어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "저길 보세요, 그 젊은이군요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "우요우! 괜찮아~?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "아파파파, 건드리지 마세요, 온몸이 아프단 말이에요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "은인님은 모르시겠지만, 그 계집애가 얼마나 미친 듯이 달려들던지 혼신의 힘을 써서 겨우 상대하다가, 사장님이 말리시는 틈을 타서 빠져나온 거예요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "……뛰어오는 모습을 보니까 하나도 안 다친 것 같은데~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "부채도 손에 잘 접혀 있고, 전혀 혼신의 힘을 쓴 것 같지 않은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "으으…… 역시 은인님은 속일 수 없습니다…… 그런데 이렇게 크게 싸운 건 너무 오랜만이라 쥐가 나긴 했어요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……이 사람은 누구입니까?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "오퍼레이터 우요우~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "아직 정식으로 입사하지는 않았지만, 제 충성심은 오래전부터 이미 로도스 아일랜드를 위해 뛰고 있었습니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "새로 입사한 오퍼레이터군요. 만나 뵙게 되어 영광입니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "저야말로 영광이죠. 은인님께 들었는데 로도스 아일랜드와 협력하신다면서요? 역시 로도스 아일랜드답군요. 널리 인맥을 쌓고 깊은 신뢰를 얻다니. 그래서 이런 좋은 인연이 생기나 봅니다…… 미스터……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그냥 리라고 불러주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "아뇨, 공손하게 리 형님이라고 불러야죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그런데, 아까 사장님이 싸움을 말려서 도망칠 수 있었다고요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "그렇습니다, 왜 그러세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……음…… 그리 간단한 일이 아닌 것 같아서요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "여기서 그만 얘기하시죠. 사람도 많은데 무슨 일이라도 생기면 저는 감당 못합니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "그럼 바로 양대인의 저택인 양지부로 가시죠.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "이 친구들은……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "양대인께서 당신만 데려오라고 당부하셔서, 다 데려가는 건 좀……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "뭐, 상관없겠죠?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "양대인은 아량도 넓으신데다 아까 두 분도 저희를 도와줬으니, 함께 가도록 갑시다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루스",
      "text": "양지부인가 …… 우리도 괜히 민폐 끼치는 거 아니야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "괜찮습니다. 제가 있잖아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "리 형님 말씀 한번 시원하게 하시네요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "뱃사공",
      "text": "그럼…… 결정했으니 어서 서두릅시다. 이쪽입니다, 자.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "리 형님?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "어? 아…… 금방 갈게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……크오오?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "이게 뭐지…… 설마 상촉에서는 이런 이상한 애완동물이 유행하는 건가……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "크오오!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "우요우",
      "text": "리 형님! 어서요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "리",
      "text": "……네네, 지금 갑니다.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "신기한 물체",
      "text": "……크오오……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
