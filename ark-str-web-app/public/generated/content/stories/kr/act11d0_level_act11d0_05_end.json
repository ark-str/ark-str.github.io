  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 5下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "어서! 이쪽으로 오세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "감사합니다, 감사합니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "폴리닉 언니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "리사! 민간인들 데리고 먼저 가!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "윽……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "이 폭도들…… 거리를 무차별적으로 공격하고 있잖아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "무장 감염자 A",
      "text": "얌마! 기껏 힘들게 빼앗아왔더니, 조준 하나 제대로 못 하냐!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "무장 감염자 B",
      "text": "닥쳐! 이거 조작하는 게 말처럼 쉬운 줄 알어! 내가 전에 음악 학원에서 조작법을 배웠기에 망정이지……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "무장 감염자 A",
      "text": "학원은 무슨 얼어 죽을 학원?! 어이, 거기 헌병! 섣불리 움직이지 않는 게 좋을 거다, 우리에겐 인질이 있으니까 말이야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "무장 감염자 B",
      "text": "인질이 어디 있는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "무장 감염자 A",
      "text": "넌 진짜 *라이타니엔 욕설*이냐?! 거리에 뛰어다니는 놈들이 전부 인질이지 그럼 뭐야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "쳇!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "폴리닉 씨! 저들이 계속 거리를 파괴하게 내버려 둬선 안 돼요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "이 일대의 건물은 모두 목조 건물이라서, 이대로라면 거리 전체가 불바다로 변할 거예요……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "불이다! 빨리 불을 꺼! 다른 사람들은 어서 몸을 피해!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "아직 미처 빠져나가지 못한 주민이 많아요, 우리가 도와야 해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "하지만 전혀 다가갈 수도 없는데……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "……윽, 불길이!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "폴리닉 씨! 부상자를 부탁합니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "폴리닉",
      "text": "타쟈나 씨?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고집 센 주민",
      "text": "이 망할 윈터위습인들! 감염자들! 쓰레기 같은 놈들!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고집 센 주민",
      "text": "어째서 우리 집을 불태우는 거야! 어째서! 우리가 네놈들에게 무슨 잘못을 했다고……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "머리 조심하세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고집 센 주민",
      "text": "뭐?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "고집 센 주민",
      "text": "으…… 윽, 타쟈나? 괘, 괜찮아?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "윽…… 전 괜찮아요. 저들은 자율 아츠 유닛을 완벽히 통제하지 못하고 있어요. 이곳은 위험해요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고집 센 주민",
      "text": "같이 맞서 싸우자! 저놈들을 쫓아내자고!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "지금은…… 아직 그럴 때가……! 윽……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "고집 센 주민",
      "text": "너, 발이……! 아, 알겠어, 네 말대로 할게!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "여기서 벗어나세요!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "(발목이 시큰거려…… 부러졌나? 큰일인걸……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "(다른 사람들과 어서 합류해야 하는데……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "무장 감염자",
      "text": "넌 그, 귀족의 앞잡이군!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "타쟈나",
      "text": "……?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "……전부 철수했나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "네, 그렇습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "세버린 장관님, 부상자가 너무 많아요. 일손이 모자랍니다……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "의사들은 여기 이 불포족 아가씨의 지시를 따르도록. 다치지 않은 청년들도 모두 부상자 치료를 도와라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "알겠습니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "폴리닉 언니만 있었다면……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "잠깐…… 그 둘은 아직 돌아오지 않았나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "어이! 폴리닉과 타쟈나는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "그, 그 둘은 아마 아직 츠벨프톤 거리에……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "……내가 방금 '전부 철수'했냐고 물었잖아!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "히익! 죄, 죄송합니다! 하지만 그 둘은 분명 무사할 겁니다. 이렇게나 많은 사람을 구할 능력이 있지 않습니까!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "반란자들이 아직 도시 방어 설비를 점거하고 있는데, 제대로 된 무기도 없는 둘이 어떻게 무사할 수 있단…… 콜록콜록, 콜록!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "……큭, 사내놈들 몇 명 데려와라, 건장한 놈들로. 같이 가봐야겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "하지만 놈들의 화력이 너무 강력합니다. 아직 인질이 있을지도 모르는데 놈들을 다시 자극하러 가다니요, 협상할 기회를 기다려야 합니다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "기회?! 적이 우리에게 기회를 주길 기다린다고? 전쟁이 그렇게 호락호락한 줄 알아?!!!!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "죄, 죄송합니다!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "그의 말도 일리는 있어요. 대열곡이 남긴 활성 오리지늄이 월루몽드 지반 전체에 퍼져있을 가능성이 높으니, 놈들이 그걸 파괴라도 하는 날엔 끔찍한 일이 벌어질 겁니다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마을 주민",
      "text": "너희는 또 어디에서 온 놈들이냐! 관계없는 사람은 어서 떠나라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "……아니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "헌병대도 없는 우리야말로 오히려 전장과 더 무관해 보이는 사람 아니겠나…… 우린 구면 아닌가? 로도스 아일랜드의 오퍼레이터.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "이해해줘서 고맙습니다. 에이어스카르페?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "……간단한 현장 검증 결과긴 하지만, 만약 저들이 계속해서 장치를 이용해 거리를 부숴댄다면, 10분… 길어야 30분 정도면 월루몽드는 좌초될 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "가장 좋은 방법은 이 거리와 시내의 연결을 끊는 것이지만, 그럼 이동할 동력원을 잃은 월루몽드는 더 이상 이동할 수 없게 되겠지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "아니, 추진기를 사용하면 이동할 수는 있네…… 거리에 반란군이 저렇게 많지만 않으면 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "저희가 이 마을에 무력 개입을 하려면, 절차를 밟아야 할까요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "……편할 대로 움직여도 좋네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "세버린",
      "text": "두 사람에게…… 타쟈나와 폴리닉을 부탁해야겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "세버린 장관님…… 추가로 필요한 물품이…… 앗!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "……리사?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "그…… 그레이스롯 선배님? 이분은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "오퍼레이터 에이어스카르페. 재앙정보전달자 레온하르트의 호위 담당이다. 레온하르트는 다른 임무에 파견돼서, 나만 여기에 끌려왔지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "리사, 아트로랑 폴리닉은?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "폴리닉 언니가 아직 저 안에 있어요! 아트로…… 아트로 언니는, 그게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "애써서 말하지 않아도 돼, 나도 예상하고 있었으니까. 그저 다시 한번…… 확인하고 싶었을 뿐이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "……흐흑…… 로도스 아일랜드 선배님들이 오셔서 정말 다행이에요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "……아니, 아니지, 지금은 이럴 때가 아니에요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "스즈란",
      "text": "전 부상자들을 돌보고 있을 테니, 반드시 폴리닉 언니를 데리고 돌아와 주세요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "응, 그럴게.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "저렇게 어린 꼬마도…… 오퍼레이터라고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "아미야도 리사랑 몇 살 차이 안 나, 호들갑은.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "……그렇군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "이번 구조 작전은 완전히 계획 밖의 일이라 방어 설비도 전혀 없는데, 괜찮겠나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "괜찮아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "에이어스카르페",
      "text": "……의외군. 그레이스롯 아가씨는 오리지늄을 반갑게 맞이해줄 사람은 아니라고 들어서, 오면서 꽤 걱정했는데 말이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이스롯",
      "text": "……비극이 일어나는 게 싫어서 그래. 우선은 구조가 급선무니, 쓸데없는 소리는 그만하고 어서 서두르자고.",
