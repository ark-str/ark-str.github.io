  "title": "스트레스 반응",
  "storyCode": "4-8",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/obt/main/level_main_04-08_end.txt",
  "sourceHash": "c323281a5ebe3bbd5b720cab262548ca46c0665cdb76da2ef7b1e5c8fb54ee47",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "벽 뒤에 있는 거 알고 있다, 쏘지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "내가 누굴 데려왔게?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "메테오라이트 씨, 저예요!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "누구야? 설마… 아미야?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아미야! 저… 정말 네가 와주다니!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "다행이야, 정말 다행이야…",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "…하지만 여기 와선 안 돼. 이건 적의 함정이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "우릴 구출하기엔 리스크가 너무 커.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "이건 판단 미스라고…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "지금 아미야 탓을 해봤자 별수 없어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "게다가, 지금 도망칠 수 없는 상황인 건 다들 알아… 아미야가 그걸 모를 리 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아미야한테 뭐라고 하는 게 아니야! 단지…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "크윽… 정말 미안해, 아미야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "괜찮아요. 여러분이 무사하신 모습을 본 것만으로도 정말 기뻐요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "아미야…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그런데 제시카 씨는… 왜 저렇게 되신 거예요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "으으…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "그러니까 좀… 놀라서 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "원래는 저 아이가 다시 기운 차릴 때까지 기다리려 했는데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "트라우마가 생겼다…고 해야 할까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "제시카 씨, 괜찮으세요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이 방법밖에 없겠어…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프로스트리프 씨, 도움이 필요해요. 제시카 씨의 손이 제 손목을 잘 잡고 있도록 해주세요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "…알았다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네, 그럼…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "크윽……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "아미야!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "괜찮아요! 그런데…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "엄청난…… 슬픔이 느껴져요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "또렷하지는 않지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "제시카 씨!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "괜찮아요……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "정신 차려요, 제시카 씨…!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "…아미야 씨…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "그래요, 저예요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "아미야 씨… 아미야 씨…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "네… 이제 괜찮아요.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "메테오라이트",
      "text": "제시카… 괜찮니…?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "아미야 씨… 저 있잖아요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "…죄송해요… 그런… 그런 일이…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "괜찮아요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "그런, 그런 일을… 으흑……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "저도 알아요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "왜냐하면 저도 그런 적이 있었으니까요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "도망치고 싶은데 발은 안 떨어지고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "소리치고 싶은데 목소리는 안 나오고…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "제시카 씨, 저도 알아요… 저도 똑같은 일을 겪었거든요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "자, 이제 일어나요. 제시카 씨.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "이제 무서워 할 필요 없어요…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "지금은 우리가 있잖아요. 혼자가 아니에요. 우리가 항상 곁에 있어 줄게요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "같이 로도스 아일랜드로 돌아가요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "프란카 씨와 리스캄 씨가 기다리고 있어요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "text": "…네!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "프로스트리프",
      "text": "아미야… 너, 방금 전 그 능력은…",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "text": "켈시 선생님께는…… 비밀로 해 주세요……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
