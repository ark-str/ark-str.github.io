    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "살카즈 전사",
      "speakerToken": "avg_npc_419_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "장군님, 준비가 끝났습니다!"
