    {
      "type": "dialogue",
      "speakerName": "외드레르",
      "speakerToken": "avg_npc_393_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "맨프레드, 당신은 이미 나의 충성을 얻었어."
