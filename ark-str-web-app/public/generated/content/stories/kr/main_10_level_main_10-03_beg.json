      "type": "dialogue",
      "speakerName": "맨프레드",
      "speakerToken": "avg_npc_404_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "자동 조준 시스템 가동, 장거리 타격 목표 입력……"
