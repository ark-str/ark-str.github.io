    {
      "type": "dialogue",
      "speakerName": "맨프레드",
      "speakerToken": "avg_npc_404_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "그러니까 너의 대답은 여전히 '아니'라는 얘기군."
