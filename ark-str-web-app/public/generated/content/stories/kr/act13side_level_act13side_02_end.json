  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 2-2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "……이보나, 왔어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "안색이 너무 안 좋아 보이는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "……당연하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "저 망할 기사 놈들의 갑옷을 산산조각 내지 못했으니까…… 쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "……네 잘못이 아니야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "본인 몸 상태를 아무에게도 알려주지 않았잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "그 정도 감염이면 몇 달 전부터 움직이지 말았어야 했는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "어떻게든 카시미어를 떠나서 본인이 원하는 대로 마지막 시간을 보냈어야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "올머 잉그라…… 이게 카봐렐리엘키의 기사 귀족이야. 포악하고 무식하고 사람 목숨을 우습게 알고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "그때 그놈의 사지를 다 부러뜨렸어야 했는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "……네 잘못도 아니야, 그레이너티.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "쳇, 내가 그 자리에 있었는데도……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "……마지막으로…… 남긴 말은 없어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "모르는 게 나을 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "그래도 알고 싶어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "……그래.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "감염자가 눈도 못 감고 죽는 게…… 드문 일은 아니잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "우리가 그 분노를 기억할 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "소나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "……이름은 제이미야. 원래는 스포츠 기사였는데 사고로 감염자가 되었지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "이혼했고 귀여운 딸이 하나 있어. 기사로서 계속 대회에 참가하려고 병세를 숨겼겠지…… 돈이 필요하니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "하지만 병세를 숨기려면…… 기사 협회에 더 많은 돈을 줘야 하는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "제이미의 방에서 협회 멤버와 주고받은 편지를 발견했는데, 그야말로 밑 빠진 독이더라.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "아주 긍정적인 사람이야. 그래서 제이미에게 그런 일이 있었는지 우리 중 누구도 눈치를 못 챈 거지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "광석병에 감염되어 처자식과 헤어졌는데도 다른 사람을 도와줬어……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "기억해? 제이미는 아침마다 아이들을 돌봐줬잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "이렇게 아무런 존엄도 없이 죽으면 안 될 사람이야. 이건 애초에 우리가 기사단을 창립한 목적에 어긋나는 거라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "그런데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "이렇게 열정적으로 살아가던 사람의 마지막이 결국 뼈에 사무치는 원한이라니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "그렇다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "……소나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "요즘 넌 너무 많은 걸 짊어졌어. 그렇게 고집부리지 마.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "……음……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "……그런 머리 굴려야 되는 어려운 일은 너희한테 맡길게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "난 더 강해질 거야. 저 위선자 녀석들을 산산조각 내고 내 힘으로 새로운 길을 만들 수 있을 정도로 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "피의 기사가 좋은 본보기잖아. 카시미어가 아직도 '기사'를 인정하는 한…… 우린 그 길을 걸어야지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "너무 복잡하게 생각하지 마, 소나. 그럼 속도만 더 느려질 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "……소나!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "알았어, 알았어. 그러니까 빨리 셰브치크랑 확인해야 돼……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "바…… 바람의 움직임이 바뀌었어. 순간이긴 했지만……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "누군가 지켜보고 있어, 게다가……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "……아머레스 유니온?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "저스티나",
      "text": "기운을 아주 잘 숨겼네…… 적이라면 진작 우리를 습격했을 거야……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "……나와.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "여긴 감염자 구역이야. 일반인은 멋대로 올 수 없는 곳이라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "이보나",
      "text": "그렇지 않으면……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "아, 알겠으니까 소리치지 마, 하아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "감염자 기사라니, 생각지도 못한 풍경이야. 10년 넘게 카봐렐리엘키 근처에도 안 왔었는데, 기사 어르신들과 상인 양반들이 정말 상상 이상이군……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "그레이너티",
      "text": "……누구야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "오해하지 마, 사람을 찾다가 우연히 지나쳤을 뿐이야. 이렇게 만난 것도 인연인데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "……우리는 공통의 화제가 있을 것 같거든, 감염자 여러분. 예를 들면…… 아머레스 유니온이라던지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "소나",
      "text": "아쉽지만 오늘 우리에게 좀 불행한 일이 있었어. 정말 얘기하고 싶으면 다음에 다시 보자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "그래? 타이밍이 영 안 맞네, 아쉽다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "그럼 다른 곳에 가보는 수밖에 없겠네. 오랜만에 그랜드 나이트 영지에 왔는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "톨런드",
      "text": "자, 그럼 이만…… 어쩌면 곧 다시 만날지도 몰라.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "셰브치크를 데려간 기사를 찾았어…… 도망친 송곳니의 기사야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "피누스 실베스트리스 기사단과 같이 있더라. 물론 감염자 기사는 원래 결속력이 좋긴 하지……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……그쪽에서 나는 건 무슨 소리야? 또 술집이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "예예, 또 나이츠모라 조사야? 아주 좋은 핑계지. 그래서, 감염자에 관한 명령은 언제 내려지는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……뭐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "셰브치크 일도 '윗선에서 아직 회의 중'이라고 해서 이렇게 된 거 아니야? 드론을 보내서 폭격까지 해놓고 무슨 의미가 있다고……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "야야…… 나한테 아무리 말해도 지금은 토너먼트 기간이라 경솔하게 결정할 수 없잖아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "네, 네네. 진짜로 게으름 피우는 거 아니니까 날 믿어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "진짜라니까…… 저기 사장님, 감자튀김 하나요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "잠시만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "네. 여보세요? 모니크, 듣고 있어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "……이런, 끊어버렸네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "자, 주문한 감자튀김.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "앗, 고마워요.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "음……! 감자를 채 썰어서 튀길 생각은 누가 했을까? 정말 천재가 따로 없다니까.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "그러고 보니 전에 두각을 드러낸 마리아 니어와 채찍의 기사도 여기 자주 온다면서요?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "사인받고 싶은 거면 운이 좋아야 할걸……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "이 술집에선 은퇴한 늙은이들밖에 볼 수 없잖아.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "저 녀석은 누구야? 아머레스 유니온의 염탐꾼인가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 장인",
      "text": "난들 알겠냐. 손을 쓰지도 않았으니 몸을 뒤질 수도 없고…… 야, 널 지켜보는 것 같은데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "음…… 그냥 내버려 둬.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "어젯밤부터 눈꺼풀이 심하게 떨리던데…… 왠지 큰일이 일어날 것 같은 느낌이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 장인",
      "text": "너도 드디어 잠이 줄어들 나이가 된 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "뭐? 난 아직 팔팔하다고! 예전에 눈꺼풀이 심하게 떨린 것만으로 포병 캐스터의 습격을 예지한 적도 있거든……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 장인",
      "text": "너한테 무슨 큰일이 생기겠어? 아침에 치약을 짰는데 올리브유라도 나왔나?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "……음.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "마틴. 뭔가 그 아우라가 막 느껴져…… 거물급이야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "난 이런 이상한 예감은 처음이라서 말이지…… 아무튼 말썽 피우러 온 게 아니면 좋겠네.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "(벌써 온 건가, 정말 빠르네…… 음, 우선 지켜봐야겠다.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "——\n……(고대 언어) 젊은 사냥꾼이 천도의 길에 오르네♪\n……(고대 언어) 꿈에서 출발해 황금의 세계로 향하네♪"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "(저 언어는……!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 장인",
      "text": "……뭐야, 요즘 사람들은 술집에 올 때 모두 스스로 등장곡을 부르는 건가? 그럼 주크박스는 의미가 없잖아!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "이런 볼품없는 내 술집이 정말 니어 가문의 덕을 보기라도 했나? 하지만 저런 기사는 처음 보는데…… 왜 그래, 포?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "나…… 나도 모르겠어, 갑자기 심장이……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(고대 언어) ……바트바야르, 동포, 후손이여.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(고대 언어) 왜 이런 곳에?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "너……! 그 이름을 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "기사는 말없이 주위를 둘러본다. 그의 시선이 닿는 곳은 불빛마저 피하는 것 같다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "대답해, 어떻게 그 이름을 알고 있냐고……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 장인",
      "text": "어이, 포, 아는 사람이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "뭐 마실래, 손님? 만약 아무 볼일이 없다면 여긴 무기 든 기사를 별로 반기지 않아서 말이지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "(고대 언어) ……아쉽군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "잠깐, 기다려……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "코발, 마리아가 공방을 계속 빌리겠다는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "……으윽.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "조, 조피아 언니, 기다려…… 꺄악!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "가, 갑자기 멈추면 어떡해? 무슨 일이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "……넌……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "……악몽의 기사?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "이번 대회의 초신성이 여긴 왜 왔지? 설마 마리아와 마가렛의 정보를 캐내려고?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "만약 그렇다면……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "시끄럽다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "조심해!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "가…… 갑자기 무슨 짓이야!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……페가수스…… 나약한 종족. 황금의 피가 흐르는 페가수스만이 상대할 만하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "그러나, 페가수스 퇴위 후, 이 이른바 '기사의 나라'……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "초원이 쇠약해지고 있다. 그런데도, 못 본 척인가, 쿠란타?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "지금의 카시미어에선, 너희 같은 사람이 기사라고 불리는가?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "다들 저…… 허울뿐인 경기장에서 대결하는가?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "방금 그런 행동을 한 너와 차분하게 대화를 할 수가 없겠군.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "움직이지 마…… 애송이, 물어볼 말이 있으니까. 네 머리통을 박살 내고 싶지는 않다고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "나쁘지 않다…… 아직 싸울 의지가 있는가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "그럼, 너는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "엥? 뭐, 나? 난 그저 지나가다 들린 기사 팬이야. 못 본 거로 해줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "난 아무것도 안 해, 아무것도. 응.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "('진동하는 철의 기사' 마틴은 해머를 능숙하게 다루고, 포겔바이데는 출정 기사의 궁수였지. '채찍의 기사'는 부상당해서 별 위협이 아니고…… 마리아는 당분간 주목할 필요가 없겠네.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "(하지만 중요한 건 이게 아니야…… 흐음…… 나이츠모라는 역시 포겔바이데를 찾아온 것인가……)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "로이",
      "text": "(자…… 이제…… 어떻게 해야 할까? 빛의 기사가 오려나?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……여기에 머물 가치가 없다. 너희와 함께 있는 것도, 불쾌할 뿐이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "이 애송이가, 누굴 깔보는 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 바트바야르, 넌 일찍이 전장에 나가 전쟁을 치렀지만, 겨우 고향만 지켜낸 것에 불과하다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 장인",
      "text": "(지금 뭐라는 거야!?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "전쟁…… 너 출정 기사야? 날 알아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 아니, 난 '기사'가 아니다. 이런 건 너무 어처구니없다. 다만, 전쟁에 나간 것은 네가 선조의 얼굴에 먹칠하지 않은 유일하게 잘한 일이다, 후예.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 비록, 이곳…… 이 콘크리트 정글에서, 비가 네온사인을 뚫고 땅에 떨어질지라도, 후예, 너는 초원의 공기와 카간의 맹세를 기억해줬으면 한다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "……카간? 뭐……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "무슨 고리타분하고 쓸데없는 소리를 하는지?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 원래는…… 다시 출발하기 전에, 기사의 나라라는 불리는 이 땅에서 남아있는 동포를 찾으려고 생각했지만, 지금 보니 나의 착각일 뿐이었다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 이제 됐다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 카시미어의 나약함은 카간의 업적에 대한 모독, 이런 행위는 누군가 바로잡아야 한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "거기 서! 아직 내 질문에 대답 안 했잖아!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……음, 지금은 평범한 사람이 되었지만, 다소나마 동포…… 네 질문에 대답하지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……네 이름은 한 노병에게 들었다. 그는, 이미 너무 늙고 쇠약해져 달리기조차 못한다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "난 카시미어에 있는 모든 동포를 찾고 있다. 아무리 먼 관계라도, 그저 동포를 찾고 있을 뿐이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "뭐? 동포? 카시미어에서?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……이제 너와는 관계없다, 카시미어인.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "잠깐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "악몽의 기사…… 괴팍스러운 신인이란 소리는 진작 들었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "하지만 우리에게 칼을 겨눈 널 쉽게 보내줄 수는 없지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "투구는 벗고 얘기하는 게 어때?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……'악몽'……? 아, 도시의 노예들이 멋대로 내게 지어준 이름인가.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "가소롭군…… 기사가 그렇게까지 이름을 신경 쓸 필요가 있나……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "기사는 타고난 신앙과 운명을 장악하려는 갈망으로 여정에 오르는 것이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "……!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "이렇게 깽판 부리면 기사 협회에서 가만있지 않을 거야. 토너먼트 자격을 잃고 싶어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "……만약…… 카시미어에 너 같은 보잘 것 없는 기사 밖에 남아 있지 않다면…… 나는 괜히 힘 뺄 필요가 없으니, 쓸데없는 자격 따위 박탈당해도 상관없다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "하지만, 네 옆에 있는 페가수스는…… 내가 찾고 있는 어떤 사람과 많이 닮았다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "……! 설마…… 언니를……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "마리아",
      "text": "……빛의 기사는 왜 찾는데?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "왜 찾냐고……? 카시미어에서 대기사로 추앙받는 챔피언들…… 만약 오늘의 카시미어에 정복할 가치가 있는 상대가 있다면, 아마 그들 중에 있을 거다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "물론…… 모두에게 실망할 가능성도 있지만.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "……너 미쳤어? 싸우려 왔나?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 미쳤다……?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) 그래…… 현재를 살아가는 걸 선택한 카시미어인들은, 자주 그렇게 물어본다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "(고대 언어) ……그러니 이제 우리는 동포가 아닌 것이다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "거기 서! 이렇게 아무 일도 없었다는 듯이 떠나려고!?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "수확이 없으니, 오래 머물 필요도 없다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "악몽의 기사",
      "text": "그럼, 후손이여.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "……쳇.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "대체 왜 저래? 넋이라도 나간 것처럼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "조피아",
      "text": "마가렛이 경기에서 저놈이랑 붙지 않았으면 좋겠다.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "대머리 마틴",
      "text": "그냥 널 보러 온 것 같은데? 같은 고향 출신이야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "나이 든 기사",
      "text": "저 사람…… 설마 나이츠모라?",
