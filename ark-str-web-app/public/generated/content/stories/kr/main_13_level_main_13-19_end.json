    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": "avg_npc_410_1",
      "isRemote": false,
      "text": "그곳에는……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": "avg_npc_410_1",
      "isRemote": false,
      "text": "뭣……"
