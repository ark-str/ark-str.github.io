    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": "avg_npc_410_1",
      "isRemote": false,
      "text": "심연 속에서 각성한 자가 더욱 강하다는 당신의 말은, 인정합니다."
