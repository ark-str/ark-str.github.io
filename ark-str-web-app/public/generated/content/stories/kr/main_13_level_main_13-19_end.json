    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "이네스",
      "speakerId": "avg_4087_ines_1",
      "isRemote": false,
      "text": "미안. 살카즈의 은혜 같은 건, 나랑 상관없거든."
