    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": "avg_npc_1072_1",
      "isRemote": false,
      "text": "큭!"
    },
    {
      "type": "dialogue",
      "speakerName": "로고스",
      "speakerId": "avg_npc_1072_1",
      "isRemote": false,
      "text": "녀석의 피가, 내게, 영향을 끼치고 있다."
