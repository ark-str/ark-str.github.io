    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": "avg_npc_410_1",
      "isRemote": false,
      "text": "살카즈, 스스로를 살카즈라 자칭하는 동포들이여!"
