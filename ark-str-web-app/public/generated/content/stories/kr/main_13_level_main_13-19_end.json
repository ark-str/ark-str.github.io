    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": "avg_npc_410_1",
      "isRemote": false,
      "text": "내가 당신들을 데려가리라, 이 모든 것이 시작된 곳으로."
