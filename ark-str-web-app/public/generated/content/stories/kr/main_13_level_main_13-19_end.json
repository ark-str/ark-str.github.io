    {
      "type": "dialogue",
      "speakerName": "뱀파이어 생귀나르",
      "speakerId": "avg_npc_410_1",
      "isRemote": false,
      "text": "아직도 고향의 경계가 확장되고 있다는 것을. 지금 이순간 이곳에서도요."
