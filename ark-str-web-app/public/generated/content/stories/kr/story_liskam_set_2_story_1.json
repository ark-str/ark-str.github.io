  "sourceHash": "a94584a4b4533db6f451bcd924bade679319bcaa4451e4cf717744f2a48bb98a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 雷蛇2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_room_2"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "제…… 부족의 상황이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래, 실례가 됐다면 미안해."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "딱히 특별한 건 없는데, 혹시 리스캄 선배가 궁금해하시는 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "맞아. 사실 최근에…… 조사를 한 적 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "제 부족과 관련된 일인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "하지만 저흰 누구와도 관계를 맺은 적이 없는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "제가 커서 부족을 떠나 여행하는 동안 만났던 용병이나 상인은 거의 없는 걸요. 하물며 스스로 떠난 다른 부족은 말할 것도 없고요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "내가 궁금한 건, 바닐라가 와이번 연맹 제한구역 밖에서 살았던 때의 상황이야."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "관련된 문헌도 드문 데다, 혼란한 상황에서는 각 부족의 상황에 대한 이야기를 듣는 것도 어려운 편이라……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "네가 말하는 그런 부족은 세상과 거의 단절된 채 살아온 게 맞지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "전 아무렇지 않아요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "하지만 리스캄 선배는 그게 왜 궁금한 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "생각나는 거라고는 끝없이 펼쳐진 사막과 건조함, 굶주림, 그리고 살아남기 위한 생존기술 같은 것뿐이에요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그런 것도 내게는 도움이 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "으음, 나쁜 의도 같은 건 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그저 와이번 연맹과 관련된 모든 걸…… 기록하고 조사하려는 것뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "와이번으로 돌아가려는 건가요, 리스캄 선배?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그, 그럴 생각은 당분간 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "나중이라면……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "어쨌든 네가 속한 부족의 식습관, 조리법, 훈련 방식, 양식 기술에 대한 자세한 이야기를 듣고 싶거든."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_corridor"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "……꺅!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "죄송해요, 정말 죄송해요…… 다치진 않았나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "괜찮아요, 쉽게 다치는 편은 아니거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "엣? 제시카 선배!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "앗…… 바닐라."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "선배, 급한 일이라도 있는 거예요?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "별거 아니야, 그냥……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배한테 예전에 빌렸던 책을 돌려드리러 가던 중이었거든."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "책이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "정말 부럽네요. 제시카 선배랑 리스캄 선배는 책을 많이 읽으셨잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "그렇게 많은 글자를 읽는다는 게 전 아직도 어려운데……"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "제시카 선배가 읽은 건 어떤 책인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "와이번에 관련된 건데……"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "와이번? 어떤 이야기죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "혹시 예전부터 내려온 《와이번 경작 및 양식법》 같은 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "김새게 해서 미안하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "내가 읽은 건, 와이번의 전쟁 시기를 배경으로 하는 로맨스 소설이야."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "와이번의…… 로맨스 소설이요?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "맞아."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "전쟁의 포화가 번지면서…… 전황은 교착 상태에 빠지고……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "용병 조직 간 경쟁이 치열한 혼란한 시대, 사랑을 위해 애인이 몸담은 용병부대에 홀몸으로 뛰어들어 대장에게 사랑을 허락해 달라고 애걸하는 여주인공…… 뭐 그런 이야기!"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "실화를 배경으로 한 책인가요? 그렇다면 그건 어느 용병 부대인 거지……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "아마…… 모티브만 따온 거지 않을까?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "특이하네요, 와이번 하면 모두들 커다란 체구의 용병을 흔히 떠올리는데."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "다들 와이번의 이야기엔 관심이 없는 줄 알았어요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "하하…… 스토리가 나름 괜찮아."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "기회가 된다면 와이번에 직접 가서 둘러보고 싶거든."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "바닐라, 와이번을 여행하려면 뭘 주의하면 될까?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "와이번을 여행한다고요?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "좀…… 이상할까?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "제시카 선배가 '지옥'을 느껴보고 싶다면, 제가 '경호'해드릴 수는 있어요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그, 그 정도야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "제가 살았던 곳은 '화장실'이나 '욕실', '주방'이라는 개념 자체가 없는 끝없이 펼쳐진 사막이 전부였어요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "으윽, 그런 생활이라면 좀……"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "아, 맞다. 리스캄 선배는 와이번 연맹 제한구역 출신이니, 어쩌면 그곳이 소설 속 배경과 비슷할지도 모르겠네요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "다만 제가 지냈던 곳에 비하면 그곳의 적은 자연 같은 게 아니라, 그보다는 한결 더 혼란한 사회라고 생각해요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "제한구역이 외부보다 더 혼란스럽다니…… 그건 소설에도 없는 묘사인데?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "솔직히 말해서 제한구역에서 무슨 일이 있었는지는 저도 몰라요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "예전에 리스캄 선배한테서 질문을 받고선 고향에 대해 이야기한 적 있었는데, “그렇게 평화로운 곳은 아니었다”라고 말했었죠."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "저는 부족에서 어린 시절을 보냈지만 늘 생사의 갈림길에서 벗어나진 못했어요. 그것만 빼면 그래도 자유로운 편이었죠."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "하지만 어른들의 말로는, 지금의 와이번은 한 치 앞도 내다보지 못할 만큼 혼란스럽다네요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "이것보다 더 자세한 건 저도 잘 몰라서…… 그런 일이라면 리스캄 선배한테 여쭤보는 게 좋을 것 같아요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "얼마 전에 절 찾아와서 부족에 대해 이야기를 나눴었거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "어? 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "리스캄 선배라면 저보다 잘 설명해 드릴 수 있을 거예요."
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "그리고…… '로맨스' 이야기는……"
    },
    {
      "type": "dialogue",
      "speakerName": "바닐라",
      "speakerId": "char_240_Vanilla",
      "isRemote": false,
      "text": "기회가 된다면 나중에 저에게도 알려주세요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "바닐라도 관심 있으면…… 기꺼이 들려줄게."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(소설 때문인가? 엄청 궁금한가 보네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(그런데…… 바닐라는 와이번에 대해 그렇게 생각하고 있었구나.)"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(소설에 나온 것보다 훨씬 끔찍한 것 같은데.)"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(리스캄 선배는 고향에 대해 또 어떻게 생각할까……)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_room_2"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "실례합니다. 선배, 저 제시카예요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "안에 있어, 들어와."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "머리 말리는 중이니까 조금만 기다려줄래?!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "네, 알겠어요."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(와아…… 지난번에 왔을 때보다 책이 더 늘었네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(게다가 보고서도 이렇게 잔뜩.)"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "(리스캄 선배는 전투력도 대단하지만 지적인 능력은 더 대단한 것 같아. 게다가 언제나 이렇게 열심이라니……)"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "엇? 이 보고서는……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "《와이번 연맹의 용병 조직 지명도 및 평가 고찰》?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그리고 이건, 《와이번 지역의 부족별 현황》…… 찾았다!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "뭘 찾았다는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "앗! 죄, 죄송해요…… 제가 함부로……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "후우…… 훈련이 방금 끝난 터라 샤워하던 중이었어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "제시카가 여기 온 건, 아마도……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "지, 지난번에 선배한테 빌린 소설책을 돌려드리려고요……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "탁자 위에 올려 둬, 내가 정리할 테니."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "네."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "엇, 이건……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "무, 무슨 문제라도 있는 건가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……음…… 아니, 내가 잘못 기억했나 싶어서……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "제시카가 빌려 갔다가 다시 돌려준 책이라면 문제없겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "감사합니다, 선배."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "저기……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……아직 더 궁금한 게 있나, 제시카?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "네, 그러니까……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그렇게 뻣뻣하게 서 있지 말고, 앉아서 말해봐."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "여긴 블랙스틸이 아니야, 그렇게 예의 차릴 필요도 없고."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "어쨌든 우린 친구인 셈이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "저기, 선배……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "역시 내 말이 믿기 어려운가……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "아, 아니에요! 선배 말 믿어요 저!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "푸흡!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "제시카는 여전하네. 예전 그대로야."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "저도 바꾸려고 노력 중인걸요……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "알아. 예전이랑 비교하면, 지금은 모두에게 보여 줄 만큼 충분히 강해졌는걸."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "하지만."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "놀라면 자신도 모르게 '머리털이 쭈뼛 서는 건' 여전하네."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "너무해요, 리스캄 선배마저 프란카 선배처럼 절 놀리기나 하고……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "난 그 녀석처럼 짓궂지는 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "네…… 아, 아니죠!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "프란카 선배도 나쁜 의도는 없지만, 매번 짓궂은 장난만 치고……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "게다가 농담은 엄청 썰렁하지."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "크흠…… 프란카 이야기는 그만할까? 제시카가 영 곤란해 하는 것 같은데."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래서 방금 저 책장에 꽂혀 있던 책 중에서 어떤 책이 보고 싶은 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "어떤 책이라기보다는…… 전, 와이번에 대해 알고 싶어요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "와이번?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "소설을 읽고 난 뒤에 그 배경에 숨겨진 이야기가 궁금해졌어요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배는 와이번 지역과 와이번 조직에 대해 줄곧 관심이 있었던 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "어? 그걸 어떻게……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "죄송해요, 방금 전에 탁자 위에 올려진 보고서 제목을 우연히 보게 됐어요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그리고 이야기를 들었어요……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……뭐, 특별한 자료 같은 건 아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "이건 뭐랄까, 나만의…… 습관 같은 거?!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "어쨌든 와이번은 내 고향이니까."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "고향을 떠나서야 고향에서 겪었던 그런…… 귀찮았던 상황이 외지 사람들에게는 어떤 의미인지 조금씩 깨닫기 시작했거든."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "다만 와이번의 지금 현실에 대해서는 나도 별다른 방법이 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "지금 할 수 있는 건 최대한 많이 파악한 뒤에, 무엇을 할 수 있을지 고민하는 것뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배가 블랙스틸에서 들려줬던 말이 생각나요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "와이번에는 남들과 다른 보안업체가 필요하다고 하셨죠."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……지금 생각해 보면 당시 블랙스틸에서 근무하면서도 그런 말을 했다는 건, 참으로 경솔하면서도 순진한 생각이었던 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그, 그건 원대한 이상이라고 생각해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "어쨌든 리스캄 선배는 장비 부서에서 절 찾아내서, 프란카 선배와 선배의 팀에 초대해 주셨잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "선배의 그 제의 덕분에, 로도스 아일랜드에서 새로운 자신을 만나게 됐으니까요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그때의 저는 꿈은커녕, 마음 털어놓을 친구조차 없었는데."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "선배한테는 항상 고마울 따름이에요. 프란카 선배가 바닐라를 스카우트하신 것처럼요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "바닐라는 프란카가 신병 무리에서 찾아냈던 거였지."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "난 그저 블랙스틸의 인재풀을 필터링하다가 쉽게 찾아낸 것뿐이고."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "뛰어난 잠재력을 지녔는데도 장비 테스트 부서에서 그 재능을 썩히는 건 너무 아까워서 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "하아……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "돌이켜보면 다 추억이네요……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "지금 돌이켜보면 그땐, 너무 유치했던 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "블랙스틸의 운영 방식을 완벽하게 이해하기만 하면 보안업체를 금방 세울 수 있을 거라고 제멋대로 판단하기도 하고."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "지난 몇 년 동안 블랙스틸의 동향을 줄곧 주시하고 있었거든."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그렇다면 선배는 왜 생화학 부서를 선택하신 거죠?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……한계에 부딪혔달까?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "지금이야 똑똑히 볼 수 있지만, 그때는 막막하기만 했어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "내가 알고 있는 '평화'와 블랙스틸의 작전 사이에 차이가 있다는 걸 깨닫곤 임무를 수행할 때마다 망설이곤 했지."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그때 롱펠로우 박사의 제안으로 생화학 부서로 옮기지 않았다면…… 아마 난 혼란 속에서 벗어나지 못했을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "제시카…… 로도스 아일랜드에 와서 어땠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "전, 정말 영광이라고 생각해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배, 프란카 선배와 같이 일할 수도 있고, 로도스 아일랜드에서 날마다 달라지고 있는 제 자신도 느낄 수 있고요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "블랙스틸에 있을 때는 마음 터 놓고 이야기할 친구도 없었는데……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "하지만 로도스 아일랜드에는 제 이야기를 들어주려는 친구가 있어요…… 덕분에 많은 도움을 받았죠."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "로도스 아일랜드에 온 게 제게는 삶의 전환점 같은 거라고 생각해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래?…… 그렇다면 다행이고."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "선배는요? 그러고 보니 프란카 선배와 같이 로도스 아일랜드를 가장 먼저 밟은 블랙스틸 대원이시잖아요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "쿨럭, 쿨럭!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "뭐, 맞아. 그땐……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그때 갑자기 인사도 없이 떠나셔서 얼마나 마음 졸였는지 몰라요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배가 우리를 버린 건 아닌지 제멋대로 걱정하기도 하고……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "나중에야 리스캄 선배가 프란카 선배처럼 로도스 아일랜드에 파견됐다는 걸 듣게 됐죠."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "어쩔 수 없었어. 나의 유일한 파트너였으니까……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "게다가 그땐 나도 블랙스틸의 일부 작전에 대해 이해하지 못했지. 아마 제시카보다도 더 헤맸을걸."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그때의 꿈도…… 한동안 잊고 지냈고."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "설마 블랙스틸에 사람들이 잘 모르는……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "블랙스틸은 훌륭한 조직이라고 생각해."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "다만…… 언제부터인가, 내 생각이 변하기 시작한 거겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "난 블랙스틸의 이념은 다른 용병 조직과 매우 다르다고 생각했거든. 이것이야말로 와이번에 흩어져 있는 용병을 한데 모으고, 생존을 개선할 수 있는 최선의 이념이라고 생각했지."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "하지만 신념과 현실은 엄연히 다르더라. 원칙과 행동 역시 백 프로 일치하는 건 아니었어."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "저, 저도……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "겉에서 봤을 때 블랙스틸은 각 지역의 평화를 유지하는 것처럼 보였어요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "하지만 로도스 아일랜드에 오고 나서야 그보다 더 심각한 상황이 있다는 걸 알게 됐죠."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그 때문에 나도 그런 경솔한 발상을 함부로 입에 담지 않게 됐어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그저 단순히 일자리만 늘려주는 보안업체보다는, 사명과 책임이 더 중요하다고 생각했으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "제시카, 현재 교착 상태에 빠진 와이번의 전시 상황이나 무질서한 관리에 관한 이야기를 들어 본 적 있나?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "예전에 들어 본 적은 있긴 한데 이번에 소설을 읽은 뒤로는……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "더 많은 걸 알고 싶어졌어요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "예전에는 다른 사람들이 와이번의 현재 상황을 보곤 도와주고 싶어 하지만 어쩔 수 없이 돕지 못하는 거라고 생각했거든."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "처음 고향을 떠나 블랙스틸에 오고 나서야 와이번 지역의 심각성을 아는 사람이 거의 없다는 걸 깨달았어. 그리고…… 아무도 신경 쓰지 않는다는 것도 알게 됐지."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래도 난 와이번을 좀 더 안전한 곳으로 만들고 싶어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "와이번 사람들이 고향으로 돌아와서 힘을 합칠 수 있게, 외부의 도움 없이도 자신을 지킬 힘을 가질 만큼 안전한 곳으로 만들고 싶어."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그래서 리스캄 선배가 취할 때마다 와이번에 평화를 가져다줄 보안업체가 필요하다고 중얼거린 것도……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그…… 그건 그냥 헛소리야!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "와이번의 자료…… 는 최근부터 정리하기 시작한 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "자, 자료 수집하는 건 그냥 습관일 뿐이지 별 대단한 의미는 없어!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……한심하다고 비웃진 말아주라."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그럴 리 없잖아요! 리스캄 선배가 하는 일이라면 분명 성공할 거라고 생각해요!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "블랙스틸에서 로도스 아일랜드에 오기까지, 선배를 알게 된 첫날부터 지금까지 선배가 게으름 피우는 걸 한 번도 본 적 없는걸요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "로도스 아일랜드에 온 뒤로 프란카 선배와 어울리는 시간도 늘긴 했지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그건 다 그 녀석 때문이라고."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "꽉 막힌 성격을 고쳐야 한다면서 굳이 그런 한심한 방법을……!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "하지만 리스캄 선배는 그 어느 때보다도 잘 지내고 계시잖아요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "게다가 훨씬 자주 웃으시게 됐고요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "전 프란카 선배가 좋은 변화를 가져왔다고 생각해요……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "사실 그 녀석, 감염자가 되긴 했지만 좀 더 멋지게 살 방법을 여전히 고민하고 있거든."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "진지할 때는 진지하게, 즐길 때는 화끈하게."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "블랙스틸에 계속 있었다면 감염자가 된 대원에게 이런 대우는 주어지지 않았을걸."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "파트너로 계속 출근하는 건 말할 것도 없고."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "프란카는 감염자가 되긴 했지만 대신 자신이 앞으로 어떤 삶을 살아야 할지 즉각 깨달았어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "난 아직도…… 많이 부족해."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "하지만 리스캄 선배는 이미 목표를 찾은 게 아니었나요?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "고향으로 돌아가서 와이번에 평화와 변화를 가져다줄 수 있는 방법……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배라면 저보다는 더 현명할 거라고 생각해요. 틀림없어요!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "난 아직…… 그렇게 대단하지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "지금의 나는 프란카처럼 명확한 목표도 없고."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "스스로 조직을 세우고 젊은 리더가 되려면 어떻게 해야 하는지 막막하기만 한걸."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래도 내 힘으로 와이번의 현실을 바꿀 가능성이 있다고 생각해."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "최소한 난 그렇게 생각해."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "분명 그럴 거예요!"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "바닐라 씨가 와이번에는 특별한 춤과 음식이 잔뜩 있다고 했어요…… 인적이 드문 곳에 사는 부족들도, 초라하지만…… 희망을 품은 채 살아가고 있다고요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "아무래도 와이번에 푹 빠진 것 같은데?"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "왜냐면…… 와이번을 배경으로 하는 소설은 이야기도, 주인공도 특별하거든요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "앞으로 와이번의 이야기를 더 많은 사람이 좋아하게 될 거라고 생각해요."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "저, 저 그리고 와이번에 여행도 가고 싶어요."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "물론이지…… 시간만 된다면 내가 제시카를 '경호'해 주고 싶네."
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "리스캄 선배마저 그렇게 말할 정도라니…… 으으…… 와이번은 정말 그렇게 무서운 곳인가요?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "지금이라면 확실히 위험하긴 해."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "강도나 만나면 그나마 다행이지. 용병 간의 싸움에 휘말려 들기라도 하면……"
    },
    {
      "type": "dialogue",
      "speakerName": "제시카",
      "speakerId": "char_259_Jessica",
      "isRemote": false,
      "text": "그, 그건……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래도 와이번은 제시카가 한 번쯤은 둘러볼 만한 곳이 될 수 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "전문 보디가드를 고용하지 않아도, 황무지와 도시 곳곳을 자유롭게, 자연스럽게 돌아다닐 수 있거든."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그렇게 하려면……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_room_2"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "흐아암~ 하이~ 리스캄, 여기 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "왜 제멋대로 문을 여는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "뭘 쓰고 있었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "내 보고서 함부로 들여다보지 마."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "응? 이 소설은?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "내 책장도 함부로 건드리지 마."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "《와이번의 사랑》…… 아, 이건!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "역시 네 것이었구나."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "이건 내가 네 탁자에 올려둔 연애소설이잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "……역시 전혀 신경 안 쓰고 있었구나."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "이 책, 정말 감동적이라니까. 사람들이랑 읽은 소감 이야기를 나누고 싶을 정도로."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "지난번에 빌려줬을 때는 전혀 관심도 없더니 웬일이래?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "제시카가 빌려 갔다가 다 읽고 방금 돌려준 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "그럼 제시카랑 이야기하면 되겠다. 너처럼 김빠지는 애한테 다신 추천하나 봐라."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "흥, 뜬구름 잡는 이야기잖아. 꼭 봐야 할 이유 같은 것도 없다고."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "이건 요새 인기몰이 중인 여성 히어로의 러브 스토리란 말이야. 게다가 드물게 와이번이 배경이기도 하고."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "그래, 컬럼비아 저자가 쓴 와이번에 관한 글이니 현지인이 보기엔 좀 이상하긴 하겠다만."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "하지만 네가 책의 비현실적인 부분을 지적하든 말든 난 별로 상관없는데?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래도 네가 좋다고 했던 편지를 주고받는 장면 같은 일은 결코 있을 수가 없다고."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "쳇."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래도…… 제시카는 소설을 다 읽고 와이번의 지명과 가문에 대해 많은 이야기를 꺼내던데."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "게다가 와이번에서 일어난 일에 강한 호기심을 보이더니 연구 보고서를 잔뜩 빌려 갔지……"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "그게 바로 소설의 매력이니까."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "맞아, 새로운 연구 소재로 써도 괜찮을 것 같아……"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "너 말이야, 연애 세포는 완전히 죽은 거니?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "선호하는 소재가 다른 것뿐이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "SF물이라면……"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "사랑 같은 건 쥐뿔도 없는 그런 장르 따위."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……무기나 장비를 연구하는 게 뭐 어때서!"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그, 그러고 보니…… 왜 날 찾아온 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "으음…… 그러니까…… 왜 왔더라?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "하아?"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "장난이야, 장난!"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "임무가 새로 내려왔어, 돌연변이 원석충과 관련된 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "흐음, 그러니까…… 내가 혼자서 처리하거나 너한테 얘기하지 않으면 머리끝까지 화를 내려나?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "어때? 나랑 같이 갈래?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "(스으으읍……)"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "(후우우우……)"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "마침 보고서도 다 썼거든."
    },
    {
      "type": "dialogue",
      "speakerName": "프란카",
      "speakerId": "char_106_franka",
      "isRemote": false,
      "text": "오케이, 그럼 바로~?"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "그래……"
    },
    {
      "type": "dialogue",
      "speakerName": "리스캄",
      "speakerId": "char_107_liskam",
      "isRemote": false,
      "text": "꾸물거릴 거 없이 바로 출발하자고."
    },
    {
      "type": "sceneBreak"
    }
  ],
