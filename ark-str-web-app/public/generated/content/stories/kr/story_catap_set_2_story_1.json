{
  "server": "kr",
  "storyId": "story_catap_set_2_story_1",
  "groupId": "story_catap_set_2",
  "stageId": null,
  "title": "변화",
  "storyCode": null,
  "avgTag": "브릿지",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/obt/memory/story_catap_2_1.txt",
  "sourceHash": "ea6fd71ac00a34329bcb12d1b8e417273c3babaadcbce175972a5c235ad2eb81",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "카시미어 외딴 지역\n캐터펄트의 고향"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "여긴가 보네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "응, 여기야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "옛날에 이 거리에 금화를 잔뜩 뿌렸었는데."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "쓸데없는 소리 하지 마. 지금은 누가 봐도 평범한 거리잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "나는 사실을 말했을 뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "사실? 네가?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "하하하하."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "에이, 그러지 마. 난 진지하다고."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "정말?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "정말."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "그래. 한 번 믿어줄게."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "언제 로도스 아일랜드로 돌아갈 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "오늘 밤에."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "이 정도로 충분해?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그냥 한번 보러 돌아온 것뿐이니까 반나절이면 충분해."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "으흠."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "지금은 아침 7시야."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "그럼…… 오후 7시쯤에 여기서 기다리고 있을게."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "알았어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "나중에 특산물 많이 갖다줄게."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "일단 잡히지나 마."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "단말기 잘 가지고 다니고 언제라도 통신 가능하게 해 둬. 문제 있으면 바로 연락하고."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "내가 애냐! 빨리 가봐."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "그렇게 내가 싫어? 알았어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "특산품 안 가져오면 차에 안 태워줄 줄 알아."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "알았다고. 나중에 이 동네 대추 맛 좀 보여 줄게!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "후……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "자, 이 빌어먹을 곳에 도대체 어떤 변화가 생겼는지 한번 볼까."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "마을 변두리는 여전히 그대로네. 하지만 마을의 중심은……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "오호, 돈이 꽤 많이 들었겠는데."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그 영감탱이였다면 분명 금화 반 개도 내놓지 않았겠지."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "어린 기사 나리는 꽤 괜찮은 사람인가 보네?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "avg_npc_001",
      "text": "도련님은 정말 훌륭하셔. 이곳에서의 삶도 전보다는 훨씬 편안해졌어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "오, 몇 년 만이야 이게. 잘 사는 것 같네, 필론 형."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "편지를 받고 돌아온 걸 알았어, 알레타."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "모양새를 보니 잘 지내는 것 같고."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "옛날엔 나를 이름으로 부르지 않았었잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "내 별명을 잊어버린 거야? 아니면 날 깔보는 거야? 응?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그래, 그래."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "캐터펄트."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이제 만족해?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그런대로 괜찮네."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "넌 몇 년 전이랑 별로 달라진 게 없네."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "나가서 뭐 했었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "나간 뒤에 막노동 일을 했었어. 그래도 보수도 짭짤했고 여기저기 여행도 다닐 수 있었어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "형은? 그때 이후로 잘 지냈지?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "에휴……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "모르나 보네. 네가 떠나자마자 영감이 마을 전부 뒤집어엎었어. 물론 원래 보물의 1/4도 되찾지 못했지만."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "결국 열 받은 영감이 세금을 두 배로 올렸어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "이런……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "지금은? 지금도 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그럴 리가 있나. 2, 3개월 동안뿐이었어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "나중에 어떻게 된 건진 모르지만 대도시에서 조사단이 내려왔어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "무슨 얘기가 오갔는지는 몰라도 이후 영감은 두 번 다시 나타나지 않았어. 듣기론 은퇴하고 조상 대대로 내려오는 저택에서 휴양을 하는 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "도련님이 오신 후 가장 먼저 세금을 전처럼 돌려놓았고, 마을에 돈을 엄청 풀어서 지금과 같은 모습이 된 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "으흠, 도련님은 희망이 보이네."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "아무튼 오랜만에 돌아왔으니 길도 잘 모르겠지. 오늘은 내가 데리고 다니면서 마을 곳곳을 다시 안내해줄게."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "가자."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "어어어, 잠깐!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "왜 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "지명 수배령이 아직 남아 있잖아. 이렇게 들어가는 건 좀 아닌 것 같은데."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "에이, 편지에도 적어 뒀잖아. 도련님이 오셨을 때 그 일이랑 관련된 지명 수배령을 모두 철회하셨어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "정말?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "왜, 이젠 이 필론 형도 못 믿겠나?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "믿지. 어떻게 안 믿을 수가 있겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "빨리 길이나 안내해 줘. 마을이 미궁처럼 변해서 길을 잃을 것 같아."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "참, 이번엔 얼마나 머물 생각이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "우리 회사의 이동함선이 마침 여기를 지나가길래 휴가를 내고 온 거야. 오늘 바로 갈 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "나가더니 바쁜 사람이 되었구나? 대단하네, 캐터펄트."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "편지를 받고 일부러 보러 온 거라니까? 정말이지."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "빨리 길이나 안내해 줘."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그래, 가자."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "자, 여긴 익숙하지? 전에 내가 일했던 공장이야. 지금은 전부 다시 지어졌지만."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "안에 에어컨도 있고, 전보다 훨씬 더 쾌적해졌어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "음……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "형, 뭐 좀 물어볼 게 있는데."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "뭔데?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "마을 제일 외곽에 있는 그 땅에는 예전에 먹을 걸 심었었잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그랬지."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "지금은 왜 포도밖에 없는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "거기뿐만이 아니야. 도련님은 모든 농지에 포도를 심을 준비를 하고 계셔."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "여기는 땅이 좋아서 포도 품질도 좋거든. 좋은 값에 팔 수 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그럼 먹을 건?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "하루 세끼를 포도만 먹을 수는 없잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하, 그럴 리가 있겠니."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "포도를 심고 나선 다른 곳에서 식량을 사 올 돈이 생겼어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "전부 밖에서 사 오는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "도련님은 수완이 좋거든. 지금 이곳의 식료품 시장에서는 지금까지 먹어본 적도 없는 많은 것들을 살 수 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "아 그렇구나. 좋네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(도련님은 영감탱이보단 믿을 만한 것 같네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(하지만 먹을 걸 심지 않았다가 도시의 권력자들이 값을 올리면 어쩔 생각이지?)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "전에는 이 작은 마을 안에 공장이 여기저기에 널려있었는데 지금 도련님이 그걸 전부 한곳에 모으려고 하셔. 대형 공장이 완공되면 우리는 도련님과 함께 큰돈을 벌게 될 수 있을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(뭐 됐어. 이건 물어봤자 분위기가 나빠질 테니 물을 필요가 없겠지.)"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "얘기가 나온 김에 대형 공장 안에 들어가 보는 건 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그래. 내가 있을 때 대형 공장은 아직 공사도 시작 안 했으니까."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "진짜 크네. 영감탱이의 조상이 살던 집도 이 정도는 아니겠는데."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "당연하지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "아직 다 지어진 게 아니라 공사하면서 운영 중이야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "다 지어지면 온 마을 사람들이 다 일을 할 수 있을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "전…… 부? 그럴 리가."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "“일이 필요하면 일을 준다.”"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "도련님이 직접 우리에게 하신 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "어릴 때 우리한테 무를 주던 할아버지 기억나?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그 대머리 할아버지?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "응."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "전엔 집에 사람이 많아서 할아버지가 농사를 지을 필요는 없었거든. 매일 한가해서 따분해 죽는 줄 알았대."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "지금은 도련님께서 할아버지에게 경비 자리를 주셨어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "할아버지도 일을 하니까 생활비도 보탤 수 있다고 좋아하셨고 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "맞는 말이네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(하지만 여긴…… 안심하고 일할 수 있는 환경은 아닌 것 같은데……)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그런데 도련님은 공장 주변을 깔끔하게 만들 생각은 없으신가?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "방금 우리가 온 길엔 시큼한 냄새가 엄청나던데."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "당분간은 참아달라고 하셨어. 공장이 다 지어지면 그때 같이 하신대."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "도련님은 어쨌든 그 영감탱이 아들인데 말하는 걸 다 잘도 믿는구나."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "도련님 덕분에 요즘 다들 잘살고 있으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "잘 사는 것처럼 보이더라."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하하 당연하지. 전보단 훨씬 나아."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그러다 언제 도련님이 형을 팔아버려도, 형은 좋아라하면서 함께 돈을 세고 있을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "설마 그러겠냐."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그럼 구체적으로 말해봐. 도련님이 대체 형한테 무슨 혜택을 준 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그거는 긴 얘긴데? 레스토랑에서 앉아서 얘기할까?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "레스토랑? 여기에 그런 고급스러운 것도 생겼어?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "물론이지. 저렴한데다 양도 많고 맛도 괜찮아."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "재미있네. 빨리 안내해 줘. 마침 배가 좀 고팠거든."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "꺼억~"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "어때, 맛있지?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "아아, 응."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(호화스러운 레스토랑일 줄 알았는데.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(이건 그냥 패스트푸드점 겸 술집이잖아?!)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(흠……)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(그래도 전에 영감탱이한테 이것저것 바칠 때는 다음 끼니를 먹을 수나 있을지 걱정하는 게 일상이긴 했지.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(패스트푸드라…… 확실히 호화로운 요리라고 할 수도 있을 것 같네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(양이 많아 배도 부르고, 그렇게 비싸지도 않고.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(그런데 마을이…… 진짜 많이 변했네.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "도련님이 예전 시가지를 완전히 철거한 건 아니지?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "아, 그곳은 거의 다 철거했어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이 패스트푸드점이 원래 어디였는지 맞춰 볼래?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "어디였을까……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "분수 광장?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "아니야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그럼 광장은 아직 그대로겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "철거했어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "쳇, 참고할 것도 없네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "다시 생각해볼게……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "법정?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "거의 맞췄어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "또 틀린 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "음……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "설마……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(폭발하는 동작을 흉내 낸다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "이거 맞지?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "맞았어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "도련님은 영감탱이의 흔적을 완전히 지워버리고 싶은 거구나."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "이곳마저 재건축하다니."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그럼 도련님은? 도련님은 어디 계시는데?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "저기 최상층에."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "나중에 보면 알겠지만 저렇게 높은 빌딩은 여기선 저거 하나뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "지금 이 조그만 마을의 돈 많고 명망 있는 사람들은 다 저기서 살고 있어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "형도 좀 벌었잖아. 왜 이사 안 했어?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "마을에 큰돈을 번 사람들에 비하면 난 부족하지."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그래도 네 덕에 꽤 저축하긴 했어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "영감이 횡포를 부릴 때 네가 준 걸 잘 숨기고 있었거든."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "도련님이 오신 후에 나는 그 돈으로 작게 장사를 할 생각이었어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "괜찮네. 형은 어릴 때부터 운도 좋고 머리도 좋았잖아. 꽤 많이 벌었겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "벌어? 그럴 리가…… 그게 그렇게 쉽겠어……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "원래 도련님은 공장을 세우기 위해 구획을 만드셨어. 나는 그곳 주변에서 작은 가게를 열려고 했지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하지만 가게를 빌리고 나니, 도련님의 공장은 반대쪽에서부터 지어지기 시작했어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이미 돈도 다 냈겠다. 나는 그저 이를 악물고 가게를 열 수밖에 없었어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "찾아와 주는 손님은 근처에 사는 몇몇 사람들뿐이야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "지금까지 매년 적자가 이어졌지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "거기다 이 공장은 언제 다 지어질지도 모르고……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그런데도 형은 도련님을 치켜세우고 있잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "넌 이해 못 할 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그 기사 아가씨가 영감을 방문한 후로 여기에도 기사 스포츠 같은 게 생겼어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하지만 진정으로 대중화된 건 다 도련님 덕이지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "지금 우리에겐 볼 경기가 생겼을 뿐만이 아니라,"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(작은 목소리로) 돈도 벌게 됐어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "경기를 보고…… 돈을 번다고? 그렇게 좋은 일이 있어?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "왜 없겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(손목시계를 본다)"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "마침 오후 경기가 곧 시작되네."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "표는 내가 사줄 테니까 보러 가자."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그래."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(듣기엔 괜찮아 보이는걸.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(그런데 왜 뭔가 이상한 것 같지?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "우리 좌석은 이 줄이야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(앉는다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "소파잖아?! 우와, 엄청 편하네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "도련님이 돈 좀 쓰셨겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이 실내 경기장은 도련님이 사시는 그 건물보다 더 커."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "대형 공장이 다 지어지기 전까진 이곳이 바로 우리 마을의 랜드마크야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "크고, 웅장하고, 편안하지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이런 걸 누릴 수 있는데 당연히 도련님을 칭찬해야 하지 않겠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "헤, 그건 그렇네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "응?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "왜 의자에 단말기가 있는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이거는 말이지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "캐터펄트, 이게 바로 내가 돈을 버는 비결이야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "무슨 말이야?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": null,
      "text": "경기장에 오신 여러분 환영합니다. 저는 오늘 이 경기의 해설자입니다."
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": null,
      "text": "우선 우리 마을의 훌륭한 젊은이를 모십니다. 프리랜서 기사~~ 라즈!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "라즈?!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "라즈는 영감탱이 밑에서 일하지 않았어?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "어떻게 된 거야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그날 네 일 때문에 많은 사람이 잘렸어. 라즈도 그중 하나였지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈는 원래 집으로 돌아가 계속 농사나 지으려고 했는데, 그 고귀한 기사 아가씨를 우연히 만난 후에 갑자기 “프로 기사가 되고 싶다” 같은 말을 하기 시작했어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "처음에는 나도 헛소리를 하는 줄 알았어."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "근데 진심이더라고."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈는 기사 스포츠가 우리 마을에 도입되자마자 등록해서 최초로 프로 기사가 된 사람 중 한 명이야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈는 원래 얼굴도 괜찮고 실력도 있어서 마을에서는 꽤 인기가 많아."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "당연하지만 가장 중요한 건……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈는 이길 능력이 있다는 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하지만 오늘 경기는…… 확실치 않아……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": null,
      "text": "그 상대는! 바로 글로리어스 실드 공업의 장비 검사원, 프리랜서 기사~~ 스톤 씨입니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "장비 검사원……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "잠깐만, 저 사람 딱 봐도 만만찮아 보이잖아."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "나도 알아. 조급해하지 마."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": null,
      "text": "여러분의 단말기가 모두 켜졌습니다."
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": null,
      "text": "선수를 위해 베팅하시겠습니까? 아니면 지원물자 투입 칩을 구매하시겠습니까?"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": null,
      "text": "기사들의 운명은 그들 자신과 여러분의 결정에 달려있습니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "단말기가 켜졌어……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(단말기를 조작한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "뭐 하는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "조용히 하고 좀만 기다려 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "스톤이 이길 확률이 높아…… 하지만……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈의 배당률이……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "좋아, 역시 이번 경기도 라즈에게 걸어야겠어!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(단말기를 조작한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "5000이나…… 걸었어?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "이 숫자가…… 현금은 아니겠지?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그래. 지금은 그저 숫자일 뿐이야. 하지만 경기장을 나갈 땐 단말기에 입력한 액수에서 상금을 제한 나머지를 지불해야 해."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그럼 누군가 지불하지 못하는 사람이 있을 거잖아. 안 그래?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "지불하지 못하면…… 도련님을 위해 일해서 갚아야지."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "형 지금 자신이 뭘 하는지는 아는 거야?!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "난 라즈가 이기는 쪽에 걸었어!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈가 이기기만 하면 한몫 더 챙길 수 있다고, 알겠냐!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "연구해 봤는데 라즈가 데이터상으론 밀리긴 하지만 이길 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "내가 베팅하면, 라즈는 이기는 거야!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "지면 어떻게 할 건데!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "그래, 가끔은 나도 실수를 할 수 있지."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하지만 내가 라즈가 이긴다는 데에 걸었으니 꼭 이길 거야!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "나와 라즈를 믿어, 알겠지?!"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "경기~ 시작합니다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(더이상 캐터펄트는 신경 쓰지 않고, 경기장만 노려본다.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(필론……)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(라즈와 스톤이 기술로나 장비로나 비교가 안 되는 걸 도대체 알기나 하는 거야?)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(베테랑 용병이 그냥 재능 좀 있는 풋내기 시골뜨기와 맞붙었다는 걸 알기나 하냐고?)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(형이 운이 좋다는 건 알긴 하지만, 이래서는……)"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈! 잘했어! 잘 싸웠어!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(올라가면 사력을 다해라. 도베르만 교관 앞이라면 채찍을 맞을 것이니.)"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈는 분명 이긴다니까."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(단말기에 1000을 입력한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "잘했어, 라즈! 힘껏 때려!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(이대로 라즈가 얼마나 버틸 수 있을까?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "15분 뒤"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈, 왜 저런 촌놈 하나 못 이기는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "무, 물러나지 마! 지금 바로 지원 물자를 보내줄게!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "(단말기를 조작한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(상대가 반격을 시작했어……)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(잠깐?!)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "저 외지인은 왜 죽일 기세인 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이, 이 경기는 원래 그, 그런 제한이 없어……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "쳇."
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "내 돈…… 내, 내 돈이……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(연락용 단말기를 켠다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(작은 목소리로) 이봐, 들려?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "char_282_catap",
      "text": "들려. 무슨 일이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "char_282_catap",
      "text": "붙잡힐 것 같아?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(작은 목소리로) 비슷해. 준비 좀 하고 마을 중심의 경기장 옆으로 와."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(작은 목소리로) 살아서 빠져나갈 자신 있지?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "char_282_catap",
      "text": "……알았어. 내 걱정은 말고 네 걱정이나 해."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "char_282_catap",
      "text": "다시 연락할게."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(작은 목소리로) 고마워."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(탄약을 장전한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(무기에 압력을 가한다)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈! 라즈, 지면 안 돼!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "너는 죽어도 상관없지만, 내 돈은 어쩔 거야!!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "비켜봐!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(이 거리에서 맞추면서 실수로 다치지 않게까지 하는 건…… 아슬아슬하겠네……)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(조준한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(모르겠다!)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(라즈, 너처럼 좋은 사람이 이런 곳에서 죽어선 안 돼.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(너한테 신세 진 걸 갚고 나면, 내가 이 빌어먹을 곳에 대해 미련을 둘 일도 없어지겠지.)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(외지인 멍청아, 좀 더 가까이 와봐!)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(방아쇠에 손가락을 올린다)"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(숨을 멈추고, 정신을 집중한다)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "멋진 일격입니다!!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "승리를 눈앞에 두고 스톤 씨가 갑자기 관중석을 돌아봅니다."
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "우리의 라즈가 기회를 잡는군요!"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "검을 들고 찔러 한방에 적을 제압합니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "절체절명의 위기에서 나온, 정말로 교과서에서나 볼 법한 반격이었습니다!"
    },
    {
      "type": "dialogue",
      "speakerName": "해설자",
      "speakerId": "char_282_catap",
      "text": "프리랜서 기사 라즈의~~ 승리입니다!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "뭐?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이, 이겼어?!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "이겼다! 이겼어!! 또 벌었다!!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "캐터펄트, 내가 뭐라고 했냐? 응?"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "라즈에 걸면 꼭 이긴다 했잖아. 꼭 이긴다고!"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "하하하하하하!!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "(무기를 회수한다)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "필론",
      "speakerId": "avg_npc_001",
      "text": "캐터펄트, 캐터펄트?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "여보세요."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "char_282_catap",
      "text": "도착했어. 오른쪽을 봐."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "왔구나."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "최악의 상황은 아닌가 보네."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "좋은 일도 일어나진 않았던 것 같고 말이야."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "카시미어의 다른 곳도 다 이래?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "기사 스포츠와 아레나를 말하는 거라면……"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "다 그래."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "알았어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "지금 몇 시야?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "오후 다, 여섯 시쯤."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "아무 데서나 뭐 좀 먹고, 특산물을 사서 돌아가자."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "이 빌어먹을 곳에서 멀면 멀수록 좋아."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "이런 *카시미어 욕설*!"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "흠……"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "일단 타."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "뒤에 저 돈 보따리 들고 쫓아오는 사람은 네 친구야?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "그냥 아는 사람, 잘 몰라."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "좀 빨리 몰아봐."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "그럴 필요는 없을 것 같네. 저 사람 돈 보따리가 찢어졌어."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "돈 주우러 돌아갔어?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "(핸들을 꺾는다)"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "그런 것 같네. 왜? 보고 싶어?"
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "볼 것도 없는데 뭐."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "아…… 배고프다."
    },
    {
      "type": "dialogue",
      "speakerName": "캐터펄트",
      "speakerId": "char_282_catap",
      "text": "우리 밥이나 먹으러 가자."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "이미 가고 있잖아?"
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "내가 알아봤으니까 안심해, 캐터펄트."
    },
    {
      "type": "dialogue",
      "speakerName": "로도스 아일랜드 외근 오퍼레이터",
      "speakerId": "avg_npc_012",
      "text": "곧 식당에 도착할 거야."
    },
    {
      "type": "sceneBreak"
    }
  ],
