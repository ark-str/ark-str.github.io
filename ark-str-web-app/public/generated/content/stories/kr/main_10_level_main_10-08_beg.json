          ]
        },
        {
          "label": "맞아, 투시 능력이 있어.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "피스트",
              "speakerId": "avg_npc_402_1",
              "isRemote": false,
              "text": "박사, 거짓말이지?"
