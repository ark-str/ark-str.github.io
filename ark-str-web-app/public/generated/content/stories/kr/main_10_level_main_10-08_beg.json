        {
          "label": "우리의 조력자일 수도 있어.",
          "value": "2",
          "blocks": []
        }
      ]
    },
    {
      "type": "dialogue",
      "speakerName": "아미야",
      "speakerId": "avg_npc_394_1",
      "isRemote": false,
      "text": "박사님, 원래 계획대로 행동할까요?"
