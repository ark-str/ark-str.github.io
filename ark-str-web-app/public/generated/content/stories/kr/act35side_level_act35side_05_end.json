{
  "server": "kr",
  "storyId": "act35side_level_act35side_05_end",
  "groupId": "act35side",
  "stageId": "act35side_05",
  "title": "유물도 출근",
  "storyCode": "AS-5",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsGamedata/kr/gamedata/story/activities/act35side/level_act35side_05_end.txt",
  "sourceHash": "f7d02af0fe56d85be51e0280d2198813b12185a2a6370c08e95f06ee7cb4ffeb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "지금 뭘 기다리고 있는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "통신. 너같이 나이 든 사람한텐 좀 신기할 수도 있겠네."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "여기서 얼마나 더 기다려야 하나?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "의심하지 마, 그냥 기다려."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "잠시 후의 통신은 내가 받아봐도 될까? 전에 사용법에 대해서는 설명을 들었……"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "안 돼, 안 돼, 절대 안 돼. 네 기계 같은 목소리를 들으면 피싱으로 오해받을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "알았다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "참, 네 말대로라면 우리 둘의 협력이 역사적으로 위대한 동맹을 본받은 거라며."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "그렇다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그럼 물어볼게, 널 위해 보석을 찾아다니면 나한테 무슨 이득이 생기는 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "아, 수확이 있긴 하네. 어젯밤에 네가 날 놀라게 만들었을 때 얼굴로 날아온 이 황금 슬리퍼를 얻었으니까."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "건의사항이라도 있나?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "……감히 그럴 리가. 그런 건 없어. 내가 살아있다는 것 자체가 네 은혜지. 너는 사르곤의 조상이니 너와 함께 보석을 찾는 건 내가 당연히 해야 할 일이야. 절대 흥분하지 마."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그런데 풍작 집회에서 1등을 했던 유물도 이런 순금에 사파이어가 박힌 슬리퍼 아니었던가?"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "그렇다. 아마 두 슬리퍼가 한 쌍일 거다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그렇다면……"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "한밤중에 거리에서 소리 지르면서 소란 피우는 것도 돈벌이 수단이 되는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……원래 한 쌍이었던 유물 중 하나가 강바닥 밑으로 가라앉게 되면 나머지 한 짝도 대부분의 가치를 잃게 되는 법이다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "오호."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……궁금한 게 있다. 이 시대의 나이츠모라는…… 모두 그대처럼 행동하나?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "아주 예리한 질문이네."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "강도질, 밀매, 납치를 위해서 각 부족의 풍습과 신앙을 조사해 봤지만, 정작 내 출생지에 대해서는 한 번도 조사해 본 적 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "어느 날 아침 해가 뜬 후로 다시는 돌아간 적이 없거든."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "그렇다면, 혹시…… 그대는 자신의 '천도'를 걷고 있는 건가?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "천도?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "(고대 언어) 천도."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "……아니, 아냐, 절대 그 단어는 듣고 싶지 않아."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "난 천도를 걷지 않아. 내 조상이 강요한다 해도 소용없어."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "설마 아직 성인식도 치르지 않은 건가?!"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그래, 별로 중요한 일도 아닌데 뭐."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "내게 나이츠모라의 피가 조금 있을 수는 있겠지. 하지만 그 피 때문에 내가 폭군이나 정복자가 되진 않았어. 그리고 난 그 피가 내 삶에 영향을 주게 만들지 않을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "아니, 아주 중요한 일이다."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "천도를 걷지 않았는데 어떻게 선조들이 그대의 피를 인정한다는 거지?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "괜찮아, 내 조상들은 대부분 대지 끝에서 실종됐을 거야. 너처럼 갑자기 박물관에서 일어나 날 욕하진 않을 거라고."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그러고 보니, 너는 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "샤 시대 사람들은 성인이 되면 머리를 밀고 향유를 바른다고 들었어. 근데 또 어떤 사람들은 그 '향유'가 사실 냄새가 아주 고약했다고 하더라고…… 그게 궁금해."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "나도……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "아, 왔네."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "……뭐야, 보석에 대한 소식을 벌써 찾은 거야?"
    },
    {
      "type": "dialogue",
      "speakerName": "보석 중개인",
      "speakerId": null,
      "text": "네, 우연히 방금 보석 거래소의 관리인이 소식을 전해 왔어요. 관리인이 급히 거래해야 할 보석을 가지고 있다고 합니다. 근데 모든 면에서 당신이 설명한 것과 일치한다고 해요."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "좋아, 직접 가서 만나야겠어."
    },
    {
      "type": "dialogue",
      "speakerName": "보석 중개인",
      "speakerId": null,
      "text": "하지만…… 제가 중개를 해도 관리인과 직접 이 거래를 논의하긴 어려우실 겁니다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "뭐? 내 부하들 말로는 카운터에만 가도 보석을 팔 수 있다던데."
    },
    {
      "type": "dialogue",
      "speakerName": "보석 중개인",
      "speakerId": null,
      "text": "파는 건 쉽지만 사는 건 달라요. 보석 거래소는 일반적인 상점이 아니죠. 관리인에게서 직접 물건을 받으려면 그만한 가치의 '저울추'를 내야 합니다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그만한 가치의 '저울추'?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "……내게 좋은 생각이 있어."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "크흠, 맞아. 이게 바로 거래 내용이야."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "최근 박물관에서 전시 중인 미라…… 샤 시대의 이름 없는 장군."
    },
    {
      "type": "narration",
      "text": "보석 거래소의 젊은 관리인이 복잡미묘한 표정으로 나란투야를 한 번 쳐다보더니 거대한 도금 상자 앞으로 몸을 숙였다.\n주바이르는 가슴 위로 양손을 포개고 조용히 누워 있었다.\n솔직히, 나란투야는 이 순간이 주바이르가 가장 가치 있는 순간이라고 생각했다. 그 무서운 황금 가면조차 신성하고 부드러운 빛을 발하는 것 같았다."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "본 적 있는 상자다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "박물관에서 그대로 가져온 관…… 의 모조품이야, 모조품."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "…… (주바이르의 몸을 살짝 두드린다)"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "(손전등으로 흉강 내부를 검사한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "어, 이건 보통 유물이 아니니까 조심히 다뤄줘. 그렇게 마구잡이로 하지 말고."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "……이미 부활해서 자유롭게 움직일 수 있다고 들었는데."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그거야 뭐, 죽은 사람이 다시 살아날 순 없잖아. 다 오리지늄 아츠 연극일 뿐인 거지."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "게다가 정말로 움직인다면 무섭지 않겠어?"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "내가 구매한 뒤, 미라가 혼자 도망이라도 갈까 봐 무섭다는 건가?"
    },
    {
      "type": "narration",
      "text": "그건……\n어머, 저 검은 동물은 네 애완동물? 하하, 정말 예쁜 녀석이네!"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "역시 보석 거래소의 관리인이야. 도시 전체의 돈 흐름을 파악하는 사람이라 그런지 애완동물도 남다르네."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "(작은 목소리로) 우프, 이 사람이야?"
    },
    {
      "type": "dialogue",
      "speakerName": "우프",
      "speakerId": null,
      "text": "(냄새를 맡는다)"
    },
    {
      "type": "dialogue",
      "speakerName": "우프",
      "speakerId": null,
      "text": "(관 옆에 앉는다)"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "저것 봐, 냄새를 맡고 알아챘잖아. 이렇게 수천 년 된 미라의 냄새는 절대 위조할 수 없거든."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "마치 내가 너와 거래하려는 이 마음에 단 하나의 거짓도 없는 것처럼."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "물론, 이 유물은 너무 귀한 탓에 처리하기 쉽지 않다는 건 알아. 맞아, 귀찮은 일을 떠넘긴 셈이야. 그래서 대가를 많이 바라지는 않을게."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "하지만 박물관에서 절대 추적할 수 없다는 건 장담해……"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "아니, 당신은 아주 무거운 저울추를 제시했어."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "물론 그렇다 해도 내 저울로 측정할 수 없을 정도는 아니지만."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "……어, 그래."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "무엇으로 교환하고 싶지? 듣기로는 보석 하나 때문에 이곳까지 왔다고 하던데."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "아, 원래는 그랬지만, 오는 길에 마음이 바뀌었어. 그 보석은 이제 필요 없어."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "난 외지인이니까 그냥 금괴로 주면 돼."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "순금으로 정산하겠다고? 맞는 저울을 가져오지."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "먼저 물건을 안쪽 방으로 옮겨줄 수 있을까? 다른 사람 눈에 띄지 않게."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그럼…… 거래 성사?"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "응."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "하, 난 이렇게 시원시원한 사람이 마음에 든다니까!"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "관에 다시 들어가는 기분은 정말 좋지 않군, 굳이 네 부하들을 시켜 이걸 운반해 올 필요는 없었다."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "쉿, 조용히 해…… 조금만 참아. 곧 데리러 올 테니까."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "서둘러서 오늘 안에 네가 원하는 보석을 찾아."
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "알았다. 하지만 잊지 말아라. 난 아직 그대한테 볼일이 남아있다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "이게 내가 제시할 수 있는 가격이야. 어때?"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "음…… ♪칼날 위의 초승달을 잊지 못하고, 씻긴 소년의 진심은 황금이 되네♪"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "정말 잊을 수 없네…… 이의 없어, 전혀!"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "그럼 이만."
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "안녕히."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "(주바이르에게 윙크한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "(나란투야에게 윙크한다)"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "다음 거래도 기대할게!"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "다음이 있다고 한 적은 없는데."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "하하, 나도 다음이 있다고는 하지 않았어. 적어도 단기간 내엔 절대 없을 거야."
    },
    {
      "type": "dialogue",
      "speakerName": "나란투야",
      "speakerId": null,
      "text": "저 늙다리가 나한테 심부름을 시키려고 하네? 미안하지만 영원히 안녕이다!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "……내 뜻을 이해했겠지? 만약 나란투야가 정말로 나이츠모라의 후손이라면……"
    },
    {
      "type": "dialogue",
      "speakerName": "주바이르",
      "speakerId": null,
      "text": "나란투야를 기다리는 보물창고가 있을 것이다."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "그가 마침내 내가 흘린 정보를 따라 이 거래소에 왔군……"
    },
    {
      "type": "dialogue",
      "speakerName": "라즈바르",
      "speakerId": null,
      "text": "미오, 우프."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "미오",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "우프",
      "speakerId": null,
      "text": "……잘했어, 라즈바르."
    },
    {
      "type": "dialogue",
      "speakerName": "미오",
      "speakerId": null,
      "text": "정말 크게 칭찬해 줘야 할 일이야."
    },
    {
      "type": "sceneBreak"
    }
  ],
