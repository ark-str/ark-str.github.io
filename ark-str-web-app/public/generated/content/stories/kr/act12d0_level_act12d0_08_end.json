{
  "server": "kr",
  "storyId": "act12d0_level_act12d0_08_end",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "가비알의 주먹",
  "storyCode": "RI-8",
  "avgTag": "작전 후",
  "sourcePath": "vendor/ArknightsData/kr/gamedata/story/activities/act12d0/level_act12d0_08_end.txt",
  "sourceHash": "f815f65651578fc86681c7a23374880c3835dea5440f74c3b4feb6d97903b121",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "대제사장",
      "text": "으아아아아아악! 에잇, 아니야. 다음엔 목소리를 바꿔야겠어. 좀 지겹기도 하니……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "어이, 저 사람 괜찮은 거야?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "걱정할 필요 없어. 곧 돌아올 거야.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그래. 근데 정말 보통 사람 맞아? 저런 사람이 있다는 얘긴 들어본 적이 없는데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "몰라. 대제사장 본인 말로는 여기서 아주 오래 살았다나봐.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그래, 그보다……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "후, 이 큰 녀석은 정말 대단하구나.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블레이즈",
      "text": "가비알, 머리에서 피가 나는데, 괜찮아?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "이 정도 상처는 괜찮아. 토미미, 내 구급상자 좀 갖다 줘.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "응? 토미미는?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "자, 구급상자는 여기. 토미미는 방금 막 이기기 직전에 다급하게 다른 곳으로 뛰어간 것 같았는데……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "고마워. 설마 겁에 질린 건 아니겠지? 아 몰라, 일단 붕대부터 감자.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "다친 동료가 있는지 가서 봐주고, 있으면 모두 데려와 줘. 내가 치료할 테니.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "케오베",
      "text": "응, 나한테 맡겨!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "블레이즈",
      "text": "하핫, 맡겨달라고.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "우타게",
      "text": "에에… 귀찮은데.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "크루아상",
      "text": "불평하지 마라!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "박사…… 음?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "거대하고 못생긴 게……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "주마마, 미안해. 부술 수밖에 없었어.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "알아.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "검사해봤는데, 네 엔진은 아직 쓸 수 있더라. 돌려줄게.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "그래? 정말 잘 됐다!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "가비알, 여기 남을 생각 없어?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "응, 나도 너랑 같아, 해야 할 일을 찾았지.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "의사?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "응.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "의사 일이 즐거워?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "기계 만드는 게 즐거워?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "응.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "나도 그래.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "하지만 대족장은 네가 해야 해.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "뭐?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "어쨌든 거대하고 못생긴 걸 쓰러뜨린 건 사실이잖아. 네가 이겼어, 가비알.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "유넥티스",
      "text": "봐, 사람들이 다시 모여들고 있어. 다들 너만 보고 있는걸.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "가비알",
      "text": "으으…… 박사, 어떡하지?",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "네가 결정해야지.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "하나 마나 한 말이네!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "박사, 자는 척하지 마! 나는 의사라고!",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "대족장 가비알 만세!",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "가비알",
              "text": "진심으로 지금 박사 한 대 때리고 싶네…",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가비알 씨, 괜찮아요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "응? 괜찮아. 어디 갔었어?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "네? 아, 그, 그건… 아까 갑자기 화장실이 너무 가고 싶어서요!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "그랬구나…… 음?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "왜 그러시죠? 가비알 씨, 왜 갑자기 절 보시는 건지…",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "어…… 하하, 방법이 있다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "모두 잘 들어!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "내가 거대하고 못생긴 걸 이겼으니까 앞으로는 내가 대족장이야!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "여기서 내가 모두에게 하고 싶은 말은……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "주먹이 전부다!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "앗, 가비알 씨, 남아서 대족장이 되시려고요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "하지만!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "정말 중요하게 해야 할 일이 있어서, 떠나야만 해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "걱정하지는 마! 내가 없는 동안은 토미미가 나를 대신해 명령을 내릴 테니!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "토미미를 나라고 여기면 돼!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "에, 에에엣?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "우타게",
          "text": "뭐? 그래도 되는 거야? 여기 사람들은 힘이 최고라고들 하잖아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "그래도 가비알이 대족장이고, 모든 사람들을 이겼으니, 가비알의 말이라면 다들 복종할 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "하하, 주마마. 기계도 재밌지만 나는 주먹이 더 좋아.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "흥, 잊지 마. 아직 널 인정한 건 아니야. 더 대단한 기계를 만들어서 다시 도전할 테니까.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "좋아. 기다리지.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "맞다, 그 전에 나랑 어디 좀 가야 해.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "왜?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "먼저 나랑 로도스 아일랜드에 가서 네 광석병 상태를 봐야겠어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "거절해도 되나? 난 거대하고 못생긴 걸……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "이번에는 안 돼. 게다가 토미미에게 넘겨주기 전까진 내가 대족장이야. 너를 묶어서라도 데려갈 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "유넥티스",
          "text": "알겠어.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "가비알 씨…… 정말 갈 거예요?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "응. 엔진을 떼어서 비행체에 장착하고 나면 떠날 거야.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "안 돼요.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "가비알",
          "text": "응?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "토미미",
          "text": "저, 저는 못 보내요!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
