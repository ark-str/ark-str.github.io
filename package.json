{
  "name": "ark-str",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/guards/check-docs.mjs",
    "constraints:check": "node scripts/guards/check-constraints.mjs",
    "arch:check": "node scripts/guards/check-architecture.mjs",
    "guards:all": "npm run docs:check && npm run constraints:check && npm run arch:check",
    "smoke": "playwright test",
    "verify": "node scripts/harness/run-verify.mjs",
    "harness:iterate": "node scripts/harness/run-iteration.mjs"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  }
}
