{
  "name": "ark-str",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docs:check": "node scripts/guards/check-docs.mjs",
    "constraints:check": "node scripts/guards/check-constraints.mjs",
    "arch:check": "node scripts/guards/check-architecture.mjs",
    "design-system:check": "node scripts/guards/check-design-system.mjs",
    "guards:all": "npm run docs:check && npm run constraints:check && npm run arch:check && npm run design-system:check",
    "content:sync": "node scripts/content/sync.mjs",
    "content:build-index": "node scripts/content/build-index.mjs",
    "content:portraits": "node scripts/content/fetch-portraits.mjs",
    "content:check": "node scripts/content/check.mjs",
    "content:status": "node scripts/content/status.mjs",
    "content:update": "node scripts/content/update.mjs",
    "harness:test": "node --test tests/harness/*.test.mjs tests/content/*.test.mjs",
    "app:dev": "npm --prefix ark-str-web-app run dev",
    "app:build": "npm --prefix ark-str-web-app run build",
    "app:export": "npm --prefix ark-str-web-app run export",
    "app:export:ghpages": "npm --prefix ark-str-web-app run export:ghpages",
    "app:start": "npm --prefix ark-str-web-app run start",
    "app:lint": "npm --prefix ark-str-web-app run lint",
    "app:typecheck": "npm --prefix ark-str-web-app run typecheck",
    "app:verify": "npm --prefix ark-str-web-app run verify",
    "smoke": "playwright test",
    "verify": "node scripts/harness/run-verify.mjs",
    "harness:iterate": "node scripts/harness/run-iteration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "^5"
  }
}
